  "driverName": "김기사",
  "driverPhone": "010-1111-2222",
  "lines": [
    {
      "productId": "{{testProductId}}",
      "productName": "시스템에어컨 4Way",
      "modelName": "AJ040RXH4BC1",
      "quantity": 1,
      "unitPrice": 1850000
    }
  ]
}

