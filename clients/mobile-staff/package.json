{
  "name": "@samhan/mobile-staff",
  "version": "0.4.0",
  "private": true,
  "description": "SamhanLogis 영업직원 React Native (Expo SDK 53). D-AX-19 = 기사 모드 제거, EstimateWebView 단일 진입 보존. 배송기사 기능은 clients/arologis-mobile 전담.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "local-dev": "node ../../scripts/run-client-local-dev.cjs mobile-staff",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "capture:v3": "node scripts/capture-v3.cjs",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.6",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.0.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "playwright": "^1.59.1",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@testing-library))"
    ]
  }
}
