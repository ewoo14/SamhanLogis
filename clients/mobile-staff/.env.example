# SamhanLogis mobile-staff — Expo SDK 53 환경변수 (EXPO_PUBLIC_* 만 client 노출).
#
# D-AX-19 = AppRootNavigator estimate WebView 단일 진입.
# P1-4 (Phase 11+1개월) = APP_VARIANT="sales" 영업 전용 빌드 분리 예정.
#
# 파일 복사:
#   cp .env.example .env.local      (로컬 개발)
#   cp .env.example .env.preview    (EAS preview 빌드 — CI 주입)
#   cp .env.example .env.production (EAS production 빌드 — CI 주입)

# ────────────────────────────────────────────────────────────────────────
# 공통 API / 앱 URL
# ────────────────────────────────────────────────────────────────────────

# estimate-app v2 (Node + Express + EJS, port 5183) URL.
#   - dev   default: http://localhost:5183/
#   - prod  default: https://estimate.samhan-air.com/
# BUILD_ENV 미사용 시 이 값이 우선 적용 (app.config.js resolveEstimateAppUrl 참조).
EXPO_PUBLIC_ESTIMATE_APP_URL=https://estimate.samhan-air.com/

# SamhanLogis API gateway base URL.
#   - dev   default: http://localhost:8080
#   - prod  default: https://api.samhan-air.com
# BUILD_ENV 미사용 시 이 값이 우선 적용 (app.config.js resolveApiBaseUrl 참조).
EXPO_PUBLIC_API_BASE_URL=https://api.samhan-air.com

# ────────────────────────────────────────────────────────────────────────
# 빌드 환경 분기 (EAS Build CI 에서 eas.json env 블록으로 주입)
# ────────────────────────────────────────────────────────────────────────

# 빌드 환경 구분.
#   "development" | "preview" | "production"
#   로컬 실행 시 미설정(development fallback). EAS 빌드 시 eas.json env 블록이 자동 주입.
BUILD_ENV=development

# 앱 분기.
#   "staff"  = 영업직원 estimate WebView 단일 앱 (현재 유일값).
#   "sales"  = Phase 11+1개월 후 P1-4 영업 native 빌드 분리 예정.
APP_VARIANT=staff

# sales 변형 native API 호출용 개발/QA access token.
# production에서는 native 로그인·secure storage 경계로 교체한다.
# EXPO_PUBLIC_SALES_ACCESS_TOKEN=

# ────────────────────────────────────────────────────────────────────────
# EAS Build 제어 (CI GitHub Actions 에서 주입)
# ────────────────────────────────────────────────────────────────────────

# iOS CFBundleVersion / Android versionCode — EAS autoIncrement 활성 시 EAS 가 관리.
# 로컬 / preview 빌드 시 수동 설정 (단조 증가).
# EXPO_BUILD_NUMBER=1

# EAS 프로젝트 ID — `npx eas init` 후 실제 ID 로 교체.
# app.config.js extra.eas.projectId 와 동일값 유지.
# EAS_PROJECT_ID=PLACEHOLDER_EAS_PROJECT_ID

# ────────────────────────────────────────────────────────────────────────
# P1-4 영업 native 앱 (Phase 11+1개월 활성 예정)
# ────────────────────────────────────────────────────────────────────────
# 아래 변수는 P1-4 슬라이스 구현 시 활성 예정. 현재는 주석 처리.
# P1-4 활성 시: APP_VARIANT=sales 로 전환 + 아래 변수 추가.

# 영업 견적 목록 API (partner-order-service 연동).
# EXPO_PUBLIC_SALES_QUOTE_API_URL=https://api.samhan-air.com/api/v1/sales

# 거래처 검색 API (partner-service 연동).
# EXPO_PUBLIC_PARTNER_SEARCH_API_URL=https://api.samhan-air.com/api/v1/partners

# 품목 검색 API (product-service 연동).
# EXPO_PUBLIC_PRODUCT_SEARCH_API_URL=https://api.samhan-air.com/api/v1/products

# 오프라인 SQLite 최대 미동기화 항목 수 (P1-4 오프라인 작성 기능).
# EXPO_PUBLIC_OFFLINE_MAX_PENDING=50
