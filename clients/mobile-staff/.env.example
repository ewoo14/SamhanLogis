# SamhanLogis mobile-staff v2 — Expo SDK 53 환경변수 (`EXPO_PUBLIC_*` 만 client 노출).
#
# v2 = WebView only RN wrapper. 인증은 WebView 안 legacy estimate checkUserAuth (Apps Script 1:1) 가 처리.
# RN 측 인증 코드 없음 — shim 의 X-Samhan-Staff header 만 추가 (token 은 WebView 안 cookie/sessionStorage 활용).

# estimate-app v2 (Node + Express + EJS, port 5183) URL.
# - dev (`__DEV__ === true`)  default: http://localhost:5183/
# - prod (`__DEV__ === false`) default: https://estimate.samhan-air.com/
# 환경변수 정의 시 dev/prod 분기 무시하고 그대로 사용.
EXPO_PUBLIC_ESTIMATE_APP_URL=https://estimate.samhan-air.com/

# SamhanLogis API gateway base URL — shim 의 fetch monkey-patch 가 Authorization Bearer + X-Samhan-Staff 첨부 시 참조.
# - dev default: http://localhost:8080
# - prod default: https://api.samhan-air.com
EXPO_PUBLIC_API_BASE_URL=https://api.samhan-air.com
