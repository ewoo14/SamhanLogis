# SamhanLogis Mobile v5 — Expo SDK 53 환경변수 (`EXPO_PUBLIC_*` 만 client 노출).
#
# Mobile v4 의 partner-order WebView (port 5180) URL — 미정의 시 default localhost:5180 사용.
EXPO_PUBLIC_ORDER_APP_URL=https://order.samhan-air.com/legacy/index.html

# v5 추가 — estimate-app v2 (Node + Express + EJS, port 5183) URL.
# - dev (`__DEV__ === true`)  default: http://localhost:5183/
# - prod (`__DEV__ === false`) default: https://estimate.samhan-air.com/
# 환경변수 정의 시 dev/prod 분기 무시하고 그대로 사용.
EXPO_PUBLIC_ESTIMATE_APP_URL=https://estimate.samhan-air.com/

# SamhanLogis API gateway base URL — 미정의 시 dev=localhost:8080, prod=api.samhan-air.com.
EXPO_PUBLIC_API_BASE_URL=https://api.samhan-air.com
