{
  "name": "@samhan/mobile",
  "version": "0.5.0",
  "private": true,
  "description": "SamhanLogis 거래처 주문서 React Native (Expo SDK 53). v4 (회고 #2 정정) = SafeAreaProvider + StatusBar + 단일 MobileOrderWebViewScreen. 모든 RN native screen + navigation + store + api 폐기 → react-native-webview 가 order-legacy v4 (Node + Express + EJS, port 5185) 직접 임베드. mobile-mode CSS 분기 / 모바일 게이트 / 페이지 메뉴 drawer / 4 카테고리 / 임시저장 / 확정 모두 WebView 안 legacy 가 처리. mobile-staff v3 패턴 1:1 적용.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "local-dev": "node ../../scripts/run-client-local-dev.cjs mobile",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web",
    "capture:v4": "node scripts/capture-v4.cjs",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-native-async-storage/async-storage": "2.1.2",
    "expo": "~53.0.0",
    "expo-status-bar": "~2.2.3",
    "expo-updates": "~0.28.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "~19.0.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.0",
    "playwright": "^1.59.1",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@testing-library))"
    ]
  }
}
