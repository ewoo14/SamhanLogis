{
  "name": "@samhan/arologis-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "아로로지스 — 배차/기사 관리 전용 Electron 데스크톱 앱 (Samhan Public 분리 독립 운영).",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "local-dev": "node ../../scripts/run-client-local-dev.cjs arologis-desktop",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "node ../../scripts/build-arologis-desktop-release.cjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "electron-store": "^10.0.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@samhan/design-system": "file:../web/design-system",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@testing-library/jest-dom": "^6.9.1",
