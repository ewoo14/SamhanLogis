# estimate-app v2 환경변수
# 사용법: 본 파일 복사 -> .env 후 값 채움

# 서버 포트 (legacy Apps Script 진입 호환 — 5183 권장)
PORT=5183

# 사용자 이메일 (legacy Session.getActiveUser().getEmail() 대체 — dev only)
DEFAULT_USER_EMAIL=dev@samhan-air.com

# ─── SamhanLogis MS (slip 발송 + snapshot + 인증 + 감사로그) ──────────────
# slip-service 직접 호출 URL (견적 finalize → 출고전표 자동 생성)
# Phase 6 M5 (PR #76) 머지 후 default 8086.
SLIP_SERVICE_URL=http://localhost:8086

# P0-B (2026-06-10 결정 ②): 출고전표 발행 = POST /internal/slips/from-estimate
# X-Internal-Token 인증 — slip-service 의 SAMHAN_INTERNAL_TOKEN 과 동일 값.
# ⚠️ 운영 필수 설정 — 미설정 시 dev 기본값으로 운영 발행이 401 거부됨
#    (slip-service InternalTokenGuard 가 dev 토큰 prod 부팅 자체를 차단).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY

# SamhanLogis API gateway base URL (인증 / 감사로그 / snapshot)
SAMHAN_API_BASE_URL=http://localhost:8080

# dc-config-service (M3, PR #76) — DC config(거래처별 할인). ⚠️ 이름은 PARTNER_SERVICE_URL 이지만
# 레거시상 dc-config-service(:8089)를 가리킨다(거래처 마스터 아님).
# #29: 거래처별 DC 설정 조회 = /internal/partners/by-bizno/{bizNo} (X-Internal-Token,
# SAMHAN_INTERNAL_TOKEN 재사용). 별도 분리 시 DC_CONFIG_SERVICE_URL 로 override 가능.
PARTNER_SERVICE_URL=http://localhost:8089

# G2: 실제 partner-service(거래처 마스터, /internal/partners/list 거래처 directory). 위 dc-config 와 별개.
# 인프라 표준(서비스간 http://partner-service:8095). estimate-app lib/directory.js 가 사용.
SAMHAN_PARTNER_SERVICE_URL=http://localhost:8095

# 견적 저장/불러오기(snapshot) — slip-service QuoteSnapshotController(/api/v1/estimates/snapshots).
# legacy 노션 견적 DB 대체. slip-service 직결(slip-bridge 동일 패턴). 미지정 시 SAMHAN_API_BASE_URL(게이트웨이) fallback.
ESTIMATE_SERVICE_URL=http://localhost:8086

# audit-log endpoint (logFrontEvent 대체)
AUDIT_LOG_URL=http://localhost:8085/api/v1/audit-logs/front

# #31 접속 게이트(checkUserAuth) — user-service internal by-email (X-Internal-Token 재사용)
USER_SERVICE_URL=http://localhost:8083

# ─── #30 카탈로그 (product-service DB 벌크 endpoint 고정) ─────────────────
PRODUCT_SERVICE_URL=http://localhost:8084

# ─── #31 주소검색/지오코딩 (라이브 06-09 searchNaverAddress) ─────────────
# 미설정 키는 해당 검색 소스만 제외됨. 실 키는 운영 .env 에만 (커밋 금지).
NAVER_SEARCH_CLIENT_ID=PLACEHOLDER_DEV_ONLY
NAVER_SEARCH_CLIENT_SECRET=PLACEHOLDER_DEV_ONLY
NAVER_MAP_KEY_ID=PLACEHOLDER_DEV_ONLY
NAVER_MAP_KEY=PLACEHOLDER_DEV_ONLY
JUSO_ROAD_API_KEY=PLACEHOLDER_DEV_ONLY

# (Phase 6 backend 머지 후 USE_MOCK_FALLBACK 환경변수는 폐기됨 — 실 endpoint 호출 강제)
