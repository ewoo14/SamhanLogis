function ensureCustomBlankRow(type) {
  const tbody = document.getElementById(type + 'CustomBody');
  if (!tbody || !tbody.lastElementChild) return;
  const row = tbody.lastElementChild;
  const hasValue = ['.pc-name', '.custom-model', '.list-price-input', '.custom-spec', '.custom-qty', '.custom-price', '.custom-fix-dc']
    .some(selector => String(row.querySelector(selector)?.value || '').trim() !== '')
    || !!row.querySelector('.custom-var-dc')?.checked;
  if (hasValue) window.addCustomRow(type);
}

// 삭제
window.removeCustomRow = function(type) {
  const tbody = document.getElementById(type + 'CustomBody');
  if (!tbody) return;
  if (tbody.lastChild) tbody.removeChild(tbody.lastChild);
  
  updateCustomSubtotal(null, type);
};

// 갱신
window.updateCustomSubtotal = function(inp, type) {
  if (inp) {
    const tr = inp.closest('tr');
    const qty = parseInt(tr.querySelector('.custom-qty').value || '0', 10);
    const price = parseInt(tr.querySelector('.custom-price').value.replace(/[^0-9-]/g, '') || '0', 10);
    const sub = tr.querySelector('.custom-sub');
    if (sub) sub.textContent = (qty * price).toLocaleString('ko-KR');
  }
  
  if (type === 'home' && typeof syncHomeTotals === 'function') syncHomeTotals();
  else if (type === 'single' && typeof syncSingleTotals === 'function') syncSingleTotals();
  else if (type === 'comm' && typeof syncCommTotals === 'function') syncCommTotals();
  else if (type === 'old' && typeof syncOldTotals === 'function') syncOldTotals();

  if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
  ensureCustomBlankRow(type);
};

