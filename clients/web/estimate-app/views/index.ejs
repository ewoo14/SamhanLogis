/* 전송목록 병합 */
function aggregateSendRows(rows){
  const map = new Map();

  rows.forEach((it, idx) => {
    const model = String(it.model || '');
    const price = Number(it.price || 0);
    const key   = model + '||' + price;

    if(map.has(key)){
      const prev = map.get(key);
      prev.qty = Number(prev.qty || 0) + Number(it.qty || 0);
      prev.name = it.name;
      prev._lastIndex = idx;
      
      // 할인 플래그
      prev.has360 = prev.has360 || it.has360;
      prev.has4way = prev.has4way || it.has4way;
      prev.hasStand = prev.hasStand || it.hasStand;
      prev.hasOneWayDc = prev.hasOneWayDc || it.hasOneWayDc;
      prev.hasDeluxeDc = prev.hasDeluxeDc || it.hasDeluxeDc;
      prev.hasFirstGradeDc = prev.hasFirstGradeDc || it.hasFirstGradeDc;
      
      // 고정DC
      const pDc = Number(prev.fixedDc || 0);
      const nDc = Number(it.fixedDc || 0);
      prev.fixedDc = (nDc > pDc) ? nDc : pDc;

      map.set(key, prev);
    }else{
      map.set(key, { ...it, qty: Number(it.qty || 0), price: price, _lastIndex: idx });
    }
  });

  return Array.from(map.values())
    .sort((a,b) => a._lastIndex - b._lastIndex)
    .map(({ _lastIndex, ...rest }) => rest);
}

