// 입력감지
const trackInteraction = (e) => {
    const t = e.target;
    if (!t || !t.classList) return;
    
    // 대상확인
    const isTarget = t.classList.contains('qty-input') || 
                     t.classList.contains('part-qty-single') || 
                     t.classList.contains('part-qty-comm') || 
                     t.classList.contains('price-input') || 
                     t.classList.contains('part-price-single') || 
                     t.classList.contains('part-price-comm') || 
                     t.classList.contains('list-price-input');
                         
    if (isTarget) {
        // 식별자추가
        const m = t.dataset.m || t.dataset.model || t.dataset.id || t.dataset.sid || t.dataset.idx || t.dataset.part;
        if (!m) return; 
        
        const setModel = t.dataset.set;
        let key = (setModel && m) ? `${setModel}|${m}` : m;
        
        window.CURRENT_INTERACTING_KEY = key;
        
        // 잠금해제
        if (t.value === '') {
            window.ABSOLUTE_LOCK.delete(key);
            t.style.color = '';
            t.style.fontWeight = '';
        } else {
            // 잠금설정
            window.ABSOLUTE_LOCK.add(key);
            t.style.setProperty('color', '#2563eb', 'important');
            t.style.setProperty('font-weight', 'bold', 'important');
        }
        
        setTimeout(() => { 
            if (window.CURRENT_INTERACTING_KEY === key) window.CURRENT_INTERACTING_KEY = null; 
        }, 0);
    }
};

document.addEventListener('input', trackInteraction, true);
document.addEventListener('change', trackInteraction, true);

// 데이터방어
function applyAbsoluteLock(mapObj) {
    if (!mapObj || !mapObj.set) return;
    const origSet = mapObj.set.bind(mapObj);
    mapObj.set = function(k, v) {
        if (window.ABSOLUTE_LOCK.has(k) && window.CURRENT_INTERACTING_KEY !== k) return this;
        return origSet(k, v);
    };
    if (mapObj.clear) {
        const origClear = mapObj.clear.bind(mapObj);
        mapObj.clear = function() {
            for (const k of mapObj.keys()) { window.ABSOLUTE_LOCK.delete(k); }
            return origClear();
        };
    }
}

[homeQty, singleQty, commQty, oldQty].forEach(applyAbsoluteLock);
if(typeof singleCustomPartQtys !== 'undefined') applyAbsoluteLock(singleCustomPartQtys);
if(typeof commCustomPartQtys !== 'undefined') applyAbsoluteLock(commCustomPartQtys);

