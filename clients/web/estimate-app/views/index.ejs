function fixFootersForMobile(isMobile){
  // 홈멀티 푸터
  const trH = document.querySelector('#wrapHome tfoot tr');
  if(trH){
    const cells = trH.children;
    if(isMobile){
      // 모바일 열
      cells[0].colSpan = 5;
      cells[2].style.display = 'none';
      const totalText = document.getElementById('homeTotal')?.textContent || '0';
      cells[1].innerHTML = `<strong>합계 <span id="homeTotalInline">${totalText}</span></strong>`;
    }else{
      // PC 복구
      cells[0].colSpan = 6;
      cells[2].style.display = '';
      cells[1].innerHTML = `<strong>합계</strong>`;
    }
  }

  // 싱글중대형 푸터
  const trS = document.querySelector('#wrapSingle tfoot tr');
  if(trS){
    const cells = trS.children;
    if(isMobile){
      // 모바일 열
      cells[0].colSpan = 4;
      cells[2].style.display = 'none';
      const totalText = document.getElementById('singleTotal')?.textContent || '0';
      cells[1].innerHTML = `<strong>합계 <span id="singleTotalInline">${totalText}</span></strong>`;
    }else{
      // PC 복구
      cells[0].colSpan = 6;
      cells[2].style.display = '';
      cells[1].innerHTML = `<strong>합계</strong>`;
    }
  }

  // 상업멀티 푸터
  const trC = document.querySelector('#wrapComm tfoot tr');
  if (trC){
    const cells = trC.children;
    if (isMobile){
      cells[0].colSpan = 6;
      cells[1].style.display = 'none';
      const totalText = document.getElementById('commTotal')?.textContent || '0';
      cells[2].innerHTML = `<strong id="commTotal">${totalText}</strong>`;
    } else {
      cells[0].colSpan = 6;
      cells[1].style.display = '';
      const totalText = document.getElementById('commTotal')?.textContent || '0';
      cells[2].innerHTML = `<strong id="commTotal">${totalText}</strong>`;
    }
  }

  // 전표생성 버튼
  document.getElementById('btnGenSlip')?.addEventListener('click', function() {
    
    // 유효성 검사
    if (typeof checkCardValid === 'function') {
      if (!checkCardValid()) return;
    }

    // 전송할 품목 데이터 구성
    var items = buildSendRows();
    if (items.length === 0) {
      alert('전송할 품목이 없습니다.');
      return;
    }

    // 거래처 및 배송지 정보 수집
    var custInput = document.getElementById('custSearch');
    var custCode = custInput ? (custInput.dataset.code || '') : ''; 
    var custName = custInput ? custInput.value.trim() : '';
    var managerInput = document.getElementById('managerSearch');
    var managerName = managerInput ? managerInput.value.trim() : '';
    var managerCode = managerInput ? (managerInput.dataset.code || '') : '';

    if (!custCode && !custName) {
      alert('거래처를 선택해주세요.');
      return;
    }

    // 주소 조합
    var addrBase = document.getElementById('addrBase').value.trim();
    var addrDetail = document.getElementById('addrDetail').value.trim();
    var fullAddr = addrBase + (addrDetail ? ' ' + addrDetail : '');

    // 감리 주소 조합
    var auditBase = document.getElementById('addrAuditBase').value.trim();
    var auditDetail = document.getElementById('addrAuditDetail').value.trim();
    var fullAuditAddr = auditBase + (auditDetail ? ' ' + auditDetail : '');

    // 출고창고 값 가져오기
    var whSelect = document.getElementById('whCode');
    var whCode = whSelect ? whSelect.value : '00003';

    // 서버 전송 객체 생성
    var orderData = {
      bizno: window.CURRENT_BIZNO || '',
      custCode: custCode,
      custName: custName,
      due: document.getElementById('due').value,
      payDue: document.getElementById('chkCardPay')?.checked ? '카드결제'
        : (document.getElementById('payDuePre')?.checked ? '선결제' : document.getElementById('payDue').value),
      whCode: whCode,
      addr: fullAddr,
      addrAudit: fullAuditAddr,
      manager: managerName,
      managerCode: managerCode,
      receiver: document.getElementById('tel').value,
      memo: document.getElementById('memo').value,
      isMobile: typeof isMobileNow === 'function' ? isMobileNow() : false,
      items: items,
      estimateConfig: CONFIG
    };

    // 진행 상태 표시
    var dlg = document.getElementById('dlgProgress');
    var icon = document.getElementById('progressIcon');
    var txt = document.getElementById('progressText');
    var btns = document.getElementById('progressBtns');
    
    if(dlg) {
      if(dlg.showModal) dlg.showModal();
      else dlg.style.display = 'block';
      
      if(icon) icon.textContent = '⏳';
      if(txt) txt.textContent = '이카운트로 전표를 생성 중입니다...';
      if(btns) btns.style.display = 'none';
    }

    // 서버 함수 호출
    google.script.run
      .withSuccessHandler(function(res) {
        if (!isSlipPublishSuccess(res)) {
          if(icon) icon.textContent = '⚠️';
          var errorMsg = (res && typeof res === 'object' && res.error) ? res.error : '전표 생성 실패';
          if(txt) txt.textContent = '전표 생성 실패:\n' + errorMsg;
          if(btns) btns.style.display = 'block';
          return;
        }
        if(icon) icon.textContent = '✅';
        var msg = (typeof res === 'object' && res.slipNo) ? res.slipNo : res;
        if(txt) txt.textContent = '전표 생성 완료!\n(' + msg + ')';
        
        setTimeout(function() {
          if(dlg) {
            if(dlg.close) dlg.close();
            else dlg.style.display = 'none';
          }
        }, 2000);
      })
      .withFailureHandler(function(err) {
        if(icon) icon.textContent = '⚠️';
        if(txt) txt.textContent = '전표 생성 실패:\n' + err;
        if(btns) btns.style.display = 'block'; 
      })
      .sendOrderFromUi(orderData);
  });
}

// 창 높이에 맞게 표 자동 조정
function fitTableWrap(wrapSelector){
  const wrap = document.querySelector(wrapSelector);
  if(!wrap) return;

  // 모바일 여부
  const isMobile = window.matchMedia('(max-width: 1280px)').matches;

  // 모바일 visualViewport
  const vh = (window.visualViewport && window.visualViewport.height)
    ? window.visualViewport.height
    : window.innerHeight;

  const rectTop = wrap.getBoundingClientRect().top;

  // 마지막 행 여유
  const bottomPadding = isMobile ? 14 : 12;

  // 사용 가능한 높이
  const avail = Math.max(200, vh - rectTop - bottomPadding);

  if(isMobile){
    // 모바일은 height를 직접 고정
    wrap.style.height = avail + 'px';
    wrap.style.maxHeight = '';
  }else{
    // PC는 max-height만 덮어쓰기
    wrap.style.height = '';
    wrap.style.maxHeight = avail + 'px';
  }
}

