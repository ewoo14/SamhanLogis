// 운임/절삭 입력 핸들러
function handleFreightInput(e, isCut, priceMap, qtyMap, model, recomputeFunc) {
  let raw = e.target.value.replace(/[^0-9]/g, '');
  let val = parseInt(raw || '0', 10);

  // 절삭 음수 처리
  if (isCut && val !== 0) val = -Math.abs(val);

  // 데이터 저장
  if (val === 0) {
    priceMap.set(model, 0);
    if(qtyMap.unlock) qtyMap.unlock(model);
    qtyMap.set(model, 0);
  } else {
    priceMap.set(model, val);
    if(qtyMap.set && qtyMap.unlock) qtyMap.set(model, 1, true);
    else qtyMap.set(model, 1);
  }

  try {
    if (typeof HOME_MANUAL_BRANCH !== 'undefined') HOME_MANUAL_BRANCH.add(model);
    if (typeof COMM_MANUAL_BASE !== 'undefined') COMM_MANUAL_BASE.add(model);
  } catch (err) {  }

  // UI 갱신
  if (val !== 0) {
    e.target.value = fmt(Math.abs(val)); 
    e.target.style.color = '#2563eb';
    e.target.style.fontWeight = 'bold';
  } else {
    e.target.value = '';
    e.target.style.color = '#374151';
    e.target.style.fontWeight = 'normal';
  }

  const tr = e.target.closest('tr');

  // 숨겨진 수량값 갱신
  const hiddenQty = tr.querySelector('input.qty-input[type="hidden"]');
  if(hiddenQty) hiddenQty.value = (val !== 0) ? '1' : '0';

  // 수량 텍스트 갱신
  const qtyStatic = tr.querySelector('.qty-static');
  if(qtyStatic) qtyStatic.textContent = (val !== 0) ? '1' : '0';

  // 재계산 수행
  if (typeof recomputeFunc === 'function') {
      try { recomputeFunc(true); } catch(err){}
  }

  const subCell = tr.querySelector('.sub, .sub-cell, [data-sub], [data-ss], [data-csub]');
  if (subCell) {
    subCell.textContent = fmt(val);
  }
  
  if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
}

// 숫자 입력 옵션 생성
function numInp(label, id, def, step, cls) {
  const w = document.createElement('div');
  w.className = 'chip ' + (cls || '');
  w.style.padding = '0 8px';
  
  const span = document.createElement('span');
  span.textContent = label + ' ';
  w.appendChild(span);

  const inp = document.createElement('input');
  inp.type = 'number';
  inp.id = id;
  inp.value = def;
  inp.step = step || 1;
  inp.style.width = '80px';
  inp.style.textAlign = 'right';
  inp.style.border = 'none';
  inp.style.background = 'transparent';
  inp.style.fontWeight = 'bold';
  
  /* 할인율강조 */
  const discountIds = ['home_rate', 'ss_disc_360', 'ss_disc_4way', 'ss_disc_stand', 'ss_disc_1way', 'ss_disc_deluxe', 'ss_disc_grade1', 'comm_rate', 'old_rate'];
  if (discountIds.includes(id)) {
    w.style.backgroundColor = '#fff7ed';
    w.style.borderColor = '#fed7aa';
    w.style.boxShadow = '0 2px 4px rgba(253,186,116,0.2)';
    inp.style.fontSize = '16px';
    inp.style.color = '#ea580c';
  }
  
  // 포커스 시 전체 선택
  inp.addEventListener('focus', function(){ this.select(); });

  // 입력 처리
  if (step === 1000) {
    inp.addEventListener('change', () => { // 변경
      let v = parseInt(inp.value || 0, 10);
      if (v > 0 && v < 1000) v = v * 1000;
      if (v % 1000 !== 0) v = Math.round(v / 1000) * 1000;
      inp.value = v;
    });
  }
  
  w.appendChild(inp);
  return w;
}
// 단위 처리(절삭/반올림) 옵션 생성
