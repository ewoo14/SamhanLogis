// 복사
async function handleInvoiceCopy() {
  document.getElementById('invSaveMenu')?.classList.add('hidden');
  
  // 래퍼 생성
  const wrapper = document.createElement('div');
  wrapper.style.cssText = `position:fixed; top:0; left:0; width:1123px; min-height:794px; background:white; z-index:-9999;`;
  
  const sourceHtml = document.querySelector('#invoiceScaleBox > div').innerHTML;
  wrapper.innerHTML = sourceHtml;
  document.body.appendChild(wrapper);

  try {
    const canvas = await html2canvas(wrapper, { scale: 2, backgroundColor: '#ffffff' });
    canvas.toBlob(async (blob) => {
      try {
        await navigator.clipboard.write([new ClipboardItem({ "image/png": blob })]);
        alert('클립보드에 복사되었습니다.');
        logAction('기능', '명세서 복사');
      } catch(e) { alert('복사 실패'); }
      document.body.removeChild(wrapper);
    });
  } catch(e) {
    document.body.removeChild(wrapper);
    alert('오류 발생');
  }
}

// 저장 (PDF, JPG, PNG)
async function handleInvoiceSave(type) {
  document.getElementById('invSaveMenu')?.classList.add('hidden');

  const wrapper = document.createElement('div');
  wrapper.style.cssText = `position:fixed; top:0; left:0; width:1123px; min-height:794px; background:white; z-index:-9999;`;
  
  // 현재 화면 내용 복제
  const sourceHtml = document.querySelector('#invoiceScaleBox > div').innerHTML;
  wrapper.innerHTML = sourceHtml;
  document.body.appendChild(wrapper);

  try {
    const canvas = await html2canvas(wrapper, { scale: 2, backgroundColor: '#ffffff' });

    if (type === 'pdf') {
       const imgData = canvas.toDataURL('image/png');
       const { jsPDF } = window.jspdf;
       // 가로(landscape) 설정
       const doc = new jsPDF('l', 'mm', 'a4');
       const pw = doc.internal.pageSize.getWidth();
       const ph = doc.internal.pageSize.getHeight();
       
       const r = Math.min(pw/canvas.width, ph/canvas.height);
       const w = canvas.width * r;
       const h = canvas.height * r;
       const x = (pw - w) / 2;
       const y = (ph - h) / 2;

       doc.addImage(imgData, 'PNG', x, y, w, h);
       doc.save(`명세서_${currentSlipData.date}.pdf`);

    } else {
       // JPG, PNG
       const link = document.createElement('a');
       link.download = `명세서_${currentSlipData.date}.${type}`;
       link.href = canvas.toDataURL(`image/${type}`);
       link.click();
    }
    logAction('기능', '명세서 ' + type.toUpperCase() + ' 저장');
  } catch(e) {
    alert('저장 중 오류가 발생했습니다.');
  } finally {
    document.body.removeChild(wrapper);
  }
}

