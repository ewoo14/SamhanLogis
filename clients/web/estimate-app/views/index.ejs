/* 전송 */
function buildSendRows(){
  const rows = [];
  const cardChk = document.getElementById('chkCardPay');
  const isCard = cardChk && cardChk.checked;

  const fmt = n => {
    if (n === undefined || n === null || n === '') return '0';
    const num = parseFloat(String(n).replace(/,/g, ''));
    return isNaN(num) ? '0' : num.toLocaleString();
  };

  /* 주소 */
  const getVal = id => { const el = document.getElementById(id); return el ? el.value : ''; };
  const fullAddr = (getVal('addrBase') + ' ' + getVal('addrDetail')).trim();
  const isKyungdong = fullAddr.includes('경동') && fullAddr.includes('/');

  /* 맵핑 */
  const pMap = new Map();
  const addP = (arr, isOld = false) => {
    if(typeof arr !== 'undefined' && Array.isArray(arr)) {
      arr.forEach(p => {
        if(p.model) {
          let v = 0;
          if (isOld) {
            v = p.price || 0; 
          } else {
            v = p.list || p.listPrice || p.cprice || p.price || 0;
          }
          pMap.set(p.model, v);
        }
      });
    }
  };
  
  addP(typeof COMM_PARTS !== 'undefined' ? COMM_PARTS : []);
  addP(typeof COMMULTI !== 'undefined' ? COMMULTI : []);
  addP(typeof SINGLE_PARTS !== 'undefined' ? SINGLE_PARTS : []);
  addP(typeof HOMEMULTI !== 'undefined' ? HOMEMULTI : []);
  addP(typeof OLD_PRODUCTS !== 'undefined' ? OLD_PRODUCTS : [], true);

  /* 고정할인 */
  const getActiveFixedDc = (sec, key, staticVal) => {
    let sel = '';
    if(sec === 'HOME') sel = '#homeBody';
    else if(sec === 'COMM') sel = '#commBody';
    else if(sec === 'SINGLE') sel = '#singleBody';

    if(sel){
      const tr = document.querySelector(`${sel} tr[data-m="${CSS.escape(key)}"], ${sel} tr[data-id="${CSS.escape(key)}"]`);
      if(tr){
        const inp = tr.querySelector('.fix-dc-inp');
        if(inp && inp.value) {
          const v = parseFloat(String(inp.value).replace(/[^0-9.]/g,''));
          return isNaN(v) ? 0 : (v > 1 ? v/100 : v);
        }
      }
    }
    return typeof staticVal === 'number' ? staticVal : 0;
  };

  /* 규격 */
  const getLiveSpec = (sec, key, def, isRem) => {
    let sel = '';
    if(sec === 'HOME') sel = '#homeBody';
    else if(sec === 'COMM') sel = '#commBody';
    else if(sec === 'SINGLE') sel = '#singleBody';
    else if(sec === 'OLD') sel = '#oldBody';

    if(sel){
      const tr = document.querySelector(`${sel} tr[data-m="${CSS.escape(key)}"], ${sel} tr[data-id="${CSS.escape(key)}"]`);
      if(tr){
        const s = isRem ? '.rem-inp, .remarks-inp' : '.spec-inp, input[name="spec"], .spec-input';
        const inp = tr.querySelector(s);
        if(inp) return inp.value.trim();
      }
    }
    return def || '';
  };

  const commPartSpecMap = new Map();
  if (typeof COMM_PARTS !== 'undefined') {
    COMM_PARTS.forEach(p => {
      const specVal = p.spec || p.규격 || p.비고; 
      if (p.model && specVal) commPartSpecMap.set(p.model, specVal);
    });
  }

  /* 상업 */
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0;
    if (!q) return;

    const isSet = String(r.unit || '').toUpperCase() === 'SET';
    const fDc = getActiveFixedDc('COMM', r.model, r.fixedDc);
    
    let userSpec = getLiveSpec('COMM', r.model, r.spec);
    if (!userSpec && commPartSpecMap.has(r.model)) userSpec = commPartSpecMap.get(r.model);

    if (isSet) {
      const domParts = Array.from(document.querySelectorAll(`.set-part[data-part-of="${CSS.escape(r.model)}"]`));
      if (domParts.length > 0) {
          domParts.forEach(ptr => {
              const pm = ptr.getAttribute('data-m');
              const pname = ptr.querySelector('.colD').textContent.replace('└ [구성]', '').trim();
              const pq = parseInt(ptr.querySelector('.part-qty-comm')?.value || '0', 10);
              if (pq !== 0) {
                  const pSpecInp = ptr.querySelector('.spec-input');
                  let setPartSpec = pSpecInp ? pSpecInp.value : '';
                  if (!setPartSpec && commPartSpecMap.has(pm)) setPartSpec = commPartSpecMap.get(pm);

                  const pBase = getBaseListPrice('comm', pm, pMap.get(pm) || 0);
                  let pList = getRealListPrice('COMM', pm, pBase);

                  if (isKyungdong) setPartSpec = (setPartSpec && setPartSpec !== '\u200B' ? setPartSpec + ' / ' : '') + fmt(pList);
                  
                  const pPriceInp = ptr.querySelector('.price-input, .part-price-comm');
                  const pPrice = pPriceInp ? parseInt(pPriceInp.value.replace(/[^0-9-]/g,'')||'0', 10) : parseInt(ptr.querySelector('.price')?.textContent.replace(/[^0-9-]/g,'')||'0', 10);

                  rows.push({ section: 'COMM', name: pname, model: pm, qty: pq, price: pPrice, list: fmt(pList), fixedDc: fDc, spec: setPartSpec || '\u200B' });
              }
          });
      } else {
          const parts = typeof explodeCommSets_ === 'function' ? explodeCommSets_(r, q) : [];
          parts.forEach(it => {
            let setPartSpec = it.spec;
            if (!setPartSpec && commPartSpecMap.has(it.model)) setPartSpec = commPartSpecMap.get(it.model);
            
            const pBase = getBaseListPrice('comm', it.model, pMap.get(it.model) || it.list || 0);
            let pList = getRealListPrice('COMM', it.model, pBase);

            if (isKyungdong) setPartSpec = (setPartSpec && setPartSpec !== '\u200B' ? setPartSpec + ' / ' : '') + fmt(pList);
            rows.push({ section: 'COMM', name: it.name, model: it.model, qty: it.qty, price: it.price, list: fmt(pList), fixedDc: fDc, spec: setPartSpec || '\u200B' });
          });
      }
    } else {
      const cBase = getBaseListPrice('comm', r.model, pMap.get(r.model) || r.listPrice || 0);
      let cList = getRealListPrice('COMM', r.model, cBase);

      if (isKyungdong) userSpec = (userSpec && userSpec !== '\u200B' ? userSpec + ' / ' : '') + fmt(cList);
      rows.push({ section: 'COMM', name: r?.name || '', model: r.model, qty: q, list: fmt(cList), price: getRealCommPrice(r.model), fixedDc: fDc, spec: userSpec || (COMM_PARTS.find(p => p.model === r.model)?.spec) || '\u200B', source: r.source });
    }
  });

  /* 홈 */
  HOMEMULTI.forEach(r=>{
    const q = homeQty.get(r.model) || 0;
    if(!q) return;
    const fDc = getActiveFixedDc('HOME', r.model, r.fixedDc);
    let userSpec = getLiveSpec('HOME', r.model, r.spec);
    
    const hBase = getBaseListPrice('home', r.model, pMap.get(r.model) || r.list || 0);
    let hList = getRealListPrice('HOME', r.model, hBase);
    
    if (isKyungdong) userSpec = (userSpec && userSpec !== '\u200B' ? userSpec + ' / ' : '') + fmt(hList);

    rows.push({ 
        section:'HOME', name:r?.name||'', model:r.model, qty:q, source: r.source,
        list: fmt(hList),
        price: getRealHomePrice(r.model), fixedDc: fDc, spec: userSpec || '\u200B'
    });
  });

  /* 싱글 */
  SINGLE_SETS.forEach(s=>{
    const q = singleQty.get(s.id) || 0;
    if(!q) return;
    const fDc = getActiveFixedDc('SINGLE', s.id, s.fixedDc);
    const userSpec = getLiveSpec('SINGLE', s.id, s.spec);

    if(s.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL) {
       rows.push({
         section: 'SINGLE', setId: s.id, setName: s.name, isSetHead: false, 
         name: s.name, model: s.model, unit: '식', qty: q, price: getRealSinglePrice(s.id), source: SPECIAL_ROW_SOURCE.CATALOG_SPECIAL,
         hasSetDc: false, fixedDc: 0, spec: '\u200B'
       });
       return;
    }

    const flags = analyzeSingleSetDiscountFlags(s);
        const domParts = Array.from(document.querySelectorAll(`.set-part-single[data-part-of="${CSS.escape(s.id)}"]`));
        let parsedParts = [];
    
    if (domParts.length > 0) {
        domParts.forEach(ptr => {
            const pm = ptr.getAttribute('data-m');
            const pname = ptr.querySelector('.colD').textContent.replace('└ [구성]', '').trim();
            const pq = parseInt(ptr.querySelector('.part-qty-single')?.value || '0', 10);
            if (pq !== 0) {
                const pSpecInp = ptr.querySelector('.spec-input');
                let mySpec = pSpecInp ? pSpecInp.value : '';
                
                const pPriceInp = ptr.querySelector('.price-input');
                const pPrice = pPriceInp ? parseInt(pPriceInp.value.replace(/[^0-9-]/g,'')||'0', 10) : parseInt(ptr.querySelector('.price')?.textContent.replace(/[^0-9-]/g,'')||'0', 10);
                
                parsedParts.push({ model: pm, name: pname, qty: pq, price: pPrice, spec: mySpec, unit: 'EA' });
            }
        });
    } else {
        parsedParts = typeof explodeSendSets_ === 'function' ? explodeSendSets_(s, q) : [];
    }

    const liveLabel = getSingleSetOptionLabelLive(s);

    parsedParts.forEach((it, idx)=>{
      let finalSpec = idx === 0 ? (userSpec || it.spec || s.spec) : (it.spec || s.spec);
      
      const sBase = getBaseListPrice('single', it.model, pMap.get(it.model) || it.list || 0);
      let sList = getRealListPrice('SINGLE', it.model, sBase);

      if (isKyungdong) finalSpec = (finalSpec && finalSpec !== '\u200B' ? finalSpec + ' / ' : '') + fmt(sList);

      rows.push({
        section: 'SINGLE', setId: s.id, setName: (s.name || s.nameRaw || '') + (idx === 0 ? liveLabel : ''), isSetHead: idx === 0,
        name: it.name, model: it.model, unit: it.unit || 'EA', qty: it.qty, price: it.price, 
        list: fmt(sList),
        has360: flags.has360, has4way: flags.has4way, hasStand: flags.hasStand,
        hasOneWayDc: flags.hasOneWay, hasDeluxeDc: flags.hasDeluxe, hasFirstGradeDc: flags.hasGrade1,
        fixedDc: fDc, spec: finalSpec || '\u200B'
      });
    });
  });

  /* 구형 */
  OLD_PRODUCTS.forEach(item => {
    if(item.name === '품 명' || item.name === '품명') return;
    const q = oldQty.get(item.model) || 0;
    if(!q) return;

    let rem = getLiveSpec('OLD', item.model, item.remarks, true);
    rem = rem ? rem.trim() : (item._tempRemarks || '').trim();
  if(item.isDisc === true) {
    const dcText = '(' + getOldDiscountPercent() + '% DC)';
    rem = rem ? rem + ' ' + dcText : dcText;
  }

    const oBase = getBaseListPrice('old', item.model, pMap.get(item.model) || item.price || 0);
    let oList = getRealListPrice('OLD', item.model, oBase);
    
    let userSpec = getLiveSpec('OLD', item.model, item.spec);
    if (!userSpec) userSpec = '\u200B';

    if (isKyungdong) userSpec = (userSpec !== '\u200B' && userSpec ? userSpec + ' / ' : '') + fmt(oList);

    rows.push({ 
        section: 'OLD', name: item.name, model: item.model, unit: item.unit || 'EA', qty: q, source: item.source,
        list: fmt(oList),
        price: getRealOldPrice(item.model), remarks: rem, spec: userSpec 
    });
  });

  /* 카드수수료 */
  applyCardFeeLogic(rows);

  /* 선금할인 */
  applyEstimateTotalAdjustments(rows, {
    advance: !!document.getElementById('payDuePre')?.checked
  });

  /* 절삭 */
  applyCutoffLogic(rows);

  /* 날짜 */
  const d = new Date();
  const mmdd = String(d.getMonth() + 1).padStart(2, '0') + String(d.getDate()).padStart(2, '0');
  const finalDate = isCard ? '카드결제' : mmdd;

  /* 주입 */
  rows.forEach(r => {
    r.payDate = finalDate; 
  });

  const customTypeMap = { home: 'HOME', single: 'SINGLE', comm: 'COMM', old: 'OLD' };
  ['home', 'single', 'comm', 'old'].forEach(type => {
    const tbody = document.getElementById(type + 'CustomBody');
    if (tbody) {
      tbody.querySelectorAll('.custom-item-row').forEach(tr => {
        const qty = parseInt(tr.querySelector('.custom-qty').value || '0', 10);
        if (qty !== 0) {
          const name = tr.querySelector('.pc-name')?.value.trim() || '사용자 정의 품목';
          const model = tr.querySelector('.custom-model')?.value.trim() || '';
          const price = parseInt(tr.querySelector('.custom-price')?.value.replace(/[^0-9-]/g, '') || '0', 10);
          const hasList = !!tr.querySelector('.custom-list');
          const list = hasList ? parseInt(tr.querySelector('.custom-list').value.replace(/[^0-9-]/g, '') || '0', 10) : 0;
          const customSpec = tr.querySelector('.custom-spec')?.value.trim() || '\u200B';
          
          rows.push({
            section: customTypeMap[type],
            name: name,
            model: model,
            unit: 'EA', 
            qty: qty,
            price: price,
            list: hasList ? list : 0,
            fixedDc: 0,
            spec: customSpec, 
            isCustom: true
          });
        }
      });
    }
  });

  return rows;
}

// 추출
function extractSpecs(item) {
  const s = item.spec || {};
  const res = [];
  const add = (label, val) => {
    if (val && String(val).trim() && String(val).trim() !== '-') res.push({ label, value: String(val).trim() });
  };

  const w = s.weight || s.outWeight || s.inWeight || '';
  const pS = s.packSize || s.outPackSize || s.inPackSize || '';
  const pW = s.packWeight || s.outPackWeight || s.inPackWeight || '';
  const sz = s.size || s.outSize || s.inSize || '';

  if (item.catL === '판넬') {
    if (item.type === 'home') {
      add('타공사이즈(mm)', s.cool_kw);
      add('전산볼트간격(mm)', s.cool_power);
    } else {
      add('타공사이즈(mm)', s.cool_cap_kcal);
      add('전산볼트간격(mm)', s.cool_pow_kw);
    }
    add('제품크기(WxHxD)', sz);
    add('제품중량(kg)', w ? w + 'kg' : '');
    add('포장치수(WxHxD)', pS);
    add('포장중량(kg)', pW ? pW + 'kg' : '');
    return res;
  }

  if (item.catL === '전열교환기') {
    const clean_ = v => (v && v !== '-' ? String(v).trim() : '');
    const join_ = (...vals) => vals.map(clean_).filter(Boolean).join(' / ');
    
    const coolVal = clean_(s.cool_power) || join_(s.cool_cap_kcal, s.cool_cap_kw, s.cool_pow_kw) || clean_(s.cool_kcal);
    const heatVal = clean_(s.heat_power) || join_(s.heat_cap_kcal, s.heat_cap_kw, s.heat_pow_kw) || clean_(s.heat_kcal);
    
    if (String(item.name || '').includes('에어콤보') || String(item.model || '').includes('에어콤보')) {
      add('냉매가스', s.gas);
      add('소비전력(전열환기)', coolVal);
      add('제품크기(WxHxD)', sz);
    } else {
      add('덕트구경', s.gas);
      add('소비전력(전열환기)', coolVal);
      add('소비전력(일반환기)', heatVal);
      add('제품크기(WxHxD)', sz);
      add('제품중량(kg)', w ? w + 'kg' : '');
    }
    return res;
  }

  // 세트
  if (item.catL === '세트' && item.raw && typeof explodeSetParts === 'function') {
    const parts = explodeSetParts(item.raw, 1, null) || [];
    const groups = { indoor: [], outdoor: [], panel: [], remote: [], material: [], wall: [] };

    // 분류
    parts.forEach(p => {
      const kind = String(p?.kind || '');
      const name = String(p?.name || '');
      const label = String(p?.model || p?.name || '').trim();
      if (!label) return;

      // 구분
      if (kind.includes('실내기')) groups.indoor.push(label);
      else if (kind.includes('실외기')) groups.outdoor.push(label);
      else if (/리모컨|리모콘/.test(kind)) groups.remote.push(label);
      else if (/판넬|패널/.test(kind)) groups.panel.push(label);
      else if (kind.includes('자재')) groups.material.push(label);
      else if (kind.includes('벽걸이')) groups.wall.push(label);
      // 품명
      else {
        if (/실내기/.test(name)) groups.indoor.push(label);
        else if (/실외기/.test(name)) groups.outdoor.push(label);
        else if (/리모컨|리모콘/.test(name)) groups.remote.push(label);
        else if (/판넬|패널|panel/i.test(name)) groups.panel.push(label);
        else if (/벽걸이/.test(name)) groups.wall.push(label);
        else if (/자재|호스|배관|배선|케이블|동파이프|브라켓|받침대|발통/.test(name)) groups.material.push(label);
      }
    });

    const compLines = [];
    if (groups.indoor.length)  compLines.push('[실내기] ' + groups.indoor.join(', '));
    if (groups.outdoor.length) compLines.push('[실외기] ' + groups.outdoor.join(', '));
    if (groups.wall.length)    compLines.push('[벽걸이] ' + groups.wall.join(', '));
    if (groups.panel.length)   compLines.push('[판넬] ' + groups.panel.join(', '));
    if (groups.remote.length)  compLines.push('[리모컨] ' + groups.remote.join(', '));
    if (groups.material.length)compLines.push('[자재] ' + groups.material.join(', '));

    if (compLines.length > 0) {
      add('구성', compLines.join(' / '));
    }
  }

  add('배관경', s.pipeDia);
  if (s.cool_kcal) add('냉방성능(kcal/h)', s.cool_kcal);
  else if (s.cool_cap_kcal) add('냉방성능(kcal/h)', s.cool_cap_kcal);
  
  if (s.cool_kw) add('냉방성능(kW)', s.cool_kw);
  else if (s.cool_cap_kw) add('냉방성능(kW)', s.cool_cap_kw);
  
  let coolPowLabel = item.catL === '세트' ? '냉방소비전력(최소/정격/최대)' : '냉방소비전력';
  if (s.cool_power) add(coolPowLabel, s.cool_power);
  else if (s.cool_pow_kw) add(coolPowLabel, s.cool_pow_kw);

  if (s.heat_kcal) add('난방성능(kcal/h)', s.heat_kcal);
  else if (s.heat_cap_kcal) add('난방성능(kcal/h)', s.heat_cap_kcal);

  if (s.heat_kw) add('난방성능(kW)', s.heat_kw);
  else if (s.heat_cap_kw) add('난방성능(kW)', s.heat_cap_kw);
  
  let heatPowLabel = item.catL === '세트' ? '난방소비전력(최소/정격/최대)' : '난방소비전력';
  if (s.heat_power) add(heatPowLabel, s.heat_power);
  else if (s.heat_pow_kw) add(heatPowLabel, s.heat_pow_kw);

  add('냉매가스', s.gas);
  add('효율등급', s.grade || s.effGrade);
  add('전원선', s.powerLine);
  add('차단기(A)', s.breaker);

  if (s.inSize || s.outSize) {
    const sizeArr = [];
    if (s.inSize) sizeArr.push('[실내기] ' + s.inSize);
    if (s.outSize) sizeArr.push('[실외기] ' + s.outSize);
    add('제품크기(WxHxD)', sizeArr.join(' / '));
    
    const weightArr = [];
    if (s.inWeight) weightArr.push('[실내기] ' + s.inWeight + 'kg');
    if (s.outWeight) weightArr.push('[실외기] ' + s.outWeight + 'kg');
    add('제품중량(kg)', weightArr.join(' / '));

    const pSizeArr = [];
    if (s.inPackSize) pSizeArr.push('[실내기] ' + s.inPackSize);
    if (s.outPackSize) pSizeArr.push('[실외기] ' + s.outPackSize);
    add('포장치수(WxHxD)', pSizeArr.join(' / '));

    const pWeightArr = [];
    if (s.inPackWeight) pWeightArr.push('[실내기] ' + s.inPackWeight + 'kg');
    if (s.outPackWeight) pWeightArr.push('[실외기] ' + s.outPackWeight + 'kg');
    add('포장중량(kg)', pWeightArr.join(' / '));
  } else {
    add('제품크기(WxHxD)', sz);
    add('제품중량(kg)', w ? w + 'kg' : '');
    add('포장치수(WxHxD)', pS);
    add('포장중량(kg)', pW ? pW + 'kg' : '');
  }
  
  add('배관길이(m)', s.maxPipe || s.pipeLen);
  add('고낙차(m)', s.maxDrop || s.drop);
  
  const maxInd = item.raw?.maxIndoor || s.maxIndoor;
  if (item.catL === '실외기' && maxInd) {
      add('연결허용대수', maxInd + '대');
  }

  return res;
}

// 스펙조회
function openSelectedSpec() {
  const items = [];
  const addIfTarget = (model, name, catL, type, catM, raw, sourcePriority, pageIndex) => {
    const n = String(name || '');
    const cL = String(catL || '');
    const cM = String(catM || '');
    
    if (['일자발', '발통', '펌프', '보드', '자재', '분기관', '받침', '중계기', '유연호스', '리모컨'].some(k => n.includes(k) || cL.includes(k) || cM.includes(k))) {
      return;
    }

    const isErv = cL === '전열교환기' || cM === '전열교환기' || n.includes('전열교환기');
    let targetGroup = '';
    
    if (['실외기', '실내기', '세트', '판넬'].includes(cL)) targetGroup = cL;
    // 판넬분류
    if (cL === '판넬' || cM === '판넬' || n.includes('판넬')) targetGroup = '판넬';
    if (isErv) targetGroup = '전열교환기';
    
    if (targetGroup) {
      items.push({ 
        model, 
        name, 
        catL: targetGroup, 
        type, 
        spec: (SPEC_DETAIL_MAP[model] && SPEC_DETAIL_MAP[model][type]) || {},
        raw: raw,
        sourcePriority: sourcePriority,
        pageIndex: pageIndex
      });
    }
  };

  COMMULTI.forEach((r, idx) => {
    if (commQty.has(r.model) && commQty.get(r.model) > 0) {
      const norm = normalizeCommCategory(r);
      addIfTarget(r.model, r.name, norm.L, 'comm', norm.M, r, 1, idx);
    }
  });

  let homeIdx = 0;
  homeQty.forEach((q, m) => {
    if (q > 0) {
      const r = homeRowByModel.get(m);
      if (r) {
        const norm = normalizeHomeCategory(r);
        addIfTarget(m, r.name, norm.catL, 'home', norm.catM, r, 2, homeIdx++);
      }
    }
  });

  SINGLE_SETS.forEach((s, idx) => {
    if (singleQty.has(s.id) && singleQty.get(s.id) > 0) {
      addIfTarget(s.model || s.name, s.name, '세트', 'single', '', s, 3, idx);
    }
  });

  items.sort((a, b) => {
    if (a.sourcePriority !== b.sourcePriority) {
      return a.sourcePriority - b.sourcePriority;
    }
    return a.pageIndex - b.pageIndex;
  });

  const body = document.getElementById('selectedSpecBody');
  if (items.length === 0) {
    body.innerHTML = '<div style="text-align:center; padding:40px; color:#666;">선택된 장비가 없습니다.</div>';
    document.getElementById('pageSelectedSpec').classList.remove('hidden');
    return;
  }

  const groups = { '실외기': [], '실내기': [], '세트': [], '판넬': [], '전열교환기': [] };
  items.forEach(it => {
    if (groups[it.catL] && !groups[it.catL].find(x => x.model === it.model)) groups[it.catL].push(it);
  });

  let html = '';
  ['실외기', '실내기', '세트', '판넬', '전열교환기'].forEach(catL => {
    if (!groups[catL] || groups[catL].length === 0) return;
      html += '<h3 style="margin-top:20px; margin-bottom:10px; border-left:4px solid #2563eb; padding-left:8px;">' + escapeEstimateHtml(catL) + '</h3>';

    html += '<table style="width:100%; border-collapse:collapse; border:1px solid #ddd; margin-bottom:15px; font-size:13px;">';
    html += '<thead style="background:#f3f4f6;"><tr><th style="padding:10px; border:1px solid #ddd; width:30%;">모델명 / 품목명</th><th style="padding:10px; border:1px solid #ddd; width:70%;">상세 스펙</th></tr></thead><tbody>';
    groups[catL].forEach(it => {
      html += '<tr><td style="padding:10px; border:1px solid #ddd; text-align:center; font-weight:bold; word-break:break-all;">' + escapeEstimateHtml(it.model) + '<br><span style="font-weight:normal; font-size:12px; color:#666;">' + escapeEstimateHtml(it.name) + '</span></td>';
      html += '<td style="padding:10px; border:1px solid #ddd;"><div style="display:flex; flex-wrap:wrap; gap:6px;">';
      
      const extracted = extractSpecs(it);
      let specCount = 0;
      
      extracted.forEach(sp => {
          let bg = '#f0f4f8';
          let color = '#374151';
          let border = '#d1d5db';
          let valStr = sp.value;
          let keyStr = sp.label;
          
          if (keyStr.includes('냉방') || valStr.includes('냉방')) {
            bg = '#eff6ff'; color = '#1d4ed8'; border = '#bfdbfe';
          } else if (keyStr.includes('난방') || valStr.includes('난방')) {
            bg = '#fef2f2'; color = '#b91c1c'; border = '#fecaca';
          }
          
          if ((keyStr.includes('효율등급') || keyStr.includes('등급')) && valStr.includes('1등급')) {
            bg = '#f0fdf4'; color = '#15803d'; border = '#bbf7d0';
          }

          html += '<span style="background:'+bg+'; border:1px solid '+border+'; padding:4px 8px; border-radius:4px; font-size:12px; color:'+color+';"><strong style="color:inherit; font-weight:bold;">' + escapeEstimateHtml(keyStr) + ':</strong> ' + escapeEstimateHtml(valStr) + '</span>';
          specCount++;
      });
      
      if (specCount === 0) html += '<span style="color:#999; font-size:12px;">스펙 정보 없음</span>';
      html += '</div></td></tr>';
    });
    html += '</tbody></table>';
  });

  body.innerHTML = html;
  document.getElementById('pageSelectedSpec').classList.remove('hidden');
  logAction('화면이동', '장비스펙');
}

function getSpecCanvas() {
  return new Promise(resolve => {
    const original = document.getElementById('selectedSpecBody');
    const clone = original.cloneNode(true);
    clone.style.position = 'fixed';
    clone.style.left = '-9999px';
    clone.style.top = '0';
    clone.style.width = '1000px';
    clone.style.height = 'auto';
    clone.style.overflow = 'visible';
    clone.style.backgroundColor = '#ffffff';
    clone.style.padding = '20px';
    document.body.appendChild(clone);

    html2canvas(clone, {
      scale: 2,
      backgroundColor: "#ffffff",
      useCORS: true,
      width: 1000,
      windowWidth: 1000
    }).then(canvas => {
      document.body.removeChild(clone);
      resolve(canvas);
    });
  });
}

// 스펙복사
function copySelectedSpec() {
  getSpecCanvas().then(canvas => {
    canvas.toBlob(blob => {
      try {
        const item = new ClipboardItem({ "image/png": blob });
        navigator.clipboard.write([item]);
        alert("스펙 이미지가 클립보드에 복사되었습니다.");
        logAction('기능', '스펙복사');
      } catch(e) { 
        alert("이미지 복사에 실패했습니다."); 
      }
    });
  });
}

// 스펙저장
function saveSelectedSpec() {
  getSpecCanvas().then(canvas => {
    const link = document.createElement('a');
    link.download = '선택장비_스펙.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
    logAction('기능', '스펙저장');
  });
}

