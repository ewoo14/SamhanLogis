function handleSpecInput(e, type, key) {
  const inp = e.target;
  const val = inp.value.trim();

  let autoSpec = '';
  if (type === 'home') { 
      const r = homeRowByModel.get(key); autoSpec = String(r?.spec||''); 
  } else if (type === 'comm') { 
      const r = COMMULTI.find(x=>x.model===key); 
      autoSpec = String(r?.spec||''); 
      if (!autoSpec) {
          const p = COMM_PARTS.find(x=>x.model===key);
          if (p) autoSpec = String(p.spec||'');
      }
  } else if (type === 'old') { 
      const r = OLD_PRODUCTS.find(x=>x.model===key); autoSpec = String(r?.spec||''); 
  } else if (type === 'comm-part') { 
      const pm = key.split('|')[0]; 
      const p = COMM_PARTS.find(x=>x.model===pm); 
      autoSpec = String(p?.spec||''); 
  }

  if (val === '' || val === autoSpec) {
    if (type === 'home') homeCustomSpecs.delete(key);
    else if (type === 'comm' || type === 'comm-part') commCustomSpecs.delete(key);
    else if (type === 'old') oldCustomSpecs.delete(key);

