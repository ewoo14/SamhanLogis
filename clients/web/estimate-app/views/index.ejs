function handlePriceInput(e, type, key) {
  const inp = e.target;
  const raw = inp.value.replace(/[^0-9]/g, ''); 

  // 복귀
  if (inp.value.trim() === '') {
    if (type === 'home') homeCustomPrices.delete(key);
    else if (type === 'comm') commCustomPrices.delete(key);
    else if (type === 'single') singleCustomPrices.delete(key);
    else if (type === 'old') oldCustomPrices.delete(key);

    let autoPrice = 0;
    if (type === 'home') autoPrice = homeUnitPrice(key);
    else if (type === 'comm') autoPrice = commUnitPrice(key);
    else if (type === 'single') { const s = SINGLE_SETS.find(x=>String(x.id)===String(key)); if(s) autoPrice = calcSetUnitPrice(s); }
    else if (type === 'old') {
      const item = OLD_PRODUCTS.find(x=>x.model===key);
      const rateVal = parseInt(document.getElementById('old_rate')?.value || String(getOldDiscountPercent()), 10);
      const listP = Math.round(Number(item?.price)||0);
      autoPrice = roundByConfig(item?.isDisc ? listP*(1-rateVal/100) : Number(item?.sheetPrice)||0, 'old');
    }

    inp.value = autoPrice.toLocaleString();
    inp.style.color = '#374151'; inp.style.fontWeight = 'normal';
  } 
  else {
    // 저장
    const val = parseInt(raw, 10);
    inp.value = val.toLocaleString();
    inp.style.color = '#2563eb'; inp.style.fontWeight = 'bold';

    if (type === 'home') homeCustomPrices.set(key, val);
    else if (type === 'comm') commCustomPrices.set(key, val);
    else if (type === 'single') singleCustomPrices.set(key, val);
    else if (type === 'old') oldCustomPrices.set(key, val);
  }

  // 갱신
  const finalVal = parseInt(inp.value.replace(/[^0-9]/g,'')||0, 10);
  const tr = inp.closest('tr');
  const qtyInp = tr.querySelector('.qty-input');
  const qty = parseInt(qtyInp?.value || 0, 10);
  
  let subCell;
  if (type === 'home') subCell = tr.querySelector('[data-sub]');
  else if (type === 'comm') subCell = tr.querySelector('[data-csub]');
  else if (type === 'single') subCell = tr.querySelector('[data-ss]');
  else if (type === 'old') subCell = tr.querySelector('.sub-cell');

  if (subCell) subCell.textContent = fmt(finalVal * qty);

  if (type === 'home') syncHomeTotals();
  else if (type === 'comm') syncCommTotals();
  else if (type === 'single') {
    updateInlineTotals();

    // 배분
    const sObj = SINGLE_SETS.find(x => String(x.id) === String(key));
    if (sObj && typeof explodeSetParts === 'function') {
      const newUnit = typeof getRealSinglePrice === 'function' ? getRealSinglePrice(key) : ((typeof singleCustomPrices !== 'undefined' && singleCustomPrices.has(key)) ? singleCustomPrices.get(key) : calcSetUnitPrice(sObj));
      const newParts = explodeSetParts(sObj, 1, newUnit);
      
      const partRows = document.querySelectorAll(`#singleBody tr.set-part-single[data-part-of="${CSS.escape(key)}"]`);
      partRows.forEach(ptr => {
        const pModel = ptr.getAttribute('data-m');
        const match = newParts.find(np => (np.model || np.name || '').trim() === pModel);
        
        if (match) {
          // 단가
          const partPriceInp = ptr.querySelector('.part-price-single');
          if (partPriceInp) {
            partPriceInp.value = typeof fmt === 'function' ? fmt(match.price) : match.price.toLocaleString();
            partPriceInp.style.color = '#374151';
            partPriceInp.style.fontWeight = 'normal';
          } else {
            const priceCell = ptr.querySelector('.price');
            if (priceCell) priceCell.textContent = typeof fmt === 'function' ? fmt(match.price) : match.price.toLocaleString();
          }
          
          // 소계
          const partQtyInp = ptr.querySelector('.part-qty-single');
          const pQty = partQtyInp ? parseInt(partQtyInp.value.replace(/[^0-9]/g, '') || '0', 10) : parseInt(match.qty || 1, 10);
          const pSubCell = ptr.querySelector('.sub');
          
          if (pSubCell) {
            const pSub = pQty * match.price;
            const pSubSpan = pSubCell.querySelector('.val-for-text');
            if (pSubSpan) {
              pSubCell.firstChild.nodeValue = typeof fmt === 'function' ? fmt(pSub) : pSub.toLocaleString();
              pSubSpan.textContent = pSub;
            } else {
              pSubCell.textContent = typeof fmt === 'function' ? fmt(pSub) : pSub.toLocaleString();
            }
          }
        }
      });
    }
  }
  else if (type === 'old') syncOldTotals();
  
  if(typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
}

