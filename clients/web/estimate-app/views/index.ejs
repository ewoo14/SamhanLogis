    .withFailureHandler((err) => {
      alert('❌ 저장 실패: ' + err);
      if (btn) {
        btn.textContent = orgText;
        btn.disabled = false;
      }
    })
    .saveQuoteSnapshot({
      snapshotId: window.editingSnapshotId || null,
      data: jsonState,
      summary: summaryData,
      ...totals
    });
}

