/* 가격 계산 */
function materialsSumForSet(s){
  const includeMat=(el('#ss_mat')?.value||SINGLE_DEFAULTS['자재 포함 여부'])==='포함';
  if(!includeMat) return 0;
  return partsForSetStrict_(s).reduce((t,p)=>t+(/자재/.test(p?.feat||'')?partUnitPrice(p):0),0);
}
function isDefaultComponent_(p){
  if (typeof p?.isDefault === 'boolean') return p.isDefault === true;
  return /기본/i.test(p?.feat||'');
}
function getDefaultRemoteRows(s){return partsForSetStrict_(s).filter(p=>(/리모컨/.test(p?.kind||'')||/리모컨/.test(p?.name||''))&&isDefaultComponent_(p));}
function getOptionRemoteRow(s,opt){
  if(!opt) return null;const linked=partsForSetStrict_(s).filter(p=>/리모컨/.test((p?.kind||'')+(p?.name||'')));
  const pick=ok=>linked.find(ok)||null;
  if(opt==='유선리모컨') return pick(p=>/유선리모컨/i.test(p?.feat||'')&&!/컬러/i.test(p?.feat||''));
  if(opt==='컬러유선리모컨') return pick(p=>/컬러유선리모컨|유선컬러/i.test((p?.feat||'')+' '+(p?.name||'')));
  return null;
}
function allowRemoteChange_(s){
  const rows=getDefaultRemoteRows(s);
  return rows.some(row=>/^(AR-?EH05|AR-?EC05|AR-?KH05)$/i.test(String(row.model||'').trim()));
}
function is1WaySet_(s){
  const t=(s?.name||'')+' '+(s?.model||'');
  if(/1\s*way|1way/i.test(t)) return true;
  return partsForSetStrict_(s).some(p=>/1\s*way|1way/i.test(((p?.name)||'')+' '+((p?.spec)||'')));
}
function getBasePanelRow(s){return partsForSetStrict_(s).filter(p=>/(판넬|패널)/.test((p?.kind||'')+(p?.name||''))).find(isDefaultComponent_)||null;}
function pickPanelRow(s){
  const panels=partsForSetStrict_(s).filter(p=>/(판넬|패널)/.test((p?.kind||'')+(p?.name||'')));
  if(!panels.length) return null;
  const panelOpt=el('#ss_panel')?.value||'',shapeOpt=el('#ss_p360')?.value||'원형';
  const base=panels.find(isDefaultComponent_)||null;
  if(panelOpt==='판넬제외') return null;
  const T=p=>`${p?.name||''} ${p?.feat||''} ${p?.spec||''} ${p?.model||''}`;
  const is360=panels.some(p=>/360\s*-?\s*CST|CST\s*-?\s*360|360CST/i.test(T(p)));
  if(panelOpt===''&&is360){const want=(shapeOpt==='사각')?'사각':'원형';const exact=panels.find(p=>String(p?.feat||'').trim()===want);if(exact) return exact;}
  const matchShape=p=>{if(!is360) return true;const t=T(p);return (shapeOpt==='사각')?/(사각|square)/i.test(t):/(원형|round)/i.test(t);};
  if(panelOpt==='블랙판넬') return panels.find(p=>/블랙/i.test(T(p))&&matchShape(p))||panels.find(matchShape)||base;
  if(panelOpt==='승강판넬') return panels.find(p=>/(자동승강|승강)/i.test(T(p))&&matchShape(p))||panels.find(matchShape)||base;
  if(panelOpt==='공청판넬') return panels.find(p=>/(공기청정|공청)/i.test(T(p))&&matchShape(p))||panels.find(matchShape)||base;
  return panels.find(p=>isDefaultComponent_(p)&&matchShape(p))||panels.find(matchShape)||base;
}

// 싱글중대형 기본가 오른쪽가 우선
function setBasePriceRightFirst(s){
  // 서버 계산가 price 최우선
  const v = priceFrom(s, {
    priceKeys:['price','priceLeft','unitPrice'],
    listKeys:['list','listLeft','출고가'],
    formulaAware:true
  });
  return v;
}

function calcSetUnitPrice(s){
  if(!s) return 0;
  const raw = String(s?.nameRaw || s?.name || '');
  const norm = raw.replace(/\s+/g,'');

  if(/유연호스I형|I형유연호스/i.test(norm)) return 8000;

  let baseL = setBasePriceRightFirst(s);
  const isInc = document.getElementById('chkSingleInc')?.checked;
  if (isInc && typeof PRICE_INC !== 'undefined' && PRICE_INC.single && PRICE_INC.single[s.model] && PRICE_INC.single[s.model].price) {
    baseL = PRICE_INC.single[s.model].price;
  }

  const basePanel = getBasePanelRow(s);
  const chosenPanel = pickPanelRow(s);
  const panelExcluded = (el('#ss_panel')?.value||'')==='판넬제외';

  let panelDelta=0;
  if(basePanel){
    const baseP=partUnitPrice(basePanel);
    if(panelExcluded) panelDelta-=baseP;
    else if(chosenPanel && chosenPanel.model!==basePanel.model){
      panelDelta += (partUnitPrice(chosenPanel)-baseP);
    }
  }

  const baseRemoteRows = getDefaultRemoteRows(s);
  let remoteDelta=0;
  const remoteExcluded = !!el('#ss_remote_ex')?.checked;
  const remoteOpt = el('#ss_remote')?.value||'';
  const baseRemoteSum = baseRemoteRows.reduce((t,p)=>t+partUnitPrice(p),0);

  if(remoteExcluded){
    remoteDelta -= baseRemoteSum;
  } else if(remoteOpt && allowRemoteChange_(s)){
    const cand = getOptionRemoteRow(s,remoteOpt);
    if(cand){
      const replace = baseRemoteRows.find(p=>/유선/i.test((p?.feat||'')+' '+(p?.name||''))) || baseRemoteRows[0];
      if(replace) remoteDelta += (partUnitPrice(cand)-partUnitPrice(replace));
      else remoteDelta += partUnitPrice(cand);
    }
  }

  const matIncludedTotal = materialsSumForSet(s);

  /*합계*/
  let setPrice = baseL + panelDelta + remoteDelta + matIncludedTotal;

  /*할인*/
  const unitExtras = setPrice - Math.round(Number(baseL) || 0);
  const baseAdjusted = adjustSingleSetBasePrice(s, baseL);
  setPrice = baseAdjusted + unitExtras;

  if(setPrice < 0) setPrice = 0;
  return setPrice;
}

/* 세트 부품 */
function partsForSetStrict_(s){return SINGLE_PARTS.filter(p=>(p?.setModel||'')===(s?.model||''));}
const isRemote=p=>/리모컨/.test(p?.kind||'')||/리모컨/.test(p?.name||'');
const isPanel=p=>/(판넬|패널)/.test(p?.kind||'')||/(판넬|패널)/.test(p?.name||'');
const isHideMat=p=>/유연호스\s*I형|운임|절삭/i.test(((p?.kind)||'')+' '+((p?.name)||''));
const isFoot=p=>/발통/.test(p?.name||'')||/SI-AL700a/i.test(p?.model||'')||(FOOT_ROUND&&p?.model===FOOT_ROUND);
const isMaterial=p=>/자재/.test(p?.feat||'');

function explodeSetParts(s, qty, setUnitOverride){
  const parts = partsForSetStrict_(s);
  if (!parts.length || qty <= 0) return [];

  const includeMat = (el('#ss_mat')?.value || SINGLE_DEFAULTS['자재 포함 여부']) === '포함';
  const basePanel = getBasePanelRow(s);
  const pickPanel = pickPanelRow(s);
  const baseRemoteRows = getDefaultRemoteRows(s);
  const remoteExcluded = !!el('#ss_remote_ex')?.checked;
  const remoteOpt = el('#ss_remote')?.value || '';

  const remoteModels = new Set();
  if (!remoteExcluded){
    if (remoteOpt && allowRemoteChange_(s)){
      const cand = getOptionRemoteRow(s, remoteOpt);
      if (cand){
        const replace = baseRemoteRows.find(p => /유선/i.test((p?.feat||'') + ' ' + (p?.name||''))) || baseRemoteRows[0];
        baseRemoteRows.forEach(p => { if (!replace || p.model !== replace.model) remoteModels.add(p.model); });
        remoteModels.add(cand.model);
      }else{
        baseRemoteRows.forEach(p => remoteModels.add(p.model));
      }
    }else{
      baseRemoteRows.forEach(p => remoteModels.add(p.model));
    }
  }

  // 포함대상확정
  const picked = parts.filter(p => {
    if (isFoot(p) || isHideMat(p)) return false;
    if (isPanel(p)){
      if (!basePanel) return true;
      if (!pickPanel) return false;
      if (p.model === basePanel.model) return pickPanel.model === basePanel.model;
      if (p.model === pickPanel.model) return true;
      return false;
    }
    if (isRemote(p)) return remoteModels.has(p.model);
    if (isMaterial(p)) return includeMat;
    return true;
  });

  // 단가스냅샷
  const mapped = picked.map(p => ({
    section: 'SET',
    name: String(p?.name||''),
    model: p.model,
    unit: p.unit || 'EA',
    qty: qty,
    price: partUnitPrice(p),
    kind: p.kind || '',
    spec: p.spec || '',
    specs: Array.isArray(p.specs) ? p.specs : []
  }));

  // 실내외그룹
  let indoorParts = mapped.filter(isIndoorUnitPart);
  let outdoorParts = mapped.filter(isOutdoorUnitPart);
  let fixedParts = mapped.filter(x => !indoorParts.includes(x) && !outdoorParts.includes(x));

  // 세트비율결정
  const fixedCls = classifySingleSetFixed(s);
  const isHousehold =
    /가정용\s*에어컨/.test(String(fixedCls?.catL||'')) ||
    /가정용\s*에어컨/.test(String(s?.name||''));
  const ratioIn = isHousehold ? 6 : 4;
  const ratioOut = isHousehold ? 4 : 6;

  // 가정용벽걸이고정
  if (isHousehold) {
    const wallMounts = indoorParts.filter(p => /벽걸이/.test(p.name));
    if (wallMounts.length > 0) {
      wallMounts.forEach(w => fixedParts.push(w));
      indoorParts = indoorParts.filter(p => !/벽걸이/.test(p.name));
    }
  }

  // 세트단가계산
  const setUnit =
    Math.round(Number(setUnitOverride)) ||
    Math.round(Number(s.price)) ||
    Math.round(Number(setBasePriceRightFirst(s)));

  // 고정합계계산
  const fixedSum = fixedParts.reduce((t, x) => t + (Math.round(Number(x.price)||0)), 0);

  // 배분적용
  if (indoorParts.length && outdoorParts.length){
    const { indoor, outdoor, remain } = splitIndoorOutdoorToK(setUnit, fixedSum, ratioIn, ratioOut);

    // 단일항목처리
    if (indoorParts.length === 1 && outdoorParts.length === 1){
      indoorParts[0].price = indoor;
      outdoorParts[0].price = outdoor;
    }else{
      // 다수항목비례배분
      const sumInBase = indoorParts.reduce((t,x)=>t+(Number(x.price)||0),0) || indoorParts.length;
      const sumOutBase = outdoorParts.reduce((t,x)=>t+(Number(x.price)||0),0) || outdoorParts.length;

      let accIn = 0;
      indoorParts.forEach((x, i) => {
        if (i < indoorParts.length - 1){
          const v = roundK(indoor * (Number(x.price)||1) / sumInBase);
          x.price = v; accIn += v;
        }else{
          x.price = indoor - accIn;
        }
      });

      let accOut = 0;
      outdoorParts.forEach((x, i) => {
        if (i < outdoorParts.length - 1){
          const v = roundK(outdoor * (Number(x.price)||1) / sumOutBase);
          x.price = v; accOut += v;
        }else{
          x.price = outdoor - accOut;
        }
      });
    }
  }

  // 반환
  return mapped.map(p => ({
    section: 'SET',
    name: p.name,
    model: p.model,
    unit: p.unit,
    qty: p.qty,
    price: Math.max(0, Math.round(Number(p.price)||0)),
    kind: p.kind,
    spec: p.spec || '',
    specs: Array.isArray(p.specs) ? p.specs : []
  }));
}

// 상업멀티 구성품 조회
function partsForCommSet_(setModel){
  const k = normKey(String(setModel||'').trim());
  const rows = (COMM_PARTS || []).filter(p => {
    const raw = String(p?.setModel || p?.setKey || p?.['세트'] || p?.Set || p?.set || '').trim();
    const kk  = normKey(raw);
    return kk === k;
  });
  return rows;
}

// 실외기 선택량 기반으로 받침대 추천 수량 산출
function inferStandCountForOutdoor_(setModel, qty){
  const parts = partsForCommSet_(setModel);
  const hasGHP = parts.some(p=>/GHP방진가대/i.test(p?.name||''));
  if (hasGHP) return { name:'GHP방진가대', qty };
  return null;
}

function recalcCommAccessories(){
  // 실외기 합산
  const outdoorModels = (COMMULTI||[]).filter(r=>isCommOutdoorRow(r)).map(r=>r.model);
  // 모델별 수량
  const selected = outdoorModels.map(m=>({m, q:commQty.get(m)||0})).filter(x=>x.q>0);

  // 받침대 자동 조정 예시
  selected.forEach(({m,q})=>{
    const st = inferStandCountForOutdoor_(m, q);
    if (st){
      // 화면 내 해당 받침대 행 찾아 수량 반영
      const row = Array.from(elAll('#commBody tr')).find(tr => (tr.querySelector('.name .nm')||{}).textContent?.includes(st.name));
      if (row){
        const inp = row.querySelector('.qty-input');
        if (inp){
          const baseModel = row.getAttribute?.('data-m') || inp.dataset?.model || '';
          if (baseModel && COMM_MANUAL_BASE.has(baseModel)) return;
          const v = Math.max(q, parseInt(inp.value||'0',10)||0);
          if (v !== q){ inp.value = st.qty; inp.dispatchEvent(new Event('input')); }
        }
      }
    }
  });
}

let HOME_FILTER = {L:'',M:'',S:'',text:''};
let SINGLE_FILTER = {L:'',M:'',text:''};
let COMM_FILTER = {L:'',M:'',S:'',text:''};

function escapeFilterRe_(s){
  return String(s||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
}

function applyHomeFilter(rows){
  const st = HOME_FILTER||{};
  const text = (st.text||'').trim();
  let re = null;
  if(text) re = new RegExp(escapeFilterRe_(text),'i');
  
  return (rows||[]).filter(row=>{
    const r = row.r||{};
    
    if(re){
      const name = String(r.name||'');
      const model = String(r.model||'');
      if(!re.test(name) && !re.test(model)) return false;
    }
    if(st.L && row.L!==st.L) return false;
    if(st.M && row.M!==st.M) return false;
    if(st.S && row.S!==st.S) return false;
    return true;
  });
}

function applySingleFilter(rows){
  const st = SINGLE_FILTER||{};
  const text = (st.text||'').trim();
  let re = null;
  if(text) re = new RegExp(escapeFilterRe_(text),'i');
  
  return (rows||[]).filter(row=>{
    const s = row.s||{};

    if(re){
      const name = String(s.name||'');
      const model = String(s.model||'');
      if(!re.test(name) && !re.test(model)) return false;
    }
    if(st.L && row.L!==st.L) return false;
    if(st.M && row.M!==st.M) return false;
    return true;
  });
}

function applyCommFilter(rows){
  const st = COMM_FILTER||{};
  const text = (st.text||'').trim();
