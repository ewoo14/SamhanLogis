function initGate() {
  document.body.classList.add('no-active');

  const mobileGate = document.getElementById('mobileGate');
  const welcomeAnimation = document.getElementById('welcomeAnimation');
  const welcomeName = document.getElementById('welcomeName');

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (!mobileGate.classList.contains('hidden') && welcomeAnimation) {
        
        // 이름출력
        if (typeof USER_AUTH !== 'undefined' && USER_AUTH.managerName) {
          welcomeName.textContent = USER_AUTH.managerName;
        }
        
        // 애니메이션
        setTimeout(() => {
          const lines = welcomeAnimation.querySelectorAll('.anim-line');
          lines.forEach(line => {
            line.style.opacity = '1';
            line.style.transform = 'translateY(0)';
          });
        }, 100);

        // 화면이동
        setTimeout(() => {
          mobileGate.classList.add('hidden');

          // 이미지팝업호출
          if (gateImagesReady && loadedGateImages.length > 0) {
            showGateImageModal();
          }

