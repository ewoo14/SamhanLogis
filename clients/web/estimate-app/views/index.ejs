/* 상업멀티 필터 셀렉트 갱신 */
function updateCommFilterOptions(){
  const selL = document.getElementById('commFilterL');
  const selM = document.getElementById('commFilterM');
  const selS = document.getElementById('commFilterS');
  if (!selL) return;

  // 렌더와 동일한 분류 규칙
  let rows = getCommFilterRows_();

  // 텍스트 검색 반영
  const text = (COMM_FILTER && COMM_FILTER.text || '').trim();
  if (text) {
    const re = new RegExp(escapeFilterRe_(text), 'i');
    rows = rows.filter(row => {
      const rr = row.r || {};
      const name  = String(rr.name  || '');
      const model = String(rr.model || '');
      return re.test(name) || re.test(model);
    });
  }

  // 대분류 리스트 (표에 나온 순서대로)
  const Ls = [];
  rows.forEach(row => {
    if (row.L && !Ls.includes(row.L)) Ls.push(row.L);
  });

  // 현재 선택이 유효하지 않으면 초기화
  if (COMM_FILTER && COMM_FILTER.L && !Ls.includes(COMM_FILTER.L)) {
    COMM_FILTER.L = '';
    COMM_FILTER.M = '';
    COMM_FILTER.S = '';
  }

  selL.innerHTML = '';
  let opt = document.createElement('option');
  opt.value = '';
  opt.textContent = '대분류 전체';
  selL.appendChild(opt);
  Ls.forEach(v => {
    const o = document.createElement('option');
    o.value = v;
    o.textContent = v;
    if (COMM_FILTER && COMM_FILTER.L === v) o.selected = true;
    selL.appendChild(o);
  });

  // 중분류 리스트
  let rowsM = rows;
  if (COMM_FILTER && COMM_FILTER.L) {
    rowsM = rowsM.filter(row => row.L === COMM_FILTER.L);
  }
  const Ms = [];
  rowsM.forEach(row => {
    if (row.M && !Ms.includes(row.M)) Ms.push(row.M);
  });

  if (COMM_FILTER && COMM_FILTER.M && !Ms.includes(COMM_FILTER.M)) {
    COMM_FILTER.M = '';
    COMM_FILTER.S = '';
  }

  selM.innerHTML = '';
  opt = document.createElement('option');
  opt.value = '';
  opt.textContent = '중분류 전체';
  selM.appendChild(opt);
  Ms.forEach(v => {
    const o = document.createElement('option');
    o.value = v;
    o.textContent = v;
    if (COMM_FILTER && COMM_FILTER.M === v) o.selected = true;
    selM.appendChild(o);
  });
  // 대분류를 선택해야 중분류 활성화
  selM.disabled = !COMM_FILTER || !COMM_FILTER.L;

  // 소분류 리스트
  let rowsS = rowsM;
  if (COMM_FILTER && COMM_FILTER.M) {
    rowsS = rowsS.filter(row => row.M === COMM_FILTER.M);
  }
  const Ss = [];
  rowsS.forEach(row => {
    if (row.S && !Ss.includes(row.S)) Ss.push(row.S);
  });

  if (COMM_FILTER && COMM_FILTER.S && !Ss.includes(COMM_FILTER.S)) {
    COMM_FILTER.S = '';
  }

  if (selS) {
    selS.innerHTML = '';
    opt = document.createElement('option');
    opt.value = '';
    opt.textContent = '소분류 전체';
    selS.appendChild(opt);
    Ss.forEach(v => {
      const o = document.createElement('option');
      o.value = v;
      o.textContent = v;
      if (COMM_FILTER && COMM_FILTER.S === v) o.selected = true;
      selS.appendChild(o);
    });
    // 중분류를 선택해야 소분류 활성화
    selS.disabled = !COMM_FILTER || !COMM_FILTER.M;
  }
}

/* 필터 이벤트 바인딩 */
