// 엑셀 기능 초기화
function initExcelUX() {
  
  // 포커스 전체선택
  document.addEventListener('focusin', function(e) {
    const el = e.target;
    if (el.tagName !== 'INPUT' || el.readOnly || el.disabled) return;
    
    // 타이머 초기화
    if (el.dataset.selTimer) clearTimeout(Number(el.dataset.selTimer));

    // 지연 선택
    const timerId = setTimeout(() => {
      if (document.activeElement === el) {
        el.select();
      }
      delete el.dataset.selTimer;
    }, 20);

    el.dataset.selTimer = timerId;
  });

  // 키보드 입력
  document.addEventListener('keydown', function(e) {
    const el = e.target;
    const k = e.key;
    
    if (el.tagName !== 'INPUT') return;
    if (!['ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'Enter'].includes(k)) return;

    // 검색창 예외
    if (el.id === 'custSearch' || el.id === 'managerSearch') {
      const list = document.getElementById(el.id === 'custSearch' ? 'custSuggestions' : 'managerSuggestions');
      if (list && !list.classList.contains('hidden') && list.children.length > 0) {
         if (k === 'ArrowUp' || k === 'ArrowDown' || k === 'Enter') return;
      }
    }

    // 기본 동작 차단
    e.preventDefault();

    const td = el.closest('td');
    
    // 테이블 내부
    if (td) {
      const tr = td.closest('tr');
      const table = tr.closest('table');
      
      if (k === 'ArrowUp' || k === 'ArrowDown' || k === 'Enter') {
        // 상하 이동 좌표기반
        const dir = (k === 'ArrowUp') ? -1 : 1;
        if (!moveTableVerticalVisual(el, table, tr, td, dir)) {
          moveSection(el, dir); // 실패시 섹션 이동
        }
      } else {
        // 좌우 이동 DOM기반
        const dir = (k === 'ArrowLeft') ? -1 : 1;
        if (!moveTableHorizontal(el, table, dir)) {
          moveSection(el, dir); // 실패시 섹션 이동
        }
      }
    } 
    // 테이블 외부
    else {
      const dir = (k === 'ArrowUp' || k === 'ArrowLeft') ? -1 : 1;
      moveSection(el, dir);
    }
  });

  // 수직 이동 좌표 함수
  function moveTableVerticalVisual(el, table, currentTr, currentTd, dir) {
    // 현재 셀 좌표 계산
    const rect = currentTd.getBoundingClientRect();
    const targetX = rect.left + (rect.width / 2); // 중심점
    
    let rowIndex = currentTr.rowIndex;
    const rows = table.rows;
    const maxRow = rows.length;

    while (true) {
      rowIndex += dir;
      if (rowIndex < 0 || rowIndex >= maxRow) return false;

      const targetTr = rows[rowIndex];
      
      // 숨김 행 제외
      if (targetTr.style.display === 'none' || targetTr.classList.contains('hidden')) continue;
      if (targetTr.offsetParent === null) continue;

      // 행 내부 셀 순회
      const cells = targetTr.cells;
      for (let i = 0; i < cells.length; i++) {
        const cell = cells[i];
        const cRect = cell.getBoundingClientRect();

        // 수직 교차 확인
        if (cRect.left <= targetX && cRect.right >= targetX) {
          const input = cell.querySelector('input:not([type=hidden]):not([disabled]):not([readonly])');
          if (input) {
            input.focus();
            return true;
          }
          // 입력창 없으면 다음 행 계속 탐색
          break; 
        }
      }
    }
  }

  // 수평 이동 함수
  function moveTableHorizontal(el, table, dir) {
    const inputs = Array.from(table.querySelectorAll('input:not([type=hidden]):not([disabled]):not([readonly])'));
    const visibleInputs = inputs.filter(inp => inp.offsetParent !== null);
    
    const currIdx = visibleInputs.indexOf(el);
    if (currIdx === -1) return false;

    const nextIdx = currIdx + dir;
    if (nextIdx >= 0 && nextIdx < visibleInputs.length) {
      visibleInputs[nextIdx].focus();
      return true;
    }
    return false;
  }

  // 전체 이동 함수
  function moveSection(el, dir) {
    const all = Array.from(document.querySelectorAll('input:not([type=hidden]):not([disabled]):not([readonly])'));
    const visible = all.filter(inp => inp.offsetParent !== null);
    
    const currIdx = visible.indexOf(el);
    const nextIdx = currIdx + dir;

    if (nextIdx >= 0 && nextIdx < visible.length) {
      visible[nextIdx].focus();
    }
  }
}

// 재고조회
function initInventoryModal() {
  const modal = document.getElementById('modalInventory');
  const btnOpenMain = document.getElementById('btnCheckStock'); // 메인 페이지 버튼
  const btnClose = document.getElementById('btnCloseInventory');
  const btnSearch = document.getElementById('btnSearchInventory');
  const inpDate = document.getElementById('invDate');
  const divResult = document.getElementById('invResult');
  const divMsg = document.getElementById('invMsg');

  if (!modal) return;

  // 공용 조회 함수
  window.openInventoryCheck = function() {
    // 모달선택
    const modal = document.getElementById('modalInventory');
    if (modal) {
      if (modal.parentNode !== document.body) {
        document.body.appendChild(modal);
      }
      modal.style.zIndex = '9999999';
    }

    // 날짜선택 오늘기준 20일 뒤
    const inpDate = document.getElementById('invDate');
    const now = new Date();
    // 시간보정
    const kst = new Date(now.getTime() + (9 * 60 * 60000));
    // 20일 추가
    kst.setUTCDate(kst.getUTCDate() + 20);
    if (inpDate) inpDate.value = kst.toISOString().split('T')[0];

    // 화면표시
    if (modal) modal.classList.add('active');
    if (typeof doSearch === 'function') doSearch();
    logAction('조회', '재고조회');
  };

  // 데이터 조회
  const doSearch = () => {
    const dateVal = inpDate.value.replace(/-/g, '');
    if (!dateVal || dateVal.length !== 8) {
      if(divMsg) divMsg.textContent = '날짜를 올바르게 선택해주세요.';
      return;
    }

    // 전표 데이터 가져오기 (메인/미리보기 공통 사용)
    let items = [];
    if (typeof buildSendRows === 'function') {
      const rows = buildSendRows(); // 현재 작성된 품목 리스트업
      if (Array.isArray(rows)) {
        items = rows
          .map(r => r.model || r.code || r.PROD_CD || (r.BulkDatas ? r.BulkDatas.PROD_CD : ''))
          .filter(c => c && typeof c === 'string');
      }
    }
    items = [...new Set(items)]; // 중복 제거

    if (items.length === 0) {
      divResult.innerHTML = '<div style="text-align:center; padding:40px; color:red;">조회할 품목이 없습니다.</div>';
      return;
    }

    if(divMsg) divMsg.textContent = '';
    divResult.innerHTML = '<div style="text-align:center; padding:40px; color:#2563eb;">⏳ 재고 데이터를 불러오는 중입니다...</div>';
    if (btnSearch) btnSearch.disabled = true;

    google.script.run
      .withSuccessHandler((html) => {
        if (btnSearch) btnSearch.disabled = false;
        divResult.innerHTML = sanitizeLegacyTableHtml(html);
      })
      .withFailureHandler((err) => {
        if (btnSearch) btnSearch.disabled = false;
        if(divMsg) divMsg.textContent = '오류: ' + err.message;
        divResult.innerHTML = '<div style="text-align:center; padding:20px; color:red;">조회 실패</div>';
      })
      .getInventoryTable(dateVal, items);
  };

  // 이벤트 바인딩
  if (btnOpenMain) {
    btnOpenMain.onclick = (e) => {
      e.preventDefault();
      window.openInventoryCheck();
    };
  }

  // 닫기 및 내부 검색 버튼
  const closeModal = () => modal.classList.remove('active');
  if (btnClose) btnClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  if (btnSearch) btnSearch.addEventListener('click', doSearch);
  if (inpDate) {
    inpDate.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') doSearch();
    });
  }
}

// 날짜 포맷 (한국시간 기준)
const toYMD = (d) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const dd = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${dd}`;
};

// 보정
function enforceDateLimit(changedType, startId, endId) {
  const elStart = document.getElementById(startId);
  const elEnd = document.getElementById(endId);
  if (!elStart || !elEnd || !elStart.value || !elEnd.value) return;

  const sDate = new Date(elStart.value);
  const eDate = new Date(elEnd.value);
  const diffTime = eDate.getTime() - sDate.getTime();
  const diffDays = diffTime / (1000 * 3600 * 24);

  if (diffDays > 7) {
    if (changedType === 'start') {
      const newEnd = new Date(sDate);
      newEnd.setDate(sDate.getDate() + 7);
      elEnd.value = toYMD(newEnd);
    } else {
      const newStart = new Date(eDate);
      newStart.setDate(eDate.getDate() - 7);
      elStart.value = toYMD(newStart);
    }
  } else if (diffDays < 0) {
    if (changedType === 'start') elEnd.value = elStart.value;
    else elStart.value = elEnd.value;
  }
}

/* 연결 */
document.addEventListener('DOMContentLoaded', () => {
  // 제한
  const elStart = document.getElementById('histStart');
  const elEnd = document.getElementById('histEnd');
  if (elStart && elEnd) {
    elStart.addEventListener('change', () => enforceDateLimit('start', 'histStart', 'histEnd'));
    elEnd.addEventListener('change', () => enforceDateLimit('end', 'histStart', 'histEnd'));
  }

  // 제한
  const snapStart = document.getElementById('snapStart');
  const snapEnd = document.getElementById('snapEnd');
  if (snapStart && snapEnd) {
    snapStart.addEventListener('change', () => enforceDateLimit('start', 'snapStart', 'snapEnd'));
    snapEnd.addEventListener('change', () => enforceDateLimit('end', 'snapStart', 'snapEnd'));
  }
});

// 카드수수료 전역변
window.CURRENT_CARD_FEE = 0;

/* 카드수수료 적용 */
function applyCardFeeLogic(rows) {
  const box = document.getElementById('chkCardPay');
  window.CURRENT_CARD_FEE = 0;
  if (!box || !box.checked) return;

  if (rows.some(r => r.name === '카드' || (r.remarks && r.remarks.includes('수수료')))) {
    return;
  }

  /* 수수료 계산 */
  const total = rows.reduce((acc, r) => acc + (r.sub || (r.price * r.qty) || 0), 0);
  const fee = Math.floor(total * getCardFeeRate());

  window.CURRENT_CARD_FEE = fee;

  /* 타겟 선정 */
  let target = rows.find(r => r.qty === 1 && r.type !== 'set-head');
  if (!target) target = rows.find(r => r.qty === 1);

  if (target) {
    target.price += fee;
    if (target.sub !== undefined) target.sub += fee;
  } else {
    // 신규 생성
    rows.push({
      name: '카드수수료', model: '카드수수료', unit: '식', 
      qty: 1, price: fee, sub: fee, remarks: '', cat: '기타',
      cardFee: fee
    });
  }
}

/* 절삭처리 */
function applyCutoffLogic(rows) {
  const el = document.getElementById('selCutUnit');
  const unit = parseInt(el ? el.value : 0) || 0;
  
  if (unit === 0) return;

  // 총액산출
  const total = rows.reduce((acc, r) => acc + (r.sub || (r.price * r.qty) || 0), 0);
  const rem = total % unit;

  if (rem === 0) return;

  // 타겟설정
  // 사용자 카탈로그 절삭은 자동 절삭의 대상이 아니다. 이름/모델이 같아도 source가 다르다.
  let target = rows.find(r => r.qty === 1
    && r.type !== 'set-head'
    && r.source !== SPECIAL_ROW_SOURCE.CATALOG_SPECIAL);

  if (target) {
    // 차감
    target.price -= rem;
    if (target.sub !== undefined) target.sub -= rem;
  } else {
    // 신규생성
    rows.push({
      section: '기타',
      name: '절삭',
      model: '절삭',
      unit: '식',
      qty: 1,
      price: -rem,
      sub: -rem,
      remarks: '',
      source: SPECIAL_ROW_SOURCE.AUTO_CUTOFF,
      identity: `auto-cutoff:${unit}:${rows.length}`
    });
  }
}

/* 스냅샷저장 */
function takeSnapshot() {
  const formData = {};
  // 폼요소
  document.querySelectorAll('input, select, textarea').forEach(el => {
    if(!el.id && !el.name) return;
    const k = el.id || el.name;
    if(el.type === 'checkbox') formData[k] = el.checked;
    else if(el.type === 'radio') {
      if(el.checked) formData[el.name] = el.value;
    }
    else {
      formData[k] = {
        v: el.value,
        l: el.style.color || false
      };
    }
  });

  // 분기상태
  if (typeof snapshotBranchState === 'function' && document.getElementById('branchBoard')) {
    const currentBranchState = snapshotBranchState();
    if (currentBranchState && Object.keys(currentBranchState.grid).length > 0) {
      window.GLOBAL_BRANCH_STATE = currentBranchState;
    }
  }

  let brData = null;
  if (window.GLOBAL_BRANCH_STATE) {
    brData = JSON.parse(JSON.stringify(window.GLOBAL_BRANCH_STATE));
  }

  const partCustomData = {};
  // 싱글부품
  document.querySelectorAll('.set-part-single').forEach(ptr => {
    const setId = ptr.getAttribute('data-part-of');
    const model = ptr.getAttribute('data-m');
    if (!setId || !model) return;
    const qNode = ptr.querySelector('.part-qty-single');
    const pNode = ptr.querySelector('.price-input');
    const specNode = ptr.querySelector('.spec-input');
    
    const q = qNode ? qNode.value : '';
    const qL = qNode ? !!qNode.style.color : false;
    const p = pNode ? pNode.value.replace(/[^0-9]/g, '') : '';
    const pL = pNode ? !!pNode.style.color : false;
    const spec = specNode ? specNode.value : '';
    const sL = specNode ? !!specNode.style.color : false;
    
    if(!partCustomData['single_' + setId]) partCustomData['single_' + setId] = {};
    partCustomData['single_' + setId][model] = { q, qL, p, pL, spec, sL };
  });

  // 상업부품
  document.querySelectorAll('#commBody tr[data-part-of]').forEach(ptr => {
    const setId = ptr.getAttribute('data-part-of');
    const model = ptr.getAttribute('data-m');
    if (!setId || !model) return;
    const qNode = ptr.querySelector('.part-qty-comm, .qty-input');
    const pNode = ptr.querySelector('.price-input, .part-price-comm');
    const specNode = ptr.querySelector('.spec-input');
    
    const q = qNode ? qNode.value : '';
    const qL = qNode ? !!qNode.style.color : false;
    const p = pNode ? pNode.value.replace(/[^0-9]/g, '') : '';
    const pL = pNode ? !!pNode.style.color : false;
    const spec = specNode ? specNode.value : '';
    const sL = specNode ? !!specNode.style.color : false;
    
    if(!partCustomData['comm_' + setId]) partCustomData['comm_' + setId] = {};
    partCustomData['comm_' + setId][model] = { q, qL, p, pL, spec, sL };
  });

  const homeDc = {};
  // 홈디씨
  document.querySelectorAll('#homeBody tr').forEach(tr => {
    const m = tr.getAttribute('data-m');
    if (!m) return;
    const fixInp = tr.querySelector('.fix-dc-inp');
    const varChk = tr.querySelector('.var-dc-chk');
    if (fixInp || varChk) {
      homeDc[m] = { 
        fix: fixInp ? fixInp.value : '', 
        var: varChk ? varChk.checked : false 
      };
    }
  });

  const commDc = {};
  // 상업디씨
  document.querySelectorAll('#commBody tr').forEach(tr => {
    const m = tr.getAttribute('data-m');
    if (!m) return;
    const fixInp = tr.querySelector('.fix-dc-inp');
    const varChk = tr.querySelector('.var-dc-chk');
    if (fixInp || varChk) {
      commDc[m] = { 
        fix: fixInp ? fixInp.value : '', 
        var: varChk ? varChk.checked : false 
      };
    }
  });

  const customRowsData = {};
  // 커스텀행
  ['home', 'single', 'comm', 'old'].forEach(type => {
    const tbody = document.getElementById(type + 'CustomBody');
    if (tbody) {
      const rows = [];
      tbody.querySelectorAll('.custom-item-row').forEach(tr => {
        const nameNode = tr.querySelector('.pc-name');
        const modelNode = tr.querySelector('.custom-model');
        const listNode = tr.querySelector('.list-price-input');
        const specNode = tr.querySelector('.custom-spec');
        const qtyNode = tr.querySelector('.custom-qty');
        const priceNode = tr.querySelector('.custom-price');
        const fixNode = tr.querySelector('.custom-fix-dc');
        const varNode = tr.querySelector('.custom-var-dc');

        const row = {
          name: nameNode ? nameNode.value : '',
          model: modelNode ? modelNode.value : '',
          list: listNode ? listNode.value : '',
          spec: specNode ? specNode.value : '',
          qty: qtyNode ? qtyNode.value : '',
          price: priceNode ? priceNode.value : '',
          fixDc: fixNode ? fixNode.value : '',
