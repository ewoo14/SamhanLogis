/* 드래그정렬 */
function makeFinalSortable() {
  const tbody = document.getElementById('finalBody');
  if (!tbody) return;

  let dragEl = null;
  let placeholder = null;

  const onStart = (e) => {
    if (!e.target.closest('.drag-handle')) return;
    if (e.type === 'touchstart') {
      const touch = e.touches[0];
      if(touch) dragEl = e.target.closest('tr');
    } else {
      e.preventDefault();
      dragEl = e.target.closest('tr');
    }
    if(!dragEl) return;

    const rect = dragEl.getBoundingClientRect();
    
    // 너비유지
    [...dragEl.children].forEach(td => {
      td.style.width = td.getBoundingClientRect().width + 'px';
    });

    placeholder = document.createElement('tr');
    placeholder.className = 'sortable-placeholder';
    placeholder.innerHTML = `<td colspan="6" style="height:${rect.height}px; background:#f3f4f6; border:1px dashed #cbd5e1;"></td>`;

    dragEl.style.width = rect.width + 'px';
    dragEl.style.position = 'fixed';
    dragEl.style.zIndex = '99999';
    dragEl.style.transition = 'none';
    dragEl.style.transform = 'scale(1.03)';
    dragEl.style.boxShadow = '0 10px 20px rgba(0,0,0,0.15)';
    dragEl.style.background = '#fff';
    dragEl.style.opacity = '0.9';

    dragEl.parentNode.insertBefore(placeholder, dragEl.nextSibling);
    moveAt(e);
  };

  const onMove = (e) => {
    if (!dragEl) return;
    e.preventDefault();
    moveAt(e);

    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    const siblings = [...tbody.querySelectorAll('tr:not(.sortable-placeholder)')].filter(tr => tr !== dragEl);
    let nextEl = siblings.find(sibling => {
      const box = sibling.getBoundingClientRect();
      return clientY < box.top + box.height / 2;
    });

    // 슬라이드
    const firstRects = new Map(siblings.map(tr => [tr, tr.getBoundingClientRect().top]));

    if (nextEl) {
      tbody.insertBefore(placeholder, nextEl);
    } else {
      tbody.appendChild(placeholder);
    }

    siblings.forEach(tr => {
      const lastTop = tr.getBoundingClientRect().top;
      const firstTop = firstRects.get(tr);
      const delta = firstTop - lastTop;
      
      if (delta !== 0) {
        tr.style.transform = `translateY(${delta}px)`;
        tr.style.transition = 'none';
        requestAnimationFrame(() => {
          tr.style.transform = '';
          tr.style.transition = 'transform 0.2s ease-out';
        });
      }
    });
  };

  const onEnd = () => {
    if (!dragEl) return;
    dragEl.style.position = '';
    dragEl.style.zIndex = '';
    dragEl.style.width = '';
    dragEl.style.transform = '';
    dragEl.style.boxShadow = '';
    dragEl.style.background = '';
    dragEl.style.opacity = '';
    
    // 너비초기화
    [...dragEl.children].forEach(td => {
      td.style.width = '';
    });

    tbody.insertBefore(dragEl, placeholder);
    placeholder.remove();
    dragEl = null;
    placeholder = null;

    /* 순서갱신 */
    window.CUSTOM_FINAL_ORDER = [...tbody.querySelectorAll('tr')].map(tr => tr.dataset.key).filter(Boolean);
  };

  const moveAt = (e) => {
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    dragEl.style.top = (clientY - dragEl.offsetHeight / 2) + 'px';
    const pRect = placeholder.getBoundingClientRect();
    dragEl.style.left = pRect.left + 'px';
  };

  tbody.removeEventListener('mousedown', window._onFinalStart);
  tbody.removeEventListener('touchstart', window._onFinalStart);
  document.removeEventListener('mousemove', window._onFinalMove);
  document.removeEventListener('touchmove', window._onFinalMove);
  document.removeEventListener('mouseup', window._onFinalEnd);
  document.removeEventListener('touchend', window._onFinalEnd);

  window._onFinalStart = onStart;
  window._onFinalMove = onMove;
  window._onFinalEnd = onEnd;

  tbody.addEventListener('mousedown', window._onFinalStart);
  tbody.addEventListener('touchstart', window._onFinalStart, {passive: false});
  document.addEventListener('mousemove', window._onFinalMove, {passive: false});
  document.addEventListener('touchmove', window._onFinalMove, {passive: false});
  document.addEventListener('mouseup', window._onFinalEnd);
  document.addEventListener('touchend', window._onFinalEnd);

  /* 모바일버튼 */
  setTimeout(() => {
    const bindNav = (id, targetSelector) => {
      const btn = document.querySelector('#cardFinal #' + id);
      const target = document.querySelector('.view-group #' + id);
      
      if(btn && target) {
        btn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          if(typeof closeFinal === 'function') closeFinal();
          target.click(); 
        };
      }
    };
    
    bindNav('btnGoHome');
    bindNav('btnGoSingle');
    bindNav('btnGoComm');
    bindNav('btnGoOld');
  }, 100);

  setTimeout(() => {
    autoShrinkTableColumns('#wrapFinal table', [3, 4]); 
  }, 100);
}

