// 상업
function computeCommRemoteModelForIndoor_(row){
  // 옵션
  const opt = (document.getElementById('comm_remote')?.value) || '무선';
  const nm  = rawNameOf(row) || '';

  // 제외
  if (opt === '제외') return '';

  // 전열
  if (/전열교환기/i.test(nm)) return 'AWR-VH12N';

  // 덕트
  if (/덕트|DUCT/i.test(nm)){
    if (opt === '컬러유선') return 'AWR-WG00N';
    return 'AWR-WE13N';
  }

  // 유선
  if (opt === '유선')     return 'AWR-WE13N';
  if (opt === '컬러유선') return 'AWR-WG00N';

  // 살균
  if (opt === '무선' && /UV-?C/i.test(nm)) {
    return 'AR-CH01';
  }

  // 무선
  if (/인피니트/i.test(nm)) return 'AR-CH01';
  if (/360/i.test(nm))      return 'AR-EH05';
  return 'AR-EH05';
}

