/* 견적서 렌더링 */
function renderPreviewContent() {
  const body = document.getElementById('previewBody');
  const foot = document.getElementById('pvFoot');
  const table = document.querySelector('#wrapPreview table');
  
  if (!body || !table) return;

  // 체크 상태
  const showList = document.getElementById('chkShowListPrice')?.checked || false;
  
  // 열 너비 설정
  let colGroupHTML = '';
  let totalCols = 6;

  if (showList) {
    totalCols = 7;
    // 출고가 포함 너비
    colGroupHTML = `
      <colgroup>
        <col style="width: 37%">
        <col style="width: 12%">
        <col style="width: 5%">
        <col style="width: 5%">
        <col style="width: 13%">
        <col style="width: 13%">
        <col style="width: 15%">
      </colgroup>`;
  } else {
    totalCols = 6;
    // 기본 너비
    colGroupHTML = `
      <colgroup>
        <col style="width: 50%">
        <col style="width: 12%">
        <col style="width: 5%">
        <col style="width: 5%">
        <col style="width: 13%">
        <col style="width: 15%">
      </colgroup>`;
  }

  // colgroup 삽입
  const oldCol = table.querySelector('colgroup');
  if (oldCol) oldCol.remove();
  
  const thead = table.querySelector('thead');
  if (thead) {
    thead.insertAdjacentHTML('beforebegin', colGroupHTML);
    
    const tr = thead.querySelector('tr');
    if (tr) {
      if (showList) {
        tr.innerHTML = `
          <th>품목</th>
          <th class="model">모델명</th>
          <th class="unit">단위</th>
          <th>수량</th>
          <th class="h-price" style="background:#eff6ff; color:#1e40af;">출고가</th>
          <th class="h-price">단가</th>
          <th>소계</th>`;
      } else {
        tr.innerHTML = `
          <th>품목</th>
          <th class="model">모델명</th>
          <th class="unit">단위</th>
          <th>수량</th>
          <th class="h-price">단가</th>
          <th>소계</th>`;
      }
    }
  }

  // 데이터 렌더링
  body.innerHTML = '';
  const sections = getStructuredQuoteData();
  let grandTotal = 0;
  const nowStr = new Date().toLocaleDateString();

  const B_COL = '#374151'; 
  const B_LIG = '#e5e7eb';
  const C_TXT = '#000000';
  const PAD = '4px 8px';
  const fmt   = (n) => (n ? Number(n).toLocaleString() : '0');

  // 병합 계산
  const labelSpan = totalCols - 1; 

  if (sections.length === 0) {
    body.innerHTML = `<tr><td colspan="${totalCols}" style="padding:40px; text-align:center;">선택된 품목이 없습니다.</td></tr>`;
    if(foot) foot.innerHTML = '';
    return;
  }

  // 섹션 반복
  sections.forEach((sec, idx) => {
    grandTotal += sec.total;

    // 섹션헤더
    const trHead = document.createElement('tr');
    trHead.className = 'section-header';
    
    // 텍스트 추출
    function parseRatioText(el) {
      var res = { pct: null, branch: null };
      if (!el) return res;
      var txt = el.innerText;
      if (txt.indexOf('---') !== -1) return res;

      // % 추출 및 에러 텍스트 인식
      var mPct = txt.match(/\d+(\.\d+)?%/);
      if (mPct) res.pct = mPct[0];
      else if (txt.indexOf('조합 불가') !== -1) res.pct = '<span style="color:#dc2626;">조합 불가</span>';
      else if (txt.indexOf('초과 주의') !== -1) res.pct = '<span style="color:#dc2626;">허용 대수 초과 주의!</span>';

      // 부족 분기관 추출
      var mBr = txt.match(/부족\s*분기관\s*:\s*\d+개/);
      if (mBr) res.branch = mBr[0];

      return res;
    }

    // 데이터 파싱
    const hData = parseRatioText(document.getElementById('homeRatio'));
    const cData = parseRatioText(document.getElementById('commRatio'));
    
    // 조합비 텍스트 조립
    let ratioTxt = "";
    let ratios = [];
    if (hData.pct) ratios.push("홈멀티 " + hData.pct);
    if (cData.pct) ratios.push("상업멀티 " + cData.pct);
    if (ratios.length > 0) ratioTxt = "조합비: " + ratios.join(' & ') + ' / ';

    // 부족 분기관 텍스트 조립
    let branchTxt = "";
    let branches = [];
    if (hData.branch) branches.push(hData.branch);
    if (cData.branch && branches.indexOf(cData.branch) === -1) branches.push(cData.branch);
    if (branches.length > 0) branchTxt = branches.join(', ') + ' / ';

    // 피씨헤더
    let headerContentPc = (idx === 0) ? `<div style="display:flex; justify-content:space-between; align-items:center;">
      <span>${escapeEstimateHtml(sec.title)}</span>
      <span style="font-weight:normal; font-size:0.9em; white-space:nowrap;">견적일: ${nowStr}</span>
    </div>` : escapeEstimateHtml(sec.title);

    // 모바일헤더
    let headerContentMo = (idx === 0) ? `<div style="display:flex; justify-content:space-between; align-items:center;">
      <span>${escapeEstimateHtml(sec.title)}</span>
      <span style="font-weight:normal; font-size:0.9em; white-space:nowrap;">${ratioTxt}${branchTxt}견적일: ${nowStr}</span>
    </div>` : escapeEstimateHtml(sec.title);

    // 엘리먼트
    trHead.innerHTML = `
      <td class="pc-only" colspan="${totalCols}" style="background:#F0EBE4; color:${C_TXT}; font-weight:bold; padding:${PAD}; border-top:2px solid ${B_COL}; border-bottom:2px solid ${B_COL}; text-align:left;">${headerContentPc}</td>
      <td class="mobile-only" colspan="${totalCols - 2}" style="background:#F0EBE4; color:${C_TXT}; font-weight:bold; padding:${PAD}; border-top:2px solid ${B_COL}; border-bottom:2px solid ${B_COL}; text-align:left;">${headerContentMo}</td>
    `;
    body.appendChild(trHead);

    // 목록
    sec.rows.forEach(r => {
      const bgColor = typeof getQuoteItemBgColor === 'function' ? getQuoteItemBgColor(r, sec.id) : '';
      const bgStyle = bgColor ? ` background-color:${bgColor} !important; -webkit-print-color-adjust: exact; color-adjust: exact;` : '';

      const tr = document.createElement('tr');
      tr.style.borderBottom = `1px dotted ${B_LIG}`;
      // 높이압축
      tr.style.lineHeight = '1.1';

      if(r.type === 'set-head') {
        tr.className = 'group-top';
        tr.style.background = '#fff';
        tr.innerHTML = `
          <td class="pc-only" colspan="${totalCols}" style="text-align:left; padding:${PAD}; font-weight:bold; color:${C_TXT};${bgStyle}">${escapeEstimateHtml(r.name)} (${escapeEstimateHtml(r.model)}) × ${fmt(r.qty)}</td>
          <td class="mobile-only" colspan="${totalCols - 2}" style="text-align:left; padding:${PAD}; font-weight:bold; color:${C_TXT};${bgStyle}">${escapeEstimateHtml(r.name)} (${escapeEstimateHtml(r.model)}) × ${fmt(r.qty)}</td>
        `;
      } else {
        if(r.isChild) tr.className = 'child';
        const namePad = r.isChild ? '4px 8px 4px 20px' : PAD;
        const color = r.isChild ? '#4b5563' : '#111';
        const prefix = r.isChild ? '└ ' : '';
        const modColor = r.isChild ? '#6b7280' : '#000000';
        const tdBase = `padding:${PAD}; border-right:1px solid ${B_LIG}; word-break:break-all;`;
        
        let html = `<td style="text-align:left; padding:${namePad}; border-right:1px solid ${B_LIG}; color:${color}; word-break:break-all;${bgStyle}">${prefix}${escapeEstimateHtml(r.name)}</td>` 
                  + `<td class="model" style="${tdBase} color:${modColor}; font-size:0.9em;">${escapeEstimateHtml(r.model)}</td>` 
                  + `<td class="unit" style="${tdBase} text-align:center;">${escapeEstimateHtml(r.unit)}</td>` 
                  + `<td style="${tdBase} text-align:center;">${fmt(r.qty)}</td>`;
        
        // 출고가 열
        if (showList) {
          html += `<td style="${tdBase} text-align:right; color:#1e40af; background:#f9fafb;">${fmt(r.list || 0)}</td>`;
        }
        
        // 납품가 및 금액
        html += `<td style="${tdBase} text-align:right;">${fmt(r.price)}</td>` 
              + `<td style="padding:${PAD}; text-align:right;">${fmt(r.sub)}</td>`;
        
        tr.innerHTML = html;
      }
      body.appendChild(tr);
    });

    // 소계
    const trSub = document.createElement('tr');
    trSub.className = 'section-subtotal';
    trSub.innerHTML = `
      <td class="pc-only" colspan="${labelSpan}" style="background:#fff; border-bottom:1px solid ${B_COL}; padding:${PAD}; text-align:left;">
        <span style="font-weight:bold; color:#4b5563;">${escapeEstimateHtml(sec.subLabel)}</span>
      </td>
      <td class="mobile-only" colspan="${labelSpan - 2}" style="background:#fff; border-bottom:1px solid ${B_COL}; padding:${PAD}; text-align:left;">
        <span style="font-weight:bold; color:#4b5563;">${escapeEstimateHtml(sec.subLabel)}</span>
      </td>
      <td style="background:#fff; border-bottom:1px solid ${B_COL}; padding:${PAD}; text-align:right;">
        <span style="font-weight:bold; color:${C_TXT}; font-size:1.1em;">${fmt(sec.total)}</span>
      </td>`;
    body.appendChild(trSub);
  });

  // 합계
  if(foot) {
    // 라벨 생성
    const optVatVal = document.querySelector('input[name="optVatDisplay"]:checked')?.value || 'inc';
    const isCard = document.getElementById('chkCardPay')?.checked;
    const isAdvance = document.getElementById('payDuePre')?.checked;
    const vParts = [];
    if (optVatVal === 'inc') vParts.push('VAT 포함');
    else if (optVatVal === 'exc') vParts.push('VAT 별도');
    if (isCard) vParts.push('카드 수수료 포함');
    if (isAdvance) vParts.push('선금 할인 포함');
    const vLabel = vParts.length > 0 ? `(${vParts.join('/')})` : '';

    let html = `
      <tr style="background:#ffedd5; border-top:1px solid ${B_COL}; border-bottom:2px solid ${B_COL};">
        <td class="pc-only" colspan="${labelSpan}" style="padding:${PAD}; text-align:left;">
          <span style="font-weight:bold; font-size:1.0em; color:${C_TXT};">총 견적 합계</span>
          ${vLabel ? `<span style="font-weight:normal; font-size:0.8em; margin-left:4px;">${vLabel}</span>` : ''}
        </td>
        <td class="mobile-only" colspan="${labelSpan - 2}" style="padding:${PAD}; text-align:left;">
          <span style="font-weight:bold; font-size:1.0em; color:${C_TXT};">총 견적 합계</span>
          ${vLabel ? `<span style="font-weight:normal; font-size:0.8em; margin-left:4px;">${vLabel}</span>` : ''}
        </td>
        <td style="padding:${PAD}; text-align:right;">
          <span style="font-weight:bold; font-size:1.2em; color:${C_TXT};">${fmt(grandTotal)}</span>
        </td>
      </tr>
      <tr>
        <td class="pc-only" colspan="${totalCols}" style="padding: 6px 8px; text-align: left; font-size: 0.85em; color: #555; line-height: 1.4;">
          ${getFooterNoticeHtml()}
        </td>
        <td class="mobile-only" colspan="${totalCols - 2}" style="padding: 6px 8px; text-align: left; font-size: 0.85em; color: #555; line-height: 1.4;">
          ${getFooterNoticeHtml()}
        </td>
      </tr>`;
    foot.innerHTML = html;
  }

  setTimeout(() => {
    const isShowList = document.getElementById('chkShowListPrice')?.checked || false;
    const priceCols = isShowList ? [4, 5, 6] : [4, 5]; 
    autoShrinkTableColumns('#wrapPreview table', priceCols);
  }, 0);
}

