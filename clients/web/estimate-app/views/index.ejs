function cleanDisplayName(rawDisp,rawName){
  const base=String(rawDisp||rawName||'').trim();if(!base) return '';
  let s=base.replace(/[|·]+/g,' ').replace(/\s{2,}/g,' ').trim();
  s=s.replace(/[\x60\x7E!@#$%^&*_=+\\\[\]{};:'",<>\/\?|]/g,'').replace(/\s{2,}/g,' ').trim();
  return s;
}

// 상업 품목명에서 분류 키워드 제거
function stripCommKeywords(s, row){
  let t = String(s || '');
  const rm = [
    /DVM\s*S2/gi, /DVM/gi, /\bS2\b/gi,
    /실외기|실내기|전열\s*교환기|판넬|패널|DUCT/gi,
    /1\s*-?\s*Way|1WAY|2\s*Way|2Way|4\s*-?\s*Way|4Way|360\s*CST|CST/gi,
    /MINI/gi, /WIFI\s*내장|WIFI내장/gi, /미내장/gi, /UV-?C/gi,
    /프라임|고효율\s*한랭지|표준형|냉방전용|ECO\s*냉난방|ECO\s*냉방전용|ECO\s*리뉴얼/gi,
    /\bSET\b/gi
  ];
  rm.forEach(rx => { t = t.replace(rx, ''); });
  t = t.replace(/\s{2,}/g, ' ').trim();

  // 앞에 'S'만 남은 경우 제거
  t = t.replace(/^\s*S\s+(?=\S)/i, '');

  // 전체가 괄호로 둘러싸인 경우 괄호 제거: "(사각 WIFI)" → "사각 WIFI"
  t = t.replace(/^\s*\(([^)]*)\)\s*$/, '$1').trim();

  return t || String(s||'').trim();
}

function displayOverrides(s,scope){
