/* 상태적용 */
function applyBranchState(st){
  if(!st) return;

  const outs = document.querySelectorAll('.out-head').length;
  const inputStyle = 'width:90%; height:34px; text-align:center; border:1px solid #ccc; border-radius:3px; font-weight:bold; font-size:14px; box-sizing:border-box; background-color:#fff;';

  if(st.outOrder && st.outOrder.length > 0) {
    const table = document.querySelector('.branch-table');
    if(table) {
      const theadTr = table.querySelector('thead tr');
      const tbodyTrs = table.querySelectorAll('tbody tr');
      st.outOrder.forEach((outId) => {
        const ths = Array.from(theadTr.children);
        const th = ths.find(t => t.dataset.out === outId);
        if(th) theadTr.appendChild(th);

        tbodyTrs.forEach(tr => {
          const tds = Array.from(tr.children);
          const td = tds.find(t => t.querySelector(`[data-out="${outId}"]`));
          if(td) tr.appendChild(td);
        });
      });
    }
  }

  if(st.grid) {
    for(let i=1; i<=outs; i++){
      const list = st.grid[`out${i}`] || [];
      const slots = document.querySelectorAll(`.out-slot[data-out="out${i}"]`);
      slots.forEach((z, idx)=>{
        z.innerHTML = ''; 
        const v = list[idx];
        if(v && v.type === 'chip'){
          const chip = makeCapsule(v.model, v.cap, true);
          z.appendChild(chip);
          chip.querySelector('.btn-x').addEventListener('click', ()=>{
            const model = chip.dataset.model;
            const cap = parseInt(chip.dataset.cap||'0',10);
            chip.remove();
            packOutColumn(`out${i}`);
            pushBackToLeft(model, cap);
            repackLeft();
            updateBranchVisuals();
          });
        } else {
          const inputHTML = `<input type="number" class="cap-input" placeholder="" inputmode="numeric" style="${inputStyle}">`;
          z.innerHTML = inputHTML;
          const inpEl = z.querySelector('input');
          if(v && v.type === 'input' && inpEl) {
            inpEl.value = v.val; 
          }
        }
      });
    }
  }

  if (st.extras) {
    Object.entries(st.extras).forEach(([k, v]) => {
      const inp = document.querySelector(`#branchSummaryBar [data-k="${k}"] .extra-branch`);
      if (inp) inp.value = v || '';
    });
  }
  if (st.outNames) {
    Object.entries(st.outNames).forEach(([k, v]) => {
      const inp = document.querySelector(`.out-name-input[data-out="${k}"]`);
      if (inp) inp.value = v || '';
    });
  }
  wireBranchInput();
  updateBranchRatios();
  recomputeBranchCodes();
  saveBranchState();
}

/* 버튼갱신 */
function refreshBranchOpenButton(ctx){
  const mActive = (typeof window.mobileActive !== 'undefined') ? window.mobileActive : null;
  const sec = ctx || window.activeSector || mActive; 
  
  const btn = document.getElementById('btnOpenBranch');
  if(!btn) return;

  const isVisible = (sec === 'comm' || sec === 'branch');
  btn.style.display = isVisible ? 'inline-flex' : 'none';

  if(!isVisible) return;

  if(sec === 'branch'){
    btn.textContent = '상업멀티 보기';
    btn.disabled = false;
    btn.style.opacity = '1';
    btn.style.cursor = 'pointer';
    return;
  }

  btn.textContent = '분기계산';
  
  let hasOut = false;
  let hasIn = false;

  if(typeof commQty !== 'undefined' && typeof COMMULTI !== 'undefined'){
    for(const [model, q] of commQty){
      if(q > 0){
        const row = COMMULTI.find(r => r.model === model);
        if(row){
          const cat = (row.catL || row['대분류'] || '').trim();
          const m = String(row.model||'').trim();
          
          if(cat === '실외기') {
            hasOut = true;
          } else {
            const isIndoor = cat.includes('실내') || cat.includes('전열') || 
                             (/^AM\d{3}/i.test(m) && !cat.includes('패널') && !cat.includes('리모컨'));
            if(isIndoor) hasIn = true;
          }
        }
      }
      if(hasOut && hasIn) break; 
    }
  }

  const isActive = hasOut && hasIn;
  btn.disabled = !isActive;
  btn.style.opacity = isActive ? '1' : '0.5';
  btn.style.cursor = isActive ? 'pointer' : 'not-allowed';
}

function refreshBranchButton() {
  refreshBranchOpenButton();
}

