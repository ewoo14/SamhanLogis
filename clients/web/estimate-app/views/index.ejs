// 리사이즈
function updateSlipScale() {
    const wrapper = document.getElementById('slipViewWrapper');
    const scaleBox = document.getElementById('slipScaleBox');
    if (!wrapper || !scaleBox) return;

    const wrapperWidth = wrapper.clientWidth;
    const slipWidth = 794; 
    const padding = 20;

    let scale = Math.min(1, (wrapperWidth - padding) / slipWidth);
    
    scaleBox.style.transform = `scale(${scale})`;
    scaleBox.style.height = (1123 * scale) + 'px'; 
    scaleBox.style.width = slipWidth + 'px';
}

// 복사
async function handleSlipCopy() {
  document.getElementById('saveMenu')?.classList.add('hidden');
  if (!currentSlipData) return;
  
  const wrapper = document.createElement('div');
  wrapper.style.cssText = `
    position: fixed; top: 0; left: 0; width: 794px; min-height: 1123px;
    padding: 30px; background: white; font-family: 'NanumGothicBold', sans-serif;
    color: black; box-sizing: border-box; z-index: -9999;
  `;
  wrapper.innerHTML = getSlipInnerContent(currentSlipData);
  document.body.appendChild(wrapper);

  try {
    const canvas = await html2canvas(wrapper, { 
      scale: 2, 
      backgroundColor: '#ffffff', 
      scrollY: 0 
    });
    canvas.toBlob(async (blob) => {
      try {
        const item = new ClipboardItem({ "image/png": blob });
        await navigator.clipboard.write([item]);
        alert("클립보드에 복사되었습니다.");
        logAction('기능', '전표 복사');
      } catch(err) {
        alert("복사 실패");
      }
      document.body.removeChild(wrapper);
    });
  } catch(e) {
    document.body.removeChild(wrapper);
    alert('오류');
  }
}

// 저장
async function handleSlipSave(type) {
  document.getElementById('saveMenu')?.classList.add('hidden');
  if (!currentSlipData) return alert('데이터 없음');

  const wrapper = document.createElement('div');
  // 스타일
  wrapper.style.cssText = `
    position: fixed; top: 0; left: 0; width: 794px; min-height: 1123px;
    padding: 30px; background: white; font-family: 'NanumGothicBold', sans-serif;
    color: black; box-sizing: border-box; z-index: -9999;
  `;
  wrapper.innerHTML = getSlipInnerContent(currentSlipData);
  document.body.appendChild(wrapper);

  try {
    // 캔버스
    const canvas = await html2canvas(wrapper, { 
      scale: 2, 
      backgroundColor: '#ffffff', 
      scrollY: 0 
    });

    if (type === 'pdf') {
      // 이미지데이터
      const imgData = canvas.toDataURL('image/png');
      const { jsPDF } = window.jspdf;
      
      // 용지설정
      const doc = new jsPDF('p', 'mm', 'a4');
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();

      // 비율계산
      const imgWidth = canvas.width;
      const imgHeight = canvas.height;
      const widthRatio = pageWidth / imgWidth;
      const heightRatio = pageHeight / imgHeight;
      const ratio = Math.min(widthRatio, heightRatio);

      // 치수설정
      const finalWidth = imgWidth * ratio;
      const finalHeight = imgHeight * ratio;

      // 중앙정렬
      const x = (pageWidth - finalWidth) / 2;
      const y = (pageHeight - finalHeight) / 2;

      // 이미지추가
      doc.addImage(imgData, 'PNG', x, y, finalWidth, finalHeight);
      
      // 파일저장
      doc.save(`전표_${currentSlipData.date}.pdf`);

    } else {
      // 링크생성
      const link = document.createElement('a');
      link.download = `전표_${currentSlipData.date}.${type}`;
      link.href = canvas.toDataURL(`image/${type}`);
      link.click();
    }
    logAction('기능', '전표 ' + type.toUpperCase() + ' 저장');
  } catch(e) {
    alert('저장 중 오류가 발생했습니다.');
  } finally {
    // 정리
    document.body.removeChild(wrapper);
  }
}

/* 숫자 -> 한글 변환 */
function numberToKorean(num) {
  if (num == 0) return "영";
  const units = ["", "십", "백", "천"];
  const bigUnits = ["", "만", "억", "조", "경"];
  const nums = ["", "일", "이", "삼", "사", "오", "육", "칠", "팔", "구"];
  
  let result = "";
  let bigIndex = 0;
  
  while (num > 0) {
    let chunk = num % 10000;
    if (chunk > 0) {
      let chunkStr = "";
      let unitIndex = 0;
      while (chunk > 0) {
        let digit = chunk % 10;
        if (digit > 0) {
            if (digit === 1 && unitIndex > 0) {
                chunkStr = units[unitIndex] + chunkStr;
            } else {
                chunkStr = nums[digit] + units[unitIndex] + chunkStr;
            }
        }
        chunk = Math.floor(chunk / 10);
        unitIndex++;
      }
      result = chunkStr + bigUnits[bigIndex] + result;
    }
    num = Math.floor(num / 10000);
    bigIndex++;
  }
  return result;
}

