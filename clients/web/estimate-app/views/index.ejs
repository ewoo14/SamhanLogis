// 추천실외기 계산
function calcRecommendOdu(cap, array) {
  // 기본
  var res = 0;
  
  // 반복
  for (var i = 0; i < array.length; i++) {
    if (cap >= array[i].cap) {
      res = array[i].hp;
    } else {
      break;
    }
  }
  return res;
}

/* 키보드대응 */
function initKeyboardFix() {
  // 기기판별
  const isMobileDevice = /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);
  
  // 실행중지
  if (!isMobileDevice) return; 

  let baseW = window.innerWidth;
  let baseH = window.innerHeight;
  
  window.addEventListener('resize', () => {
    // 가로변경
    if (window.innerWidth !== baseW) {
      baseW = window.innerWidth;
      baseH = window.innerHeight;
      document.body.classList.remove('kbd-up');
    } 
    // 세로축소
    else if (window.innerWidth <= 1280) {
      if (window.innerHeight < baseH - 100) {
        document.body.classList.add('kbd-up');
      } else {
        document.body.classList.remove('kbd-up');
        baseH = window.innerHeight;
      }
    }
  });
}
window.addEventListener('DOMContentLoaded', initKeyboardFix);

// 다중셀선택
document.addEventListener('DOMContentLoaded', () => {

  // 스타일주입
  const style = document.createElement('style');
  style.innerHTML = `
    .top .title { font-size: 0px !important; color: transparent !important; }
    .top .title .badge { font-size: 13px !important; color: initial !important; margin-left: 5px; }
    #cardOrderInfo .card-title,
    #cardPreview #previewTitleTxt,
    #cardFinal .card-title {
      display: none !important;
    }
  `;
  document.head.appendChild(style);

  // 배지생성
  let sumBadge = document.getElementById('selectedCellSumBadge');
  if (!sumBadge) {
    sumBadge = document.createElement('span');
    sumBadge.id = 'selectedCellSumBadge';
    sumBadge.className = 'badge';
    sumBadge.style.cssText = 'display:none; background:#ffedd5; color:#c2410c; margin-left:5px; font-size:12px;';
  }

  // 화면유지
  window.forceOrderTitle = function() {
    const t = document.querySelector('.title');
    if (!t) return;
    
    t.style.display = 'flex';
    t.style.alignItems = 'center';

    const cntBadge = document.getElementById('selectedCount');
    const sBadge = document.getElementById('selectedCellSumBadge') || sumBadge;
    const rateBadge = document.getElementById('selectedRateBadge');
    
    Array.from(t.childNodes).forEach(n => {
      if (n.nodeType === Node.TEXT_NODE) n.nodeValue = '';
    });
    t.insertBefore(document.createTextNode('종합견적서'), t.firstChild);

    if (cntBadge && !t.contains(cntBadge)) t.appendChild(cntBadge);
    if (sBadge && !t.contains(sBadge)) t.appendChild(sBadge);
    if (rateBadge && !t.contains(rateBadge)) t.appendChild(rateBadge);
  };
  window.forceOrderTitle();

  let isDragging = false;
  let startCell = null;
  let selectedCells = [];

  // 합계산출
  function updateCellSelectionSum() {
    let sum = 0;
    let hasNum = false;
    
    if (typeof selectedCells !== 'undefined') {
      selectedCells.forEach(td => {
        let val = typeof getCellValue === 'function' ? getCellValue(td) : td.textContent;
        if (val) {
          val = String(val).replace(/,/g, '').trim();
          if (val !== '' && !isNaN(Number(val))) {
            sum += Number(val);
            hasNum = true;
          }
        }
      });
    }

    const badge = document.getElementById('selectedCellSumBadge');
    if (badge) {
      badge.style.display = (hasNum && selectedCells.length > 0) ? 'inline-flex' : 'none';
      badge.style.alignItems = 'center';
      badge.style.justifyContent = 'center';
      badge.style.height = '26px';
      badge.style.boxSizing = 'border-box';
      badge.style.verticalAlign = 'middle';
      badge.style.lineHeight = '1';
      badge.style.padding = '0 8px';
      
      if (hasNum && selectedCells.length > 0) {
        badge.textContent = '합계 : ' + sum.toLocaleString('ko-KR');
      }
    }
  }

  // 선택초기화
  function clearSelection() {
    selectedCells.forEach(td => td.classList.remove('cell-selected'));
    selectedCells = [];
    startCell = null;
    updateCellSelectionSum();
  }

  // 그리드생성
  function getTrueMatrix(table) {
    const matrix = [];
    const visibleRows = Array.from(table.rows).filter(tr => 
      tr.offsetWidth > 0 && tr.offsetHeight > 0 && tr.style.display !== 'none'
    );

    for (let i = 0; i < visibleRows.length; i++) matrix.push([]);
    
    for (let r = 0; r < visibleRows.length; r++) {
      let c = 0;
      for (let j = 0; j < visibleRows[r].cells.length; j++) {
        const td = visibleRows[r].cells[j];
        
        if (td.offsetWidth === 0 || td.offsetHeight === 0 || td.style.display === 'none') continue;

        while (matrix[r][c]) c++;
        
        const rowSpan = td.rowSpan || 1;
        const colSpan = td.colSpan || 1;
        
        for (let rr = 0; rr < rowSpan; rr++) {
          for (let cc = 0; cc < colSpan; cc++) {
            if (matrix[r + rr]) matrix[r + rr][c + cc] = td;
          }
        }
      }
    }
    return matrix;
  }

  // 좌표계산
  function getCellPos(td) {
    const table = td.closest('table');
    if (!table) return null;
    const matrix = getTrueMatrix(table);
    let minR = Infinity, minC = Infinity, maxR = -1, maxC = -1;
    for (let r = 0; r < matrix.length; r++) {
      for (let c = 0; c < matrix[r].length; c++) {
        if (matrix[r][c] === td) {
          if (r < minR) minR = r;
          if (r > maxR) maxR = r;
          if (c < minC) minC = c;
          if (c > maxC) maxC = c;
        }
      }
    }
    if (minR === Infinity) return null;
    return { minR, maxR, minC, maxC, table, matrix };
  }

  // 범위선택
  function selectCells(td1, td2) {
    if (!td1 || !td2) return;
    const pos1 = getCellPos(td1);
    const pos2 = getCellPos(td2);
    if (!pos1 || !pos2 || pos1.table !== pos2.table) return;

    selectedCells.forEach(td => td.classList.remove('cell-selected'));
    selectedCells = [];

    const boxMinR = Math.min(pos1.minR, pos2.minR);
    const boxMaxR = Math.max(pos1.maxR, pos2.maxR);
    const boxMinC = Math.min(pos1.minC, pos2.minC);
    const boxMaxC = Math.max(pos1.maxC, pos2.maxC);

    const matrix = pos1.matrix;
    for (let r = boxMinR; r <= boxMaxR; r++) {
      for (let c = boxMinC; c <= boxMaxC; c++) {
        const cell = matrix[r][c];
        if (cell && cell.offsetWidth > 0 && cell.offsetHeight > 0 && cell.style.display !== 'none') {
          if (!selectedCells.includes(cell)) {
            cell.classList.add('cell-selected');
            selectedCells.push(cell);
          }
        }
      }
    }
    updateCellSelectionSum();
  }

  // 값추출
  function getCellValue(td) {
    const inp = td.querySelector('input:not([type="hidden"])');
    if (inp) return inp.value;
    const sel = td.querySelector('select');
    if (sel) return sel.options[sel.selectedIndex]?.text || '';
    const text = td.innerText.trim();
    return text.split(/\r?\n/)[0].trim();
  }

  // 값입력
  function setCellValue(td, val) {
    if (val === undefined || val === null) return;
    const cleanVal = String(val).trim();
    const inp = td.querySelector('input:not([type="hidden"])');
    if (inp) {
      inp.value = cleanVal;
      inp.dispatchEvent(new Event('input', { bubbles: true }));
      inp.dispatchEvent(new Event('change', { bubbles: true }));
      return;
    }
    const sel = td.querySelector('select');
    if (sel) {
      Array.from(sel.options).forEach((opt, idx) => {
        if (opt.text === cleanVal || opt.value === cleanVal) sel.selectedIndex = idx;
      });
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      return;
    }
    if (!td.firstElementChild || td.classList.contains('model')) {
      td.innerText = cleanVal;
    }
  }

  // 드래그시작
  document.addEventListener('mousedown', (e) => {
    const td = e.target.closest('td');
    const table = td?.closest('table.est-table, #wrapPreview table, #wrapFinal table, .branch-table, #branchTable, #branchModal table, #branchArea table');
    
    if (table && td) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'BUTTON' || td.classList.contains('drag-handle')) {
         if(!selectedCells.includes(td)) clearSelection();
         return;
      }
      if (e.button !== 0) return; 
      e.preventDefault(); 

      if (e.ctrlKey || e.metaKey) {
        // 핀셋선택
        isDragging = false;
        if (selectedCells.includes(td)) {
          td.classList.remove('cell-selected');
          selectedCells = selectedCells.filter(cell => cell !== td);
        } else {
          td.classList.add('cell-selected');
          selectedCells.push(td);
          startCell = td;
        }
        updateCellSelectionSum();
      } else if (e.shiftKey) {
        // 범위선택
        isDragging = false; 
        if (startCell) {
          selectCells(startCell, td);
        } else {
          startCell = td;
          selectCells(startCell, startCell);
        }
      } else {
        // 일반선택
        isDragging = true;
        startCell = td;
        selectCells(startCell, startCell);
      }
    } else {
      if (!e.target.closest('.cell-selected')) clearSelection();
    }
  });

  // 드래그진행
  document.addEventListener('mouseover', (e) => {
    if (!isDragging) return;
    const td = e.target.closest('td');
    if (td && startCell) {
      const table = td.closest('table');
      if (table && table === startCell.closest('table')) {
        selectCells(startCell, td);
      }
    }
  });

  // 드래그종료
  document.addEventListener('mouseup', () => { 
    isDragging = false; 
    updateCellSelectionSum();
  });

  // 데이터수정
  document.addEventListener('input', (e) => {
    if (selectedCells.length > 0 && selectedCells.some(td => td.contains(e.target))) {
      updateCellSelectionSum();
    }
    if (e.target && ['home_rate', 'comm_rate', 'old_rate'].includes(e.target.id)) {
      if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
    }
  });

  // 키보드조작
  document.addEventListener('keydown', async (e) => {
    if (selectedCells.length === 0) return;

    if (e.key === 'Delete' || e.key === 'Backspace') {
      if (document.activeElement && document.activeElement.tagName === 'INPUT' && selectedCells.length <= 1) return;
      e.preventDefault();
      selectedCells.forEach(td => {
        const inp = td.querySelector('input:not([type="hidden"])');
        if (inp) {
          inp.value = '';
          inp.dispatchEvent(new Event('input', { bubbles: true }));
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        }
        const sel = td.querySelector('select');
        if (sel) {
          sel.selectedIndex = 0;
          sel.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
      updateCellSelectionSum();
      return;
    }

    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'c') {
      // 복사대상확인
      let targets = selectedCells;
      if (document.activeElement && document.activeElement.tagName === 'INPUT') {
        if (document.activeElement.selectionStart !== document.activeElement.selectionEnd) return;
        if (targets.length === 0) {
          const td = document.activeElement.closest('td');
          if (td) targets = [td];
        }
      }
      if (targets.length === 0) return;
      
      e.preventDefault();
      const posArr = targets.map(td => getCellPos(td)).filter(Boolean);
      if (!posArr.length) return;
      
      let minR = Math.min(...posArr.map(p => p.minR));
      let maxR = Math.max(...posArr.map(p => p.maxR));
      let minC = Math.min(...posArr.map(p => p.minC));
      let maxC = Math.max(...posArr.map(p => p.maxC));
      
      const matrix = posArr[0].matrix;
      const rows = [];
      const handled = new Set();
      
      for (let r = minR; r <= maxR; r++) {
         const row = [];
         let hasCell = false;
         for (let c = minC; c <= maxC; c++) {
            const cell = matrix[r][c];
            if (cell && targets.includes(cell) && !handled.has(cell)) {
               row.push(getCellValue(cell));
               handled.add(cell);
               hasCell = true;
            } else {
               row.push('');
            }
         }
         if(hasCell) rows.push(row.join('\t')); 
      }
      const textToCopy = rows.join('\n'); 
      
      try {
        await navigator.clipboard.writeText(textToCopy);
      } catch (err) {
        const textArea = document.createElement("textarea");
        textArea.value = textToCopy;
        document.body.appendChild(textArea);
        textArea.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(textArea);
      }
    }
  });

  // 데이터붙여넣기
  document.addEventListener('paste', (e) => {
    // 붙여넣기대상확인
    let targets = selectedCells;
    if (targets.length === 0 && document.activeElement && document.activeElement.tagName === 'INPUT') {
      const td = document.activeElement.closest('td');
      if (td) targets = [td];
    }
    if (targets.length === 0) return;

    const text = (e.clipboardData || window.clipboardData).getData('text');
    if (!text) return;

    const isMultiData = text.includes('\t') || text.includes('    ') || text.includes('\n');
    if (targets.length <= 1 && !isMultiData && document.activeElement && document.activeElement.tagName === 'INPUT') {
      return; 
    }

    e.preventDefault(); 
    const rows = text.split(/\r?\n/).map(row => row.split(/\t|    /));
    const startPos = getCellPos(targets[0]);
    if (!startPos) return;

    const matrix = startPos.matrix;
    let currentR = Math.min(...targets.map(td => getCellPos(td).minR));
    let startC = Math.min(...targets.map(td => getCellPos(td).minC));
    const handledPaste = new Set();

    for (let i = 0; i < rows.length; i++) {
       if (rows[i].length === 1 && rows[i][0] === '') continue; 
       
       while (currentR < matrix.length) {
          if (matrix[currentR].some(c => c && c.offsetWidth > 0)) break;
          currentR++;
       }
       if (currentR >= matrix.length) break;

       let currentC = startC;
       for (let j = 0; j < rows[i].length; j++) {
          while (currentC < matrix[currentR].length) {
              const cell = matrix[currentR][currentC];
              if (!cell || cell.offsetWidth === 0) currentC++;
              else break;
          }
          if (currentC < matrix[currentR].length) {
             const cell = matrix[currentR][currentC];
             if (cell && !handledPaste.has(cell)) {
                 setCellValue(cell, rows[i][j]);
                 handledPaste.add(cell);
             }
             currentC++;
          }
       }
       currentR++;
    }
    updateCellSelectionSum();
  });
});

