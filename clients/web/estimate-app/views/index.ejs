        sec.rows.forEach(r => {
          const bgColor = typeof getQuoteItemBgColor === 'function' ? getQuoteItemBgColor(r, sec.id) : '';
          const bgStyle = bgColor ? ' background-color:' + bgColor + ' !important; -webkit-print-color-adjust: exact; color-adjust: exact;' : '';
          const tr = document.createElement('tr');
