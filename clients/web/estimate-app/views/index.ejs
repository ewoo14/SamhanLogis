// 모달 안에 주소 시트 만들기
function mountAddrSheet(){
  const dlg = el('#pageOrderInfo');
  const modal = dlg?.querySelector('.modal');
  if (!modal) return null;

  // 이전 시트 제거
  const old = modal.querySelector('#addrSheet')
  if(old) old.remove()

  // 시트 루트
  const sheet = document.createElement('div')
  sheet.id = 'addrSheet'
  sheet.style.position = 'absolute'
  sheet.style.inset = '0'
  sheet.style.zIndex = '1000'
  sheet.style.background = '#fff'
  sheet.style.display = 'flex'
  sheet.style.flexDirection = 'column'

  // 헤더
  const bar = document.createElement('div')
  bar.style.display = 'flex'
  bar.style.alignItems = 'center'
  bar.style.justifyContent = 'space-between'
  bar.style.padding = '10px'
  bar.style.borderBottom = '1px solid #000'
  const title = document.createElement('strong')
  title.textContent = '주소 검색'
  const close = document.createElement('button')
  close.className = 'btn btn-ghost'
  close.textContent = '닫기'
  bar.appendChild(title)
  bar.appendChild(close)

  // 임베드 컨테이너
  const wrap = document.createElement('div')
  wrap.id = 'addrEmbedInDialog'
  wrap.style.width = '100%'
  wrap.style.flex = '1'
  wrap.style.minHeight = '320px'

  // 합체
  sheet.appendChild(bar)
  sheet.appendChild(wrap)
  modal.appendChild(sheet)

  // 높이 계산
  const fit = ()=>{
    const modalH = modal.getBoundingClientRect().height
    const barH = bar.getBoundingClientRect().height
    const h = Math.max(360, Math.floor(modalH - barH))
    wrap.style.height = h + 'px'
  }
  fit()
  window.addEventListener('resize', fit, { passive:true })
  window.addEventListener('orientationchange', fit, { passive:true })

  // 닫기 핸들러
  close.onclick = ()=>{
    sheet.remove()
  }

  return { sheet, wrap, fit }
}

