document.addEventListener('click', e => {
  // 구성품 보기/닫기 토글
  if(e.target.classList.contains('toggle-comp-comm') || e.target.classList.contains('toggle-comp-single')) {
      const isComm = e.target.classList.contains('toggle-comp-comm');
      const id = isComm ? e.target.dataset.m : e.target.dataset.id;
      const mainTr = e.target.closest('tr');
      const selector = isComm ? `.set-part[data-part-of="${CSS.escape(id)}"]` : `.set-part-single[data-part-of="${CSS.escape(id)}"]`;
      const parts = document.querySelectorAll(selector);
      
      if(parts.length === 0) return;
      
      const isHidden = parts[0].style.display === 'none';
      const diff = isHidden ? parts.length : -parts.length;
      
      parts.forEach(p => p.style.display = isHidden ? '' : 'none');
      
      // 밀림 방지 rowspan 동적 수정
      adjustRowSpans(mainTr, diff);
      
      e.target.textContent = isHidden ? '닫기' : '보기';
      e.target.style.background = isHidden ? '#374151' : '';
      e.target.style.color = isHidden ? '#fff' : '';
  }
});

document.addEventListener('input', e => {
  const target = e.target;

  const updateSpan = (el, val) => {
      const span = el.closest('td')?.querySelector('.val-for-text');
      if(span) span.textContent = val;
  };

  // 세트행 수량 동기화
  if (target.classList.contains('qty-input') && !target.classList.contains('part-qty-single') && !target.classList.contains('part-qty-comm')) {
      const tr = target.closest('tr');
      const isComm = tr.closest('tbody')?.id === 'commBody';
      const isSingle = tr.closest('tbody')?.id === 'singleBody';
      
      if (isComm || isSingle) {
          const setModel = isComm ? tr.dataset.m : tr.dataset.id;
          const setQty = parseInt(target.value || '0', 10);
          const selector = isComm ? `.set-part[data-part-of="${CSS.escape(setModel)}"]` : `.set-part-single[data-part-of="${CSS.escape(setModel)}"]`;
          
          let activeModels = null;
          if (isSingle) {
            const sObj = SINGLE_SETS.find(x => String(x.id) === String(setModel));
            if (sObj && typeof explodeSetParts === 'function') {
              const activeParts = explodeSetParts(sObj, 1, 0);
              activeModels = new Set(activeParts.map(ap => (ap.model || ap.name || '').trim()));
            }
          }

          document.querySelectorAll(selector).forEach(ptr => {
            const qtyInp = ptr.querySelector('.part-qty-comm, .part-qty-single');
            if (qtyInp) {
              const pModel = ptr.getAttribute('data-m');
              const pKeyStr = `${setModel}|${pModel}`;
              const isManual = isSingle 
                ? (typeof singleCustomPartQtys !== 'undefined' && singleCustomPartQtys.has(pKeyStr))
                : (typeof commCustomPartQtys !== 'undefined' && commCustomPartQtys.has(pKeyStr));

              const defQ = parseFloat(qtyInp.dataset.def || '1');
              let newCompQty = Math.floor(setQty * defQ);
              
              if (isSingle && activeModels) {
                if (!activeModels.has(pModel)) {
                  newCompQty = 0;
                }
              }

              if (isManual) {
                newCompQty = isSingle ? singleCustomPartQtys.get(pKeyStr) : commCustomPartQtys.get(pKeyStr);
              }

              if (!isManual) {
                qtyInp.value = newCompQty || '';
                qtyInp.setAttribute('value', newCompQty || '');
                updateSpan(qtyInp, newCompQty || 0);
              }

              const pNode = ptr.querySelector('.price-input');
              const pUnit = parseInt(pNode ? pNode.value.replace(/[^0-9]/g, '') : '0', 10);
              const compSub = newCompQty * pUnit;
              
              const subCell = ptr.querySelector('.sub');
              if(subCell) {
                  subCell.childNodes[0].nodeValue = fmt(compSub);
                  updateSpan(subCell, compSub);
              }
            }
          });
      }
  }

  const isPartQty = target.classList.contains('part-qty-single') || target.classList.contains('part-qty-comm');
  const isPartPrice = target.classList.contains('part-price-single') || target.classList.contains('part-price-comm');
  const isPartList = target.classList.contains('list-price-input');

  if (isPartList) {
      target.setAttribute('value', target.value);
      updateSpan(target, target.value.replace(/[^0-9]/g, '') || '0');
  }

  // 구성품 수정에 따른 세트 단가/견적서 데이터 동기화
  if (isPartQty || isPartPrice) {
      const isComm = target.classList.contains('part-qty-comm') || target.classList.contains('part-price-comm');
      const setModel = target.dataset.set;
      const partModel = target.dataset.part;
      const tr = target.closest('tr');
      
      if (isPartQty) {
         target.setAttribute('value', target.value);
         updateSpan(target, target.value || '0');
      }
      if (isPartPrice) {
         target.setAttribute('value', target.value);
         updateSpan(target, target.value.replace(/[^0-9-]/g, '') || '0');
      }

      const qtyNode = tr.querySelector('.part-qty-comm, .part-qty-single');
      const partQtyVal = parseInt(qtyNode?.value || '0', 10);
      
      const priceNode = tr.querySelector('.price-input');
      const unit = parseInt(priceNode ? priceNode.value.replace(/[^0-9-]/g, '') : '0', 10);
      
      const subCell = tr.querySelector('.sub');
      if(subCell) {
          subCell.childNodes[0].nodeValue = fmt(unit * partQtyVal);
          updateSpan(subCell, unit * partQtyVal);
      }

      const selector = isComm ? `.set-part[data-part-of="${CSS.escape(setModel)}"]` : `.set-part-single[data-part-of="${CSS.escape(setModel)}"]`;
      let pos = [];
      let neg = [];
      let sumSub = 0;
      
      document.querySelectorAll(selector).forEach(ptr => {
        const pq = parseInt(ptr.querySelector('.part-qty-comm, .part-qty-single')?.value || '0', 10);

        if (pq > 0) pos.push(pq);
        else if (pq < 0) neg.push(pq);
        
        const pUnitStr = ptr.querySelector('.price-input')?.value.replace(/[^0-9-]/g, '') || '0';
        sumSub += (pq * parseInt(pUnitStr, 10));
      });
      
      let maxQty = 0;
      if (pos.length > 0) {
        maxQty = Math.max(...pos);
      } else if (neg.length > 0) {
        maxQty = Math.min(...neg);
      }

      const mainTbody = document.getElementById(isComm ? 'commBody' : 'singleBody');
      const mainTr = mainTbody.querySelector(isComm ? `tr[data-m="${CSS.escape(setModel)}"]` : `tr[data-id="${CSS.escape(setModel)}"]`);

      if (mainTr) {
          const mainQtyNode = mainTr.querySelector('.qty-input:not(.part-qty-comm):not(.part-qty-single)');
          
          if (mainQtyNode) {
              const isMainManual = mainQtyNode.style.fontWeight === 'bold' || mainQtyNode.style.fontWeight === '700' || mainQtyNode.style.color === 'rgb(37, 99, 235)' || mainQtyNode.style.color === '#2563eb';
              let effQty = maxQty;
              
              if (!isMainManual && maxQty !== 0) {
                  // 자동갱신
                  mainQtyNode.value = maxQty || '';
                  mainQtyNode.setAttribute('value', maxQty || '');
                  
                  if (isComm && typeof commQty !== 'undefined') commQty.set(setModel, maxQty);
                  if (!isComm && typeof singleQty !== 'undefined') singleQty.set(setModel, maxQty);
              } else if (isMainManual) {
                  // 수동유지
                  const rawMain = mainQtyNode.value.replace(/[^0-9-]/g, '');
                  effQty = rawMain === '' ? 0 : parseInt(rawMain, 10);
              }
              
              if (effQty !== 0) {
                  const newUnitPrice = Math.round(sumSub / effQty);
                  const priceInp = mainTr.querySelector('.price-input');
                  if (priceInp) {
                      priceInp.value = newUnitPrice.toLocaleString('ko-KR');
                      priceInp.setAttribute('value', priceInp.value);
                      priceInp.style.color = '#2563eb';
                      priceInp.style.fontWeight = 'bold';
                      
                      if (isComm && typeof commCustomPrices !== 'undefined') commCustomPrices.set(setModel, newUnitPrice);
                      if (!isComm && typeof singleCustomPrices !== 'undefined') singleCustomPrices.set(setModel, newUnitPrice);
                  }
                  
                  const mainSubCell = mainTr.querySelector(isComm ? '[data-csub]' : '[data-ss]');
                  if (mainSubCell) {
                      if (mainSubCell.querySelector('span')) {
                          mainSubCell.childNodes[0].nodeValue = fmt(sumSub);
                          updateSpan(mainSubCell, sumSub);
                      } else {
                          mainSubCell.textContent = fmt(sumSub);
                      }
                  }
              }

              // 배열갱신
              const effectiveMainQty = effQty !== 0 ? effQty : 1;
              if (isPartQty && partModel) {
                  if (isComm && typeof COMM_PARTS !== 'undefined') {
                      COMM_PARTS.forEach(cp => {
                          if ((cp.refModel === setModel || cp.setModel === setModel) && cp.model === partModel) {
                              cp.qty = partQtyVal / effectiveMainQty; 
                          }
                      });
                  }
                  if (!isComm && typeof SINGLE_PARTS !== 'undefined') {
                      SINGLE_PARTS.forEach(sp => {
                          if ((sp.refId === setModel || sp.refModel === setModel) && sp.model === partModel) {
                              sp.qty = partQtyVal / effectiveMainQty;
                              sp.defaultQty = partQtyVal / effectiveMainQty;
                          }
                      });
                  }
              }
          }
      }
      
      if (isComm && typeof syncCommTotals === 'function') syncCommTotals();
      if (!isComm && typeof updateInlineTotals === 'function') updateInlineTotals();
      if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
  }
});

// 콤마 적용 포맷 핸들러 교체
document.addEventListener('focusout', e => {
  if (e.target.classList.contains('part-price-single') || e.target.classList.contains('part-price-comm') || e.target.classList.contains('list-price-input')) {
    const val = e.target.value.replace(/[^0-9-]/g, '');
    if(val && val !== '-') {
      e.target.value = parseInt(val, 10).toLocaleString('ko-KR');
          e.target.setAttribute('value', e.target.value);
          let span = e.target.closest('td')?.querySelector('.val-for-text');
          if(span) span.textContent = val;
      } else {
          e.target.value = '';
          e.target.setAttribute('value', '');
          let span = e.target.closest('td')?.querySelector('.val-for-text');
          if(span) span.textContent = '0';
      }
  }
});

// 셀 밀림 동적 보정
function adjustRowSpans(tr, diff) {
  let curr = tr;
  let foundL = false, foundM = false, foundS = false;
  
  while (curr && (!foundL || !foundM || !foundS)) {
      // 구성품 행은 건너뜀
      if (curr.classList.contains('set-part') || curr.classList.contains('set-part-single')) {
          curr = curr.previousElementSibling;
          continue;
      }
      if (!foundL && curr.querySelector('.colL')) {
          curr.querySelector('.colL').rowSpan += diff;
          foundL = true;
      }
      if (!foundM && curr.querySelector('.colM')) {
          curr.querySelector('.colM').rowSpan += diff;
          foundM = true;
      }
      if (!foundS && curr.querySelector('.colS')) {
          curr.querySelector('.colS').rowSpan += diff;
          foundS = true;
      }
      curr = curr.previousElementSibling;
  }
}

