// 합산역산
function syncSetPriceFromParts(setId, isSingle) {
  let totalSum = 0;
  
  // 구성품조회
  const parts = document.querySelectorAll(`tr[data-part-of="${CSS.escape(setId)}"]`);
  if (!parts.length) return;

  parts.forEach(ptr => {
    // 단가확인
    const pInp = ptr.querySelector('.price-input');
    let pUnit = 0;
    if (pInp) {
      pUnit = parseInt(pInp.value.replace(/[^0-9-]/g, '') || '0', 10);
    } else {
      const pCell = ptr.querySelector('.price');
      if (pCell) pUnit = parseInt(pCell.textContent.replace(/[^0-9]/g, '') || '0', 10);
    }

    // 수량확인
    let pQty = 0;
    const qInp = ptr.querySelector(isSingle ? '.part-qty-single' : '.part-qty-comm');
    if (qInp) {
      pQty = parseInt(qInp.value.replace(/[^0-9-]/g, '') || '0', 10);
    } else {
      const qSpan = ptr.querySelector('.val-for-text');
      if (qSpan) pQty = parseInt(qSpan.textContent || '0', 10);
    }
    
    totalSum += (pUnit * pQty);
  });

  // 메인행검색
  let setRow = document.querySelector(isSingle 
    ? `#singleBody tr[data-id="${CSS.escape(setId)}"], #singleBody tr[data-m="${CSS.escape(setId)}"]` 
    : `#commBody tr[data-setModel="${CSS.escape(setId)}"], #commBody tr[data-m="${CSS.escape(setId)}"]`);
  
  if (setRow) {
    const setQtyInp = setRow.querySelector('.qty-input');
    const setQty = parseInt(setQtyInp ? setQtyInp.value.replace(/[^0-9-]/g, '') : '0', 10);
    
    if (setQty !== 0) {
      // 단가소계갱신
      const newUnit = Math.floor(totalSum / setQty);
      const priceInp = setRow.querySelector('.price-input');
      
      if (priceInp) {
        priceInp.value = typeof fmt === 'function' ? fmt(newUnit) : newUnit.toLocaleString();
        
        // 단가저장
        if (isSingle && typeof singleCustomPrices !== 'undefined') singleCustomPrices.set(setId, newUnit);
        if (!isSingle && typeof commCustomPrices !== 'undefined') commCustomPrices.set(setId, newUnit);
      }
      
      const subCell = setRow.querySelector('.sub, [data-csub]');
      if (subCell) {
        if (subCell.childNodes.length > 0 && subCell.childNodes[0].nodeType === 3) {
          subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(totalSum) : totalSum.toLocaleString();
        } else {
          subCell.textContent = typeof fmt === 'function' ? fmt(totalSum) : totalSum.toLocaleString();
        }
      }
    }
  }
}

// 수량동기화
document.addEventListener('change', function(e) {
  if (e.target.classList.contains('qty-input') && !e.target.classList.contains('fix-dc-inp')) {
    const raw = e.target.value.replace(/[^0-9-]/g, '');
    const isCleared = (raw === '');
    const val = isCleared ? 0 : parseInt(raw, 10);

    // 싱글중대형
    if (e.target.classList.contains('part-qty-single')) {
      const setId = e.target.getAttribute('data-set');
      const partId = e.target.getAttribute('data-part');
      const key = setId + '|' + partId;
      
      if (isCleared) {
         singleCustomPartQtys.delete(key);
         const defQ = parseInt(e.target.getAttribute('data-def') || '1', 10);
         const setQty = singleQty.get(setId) || 0;
         const effQ = setQty * defQ;
         e.target.value = effQ ? String(effQ) : '';
         if(e.target.parentElement.nextElementSibling) e.target.parentElement.nextElementSibling.textContent = effQ;
      } else {
         singleCustomPartQtys.set(key, val);
         if(e.target.parentElement.nextElementSibling) e.target.parentElement.nextElementSibling.textContent = val;
      }
      
      const tr = e.target.closest('tr');
      if (tr) {
        const priceInp = tr.querySelector('.price-input');
        const pVal = priceInp ? parseInt(priceInp.value.replace(/[^0-9-]/g,'')||'0', 10) : 0;
        const subCell = tr.querySelector('.sub');
        const finalQ = isCleared ? (singleQty.get(setId) || 0) * parseInt(e.target.getAttribute('data-def') || '1', 10) : val;
        if(subCell) {
          subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(finalQ * pVal) : (finalQ * pVal).toLocaleString();
        }
      }
      
      // 역산실행
      syncSetPriceFromParts(setId, true);

      if (typeof updateInlineTotals === 'function') updateInlineTotals();
      if (typeof syncSingleTotals === 'function') syncSingleTotals();
    }
    
    // 상업멀티
    else if (e.target.classList.contains('part-qty-comm')) {
      const setId = e.target.getAttribute('data-set');
      const partId = e.target.getAttribute('data-part');
      const key = setId + '|' + partId;
      
      if (isCleared) {
         commCustomPartQtys.delete(key);
         const defQ = parseInt(e.target.getAttribute('data-def') || '1', 10);
         const setQty = commQty.get(setId) || 0;
         const effQ = setQty * defQ;
         e.target.value = effQ ? String(effQ) : '';
         if(e.target.parentElement.nextElementSibling) e.target.parentElement.nextElementSibling.textContent = effQ;
      } else {
         commCustomPartQtys.set(key, val);
         if(e.target.parentElement.nextElementSibling) e.target.parentElement.nextElementSibling.textContent = val;
      }
      
      const tr = e.target.closest('tr');
      if (tr) {
        const priceInp = tr.querySelector('.price-input');
        const pVal = priceInp ? parseInt(priceInp.value.replace(/[^0-9-]/g,'')||'0', 10) : 0;
        const subCell = tr.querySelector('.sub, [data-csub]');
        const finalQ = isCleared ? (commQty.get(setId) || 0) * parseInt(e.target.getAttribute('data-def') || '1', 10) : val;
        if(subCell) {
          if (subCell.childNodes.length > 0 && subCell.childNodes[0].nodeType === 3) {
            subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(finalQ * pVal) : (finalQ * pVal).toLocaleString();
          } else {
            subCell.textContent = typeof fmt === 'function' ? fmt(finalQ * pVal) : (finalQ * pVal).toLocaleString();
          }
        }
      }

      // 역산실행
      syncSetPriceFromParts(setId, false);

      if (typeof updateInlineTotals === 'function') updateInlineTotals();
      if (typeof syncCommTotals === 'function') syncCommTotals();
    }
  }
});

// 자동축소
function autoShrinkTableColumns(tableSelector, colIndices) {
  const table = document.querySelector(tableSelector);
  if (!table) return;

  const rows = table.querySelectorAll('tbody tr, tfoot tr');
  rows.forEach(row => {
    colIndices.forEach(idx => {
      const td = row.children[idx]; 
      if (!td || !td.textContent.trim()) return;
      if (td.querySelector('.auto-shrink')) return;

      const text = td.innerHTML; 
      td.innerHTML = `<span class="auto-shrink" style="display:inline-block; white-space:nowrap;">${text}</span>`;
      
      const span = td.querySelector('.auto-shrink');
      const cs = window.getComputedStyle(td);
      let fs = parseFloat(cs.fontSize) || 12;
      span.style.fontSize = fs + 'px';
      
      const padding = parseFloat(cs.paddingLeft || 0) + parseFloat(cs.paddingRight || 0);
      const availWidth = td.clientWidth - padding - 2; 
      
      while (span.offsetWidth > availWidth && fs > 6) {
        fs -= 0.5;
        span.style.fontSize = fs + 'px';
      }
    });
  });
}

