const origInpDesc = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value');
if (origInpDesc) {
    Object.defineProperty(HTMLInputElement.prototype, 'value', {
        get: origInpDesc.get,
        set: function(val) {
            // 식별자추가
            const m = this.dataset.m || this.dataset.model || this.dataset.id || this.dataset.sid || this.dataset.idx || this.dataset.part;
            if (m) {
                const setModel = this.dataset.set;
                let key = (setModel && m) ? `${setModel}|${m}` : m;
                if (window.ABSOLUTE_LOCK.has(key) && window.CURRENT_INTERACTING_KEY !== key) return;
            }
            return origInpDesc.set.call(this, val);
        }
    });
}

// 화면스타일방어
