function openSpecModalByItem(item, scope){
  if(!item) return;

  const L = String(item.catL || item.L || item.catLText || '').trim();
  const M = String(item.catM || item.M || '').trim();
  const model = String(item.model || '').trim();
  const name  = String(item.name || item.s?.name || '').trim();

  const allowL = ['실내기','실외기','판넬'];
  const isErv = (scope==='comm' && M==='전열교환기');

  // 스코프별 오픈 조건
  if(scope === 'home'){
    if(!allowL.includes(L)) return;
  } else if(scope === 'comm'){
    if(!allowL.includes(L) && !isErv) return;
  } else if(scope === 'single'){
    // 싱글중대형은 "세트 품목만" 허용
    if(!item.isSet) return;
  }

  const spec = SPEC_DETAIL_MAP[model] || {};
  const box = el('#specBody');
  if(!box) return;

  el('#specTitle').textContent = `${name} (${model})`;

  if(scope==='home'){
    box.innerHTML = renderHomeSpec_(L, item, spec.home || {});
  }
  else if(scope==='single'){
    box.innerHTML = renderSingleSpec_(L, item, spec.single || {});
  }
  else if(scope==='comm'){
    if(isErv){
      box.innerHTML = renderErvSpec_(spec.comm || {});
    } else {
      box.innerHTML = renderCommSpec_(L, item, spec.comm || {});
    }
  }

  el('#dlgSpec').showModal();
  logAction('조회', '장비스펙');
}

