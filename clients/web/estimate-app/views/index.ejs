body.history-active .grid { display: none !important; } body.history-active #pageHistory { display: flex !important; } body.history-active #btnGoHome, body.history-active #btnGoSingle, body.history-active #btnGoComm { display: inline-block !important; }
.mobile-handle-bar, .mobile-drawer { display: none; }
/* [필수 추가 스타일] 게이트 및 메뉴 */
