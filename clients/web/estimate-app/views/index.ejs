          <span data-k="2815">2815 <b>0</b> <input type="number" class="extra-branch" min="0" style="width:40px; margin-left:4px; text-align:center; border:1px solid #ccc; border-radius:4px; height:24px;"></span>
          <span data-k="3419">3419 <b>0</b> <input type="number" class="extra-branch" min="0" style="width:40px; margin-left:4px; text-align:center; border:1px solid #ccc; border-radius:4px; height:24px;"></span>
          <span data-k="4119">4119 <b>0</b> <input type="number" class="extra-branch" min="0" style="width:40px; margin-left:4px; text-align:center; border:1px solid #ccc; border-radius:4px; height:24px;"></span>
