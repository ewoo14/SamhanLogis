/* 전표전송 */
function submitOrderCard() {
  if (window.isSubmitting) return;
  window.isSubmitting = true;

  try {
    const getEl = (id) => document.getElementById(id);
    const getVal = (id) => {
      const el = getEl(id);
      return el ? el.value : '';
    };

    // 품목수집
    var itemsRaw = (typeof buildSendRows === 'function') ? buildSendRows() : [];
    var items = (typeof aggregateSendRows === 'function') ? aggregateSendRows(itemsRaw) : itemsRaw;

    /* 순서반영 */
    const currentHash = items.map(it => `${it.model}|${it.qty}|${it.price}`).join('||');
    if (window.CUSTOM_FINAL_HASH === currentHash && window.CUSTOM_FINAL_ORDER) {
      const orderMap = new Map(window.CUSTOM_FINAL_ORDER.map((k, i) => [k, i]));
      items.sort((a, b) => {
        const ka = `${a.model}|${a.qty}|${a.price}`;
        const kb = `${b.model}|${b.qty}|${b.price}`;
        const ia = orderMap.has(ka) ? orderMap.get(ka) : 999;
        const ib = orderMap.has(kb) ? orderMap.get(kb) : 999;
        return ia - ib;
      });
    }

    if (!items || items.length === 0) throw new Error('전송할 품목이 없습니다.');

    // 입력값조회
    const custInput = getEl('custSearch');
    const custCode = custInput?.dataset.code || '';
    const custName = custInput?.value || '';
    const managerInput = getEl('managerSearch');
    const managerName = managerInput?.value || '';
    const managerCode = managerInput?.dataset.code || '';
    const fullAddr = (getVal('addrBase') + ' ' + getVal('addrDetail')).trim();
    
    // 입력창 값 읽기
    const getInputVal = (id) => {
        const el = getEl(id);
        if (!el) return 0;
        const raw = String(el.value).replace(/,/g, ''); // 콤마 제거
        const v = parseFloat(raw);
        return isNaN(v) ? 0 : v;
    };

    // 할인율 및 금액 설정
    const dcCfg = {
      HOME: getInputVal('home_rate') / 100,
      COMM: getInputVal('comm_rate') / 100,
      OLD:  getInputVal('old_rate') / 100
    };
    
    const D_360   = getInputVal('ss_disc_360');
    const D_4WAY  = getInputVal('ss_disc_4way');
    const D_STAND = getInputVal('ss_disc_stand');
    const D_1WAY  = getInputVal('ss_disc_1way');
    const D_DLX   = getInputVal('ss_disc_deluxe');
    const D_GR1   = getInputVal('ss_disc_grade1');

    const fmtPct = (r) => Math.round(r * 100) + '%';
    const fmtMoney = (n) => {
      if (!n) return '';
      const m = Math.floor(n / 10000);
      const c = Math.floor((n % 10000) / 1000);
      return '-' + (m > 0 ? m + '만' : '') + (c > 0 ? c + '천' : '');
    };

    // 적요초기화
    items.forEach(it => {
        it.remarks = '';
        it._isGlobalDcTarget = false;
    });

    // 주소입력
    if (items.length > 0 && fullAddr) {
      items[0].remarks = fullAddr;
    }

    // 섹션 분류 헬퍼
    const getCanonicalSection = (s) => {
        s = String(s || '').toUpperCase().replace(/[^A-Z]/g, ''); 
        if (s.includes('HOME') || s.includes('HM')) return 'HOME';
        if (s.includes('COMM') || s.includes('CM')) return 'COMM';
        if (s.includes('SINGLE') || s === 'S') return 'SINGLE';
        if (s.includes('OLD')) return 'OLD';
        return 'ETC';
    };

    const itemsBySec = { HOME:[], COMM:[], OLD:[], SINGLE:[], ETC:[] };
    items.forEach((it, idx) => {
      const sec = getCanonicalSection(it.section);
      if (itemsBySec[sec]) itemsBySec[sec].push({ ...it, absIdx: idx });
    });

    /* 전역대상확인 */
    const checkGlobalTarget = it => {
      let raw = it.fixedDc;
      let v = 0;
      if (typeof raw === 'string') {
          v = parseFloat(raw.replace(/[^0-9.]/g, ''));
          if (!isNaN(v)) v = v > 1 ? v / 100 : v;
      } else if (typeof raw === 'number') {
          v = raw;
      }
      return v < 0.01 || isNaN(v);
    };

    /* 전역할인 (HOME, COMM, OLD) */
    ['HOME', 'COMM', 'OLD'].forEach(sec => {
      const rate = dcCfg[sec];
      const hasTarget = itemsBySec[sec].some(checkGlobalTarget);
      
      if (rate >= 0.01 && hasTarget) {
        const txt = fmtPct(rate);
        let targetIdx = -1;

        // 빈 칸 찾기
        for (const item of itemsBySec[sec]) {
          if (!items[item.absIdx].remarks) {
            targetIdx = item.absIdx;
            break;
          }
        }

        // 없으면 섹션 첫 항목에 병합
        if (targetIdx === -1) {
            targetIdx = itemsBySec[sec][0].absIdx;
            const exist = items[targetIdx].remarks;
            // 주소가 든 품목에는 할인정보를 붙이지 않음
            if (!(fullAddr && exist === fullAddr)) {
              items[targetIdx].remarks = exist ? (exist + ' / ' + txt) : txt;
            }
        } else {
            items[targetIdx].remarks = txt;
        }
        items[targetIdx]._isGlobalDcTarget = true;
      }
    });

    // 싱글중대형 할인액
    const sets = {}; 
    itemsBySec.SINGLE.forEach(it => {
      if (it.setId) {
        if (!sets[it.setId]) sets[it.setId] = [];
        sets[it.setId].push(it);
      }
    });

    // ADD_TXT_06_T(이카운트 비고란)에 넣기 위한 싱글 할인 세트
    const appliedSingleDcs = new Set();

    Object.keys(sets).forEach(setId => {
      const group = sets[setId];
      const head = group.find(g => g.isSetHead) || group[0]; 
      
      const txts = [];
      if (head.has360 && D_360 > 0) { const txt = fmtMoney(D_360); txts.push(txt); appliedSingleDcs.add(txt); }
      if (head.has4way && D_4WAY > 0) { const txt = fmtMoney(D_4WAY); txts.push(txt); appliedSingleDcs.add(txt); }
      if (head.hasStand && D_STAND > 0) { const txt = fmtMoney(D_STAND); txts.push(txt); appliedSingleDcs.add(txt); }
      if (head.hasOneWayDc && D_1WAY > 0) { const txt = fmtMoney(D_1WAY); txts.push(txt); appliedSingleDcs.add(txt); }
      if (head.hasDeluxeDc && D_DLX > 0) { const txt = fmtMoney(D_DLX); txts.push(txt); appliedSingleDcs.add(txt); }
      if (head.hasFirstGradeDc && D_GR1 > 0) { const txt = fmtMoney(D_GR1); txts.push(txt); appliedSingleDcs.add(txt); }

      if (txts.length > 0) {
        const fullTxt = txts.join(' / ');
        let targetIdx = -1;
        
        // 세트 내 빈 칸 찾기
        for (const g of group) {
           if (!items[g.absIdx].remarks) {
             targetIdx = g.absIdx;
             break;
           }
        }

        if (targetIdx === -1) {
            targetIdx = group[0].absIdx;
            const exist = items[targetIdx].remarks;
            // 주소가 든 품목에는 할인정보를 붙이지 않음
            if (!(fullAddr && exist === fullAddr)) {
              items[targetIdx].remarks = exist ? (exist + ' / ' + fullTxt) : fullTxt;
            }
        } else {
            items[targetIdx].remarks = fullTxt;
        }
      }
    });

    /* 고정 할인 처리 */
    const uniqueFixedDcs = new Set();
    let lastFixedDcTxt = '';

    items.forEach((it) => {
      let fixedDc = 0;
      let raw = it.fixedDc;
      
      if (raw !== undefined && raw !== null && raw !== '') {
          if (typeof raw === 'string') {
             raw = raw.replace(/[^0-9.]/g, ''); 
             const v = parseFloat(raw);
             if (!isNaN(v)) fixedDc = (v > 1) ? v / 100 : v;
          } else if (typeof raw === 'number') {
             fixedDc = raw;
          }
      }

      if (fixedDc >= 0.01) {
        const txt = fmtPct(fixedDc);
        uniqueFixedDcs.add(txt);
        
        if (txt !== lastFixedDcTxt) {
            if (!it.remarks) {
              it.remarks = txt;
            } else if (!(fullAddr && it.remarks === fullAddr) && !it.remarks.includes(txt)) {
              // 주소가 든 품목에는 할인정보를 붙이지 않음
              it.remarks += ' / ' + txt;
            }
        }
        lastFixedDcTxt = txt;
      } else {
        lastFixedDcTxt = '';
      }
    });

    /* ADD_TXT_06_T 추출용 배열 */
    const dcInfoArr = [];
    const commRate = dcCfg.COMM;
    const homeRate = dcCfg.HOME;
    
    // 홈/상업멀티 전역 비율
    if (commRate >= 0.01 && itemsBySec.COMM.some(checkGlobalTarget)) dcInfoArr.push(fmtPct(commRate));
    if (homeRate >= 0.01 && itemsBySec.HOME.some(checkGlobalTarget)) dcInfoArr.push(fmtPct(homeRate));
    
    // 싱글중대형에 적용된 금액 할인
    appliedSingleDcs.forEach(dc => dcInfoArr.push(dc));

    // 사용자가 지정한 고정 DC
    uniqueFixedDcs.forEach(dc => dcInfoArr.push(dc));

    const dcInfoStr = dcInfoArr.join(' / ');

    /* 소거 */
    let lastSpec = '';
    items.forEach(it => {
      const cur = String(it.spec || '').trim();
      if(cur && cur === lastSpec) {
        it.spec = '';
      }
      lastSpec = cur;
    });

    // 카드 수수료 로직
    if (window.CURRENT_CARD_FEE > 0) {
      const feeTxt = '수수료 ' + new Intl.NumberFormat('ko-KR').format(window.CURRENT_CARD_FEE) + '원 포함';
      
      let isInserted = false;
      
      /* 탐색 */
      for (let i = 1; i < items.length; i++) {
        const currentVal = items[i].remarks || items[i]['적요'] || '';
        if (currentVal.trim() === '') {
          items[i].remarks = feeTxt;
          isInserted = true;
          break;
        }
      }
    }

    /* 유효 */
    if (!custCode) throw new Error('거래처를 선택해주세요.');
    if (!getVal('due')) throw new Error('납기일을 입력해주세요.');
    if (!fullAddr) throw new Error('주소를 입력해주세요.');

    /* 확인 */
    if (!confirm(`거래처: ${custName}\n총 ${items.length}품목의 전표를 생성하시겠습니까?`)) {
      window.isSubmitting = false;
      return;
    }

    /* 묶음 */
    var orderData = {
      bizno: window.CURRENT_BIZNO || '',
      custCode: custCode,
      custName: custName,
      whCode: getVal('whCode'),
      due: getVal('due'),
      payDue: document.getElementById('chkCardPay')?.checked ? '카드결제' : 
              (document.getElementById('payDueStar')?.checked ? '*' : 
              (document.getElementById('payDuePre')?.checked ? '선결제' : getVal('payDue'))),
      manager: managerName.trim(),
      managerCode: managerCode,
      addr: fullAddr,
      tel: getVal('tel'),
      memo: getVal('memo'),
      custTel: getVal('custTel'),   
      custAddr: getVal('custAddr'),
      items: JSON.stringify(items),
      auth: USER_AUTH,
      isMobile: (typeof isMobileNow === 'function') ? isMobileNow() : false,
      estimateConfig: CONFIG,
      dcInfo: dcInfoStr // 이카운트 ADD_TXT_06_T에 주입할 정보 (홈/상업/싱글 할인 내역 통합)
    };
    
    try {
        const c = document.cookie.match(new RegExp('(^| )USER_AUTH=([^;]+)'));
        if(c) orderData.auth = JSON.parse(decodeURIComponent(c[2]));
    } catch(e) {}

    const later = getEl('auditLater')?.checked;
    const same = getEl('sameAddr')?.checked;
    if (later) orderData.auditAddr = '추후';
    else if (same) orderData.auditAddr = fullAddr;
    else orderData.auditAddr = (getVal('addrAuditBase') + ' ' + getVal('addrAuditDetail')).trim();

    // 모달오픈
    const dlg = getEl('dlgProgress');
    const icon = getEl('progressIcon');
    const txt = getEl('progressText');
    const btns = getEl('progressBtns');

    if (dlg) {
      if (typeof dlg.showModal === 'function') dlg.showModal(); else dlg.style.display = 'block';
      if (icon) icon.textContent = '⏳';
      if (txt) txt.textContent = '전표 생성 중...';
      if (btns) btns.style.display = 'none';
    }

    // 서버호출
    google.script.run
      .withSuccessHandler((res) => {
        if (!isSlipPublishSuccess(res)) {
          if(icon) icon.textContent = '⚠️';
          const errorMsg = (res && typeof res === 'object' && res.error) ? res.error : '전표 생성 실패';
          if(txt) txt.textContent = '전표 생성 실패:\n' + errorMsg;
          if(btns) btns.style.display = 'block';
          window.isSubmitting = false;
          return;
        }
        if(icon) icon.textContent = '✅';
        const slipNo = (res && res.slipNo) ? res.slipNo : (typeof res==='object'?'':res);
        const msg = slipNo ? ('완료! 전표번호: ' + slipNo) : '전표 생성 오류';

        if(txt) txt.textContent = msg;
        logAction('기능', '전표생성: ' + msg);

        // 중복방지스냅샷저장
        if (slipNo && typeof getCurrentSlipSnapshot === 'function') {
          window.LAST_SLIP_SNAPSHOT = getCurrentSlipSnapshot();
          if (typeof toggleSlipButton === 'function') toggleSlipButton();
        }

        setTimeout(() => {
          if(dlg) { if(dlg.close) dlg.close(); else dlg.style.display = 'none'; }
          window.isSubmitting = false;
          if (typeof resetCardData === 'function') {
            // resetCardData(); // 성공 시 자동으로 폼 초기화 (현재는 비활성화 상태)
          } else alert(`⚠️ ${msg}`);
        }, 1000);
      })
      .withFailureHandler((err) => {
        if(icon) icon.textContent = '⚠️';
        if(txt) txt.textContent = '서버 오류: ' + err;
        if(btns) btns.style.display = 'block';
        alert('서버 처리에 실패했습니다.\n' + err);
        window.isSubmitting = false;
      })
      .sendOrderFromUi(orderData);

  } catch (e) {
    console.error(e);
    alert('오류 발생: ' + e.message);
    window.isSubmitting = false;
    const d = document.getElementById('dlgProgress');
    if(d && d.close) d.close();
  }
}

function initCustomerSearch() {
  const inp = document.getElementById('custSearch');
  if (!inp) return;

  inp.placeholder = "거래처 데이터 로딩중...";
  inp.disabled = true;

  google.script.run
    .withSuccessHandler(function(data) {
      CUSTOMERS = data || []; 
      inp.placeholder = "거래처명 검색";
      inp.disabled = false;
    })
    .withFailureHandler(function(err) {
      console.error(err);
      inp.placeholder = "데이터 로드 실패";
    })
    .getCustomerDataAsync(); 

  let currentFocus = -1;

  // 입력감지 이벤트 핸들러
  inp.addEventListener('input', function(e) {
    // 코드 정보 초기화
    this.dataset.code = ''; 
    if(typeof toggleSlipButton === 'function') toggleSlipButton();

    // 입력값이 변경 시 하위 거래처 정보 필드 모두 초기화
    const fieldsToClear = ['custRep', 'custTel', 'custAddr', 'custGroup', 'custNote'];
    fieldsToClear.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });

    const val = this.value;
    closeAllLists();
    
    // 값이 없으면 리턴
    if (!val) return;

    currentFocus = -1;
    const list = document.getElementById('custSuggestions');
    list.classList.remove('hidden');
    list.innerHTML = '';

    // 검색 및 렌더링 로직
    const targets = (typeof CUSTOMERS !== 'undefined') ? CUSTOMERS : [];
    const matches = targets.filter(c => c.name.toLowerCase().includes(val.toLowerCase()));

    if (matches.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'ac-row';
      empty.innerHTML = '<span style="color:#999;">검색 결과 없음</span>';
      list.appendChild(empty);
      return;
    }

    matches.forEach(c => {
      const item = document.createElement('div');
      item.className = 'ac-row';
      const highlightName = escapeEstimateHtml(c.name);
      const repName = c.rep || '';
      const addrShort = (c.addr || '').split(' ').slice(0, 3).join(' ');

      item.innerHTML = `
        <div class="ac-col-name">${highlightName}</div>
        <div class="ac-col-meta">${escapeEstimateHtml(repName)} | ${escapeEstimateHtml(addrShort)}</div>
      `;

      item.addEventListener('mousedown', function(e) {
        inp.value = c.name;
        inp.dataset.code = c.code; 

        // 값 주입
        if(document.getElementById('custRep')) document.getElementById('custRep').value = c.rep || '';
        if(document.getElementById('custTel')) document.getElementById('custTel').value = c.tel || '';
        if(document.getElementById('custAddr')) document.getElementById('custAddr').value = c.addr || '';
        if(document.getElementById('custGroup')) document.getElementById('custGroup').value = c.group || '';
        if(document.getElementById('custNote')) document.getElementById('custNote').value = c.note || '';

        // 노션 할인설정 자동적용
        if(typeof applyCustomerDiscounts === 'function') applyCustomerDiscounts(c.dc);

        if(typeof toggleSlipButton === 'function') toggleSlipButton();
        closeAllLists();
      });

      list.appendChild(item);
    });
  });

  inp.addEventListener('keydown', function(e) {
    let list = document.getElementById('custSuggestions');
    let items = list ? list.getElementsByClassName('ac-row') : [];
    if (e.key === 'ArrowDown') { currentFocus++; addActive(items); } 
    else if (e.key === 'ArrowUp') { currentFocus--; addActive(items); } 
    else if (e.key === 'Enter') {
      e.preventDefault();
      if (currentFocus > -1 && items) {
        const event = new MouseEvent('mousedown');
        items[currentFocus].dispatchEvent(event);
      }
    }
  });

  function addActive(x) {
    if (!x || x.length === 0) return false;
    removeActive(x);
    if (currentFocus >= x.length) currentFocus = 0;
    if (currentFocus < 0) currentFocus = (x.length - 1);
    x[currentFocus].classList.add('autocomplete-active');
    x[currentFocus].scrollIntoView({block: 'nearest'});
  }

  function removeActive(x) {
    for (let i = 0; i < x.length; i++) x[i].classList.remove('autocomplete-active');
  }

  function closeAllLists(elmnt) {
    const list = document.getElementById('custSuggestions');
    if (elmnt !== inp && elmnt !== list) {
      list.innerHTML = '';
      list.classList.add('hidden');
    }
  }

  document.addEventListener('click', function(e) {
    closeAllLists(e.target);
  });
}

