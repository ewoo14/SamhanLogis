  .est-table th:last-child, .est-table td:last-child { border-right:none !important }
  
  .qty-input { width:100%; height:32px; font-size:14px; padding:0; border:1px solid #ddd; text-align:center; border-radius:4px }

  /* 분기모바일고정해제 */
  .branch-table tbody td.branch-sticky { position:static !important; z-index:1 !important; }
  .branch-table thead th.branch-sticky { position:static !important; z-index:1 !important; }
  .branch-wrap .branch-table thead th { position:static !important; z-index:1 !important; }

  /* 핸들바 */
  .mobile-handle-bar {
    display:flex !important; align-items:center; justify-content:center;
    position:fixed; left:0; right:0; height:40px; z-index:99100;
    background:#f8fafc; border:1px solid #cbd5e1;
