function sel(label,arr,def,id){const w=document.createElement('label');w.className='chip';w.appendChild(document.createTextNode(label+' '));const s=document.createElement('select');s.id=id;(arr||[]).forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=(v===''||v==='선택 안함')?'기본':v;s.appendChild(o);});s.value=((arr||[]).includes(def)?def:((arr||[])[0]||''));w.appendChild(s);return w;}

