          if(r.type === 'set-head') {
            tr.innerHTML = '<td colspan="' + totalCols + '" style="background:' + (bgColor || '#fff') + ' !important; -webkit-print-color-adjust: exact; color-adjust: exact; font-weight:bold; padding:' + PAD + '; height:16px; border-bottom:' + bBottom + '; border-left:' + B_SIDE + '; border-right:' + B_SIDE + '; text-align:left; color:' + C_TXT + ';">' + escapeEstimateHtml(r.name) + ' (' + escapeEstimateHtml(r.model) + ') × ' + fmt(r.qty) + '</td>';
          } else {
            const prefix = r.isChild ? '└ ' : '';
            const namePad = r.isChild ? '1px 4px 3px 12px' : PAD;
            const color = r.isChild ? '#4b5563' : '#111';
            const modColor = r.isChild ? '#6b7280' : '#000000';
            const tdCommon = 'padding:' + PAD + '; height:16px; border-right:1px solid ' + B_IN_COLOR + '; border-bottom:' + bBottom + '; white-space:nowrap;';
            
            let html = '<td style="text-align:left; padding:' + namePad + '; height:16px; border-left:' + B_SIDE + '; border-right:1px solid ' + B_IN_COLOR + '; border-bottom:' + bBottom + '; color:' + color + '; word-break:break-all;' + bgStyle + '">' + prefix + escapeEstimateHtml(r.name) + '</td>' +
                       '<td style="' + tdCommon + ' text-align:center; color:' + modColor + ';">' + escapeEstimateHtml(r.model) + '</td>' +
                       '<td style="' + tdCommon + ' text-align:center;">' + escapeEstimateHtml(r.unit) + '</td>' +
                       '<td style="' + tdCommon + ' text-align:center;">' + fmt(r.qty) + '</td>';
            
            if (showList) html += '<td style="' + tdCommon + ' text-align:right; color:#1e40af;"><span class="auto-shrink">' + fmt(r.list || 0) + '</span></td>';
            
            html += '<td style="' + tdCommon + ' text-align:right;"><span class="auto-shrink">' + fmt(r.price) + '</span></td>' +
                    '<td style="padding:' + PAD + '; height:16px; border-bottom:' + bBottom + '; border-right:' + B_SIDE + '; text-align:right;"><span class="auto-shrink">' + fmt(r.sub) + '</span></td>';
