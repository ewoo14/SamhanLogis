// 고정DC 파싱
function parseFixedDc(dc){
  if(dc == null || dc === '') return null;
  if(typeof dc === 'number'){
    const v = dc > 1 ? dc/100 : dc;                 // 수치형 처리
    return Math.min(Math.max(v,0),0.99);
  }
  const s = String(dc).trim();
  const m = s.match(/-?\d+(?:\.\d+)?/);             // 첫 숫자 추출
  if(!m) return null;
  let v = Number(m[0]);
  if(/%/.test(s) || v > 1) v = v/100;               // % 또는 1 초과는 퍼센트
  v = Math.min(Math.max(v,0),0.99);                 // 0~0.99 클램프
  return v;
}

// 품목명이 벽걸이인지 확인
function isWallMountName(name){
  if(!name) return false;
  return /벽\s*걸이|벽걸이/i.test(String(name));
}

// 상태확인
function getStockState_(note) {
  const s = String(note || '').replace(/\s+/g, '');
  // 품절
  if (/품절/.test(s)) return { type: 'SOLD' };

  // 날짜추출
  const m = s.match(/(\d{2})(\d{2})(\d{2})/);
  if (m) {
    const y = 2000 + parseInt(m[1], 10);
    const mo = parseInt(m[2], 10) - 1;
    const d = parseInt(m[3], 10);
    
    const target = new Date(y, mo, d);
    const today = new Date();
    today.setHours(0, 0, 0, 0);

    // 미래
    if (today < target) {
      return { type: 'FUTURE', label: m[2] + '.' + m[3] + ' 예정' };
    }
  }
  // 정상
  return { type: 'OK' };
}

