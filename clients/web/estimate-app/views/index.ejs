function resetBranch() {
  window.GLOBAL_BRANCH_STATE = null;
  try { sessionStorage.removeItem('branch_state_v2'); } catch(e){}

  // 입력초기화
  document.querySelectorAll('#branchBoard input').forEach(el => {
    if (el.classList.contains('out-name-input')) {
      // 명칭복원
      const num = el.getAttribute('data-out').replace('out', '');
      el.value = '실외기' + num;
    } else if (!el.readOnly && el.type !== 'button') {
      // 값지움
      el.value = '';
    }
  });
  
  // 캡슐제거
  document.querySelectorAll('.capsule.in-grid').forEach(el => el.remove());
  
  // 분기초기화
  document.querySelectorAll('.extra-branch').forEach(el => el.value = '');

  if (typeof saveBranchState === 'function') saveBranchState();
  if (typeof recomputeBranchCodes === 'function') recomputeBranchCodes();

  if (typeof commQty !== 'undefined') {
    const targets = [];
    for (const k of commQty.keys()) {
      if (/(분기관|AXJ)/i.test(k)) {
        targets.push(k);
      }
    }
    targets.forEach(k => commQty.delete(k));
  }

  // 상단이동
  const board = document.getElementById('branchBoard');
  if (board) {
    const wrap = board.closest('.table-wrap');
    if (wrap) wrap.scrollTo({ top: 0, behavior: 'smooth' });
  }
  logAction('초기화', '분기계산 초기화');
}

