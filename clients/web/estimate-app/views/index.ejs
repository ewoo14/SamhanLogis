function singleUnitPrice(it){
  // 기본가 원본
  let base = Math.round(Number(it.priceRaw ?? it.price ?? 0));
  
  const isInc = document.getElementById('chkSingleInc')?.checked;
  if (isInc && typeof PRICE_INC !== 'undefined' && PRICE_INC.single && PRICE_INC.single[it.model] && PRICE_INC.single[it.model].price) {
    base = PRICE_INC.single[it.model].price;
  }

  // I형 유연호스 단가 고정
  const rawName = String(it.nameRaw || it.name || '');
  if (!window.SHOW_I_HOSE && /유연호스\s*I형/i.test(rawName)) {
    return 8000;
  }

  // 부자재 판정
  const isAcc = (it.catL === 'acc') ||
    /리모컨|리모콘|자재|부자재|보드|키트|KIT|중계기|발통|드레인펌프|일자발|분\s*기\s*관|분기관/i.test(rawName);
  if (isAcc) {
    return base;
  }

  const model = String(it.model || '').toUpperCase();
  if (!/^(AC|AP|AR|AF)/i.test(model)) {
    return base;
  }

  const flags = getModelFlags(model);

  let v = base;
  const d360    = parseInt(el('#ss_disc_360')?.value || 0, 10);
  const d4way   = parseInt(el('#ss_disc_4way')?.value || 0, 10);
  const dStand  = parseInt(el('#ss_disc_stand')?.value || 0, 10);
  const d1w     = parseInt(el('#ss_disc_1way')?.value || 0, 10);
  const dDeluxe = parseInt(el('#ss_disc_deluxe')?.value || 0, 10);
  const dFirst  = parseInt(el('#ss_disc_grade1')?.value || 0, 10);

  const calc = (val, rateAmt) => Math.max(0, val - rateAmt);

  if (flags.is360 && d360 > 0) v = calc(v, d360);
  if (flags.is4way && d4way > 0) v = calc(v, d4way);
  if (flags.isStand && dStand > 0) v = calc(v, dStand);
  if (flags.is1way && d1w > 0) v = calc(v, d1w);
  if (flags.isDeluxe && dDeluxe > 0) v = calc(v, dDeluxe);
  if (flags.isGrade1 && dFirst > 0) v = calc(v, dFirst);

  return v;
}

