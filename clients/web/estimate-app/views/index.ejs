  // 서울시간
  const getKstToday = () => {
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const kst = new Date(utc + (9 * 60 * 60000));
    const y = kst.getFullYear();
    const m = String(kst.getMonth() + 1).padStart(2, '0');
    const d = String(kst.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  };

  // // 홈초기화
  // const btnResetHome = el('#btnResetHome');
  // if (btnResetHome) {
  //   btnResetHome.addEventListener('click', () => {
  //     if (typeof resetHome === 'function') resetHome();
  //   });
  // }

  // // 싱글초기화
  // const btnResetSingle = el('#btnResetSingle');
  // if (btnResetSingle) {
  //   btnResetSingle.addEventListener('click', () => {
  //     if (typeof resetSingle === 'function') resetSingle();
  //   });
  // }

  // // 상업초기화
  // const btnResetComm = el('#btnResetComm');
  // if (btnResetComm) {
  //   btnResetComm.addEventListener('click', () => {
  //     if (typeof resetComm === 'function') resetComm();
  //   });
  // }

  // // 구형초기화
  // el('#btnResetOld')?.addEventListener('click', () => {
  //   if (typeof resetOld === 'function') resetOld();
  // });

  // // 전체초기화
  // el('#btnResetInfo')?.addEventListener('click', () => {
  //   if (typeof resetCardData === 'function') resetCardData();
  // });

  /* 탭이동 */
  const bindTap = (id, fn) => { const b = el(id); if (b) b.addEventListener('click', fn); };
  bindTap('#btnGoOrderInfo', typeof goOrderInfo !== 'undefined' ? goOrderInfo : null);
  bindTap('#btnGoFinal', typeof goFinal !== 'undefined' ? goFinal : null);

  // 견적서모드
  el('#btnGoPreview')?.addEventListener('click', () => {
    window.previewMode = 'DETAIL';
    if (typeof goPreview === 'function') goPreview();
  });
  el('#btnGoPreviewSimple')?.addEventListener('click', () => {
    window.previewMode = 'SIMPLE';
    if (typeof goPreview === 'function') goPreview();
  });

  // 입력감지
  const inputs = [
    'memo', 
    'addrBase', 'addrDetail',
    'addrAuditBase', 'addrAuditDetail',
    'tel', 'due', 'payDue', 'whCode', 'custSearch', 'managerSearch'
  ];
  inputs.forEach(id => {
    const elem = el('#' + id);
    if (elem) {
      elem.addEventListener('input', toggleSlipButton);
      elem.addEventListener('change', toggleSlipButton);
      elem.addEventListener('blur', toggleSlipButton);
    }
  });

  // 품목감지
  const tables = document.querySelectorAll('table');
  tables.forEach(tbl => {
    tbl.addEventListener('click', () => setTimeout(toggleSlipButton, 300));
    tbl.addEventListener('keyup', () => setTimeout(toggleSlipButton, 300));
    // 수량 변경 input 감지 추가
    tbl.addEventListener('change', (e) => {
       if(e.target.tagName === 'INPUT') toggleSlipButton();
    });
  });

  // 주소동일
  el('#sameAddr')?.addEventListener('change', (e) => {
    const ab = el('#addrBase');
    const ad = el('#addrDetail');
    const aab = el('#addrAuditBase');
    const aad = el('#addrAuditDetail');

    if (e.target.checked) {
      if (aab && ab) aab.value = ab.value;
      if (aad && ad) aad.value = ad.value;
    } else {
      if (aab) aab.value = '';
      if (aad) aad.value = '';
    }
    toggleSlipButton();
  });

  // 닫기
  el('#btnProgressClose')?.addEventListener('click', () => {
    const d = el('#dlgProgress');
    if (d && d.close) d.close();
  });

  // 단축키
  const bindOrderHotkeys = () => {
    const inp = document.querySelector('#mgrQuery');
    const btn = document.querySelector('#btnMgrSearch');
    if (inp && btn) {
      inp.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); btn.click(); }
      });
    }
    const ad = el('#addrDetail'); // 상세주소에서 엔터시 전화번호로
    if (ad) {
      ad.addEventListener('keydown', e => {
        if (e.key === 'Enter') {
          e.preventDefault();
          el('#tel')?.focus();
        }
      });
    }
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindOrderHotkeys, { once: true });
  else bindOrderHotkeys();

  // 기본 날짜
  const today = getKstToday();
  if (el('#due') && !el('#due').value) el('#due').value = today;
  if (el('#payDue') && !el('#payDue').value) el('#payDue').value = today;

  // 전화번호
  const tel = el('#tel');
  if (tel) {
    const f = v => {
      const d = String(v || '').replace(/\D/g, '');
      let t = d.startsWith('010') ? d.slice(3) : d; t = t.slice(0, 8);
      if (t.length <= 4) return '010-' + t;
      return '010-' + t.slice(0, 4) + '-' + t.slice(4);
    };
    
    // 초기값설정
    if (!tel.value) tel.value = '010-';

    tel.addEventListener('beforeinput', e => {
      if (e.inputType === 'insertText' && /\D/.test(e.data || '')) e.preventDefault();
    });
    tel.addEventListener('input', () => {
      tel.value = f(tel.value);
      toggleSlipButton();
    });
  }

  // 초기체크
  setTimeout(toggleSlipButton, 500);
}

