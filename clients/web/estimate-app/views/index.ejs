/* 선택 뱃지/미리보기 버튼 */
function refreshSelectedBadge() {
  let cnt = 0;
  let hasHome = false;
  let hasComm = false;
  let hasOld = false;

  // 수량
  const maps = [
    typeof homeQty !== 'undefined' ? { m: homeQty, type: 'home' } : null,
    typeof singleQty !== 'undefined' ? { m: singleQty, type: 'single' } : null,
    typeof commQty !== 'undefined' ? { m: commQty, type: 'comm' } : null,
    typeof oldQty !== 'undefined' ? { m: oldQty, type: 'old' } : null
  ];

  maps.forEach(obj => {
    if (!obj) return;
    obj.m.forEach(v => {
      if ((parseInt(v) || 0) !== 0) {
        cnt++;
        if (obj.type === 'home') hasHome = true;
        if (obj.type === 'comm') hasComm = true;
        if (obj.type === 'old') hasOld = true;
      }
    });
  });

  // 합산
  document.querySelectorAll('.custom-qty').forEach(inp => {
    if (parseInt(inp.value || '0', 10) !== 0) cnt++;
  });

  // 공통규격
  const baseStyle = 'align-items:center; justify-content:center; height:26px; box-sizing:border-box; vertical-align:middle; line-height:1; padding:0 8px;';

  // 건수
  const badge = document.getElementById('selectedCount');
  if (badge) {
    badge.textContent = `선택 ${cnt}건`;
    badge.style.cssText = (cnt > 0 ? 'display:inline-flex;' : 'display:none;') + baseStyle + 'margin-left:8px; background:#eef2ff; color:#3730a3; border-radius:999px; font-size:12px; font-weight:bold;';
  }

  // 할인율
  let rateBadge = document.getElementById('selectedRateBadge');
  if (!rateBadge) {
    rateBadge = document.createElement('span');
    rateBadge.id = 'selectedRateBadge';
    rateBadge.className = 'badge';
    // QA Phase 7 2차 — DC 적용 단가/할인율 식별 selector (광범위 body 매칭 회피)
    rateBadge.setAttribute('data-testid', 'dc-applied-rate');
    const titleEl = document.querySelector('.title');
    if (titleEl) titleEl.appendChild(rateBadge);
  }

  // 조합
  const rates = [];
  if (hasHome) {
    const r = document.getElementById('home_rate')?.value || '45';
    rates.push(`홈멀티:${r}%`);
  }
  if (hasComm) {
    const r = document.getElementById('comm_rate')?.value || '45';
    rates.push(`상업:${r}%`);
  }
  if (hasOld) {
    const r = document.getElementById('old_rate')?.value || String(getOldDiscountPercent());
    rates.push(`구형:${r}%`);
  }

  // 적용
  if (rates.length > 0 && cnt > 0) {
    rateBadge.textContent = rates.join(' / ');
    rateBadge.style.cssText = 'display:inline-flex;' + baseStyle + 'margin-left:8px; background:#dcfce7; color:#166534; border-radius:4px; font-size:12px; font-weight:bold;';
  } else {
    rateBadge.style.display = 'none';
  }

  // 버튼
  const btnSimple = document.getElementById('btnGoPreviewSimple');
  const btnPreview = document.getElementById('btnGoPreview');
  const btnFinal = document.getElementById('btnGoFinal');
  
  if (btnSimple) btnSimple.disabled = (cnt === 0);
  if (btnPreview) btnPreview.disabled = (cnt === 0);
  if (btnFinal) btnFinal.disabled = (cnt === 0);
}

// 표시된 세트 납품가를 숫자로 반환
function getSetUnitNowById(id){
  const cell = document.querySelector(`#singleBody [data-ssu="${CSS.escape(id)}"]`);
  if (cell){
    const v = Math.round(Number(cell.getAttribute('data-unitraw')) || 0);
    if (v > 0) return v;
    const t = Number(String(cell.textContent||'').replace(/[^\d]/g,''));
    if (t > 0) return t;
  }
  const s = SINGLE_SETS.find(x => String(x.id) === String(id));
  if (!s) return 0;
  return Math.round(Number(setBasePriceRightFirst(s)) || 0);
}

// 싱글중대형 → 전송용 품목 목록
function explodeSendSets_(s, q){
  const unitOverride = getRealSinglePrice(s.id); 
  
  const cls = classifySingleSetFixed(s);
  const catL = String(cls && cls.catL || '');
  const isAccessory = (catL === '부자재' || catL === '실외기 받침');

  // 세트 단위 전송이거나 부자재인 경우
  if (typeof SEND_AS_SET_IDS !== 'undefined' && SEND_AS_SET_IDS.has(s.id) || isAccessory){
    return [{
      name: s?.name || '',
      model: s.model,
      unit: s.unit || 'SET',
      qty: q,
      price: unitOverride || calcSetUnitPrice(s),
      spec: s.spec || ''
    }];
  }

  // 세트 분해
  return explodeSetParts(s, q, unitOverride)
    .map(k => ({
      name: k.name,
      model: k.model,
      unit: k.unit || 'EA',
      qty:  k.qty,
      price: k.price,
      spec: k.spec || ''
    }));
}

