// 보정
function enforceDateLimit(changedId) {
  const sEl = document.getElementById('histStart');
  const eEl = document.getElementById('histEnd');
  if (!sEl || !eEl || !sEl.value || !eEl.value) return;

  const sDate = new Date(sEl.value);
  const eDate = new Date(eEl.value);
  const diffTime = eDate - sDate;
  const diffDays = diffTime / (1000 * 60 * 60 * 24);

  // 보정
  if (diffDays < 0) {
    if (changedId === 'histStart') eEl.value = sEl.value;
    else sEl.value = eEl.value;
    return;
  }

  // 보정
  if (diffDays > 7) {
    if (changedId === 'histStart') {
      const newEnd = new Date(sDate);
      newEnd.setDate(sDate.getDate() + 7);
      eEl.value = newEnd.toISOString().slice(0, 10);
    } else {
      const newStart = new Date(eDate);
      newStart.setDate(eDate.getDate() - 7);
      sEl.value = newStart.toISOString().slice(0, 10);
    }
  }
}

