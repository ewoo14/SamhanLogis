/* 판넬 선택 */
function pickPanelBy(kind, wifi, opt){
  const has = (r, rx) => rx.test(((r?.name||'')+' '+(r?.disp||'')+' '+(r?.model||'')).toLowerCase());
  const matchKind = r => {
    const text = (((r?.name||'')+' '+(r?.disp||'')).toLowerCase());
    if (kind === '360') return /360/.test(text);
    if (kind === '4way') return /(4\s*-?\s*way|4way)/i.test(text) && !/360/.test(text);
    if (kind === '1way') return /(1\s*-?\s*way|1way)/i.test(text) && !/(4\s*-?\s*way|4way|360)/i.test(text);
    return false;
  };
  const matchWifi = r => wifi ? has(r,/(wi\s*[-\s]?fi|wifi)/i) : has(r,/(미내장|non[-\s]?wifi|no[-\s]?wifi)/i);

  const wantAir  = (opt==='공청판넬');
  const wantAI   = (opt==='인피니트 공청+동작감지 AI');
  const prefer = rr => {
    const t=(rr?.name||'');
    let score = 0;
    // 옵션 정합성 가중치
    if(wantAI)     score += /(ai|동작감지)/i.test(t) ? -6 : 3;
    if(wantAir)    score += /(공기청정|공청)/i.test(t) ? -4 : 2;
    // “기본” 우선
    score += /(기본)/i.test(t) ? -2 : 0;
    score += /(블랙|승강)/i.test(t) ? 2 : -1;
    return score;
  };

  const cands = HOMEMULTI.filter(r => isPanelRow(r) && matchKind(r) && matchWifi(r));
  if(!cands.length) return null;
  cands.sort((a,b)=>prefer(a)-prefer(b));
  return cands[0]?.model || null;
}

