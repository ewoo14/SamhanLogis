/* 숫자변환 */
const _toInt = (typeof toInt==='function') ? toInt : v=>{
  v = Number(String(v).replace(/[^0-9.-]/g,''));
  return isFinite(v)?v:0;
};

/* 용량추출 */
function capFromModel(model){
  const m = /AM(\d{3})/i.exec(String(model||'')); 
  return m ? parseInt(m[1],10) : 0;
}

// 상업멀티 선택 실외기
function pickSelectedOutdoors(){
  const rows = (COMMULTI||[]).filter(r=>{
    const m = String(r.model||'').trim().toUpperCase();
    return m.startsWith('AM') && m.length >= 7 && m.charAt(6) === 'X';
  });

  // 상업멀티 DOM 순서
  const order = Array.from(document.querySelectorAll('#commBody .item-row'))
    .map(tr=> tr.querySelector('.qty-input')?.dataset.model).filter(Boolean);

  rows.sort((a,b)=> order.indexOf(a.model) - order.indexOf(b.model));

  const out = [];
  rows.forEach(r=>{
    const q = Math.max(0, parseInt(commQty.get(r.model)||0,10));
    const cap = Math.max(0, parseInt(r.능력||r.capacity||0,10));
    for(let i=0;i<q;i++) out.push({ model:r.model, cap, row:r });
  });
  return out;
}

// 상업멀티 선택 실내기
function pickSelectedIndoorsExpanded(){
  const rows = (COMMULTI||[]).filter(r=>{
    const m = String(r.model||'').trim().toUpperCase();
    return m.startsWith('AM') && m.length >= 7 && m.charAt(6) === 'N';
  });

  const out = [];
  rows.forEach(r=>{
    const model = String(r.model||'').trim();

    // 상업멀티 입력 수량 우선
    let q = parseInt(commQty?.get(model) ?? (
      document.querySelector(`#commBody .qty-input[data-model="${CSS.escape(model)}"]`)?.value || '0'
    ), 10);
    if(!q || Number.isNaN(q)) q = 0;

    if(q>0){
      const cap = parseInt((model.match(/AM(\d{3})/i)||[])[1]||'0',10) || parseInt(r.cap||r.capacity||0,10) || 0;
      for(let i=0;i<q;i++) out.push({ model, cap, row:r });
    }
  });

  // 표시는 오름차순
  out.sort((a,b)=> String(a.model).localeCompare(String(b.model),'ko'));
  return out;
}

/* 누적합코드 */
function codeByCumulativeSum(csum){
  if(csum < 150) return '1509';
  if(csum < 406) return '2512';
  if(csum < 464) return '2812';
  if(csum < 696) return '2815';
  if(csum < 986) return '3419';
  return '4119';
}

/* 실외기용량코드 */
function codeByOutdoorHP(hp, def){
  if(!Number.isFinite(hp) || hp<=0) return def;
  let forced = def;
  if(hp <= 50)        forced = '1509';
  else if(hp <= 100)  forced = '2512';
  else if(hp <= 160)  forced = '2812';
  else if(hp <= 220)  forced = '2815';
  else if(hp <= 340)  forced = '3419';
  else                forced = '4119';
  return forced;
}

/* 분기관계산 */
function recomputeBranchCodes(outsArg){
  const outs = outsArg || pickSelectedOutdoors();

  outs.forEach((o, idx)=>{
    const key   = `out${idx+1}`;
    const slots = Array.from(document.querySelectorAll(`.out-slot[data-out="${key}"]`));

    let csum = 0;
    const filled = [];
    const codes  = [];

    slots.forEach((slot, i)=>{
      const inp = slot.querySelector('.cap-input');
      const cell = slot.parentElement.querySelector('.code-cell');
      if(!cell) return;

      const val = parseInt(inp?.value || '0', 10);
      if(!val){
        cell.textContent = '-';
        cell.dataset.code = '-';
        codes[i] = '-';
        return;
      }

      csum += val;
      filled.push(i);

      let code = '-';
      if(filled.length > 1){
        code = typeof codeByCumulativeSum === 'function'
          ? (codeByCumulativeSum(csum) || '-')
          : (csum<=1200 ? '1509' : csum<=2000 ? '2512' : csum<=2800 ? '2812' : csum<=3100 ? '2815' : csum<=3800 ? '3419' : '4119');
      }
      cell.textContent = code;
      cell.dataset.code = code;
      codes[i] = code;
    });

    if(filled.length > 1){
      const lastI = filled[filled.length-1];
      const zLast = slots[lastI];
      const cell  = zLast?.parentElement?.querySelector('.code-cell');
      if(cell){
        const def = codes[lastI] || cell.dataset.code || cell.textContent || '-';
        const m  = String(o.model||'').match(/^AM\s*-?\s*(\d{3})/i);
        const hp = m ? parseInt(m[1],10) : 0;
        const forced = typeof codeByOutdoorHP === 'function' ? codeByOutdoorHP(hp, def) : def;

        cell.textContent  = forced;
        cell.dataset.code = forced;
      }
    }
  });

  const totals = { '1509':0,'2512':0,'2812':0,'2815':0,'3419':0,'4119':0 };
  document.querySelectorAll('.code-cell').forEach(c=>{
    const k=(c.dataset.code||'').trim(); if(k in totals) totals[k]+=1;
  });
  Object.entries(totals).forEach(([k,v])=>{
    const el = document.querySelector(`#branchSummaryBar [data-k="${k}"] b`);
    const extraInp = document.querySelector(`#branchSummaryBar [data-k="${k}"] .extra-branch`);
    const extraVal = extraInp ? parseInt(extraInp.value || '0', 10) : 0;
    if(el) el.textContent = String(v + extraVal);
  });

  if(typeof pushBranchPartsToCommFromBadges==='function') pushBranchPartsToCommFromBadges();
  saveBranchState();
}

