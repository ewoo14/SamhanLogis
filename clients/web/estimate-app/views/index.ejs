    ['냉방소비전력(정격, kW)', s.cool_power||''],
    ['냉매가스', s.gas||''],
    ['에너지소비효율등급', s.effGrade||''],
    ['전원선(m²)', s.powerLine||''],
    ['차단기(A)', s.breaker||''],
    ['제품크기(mm)\n(WxHxD)', s.size||''],
    ['제품중량(kg)', s.weight ? s.weight + 'kg' : ''],
    ['포장치수(WxHxD)', s.packSize||''],
    ['포장중량(kg)', s.packWeight ? s.packWeight + 'kg' : ''],
    ['배관길이(m)', s.maxPipe||''],
    ['고낙차(m)', s.maxDrop||'']
  ];

  const model = item?.model;
  const rawData = model ? homeRowByModel.get(model) : null;
  const maxInd = rawData?.maxIndoor || s?.maxIndoor;
  
  if (catL === '실외기' && maxInd) {
    rows.push(['최대 실내기 연결 허용 대수', maxInd + '대']);
  }

  return specTable_(rows, {coolIdx:[1,2,3]});
}

// 싱글중대형 스펙
function renderSingleSpec_(catL, item, s){
  const parts = explodeSetParts(item, 1, null) || [];
  const compSpecsHtml = renderComponentSpecs_(parts, s, 'single');
  const groups = { indoor:[], outdoor:[], panel:[], remote:[], material:[], wall:[] };

  // 분류
  parts.forEach(p=>{
    const kind = String(p?.kind || '');
    const name = String(p?.name || '');
    const label = String(p?.model || p?.name || '').trim();
    if(!label) return;

    // 1. 구분(kind) 데이터 우선 적용
    if(kind.includes('실내기')) groups.indoor.push(label);
    else if(kind.includes('실외기')) groups.outdoor.push(label);
    else if(/리모컨|리모콘/.test(kind)) groups.remote.push(label);
    else if(/판넬|패널/.test(kind)) groups.panel.push(label);
    else if(kind.includes('자재')) groups.material.push(label);
    else if(kind.includes('벽걸이')) groups.wall.push(label);
    // 2. 구분이 없거나 매칭되지 않을 경우 품명(name) 검사 (자재 우선)
    else {
      if(/실내기/.test(name)) groups.indoor.push(label);
      else if(/실외기/.test(name)) groups.outdoor.push(label);
      else if(/리모컨|리모콘/.test(name)) groups.remote.push(label);
      else if(/판넬|패널|panel/i.test(name)) groups.panel.push(label);
      else if(/자재|호스|배관|배선|케이블|동파이프|브라켓|받침대|발통/.test(name)) groups.material.push(label);
      else if(/벽걸이/.test(name)) groups.wall.push(label);
    }
  });

  const compLines = [];
  if(groups.indoor.length)  compLines.push('[실내기] ' + groups.indoor.join(', '));
  if(groups.outdoor.length) compLines.push('[실외기] ' + groups.outdoor.join(', '));
  if(groups.wall.length)    compLines.push('[벽걸이] ' + groups.wall.join(', '));
  if(groups.panel.length)   compLines.push('[판넬] ' + groups.panel.join(', '));
  if(groups.remote.length)  compLines.push('[리모컨] ' + groups.remote.join(', '));
  if(groups.material.length)compLines.push('[자재] ' + groups.material.join(', '));
  
  const sizeLines = [];
  if (s && s.inSize)  sizeLines.push('[실내기] ' + s.inSize);
  if (s && s.outSize) sizeLines.push('[실외기] ' + s.outSize);
  const sizeText = sizeLines.join('<br>');

  const weightLines = [];
  if (s && s.inWeight)  weightLines.push('[실내기] ' + s.inWeight + 'kg');
  if (s && s.outWeight) weightLines.push('[실외기] ' + s.outWeight + 'kg');
  const weightText = weightLines.join('<br>');

  const packSizeLines = [];
  if (s && s.inPackSize)  packSizeLines.push('[실내기] ' + s.inPackSize);
  if (s && s.outPackSize) packSizeLines.push('[실외기] ' + s.outPackSize);
  const packSizeText = packSizeLines.join('<br>');

  const packWeightLines = [];
  if (s && s.inPackWeight)  packWeightLines.push('[실내기] ' + s.inPackWeight + 'kg');
  if (s && s.outPackWeight) packWeightLines.push('[실외기] ' + s.outPackWeight + 'kg');
  const packWeightText = packWeightLines.join('<br>');

  if(catL === '판넬'){
    const rowsPanel = [
      ['구성', compLines.join('<br>')],
      ['타공사이즈(mm)', s.cool_cap_kcal || ''],
      ['전산볼트간격(mm)', s.cool_pow_kw || ''],
      ['제품크기(mm)\n(WxHxD)', sizeText || ''],
      ['제품중량(kg)', weightText || ''],
      ['포장치수(mm)\n(WxHxD)', packSizeText || ''],
      ['포장중량(kg)', packWeightText || '']
    ];
    return specTable_(rowsPanel, { coolIdx:[1], heatIdx:[] }) + compSpecsHtml;
  }

  const rows = [
    ['구성', compLines.join('<br>')],
    ['배관경(액관/가스관)', s.pipeDia || ''],
    ['냉방성능(kcal/h) (최소/정격/최대)', s.cool_cap_kcal || ''],
    ['난방성능(kcal/h) (최소/정격/최대)', s.heat_cap_kcal || ''],
    ['냉방성능(kW) (최소/정격/최대)', s.cool_cap_kw || ''],
    ['난방성능(kW) (최소/정격/최대)', s.heat_cap_kw || ''],
    ['냉방소비전력(kW) (최소/정격/최대)', s.cool_pow_kw || ''],
    ['난방소비전력(kW) (최소/정격/최대)', s.heat_pow_kw || ''],
    ['냉매가스', s.gas || ''],
    ['에너지소비효율등급', s.grade || ''],
    ['전원선(mm²)', s.powerLine || ''],
    ['차단기(A)', s.breaker || ''],
    ['제품크기(mm)\n(WxHxD)', sizeText || ''],
    ['제품중량(kg)', weightText || ''],
    ['포장치수(mm)\n(WxHxD)', packSizeText || ''],
    ['포장중량(kg)', packWeightText || ''],
    ['배관길이(m)', s.pipeLen || ''],
    ['고낙차(m)', s.drop || '']
  ];

  return specTable_(rows, { coolIdx:[2,4,6], heatIdx:[3,5,7] }) + compSpecsHtml;
}

// 상업멀티 스펙
function renderCommSpec_(catL, item, s){
  if(!s || typeof s !== 'object') s = {};

  const txt = `${item?.name||''} ${item?.disp||''} ${item?.feat||''} ${item?.catM||''}`;
  const isErv = /전열교환기/i.test(txt);
  if(isErv){
    return renderErvSpec_(s);
  }

  const isSetOutdoor = (catL==='실외기' && String(item?.unit||'').toUpperCase()==='SET');
  // 상업멀티 구성품 사양: 상업 카탈로그 단위는 전부 EA(SET 없음)이므로 단위 무관, 세트 실외기가
  // 구성품(COMM_PARTS refModel 매칭)을 보유하면 표시. 기존 compLine 은 isSetOutdoor 로직 무변경 유지.
  const compParts = (catL==='실외기') ? (explodeCommSets_(item, 1) || []) : [];
  const compSpecsHtml = renderComponentSpecs_(compParts, s, 'comm');

  let compLine = '';
  if(isSetOutdoor){
    const models = compParts.map(p=>String(p?.model||'').trim()).filter(Boolean);
    if(models.length) compLine = models.join('<br>');
  }

  // 상업멀티는 실내기/실외기에 따라 in/out 접두사가 붙을 수 있으므로 fallback 처리 추가
  const w = s.weight || s.outWeight || s.inWeight || '';
  const pS = s.packSize || s.outPackSize || s.inPackSize || '';
  const pW = s.packWeight || s.outPackWeight || s.inPackWeight || '';
  const sz = s.size || s.outSize || s.inSize || '';

  if(catL==='판넬'){
    const rowsPanel = [
      ...(compLine ? [['구성', compLine]] : []),
      ['타공사이즈(mm)', s.cool_cap_kcal || ''],
      ['전산볼트간격(mm)', s.cool_pow_kw || ''],
      ['제품크기(mm)\n(WxHxD)', sz],
      ['제품중량(kg)', w ? w + 'kg' : ''],
      ['포장치수(mm)\n(WxHxD)', pS],
      ['포장중량(kg)', pW ? pW + 'kg' : '']
    ];
    return specTable_(rowsPanel, {noTone:true}) + compSpecsHtml;
  }

  const rows = [
    ...(compLine ? [['구성', compLine]] : []),
    ['배관경(액관/가스관)', s.pipeDia || ''],
    ['냉방성능(정격, kcal/h)', s.cool_cap_kcal || ''],
    ['난방성능(정격, kcal/h)', s.heat_cap_kcal || ''],
    ['냉방성능(정격, kW)', s.cool_cap_kw || ''],
    ['난방성능(정격, kW)', s.heat_cap_kw || ''],
    ['냉방소비전력(정격, kW)', s.cool_pow_kw || ''],
    ['난방소비전력(정격, kW)', s.heat_pow_kw || ''],
    ['냉매가스', s.gas || ''],
    ['소비효율등급', s.grade || ''],
    ['전원선(m²)', s.powerLine || ''],
    ['차단기(A)', s.breaker || ''],
    ['제품크기(mm)\n(WxHxD)', sz],
    ['제품중량(kg)', w ? w + 'kg' : ''],
    ['포장치수(mm)\n(WxHxD)', pS],
    ['포장중량(kg)', pW ? pW + 'kg' : '']
  ];

  const needTriple_ = v => {
    const s0 = String(v || '').trim();
    if(!s0) return false;
    if(!s0.includes('/')) return false;
    const parts = s0.split('/').map(x=>String(x).trim()).filter(Boolean);
    return parts.length >= 3;
  };

  let pipeTriple = null;
  let dropTriple = null;

  if(needTriple_(s.maxPipe)){
    pipeTriple = buildTripleSpecRows_(
      '배관길이(m)',
      s.maxPipe,
      ['실외기-실내기','첫 분기관-실내기','총 배관길이']
    );
  }else{
    rows.push(['배관길이(m)', s.maxPipe || '']);
  }

  if(needTriple_(s.maxDrop)){
    dropTriple = buildTripleSpecRows_(
      '고낙차(m)',
      s.maxDrop,
      ['실외기가 높은 경우','실내기가 높은 경우','실내기-실내기']
    );
  }else{
    rows.push(['고낙차(m)', s.maxDrop || '']);
  }

  if (catL === '실외기' && item && item.maxIndoor) {
    rows.push(['최대 실내기 연결 허용 대수', item.maxIndoor + '대']);
  }

  const compOffset = compLine ? 1 : 0;
  const toneOpt = {
    coolIdx:[1+compOffset,3+compOffset,5+compOffset],
    heatIdx:[2+compOffset,4+compOffset,6+compOffset]
  };

  if(pipeTriple || dropTriple){
    return specTableWithTriple_(rows, pipeTriple, dropTriple, toneOpt) + compSpecsHtml;
  }

  return specTable_(rows, toneOpt) + compSpecsHtml;
}

function renderErvSpec_(s){
  if(!s || typeof s !== 'object') s = {};

  const clean_ = v => {
    const t = String(v || '').trim();
    if(!t) return '';
    if(t === '-') return '';
    return t;
  };

  const join_ = (...vals) => {
    const parts = vals.map(clean_).filter(Boolean);
    return parts.join(' / ');
  };

  const coolFallback = join_(s.cool_cap_kcal, s.cool_cap_kw, s.cool_pow_kw);
  const heatFallback = join_(s.heat_cap_kcal, s.heat_cap_kw, s.heat_pow_kw);

  const coolVal =
    clean_(s.cool_power) ||
    coolFallback ||
    clean_(s.cool_kcal) ||
    '';

  const heatVal =
    clean_(s.heat_power) ||
    heatFallback ||
    clean_(s.heat_kcal) ||
    '';

  const sz = clean_(s.size || s.outSize || s.inSize);

  const rows = [
    ['덕트구경', clean_(s.gas)],
    ['소비전력(전열환기)', coolVal],
    ['소비전력(일반환기)', heatVal],
    ['제품크기(mm)\n(WxHxD)', sz],
    ['제품중량(kg)', clean_(s.weight) ? clean_(s.weight) + 'kg' : '']
  ];

  return specTable_(rows, { noTone:true });
}

// 판넬 공통
function renderPanelSpecCommon_(catL, p){
  const rows = [
    ['타공사이즈(mm)', p.holeSize||''],
    ['전산볼트간격(mm)', p.boltGap||''],
    ['제품크기(mm)\n(WxHxD)', p.size||''],
    ['제품중량(kg)', p.weight ? p.weight + 'kg' : ''],
    ['포장치수(mm)\n(WxHxD)', p.packSize||''],
    ['포장중량(kg)', p.packWeight ? p.packWeight + 'kg' : '']
  ];
  return specTable_(rows, {noTone:true});
}

function buildTripleSpecRows_(title, raw, labels){
  const s = String(raw||'').trim();
  if(!s.includes('/')) return null;

  const parts = s.split('/').map(x=>x.trim()).filter(Boolean);
  if(parts.length!==3) return null;

  return parts.map((v,i)=>({
    left:title,
    rightLabel:labels[i],
    value:v,
    isFirst:i===0
  }));
}

function specTableWithTriple_(rows, pipeTriple, dropTriple, opt){
  const coolIdx = opt?.coolIdx || [];
  const heatIdx = opt?.heatIdx || [];
  const noTone = !!opt?.noTone;

  const hasTriple = !!pipeTriple || !!dropTriple;

  let html = `<table class="spec-table"><tbody>`;

  rows.forEach((r, i)=>{
    if(!r) return;
    const vCls = noTone ? '' : (coolIdx.includes(i) ? 'cool' : heatIdx.includes(i) ? 'heat' : '');
    const val = (r[1] === undefined || r[1] === null || String(r[1]).trim() === '') ? '-' : r[1];
    const labelHtml = estimateSpecValueHtml(r[0]);
    const valHtml = estimateSpecValueHtml(val);
    if(hasTriple){
      html += `
        <tr>
          <th class="spec-h">${labelHtml}</th>
          <td class="${vCls}" colspan="2">${valHtml}</td>
        </tr>`;
    }else{
      html += `
        <tr>
          <th class="spec-h">${labelHtml}</th>
          <td class="${vCls}">${valHtml}</td>
        </tr>`;
    }
  });

  const triples = [];
  if(pipeTriple) triples.push(pipeTriple);
  if(dropTriple) triples.push(dropTriple);

  triples.forEach(tri=>{
    tri.forEach(t=>{
      html += `<tr>`;
      if(t.isFirst){
        html += `<th class="spec-h" rowspan="3">${estimateSpecValueHtml(t.left)}</th>`;
      }
      html += `<th class="spec-h sub">${estimateSpecValueHtml(t.rightLabel)}</th>`;
      const tVal = (t.value === undefined || t.value === null || String(t.value).trim() === '') ? '-' : t.value;
      html += `<td>${estimateSpecValueHtml(tVal)}</td>`;
      html += `</tr>`;
    });
  });

  html += `</tbody></table>`;
  return html;
}

function renderComponentSpecs_(parts, setSpec, scope){
  if(!Array.isArray(parts) || !parts.length) return '';
  const s = (setSpec && typeof setSpec === 'object') ? setSpec : {};

  const clean_ = v => {
    const t = String(v ?? '').trim();
    return t && t !== '-' ? t : '';
  };
  const html_ = v => clean_(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
  const withKg_ = v => {
    const t = clean_(v);
    return t ? t + 'kg' : '';
  };
  const isIndoor_ = p => {
    const kind = String(p?.kind || '');
    const name = String(p?.name || '');
    return kind.includes('실내기') || kind.toUpperCase().includes('INDOOR') || /실내기/.test(name);
  };
  const isOutdoor_ = p => {
    const kind = String(p?.kind || '');
    const name = String(p?.name || '');
    return kind.includes('실외기') || kind.toUpperCase().includes('OUTDOOR') || /실외기/.test(name);
  };
  // 구성품 구분(kind) 한글 라벨 — DB 모드는 BE enum(영문), legacy 시트 모드는 한글. 영문은 한글 매핑,
  // 미매칭(legacy 한글 포함)은 원본 유지하여 모달 내 "구성" 행 한글 라벨과 표기 일관.
  const KIND_KO = { INDOOR:'실내기', OUTDOOR:'실외기', PANEL:'판넬', REMOTE:'리모컨',
    MATERIAL:'자재', ACCESSORY:'부속', FOOT:'받침대', WALL:'벽걸이' };
  const kindLabel_ = k => {
    const t = clean_(k);
    return t ? (KIND_KO[t.toUpperCase()] || t) : '';
  };
  const detailRows_ = detail => {
    if(!detail || typeof detail !== 'object') return [];
    const rows = [
      ['배관경(액관/가스관)', detail.pipeDia],
      ['냉방성능(kcal/h)', detail.cool_cap_kcal || detail.cool_kcal],
      ['난방성능(kcal/h)', detail.heat_cap_kcal || detail.heat_kcal],
      ['냉방성능(kW)', detail.cool_cap_kw || detail.cool_kw],
      ['난방성능(kW)', detail.heat_cap_kw || detail.heat_kw],
      ['냉방소비전력(kW)', detail.cool_pow_kw || detail.cool_power],
      ['난방소비전력(kW)', detail.heat_pow_kw || detail.heat_power],
      ['냉매가스', detail.gas],
      ['전원선(mm²)', detail.powerLine],
      ['차단기(A)', detail.breaker],
      ['제품크기(mm) (WxHxD)', detail.size],
      ['제품중량(kg)', withKg_(detail.weight)],
      ['포장치수(mm) (WxHxD)', detail.packSize],
      ['포장중량(kg)', withKg_(detail.packWeight)],
      ['최대장배관(m)', detail.maxPipe],
      ['최대고저차(m)', detail.maxDrop]
    ];
    return rows.filter(r => clean_(r[1]));
  };

  const blocks = [];
  parts.forEach(p => {
    if(scope === 'comm' && p?.isSetFallback) return;

    const rows = [];
    if(Array.isArray(p?.specs) && p.specs.length){
      p.specs.forEach(spec => {
        const key = clean_(spec?.specKey);
        const value = clean_(spec?.specValue);
        if(!key || !value) return;
        const unit = clean_(spec?.unit);
        rows.push([key, value + (unit ? ' ' + unit : '')]);
      });
    }
    if(!rows.length){
      const modelSpec = SPEC_DETAIL_MAP?.[clean_(p?.model)]?.[scope];
      rows.push(...detailRows_(modelSpec));
    }
    if(!rows.length && scope === 'single' && isIndoor_(p)){
      rows.push(
        ['제품크기(mm) (WxHxD)', clean_(s.inSize)],
        ['제품중량(kg)', withKg_(s.inWeight)],
        ['포장치수(mm) (WxHxD)', clean_(s.inPackSize)],
        ['포장중량(kg)', withKg_(s.inPackWeight)]
      );
    }else if(!rows.length && scope === 'single' && isOutdoor_(p)){
      rows.push(
        ['제품크기(mm) (WxHxD)', clean_(s.outSize)],
        ['제품중량(kg)', withKg_(s.outWeight)],
        ['포장치수(mm) (WxHxD)', clean_(s.outPackSize)],
        ['포장중량(kg)', withKg_(s.outPackWeight)]
      );
    }

    const validRows = rows.filter(r => r && clean_(r[0]) && clean_(r[1]));
    if(!validRows.length) return;

    const kind = kindLabel_(p?.kind);
    const model = clean_(p?.model);
    const name = clean_(p?.name);
    const head = (kind ? '[' + kind + '] ' : '') + (model || name) + (model && name ? ' · ' + name : '');
    blocks.push('<div class="comp-spec-block"><div class="comp-spec-head">'
      + html_(head)
      + '</div>'
      + specTable_(validRows, {noTone:true})
      + '</div>');
  });

  if(!blocks.length) return '';
  return '<div class="comp-spec-section"><div class="comp-spec-title">구성품별 사양</div>'
    + blocks.join('')
    + '</div>';
}

// 표 렌더러
function specTable_(rows, opt){
  const coolIdx = opt?.coolIdx || [];
  const heatIdx = opt?.heatIdx || [];
  const noTone = !!opt?.noTone;

  let html = `<table class="spec-table"><tbody>`;
  rows.forEach((r, i)=>{
    if(!r) return;
    const vCls = noTone ? '' : (coolIdx.includes(i) ? 'cool' : heatIdx.includes(i) ? 'heat' : '');
    const val = (r[1] === undefined || r[1] === null || String(r[1]).trim() === '') ? '-' : r[1];
    html += `
      <tr>
        <th class="spec-h">${estimateSpecValueHtml(r[0])}</th>
        <td class="${vCls}">${estimateSpecValueHtml(val)}</td>
      </tr>`;
  });
  html += `</tbody></table>`;
  return html;
}

