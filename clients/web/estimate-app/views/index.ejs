/* 타이머 */
function initAutoLogout() {
  let logoutTimer;
  let expireTime;

  /* 화면갱신 */
  function updateTimerDisplay() {
    const timerEl = document.getElementById('autoLogoutTimer');
    if (!timerEl) return;
    
    const now = Date.now();
    const timeLeft = Math.max(0, Math.floor((expireTime - now) / 1000));
    
    const hours = Math.floor(timeLeft / 3600);
    const minutes = Math.floor((timeLeft % 3600) / 60);
    const seconds = timeLeft % 60;
    const timeStr = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
    const timeColor = timeLeft < 60 ? '#dc2626' : '#2563eb';
    
    timerEl.innerHTML = '<span style="font-size:12px; color:var(--c-strong, #000); font-weight:normal;">자동 로그아웃:</span><br><span style="font-size:16px; color:' + timeColor + '; font-weight:bold;">' + timeStr + '</span>';
    
    if (timeLeft <= 0) {
      clearInterval(logoutTimer);
      window.close();
      document.body.innerHTML = '<div style="display:flex;height:100vh;justify-content:center;align-items:center;font-size:24px;font-weight:bold;color:var(--c-strong, #000);">자동 로그아웃 되었습니다.</div>';
    }
  }

  /* 리셋 */
  function resetTimer() {
    expireTime = Date.now() + (5 * 3600 * 1000);
    clearInterval(logoutTimer);
    updateTimerDisplay();
    logoutTimer = setInterval(updateTimerDisplay, 1000);
  }

  ['mousemove', 'keydown', 'mousedown', 'touchstart'].forEach(evt => {
    document.addEventListener(evt, resetTimer);
  });

  resetTimer();
}

/* CSP script-src-attr 가 inline 이벤트 실행을 차단하므로, 기존 템플릿 이벤트를
 * DOM 리스너로 옮긴다. 동적으로 생성되는 견적 행/조회 결과도 같은 규칙을 적용한다. */
function installCspEventListeners(root = document) {
  const eventNames = ['click', 'change', 'input', 'focus', 'blur', 'keydown', 'keyup', 'submit'];
  const elements = root.querySelectorAll ? root.querySelectorAll('*') : [];
  const targets = root.nodeType === 1 ? [root, ...elements] : [...elements];

  targets.forEach((element) => {
    eventNames.forEach((eventName) => {
      const attributeName = `on${eventName}`;
      const source = element.getAttribute(attributeName);
      if (source === null || element.dataset[`csp${eventName}Bound`]) return;

      // 기존 inline handler의 this/event 의미를 보존하되, 실행은 addEventListener에서 한다.
      const handler = new Function('event', source);
      element.addEventListener(eventName, function cspEventHandler(event) {
        return handler.call(element, event);
      });
      element.removeAttribute(attributeName);
      element.dataset[`csp${eventName}Bound`] = 'true';
    });
  });
}

document.addEventListener('DOMContentLoaded', () => {
  installCspEventListeners();
  document.getElementById('btnSaveSnapshot')?.addEventListener('click', () => handleSaveSnapshot());
  document.getElementById('btnLoadSnapshot')?.addEventListener('click', () => goSnapshotPage());

  const observer = new MutationObserver((mutations) => {
    mutations.forEach(({ addedNodes }) => {
      addedNodes.forEach((node) => {
        if (node.nodeType === Node.ELEMENT_NODE) installCspEventListeners(node);
      });
    });
  });
  observer.observe(document.body, { childList: true, subtree: true });
});
