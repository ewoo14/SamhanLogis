/* 전표업로드목록 렌더링 */
function renderFinalContent() {
  const body = document.getElementById('finalBody');
  if (!body) return;
  body.innerHTML = '';

  /* 데이터생성 */
  const itemsRaw = typeof buildSendRows === 'function' ? buildSendRows() : [];
  const items = typeof aggregateSendRows === 'function' ? aggregateSendRows(itemsRaw) : itemsRaw;

  /* 데이터보정 */
  items.forEach(it => {
    if (it.sub === undefined) it.sub = (it.qty || 0) * (it.price || 0);
    if (!it.note) it.note = '';
  });

  /* 스타일상수 */
  const B_LIG = '#e5e7eb';
  const PAD   = '4px 12px';
  const tdBase = `padding:${PAD}; border-right:1px solid ${B_LIG};`;
  const tdLast = `padding:${PAD};`;

  /* 순서유지 */
  const currentHash = items.map(it => `${it.model}|${it.qty}|${it.price}`).join('||');
  if (window.CUSTOM_FINAL_HASH === currentHash && window.CUSTOM_FINAL_ORDER) {
    const orderMap = new Map(window.CUSTOM_FINAL_ORDER.map((k, i) => [k, i]));
    items.sort((a, b) => {
      const ka = `${a.model}|${a.qty}|${a.price}`;
      const kb = `${b.model}|${b.qty}|${b.price}`;
      const ia = orderMap.has(ka) ? orderMap.get(ka) : 999;
      const ib = orderMap.has(kb) ? orderMap.get(kb) : 999;
      return ia - ib;
    });
  } else {
    window.CUSTOM_FINAL_HASH = currentHash;
    window.CUSTOM_FINAL_ORDER = items.map(it => `${it.model}|${it.qty}|${it.price}`);
  }

  /* 예외처리 */
  if (items.length === 0) {
    body.innerHTML = '<tr><td colspan="6" style="padding:40px 0; text-align:center; color:#9ca3af;">선택된 품목이 없습니다.</td></tr>';
  } else {
    /* 목록출력 */
    items.forEach(it => {
      const tr = document.createElement('tr');
      tr.style.borderBottom = `1px dotted ${B_LIG}`;
      tr.style.background = '#fff';
      tr.dataset.key = `${it.model}|${it.qty}|${it.price}`;

      const currentSub = (it.qty || 0) * (it.price || 0);

      tr.innerHTML = `
        <td class="drag-handle" style="text-align:center; padding:4px 0; border-right:1px solid ${B_LIG}; cursor:grab; color:#9ca3af; font-size:18px; user-select:none; font-weight:bold;">=</td>
        <td style="text-align:left; ${tdBase}">${escapeEstimateHtml(it.name)}</td>
        <td class="model" style="${tdBase} color:#6b7280; font-size:0.9em;">${escapeEstimateHtml(it.model)}</td>
