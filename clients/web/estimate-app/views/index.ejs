      if (isCard) vParts.push('카드 수수료 포함');
      if (isAdvance) vParts.push('선금 할인 포함');
      
      const vLabelHtml = vParts.length > 0 ? ' <span style="font-weight:normal; font-size:12px !important; margin-left:4px;">(' + vParts.join('/') + ')</span>' : '';

      const trGrand = document.createElement('tr');
      trGrand.style.cssText = 'height: 27px !important;';
      trGrand.innerHTML = '<td colspan="' + labelSpan + '" style="vertical-align: middle; background:#F5D2A9; border-top:' + B_TOP_BOT + '; border-bottom:' + B_TOP_BOT + '; padding:4px 8px !important; height:27px !important; text-align:left; font-weight:bold; font-size:12px !important; color:' + C_TXT + '; border-left:' + B_SIDE + '; border-right:1px solid ' + B_IN_COLOR + '; line-height:1.2 !important;">총 견적 합계' + vLabelHtml + '</td>' +
                          '<td style="vertical-align: middle; background:#F5D2A9; border-top:' + B_TOP_BOT + '; border-bottom:' + B_TOP_BOT + '; padding:4px 8px !important; height:27px !important; text-align:right; font-weight:bold; font-size:12px !important; color:' + C_TXT + '; border-right:' + B_SIDE + '; line-height:1.2 !important;"><span class="auto-shrink">' + fmt(grandTotal) + '</span></td>';
      tFoot.appendChild(trGrand);

      // 안내
      const trNote = document.createElement('tr');
      trNote.innerHTML = '<td colspan="' + totalCols + '" style="padding: 6px 4px !important; text-align: left; font-size: 8px !important; color: #555; line-height: 1.4 !important; border-left:' + B_SIDE + '; border-right:' + B_SIDE + '; border-bottom:' + B_SIDE + ';">' + getFooterNoticeHtml() + '</td>';
      tFoot.appendChild(trNote);

      // 축소
      wrapper.querySelectorAll('.auto-shrink').forEach(span => {
        const td = span.parentElement;
        let fs = parseFloat(window.getComputedStyle(td).fontSize) || 9;
        span.style.fontSize = fs + 'px';
        const availWidth = td.clientWidth - 8; 
        while (span.offsetWidth > availWidth && fs > 4) {
          fs -= 0.2;
          span.style.fontSize = fs + 'px';
        }
      });

      // 캡처
      const canvas = await html2canvas(wrapper, {
        scale: 2,
        backgroundColor: "#ffffff",
        windowWidth: 580,
        useCORS: true
      });
      
      let targetCanvas = canvas;
      let quality = 0.7;
      let scaleFactor = 1.0;
      
      imgBase64 = targetCanvas.toDataURL('image/jpeg', quality);
      let totalPayload = baseSize + imgBase64.length;
      
      // 조절
      while (totalPayload > targetSize && (quality > 0.3 || scaleFactor > 0.5)) {
        if (quality > 0.3) {
          quality -= 0.1;
        } else {
          scaleFactor -= 0.1;
          targetCanvas = document.createElement('canvas');
          targetCanvas.width = Math.floor(canvas.width * scaleFactor);
          targetCanvas.height = Math.floor(canvas.height * scaleFactor);
          const ctx = targetCanvas.getContext('2d');
          ctx.drawImage(canvas, 0, 0, targetCanvas.width, targetCanvas.height);
        }
        imgBase64 = targetCanvas.toDataURL('image/jpeg', Number(quality.toFixed(2)));
        totalPayload = baseSize + imgBase64.length;
      }
      
    } catch(e) {
    } finally {
      if(wrapper.parentNode) document.body.removeChild(wrapper);
    }
  }

  // 전송 — 상태는 JSON 그대로 보내고 미리보기 base64는 저장하지 않는다.
  const screenTotal = getStructuredQuoteData().reduce((sum, section) => sum + (Number(section.total) || 0), 0);
  const vatDisplay = document.querySelector('input[name="optVatDisplay"]:checked')?.value || 'inc';
  const totals = vatDisplay === 'exc'
    ? { supplyAmount: screenTotal, vatAmount: Math.floor(screenTotal * 0.1), totalAmount: screenTotal + Math.floor(screenTotal * 0.1) }
    : { supplyAmount: screenTotal - Math.floor(screenTotal / 11), vatAmount: Math.floor(screenTotal / 11), totalAmount: screenTotal };
  google.script.run
    .withSuccessHandler(() => {
      alert('✅ 안전하게 저장되었습니다!');
      if (btn) {
        btn.textContent = orgText;
        btn.disabled = false;
      }
      logAction('기능', '견적저장 성공');
