function isExpansionModel(s) {
  if (!s || !s.model) return false;
  const m = String(s.model).toUpperCase();
  const name = String(s.name || '').toLowerCase();
  if (m.startsWith('AC') && m.length >= 7 && m.substring(5, 7) === 'CS') {
    return name.includes('프레스티지');
  }
  if (m.startsWith('AP') && m.length >= 7 && m.substring(5, 7) === 'CA') return true;
  if (m.startsWith('AF70') && m.length >= 10 && (m.substring(8, 10) === '24' || m.substring(8, 10) === '25')) return true;
  if (m.startsWith('AF80') || m.startsWith('AF90')) return true;
  return false;
}

function classifySingleSetFixed(s){
  const hay=((s?.name||'')+' '+(s?.model||'')+' '+(s?.spec||'')).toLowerCase();
  const mdl=(s?.model||'').trim();
  if (/^ADP-F075SP$/i.test(mdl)) {return { catL: '부자재', catM: '' };}
  const has=rx=>rx.test(hay);const any=(...r)=>r.some(has);
  const isCoolOnly=any(/냉방전용/,/냉전/),isHeatCool=/냉난방/.test(hay);
  let L='기타',M='';
  if(any(/발통/,/일자발/,/받침/)){L='실외기 받침';}
  else if(any(/360/,/cst/)){L='360';if(any(/cst\s*uv/,/uv/)) M='CST UV';}
  else if(any(/4\s*way/,/4way/)){if(isHeatCool)L='4way 냉난방';else if(isCoolOnly)L='4way 냉방전용';if(L==='4way 냉난방'){if(/프레스티지/.test(hay))M='프레스티지';else if(any(/프리미엄/,/디럭스/))M='프리미엄/디럭스';else if(/1\s*등급/.test(hay))M='1등급';}}
  else if(any(/1\s*way/,/1way/)){if(isHeatCool)L='1way 냉난방';else if(isCoolOnly)L='1way 냉방전용';}
  else if(any(/덕트/,/duct/)){L='덕트';}
  else if(/실링/.test(hay)){L='실링';}
  else if(/스탠드/.test(hay)){
    if(/비스포크/.test(hay)){L='비스포크 스탠드';if(/콰이엇\s*그레이/i.test(hay))M='콰이엇 그레이';else if(/세이지\s*블루/i.test(hay))M='세이지 블루';else if(/프라임\s*핑크/i.test(hay))M='프라임 핑크';}
    else if(isHeatCool){L='냉난방 스탠드';if(/프레스티지/.test(hay))M='프레스티지';else if(any(/프리미엄/,/디럭스/))M='프리미엄/디럭스';else if(/1\s*등급/.test(hay))M='1등급';}
    else if(isCoolOnly){L='냉전 스탠드';if(/프레스티지/.test(hay))M='프레스티지';}
  }else if(/벽걸이/.test(hay)){
    if(isHeatCool){L='냉난방 벽걸이';if(/무풍/.test(hay))M='무풍';}else if(isCoolOnly){L='냉전 벽걸이';M=/무풍/.test(hay)?'무풍':'일반';}
  }else if(/가정용/.test(hay)){
    // 가정용 에어컨 단일 대분류 5개 중분류로 정리
    const isPro = /무풍\s*콤보\s*갤러리\s*프로/i.test(hay) || /콤보\s*갤러리\s*프로/i.test(hay) || /무풍\s*ai\s*콤보\s*프로/i.test(hay) || /ai\s*콤보\s*프로/i.test(hay);
    const isGallery = /무풍갤러리/i.test(hay);
    const isClassic = /무풍클래식/i.test(hay);
    const isQ9000 = /q9000/i.test(hay);

    L='가정용 에어컨';
    if(isPro) M='무풍콤보 갤러리프로';
    else if(isQ9000) M='Q9000';
    else if(isClassic) M='무풍클래식';
    else if(isGallery) M='무풍갤러리';
    else M='24년형';
  }
  if(L==='기타'&&any(/kit|키트|중계기|리모컨|유연호스|드레인펌프|유선보드|board|보드|멀티\s*wifi/i)){L='부자재';}
  return {catL:unifyCatL_(L),catM:M};
}

