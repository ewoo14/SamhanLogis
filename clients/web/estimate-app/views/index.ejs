}

// 세트 베이스 할인 계산
function adjustSingleSetBasePrice(s, base){
  const rawName = String(s.nameRaw || s.name || '');
  const model   = String(s.model || '');
  let v = Math.round(Number(base) || 0);

  // 부자재 차단
  const isAcc = (s.catL === 'acc') ||
    /리모컨|리모콘|자재|부자재|보드|키트|KIT|중계기|발통|드레인펌프|일자발|분\s*기\s*관|분기관/i.test(rawName);
  if (isAcc) return v;

  if(!/^(AC|AP|AR|AF)/i.test(model)) return v;

  const flags = getModelFlags(model);

  // UI에서 값 읽기
  const d360    = parseInt(el('#ss_disc_360')?.value || 0, 10);
  const d4way   = parseInt(el('#ss_disc_4way')?.value || 0, 10);
  const dStand  = parseInt(el('#ss_disc_stand')?.value || 0, 10);
  const d1w     = parseInt(el('#ss_disc_1way')?.value || 0, 10);
  const dDeluxe = parseInt(el('#ss_disc_deluxe')?.value || 0, 10);
  const dFirst  = parseInt(el('#ss_disc_grade1')?.value || 0, 10);

  if(flags.is360 && d360 > 0) v = Math.max(0, v - d360);
  if(flags.is4way && d4way > 0) v = Math.max(0, v - d4way);
  if(flags.isStand && dStand > 0) v = Math.max(0, v - dStand);
  if(flags.is1way && d1w > 0) v = Math.max(0, v - d1w);
  if(flags.isDeluxe && dDeluxe > 0) v = Math.max(0, v - dDeluxe);
  if(flags.isGrade1 && dFirst > 0) v = Math.max(0, v - dFirst);

  return v;
}

// 천 단위 반올림
function roundK(n){
  // 천 단위로 반올림
  return Math.round((Number(n)||0) / 1000) * 1000;
}

// 단위처리(멀티 납품가 처리)
function roundByConfig(n, prefix){
  let v = Number(n) || 0;
  
  if(!prefix) return v; 

  const elUnit = document.getElementById(prefix + '_round_unit');
  const elMode = document.getElementById(prefix + '_round_mode');

  const unit = elUnit ? parseInt(elUnit.value, 10) : 0;
  const mode = elMode ? elMode.value : 'ROUND';

  if (unit > 0) {
    const x = v / unit;
    let out;
    if (mode === 'CEIL')      out = Math.ceil(x) * unit;
    else if (mode === 'FLOOR') out = Math.floor(x) * unit;
    else                       out = Math.round(x) * unit; 
    return out;
  }
  return v;
}

// 실내기 판별
function isIndoorUnitPart(p){
  // 패널 리모컨 자재 제외
  const k = String(p?.kind||'');
  const n = String(p?.name||'');
  if (/실외기/i.test(k) || /실외기/i.test(n)) return false;
  const hasIndoor = /실내기/i.test(k) || /실내기/i.test(n);
  if (!hasIndoor) return false;
  // 부자재는 실내/외 배분 대상에서 제외
  if (isPanel(p) || isRemote(p) || isMaterial(p) || isFoot(p)) return false;
  return true;
}

// 실외기 판별
function isOutdoorUnitPart(p){
  // 구분과 이름 확인
  const k = String(p?.kind||'');
  const n = String(p?.name||'');
  const hasOutdoor = /실외기/i.test(k) || /실외기/i.test(n);
  if (!hasOutdoor) return false;
  if (isPanel(p) || isRemote(p) || isMaterial(p) || isFoot(p)) return false; // 실외기 받침대(발통) 등 제외
  return true;
}

// 잔액을 비율로 나눠 둘 다 천 단위로 맞춤
function splitIndoorOutdoorToK(setUnit, fixedSum, ratioIn, ratioOut){
  // 잔액 계산
  const remain = Math.max(0, Math.round(Number(setUnit)||0) - Math.round(Number(fixedSum)||0));

  // 비율 배분 초깃값
  const tot = ratioIn + ratioOut;
  let indoor = Math.round(remain * ratioIn / tot);
  let outdoor = remain - indoor;

  // 실내기 천 단위
  indoor = roundK(indoor);

  // 실외기 보정
  outdoor = remain - indoor;
  const mod = ((outdoor % 1000) + 1000) % 1000;
  if (mod !== 0){
    // 실내기에서 이동해 실외기 천 단위 맞춤
    if (outdoor > 0){ indoor -= mod; outdoor += mod; }
    else { indoor += (1000 - mod); outdoor -= (1000 - mod); }
  }

  // 음수 방지
  if (indoor < 0){ outdoor += indoor; indoor = 0; }
  if (outdoor < 0){ indoor += outdoor; outdoor = 0; }

  return { indoor, outdoor, remain };
}

function analyzeSingleSetDiscountFlags(s){
  const rawName = String(s.nameRaw || s.name || '');
  const model   = String(s.model || '');

  // 제외 대상 확인
  const isAcc = (s.catL === 'acc') ||
    /리모컨|리모콘|자재|부자재|보드|키트|KIT|중계기|발통|드레인펌프|일자발|분\s*기\s*관|분기관/i.test(rawName);
  
  if (isAcc) return { has360:false, has4way:false, hasStand:false, hasOneWay:false, hasDeluxe:false, hasGrade1:false };
  if(!/^(AC|AP|AR|AF)/i.test(model)) return { has360:false, has4way:false, hasStand:false, hasOneWay:false, hasDeluxe:false, hasGrade1:false };

  const flags = getModelFlags(model);

  const d360    = parseInt(el('#ss_disc_360')?.value || 0, 10);
  const d4way   = parseInt(el('#ss_disc_4way')?.value || 0, 10);
  const dStand  = parseInt(el('#ss_disc_stand')?.value || 0, 10);
  const d1w     = parseInt(el('#ss_disc_1way')?.value || 0, 10);
  const dDeluxe = parseInt(el('#ss_disc_deluxe')?.value || 0, 10);
  const dFirst  = parseInt(el('#ss_disc_grade1')?.value || 0, 10);

  return {
    has360:    d360 > 0 && flags.is360,
    has4way:   d4way > 0 && flags.is4way,
    hasStand:  dStand > 0 && flags.isStand,
    hasOneWay: d1w > 0 && flags.is1way,
    hasDeluxe: dDeluxe > 0 && flags.isDeluxe,
    hasGrade1: dFirst > 0 && flags.isGrade1
  };
}

