<script>
/* dialog polyfill */
(function(){
  const P = window.HTMLDialogElement && HTMLDialogElement.prototype;
  if(!P || !P.showModal){
    HTMLDialogElement.prototype.showModal = function(){this.setAttribute('open','');this.style.display='block';};
    HTMLDialogElement.prototype.close = function(){this.removeAttribute('open');this.style.display='none';};
  }
})();

/* 서버 데이터 바인딩 */
var USER_AUTH = { authorized: false };
try {
  USER_AUTH = JSON.parse('<%- authData %>');
} catch(e) {
  console.error("인증정보 파싱에러", e);
}
const HM_RAW = <%- homemulti %>;
const SS_RAW = <%- singleSets %>;
const SP_RAW = <%- singleParts %>;
const HD_RAW = <%- homeDefaults %>;
const SD_RAW = <%- singleDefaults %>;
const SM_RAW = <%- singleMatPrices %>;
const CM_RAW = <%- commercialMulti %>;
const CP_RAW = <%- commercialParts %>;
const OLD_RAW = <%- oldProducts %>;
const CFG_RAW = <%- config %>;
const SPEC_RAW = <%- specDetailMap %>;
const CUST_RAW = [];
const SPEC_DETAIL_MAP = J(SPEC_RAW,{});
const REC_RAW = <%- recommendData %>;
const RECOMMEND_DATA = J(REC_RAW, {comm:[], home:[], homeEx:[]});
const PRICE_INC_RAW = <%- priceInc %>;
const PRICE_INC = J(PRICE_INC_RAW, {home:{}, comm:{}, single:{}});
const PRICE_CHANGE_SCHEDULE = J(<%- priceChangeSchedule %>, {});
const PRICE_DEFAULT_VARIANT = J(<%- priceDefaultVariant %>, {});
const HOME_QUANTITY_SYNC_RULES = J(<%- quantitySyncRules || '[]' %>, []);
const ACTIVE_HOME_QUANTITY_SYNC_RULES = Array.isArray(HOME_QUANTITY_SYNC_RULES)
  ? HOME_QUANTITY_SYNC_RULES.filter(rule => rule?.enabled === true)
  : [];

// 출고가 보정
function getBaseListPrice(type, model, defaultVal) {
  if (type === 'home' || type === 'HOME') {
    const isInc = document.getElementById('chkHomeInc')?.checked;
    if (isInc && PRICE_INC.home[model]) return PRICE_INC.home[model];
  } else if (type === 'comm' || type === 'COMM') {
    const isInc = document.getElementById('chkCommInc')?.checked;
    if (isInc && PRICE_INC.comm[model]) return PRICE_INC.comm[model];
  } else if (type === 'single' || type === 'SINGLE') {
    const isInc = document.getElementById('chkSingleInc')?.checked;
    if (isInc && PRICE_INC.single && PRICE_INC.single[model] && PRICE_INC.single[model].list) return PRICE_INC.single[model].list;
  }
  return defaultVal;
}

/* 유틸 */
function J(v,d){if(typeof v==='string'){try{const p=JSON.parse(v);return p==null?d:p;}catch(e){return d;}}return v==null?d:v;}

// 특수행 출처 — 화면 라벨은 동일하지만 catalog 행과 자동 cutoff 행은 절대 병합하지 않는다.
const SPECIAL_ROW_SOURCE = Object.freeze({
  CATALOG_SPECIAL: 'CATALOG_SPECIAL',
  AUTO_CUTOFF: 'AUTO_CUTOFF',
});

// 카탈로그 원본을 row metadata로 변환하는 유일한 경계. 이후 계산/저장/payload는 metadata만 읽는다.
function catalogSpecialMetadata(product) {
  const text = `${product?.kind || ''} ${product?.name || ''}`;
  if (!/운임|절삭/i.test(text)) return null;
  return {
    source: SPECIAL_ROW_SOURCE.CATALOG_SPECIAL,
    kind: /절삭/i.test(text) ? 'CUT' : 'FREIGHT',
  };
}

function catalogSpecialSource(product) {
  return catalogSpecialMetadata(product)?.source;
}

const HOMEMULTI=J(HM_RAW,[]),SINGLE_SETS=J(SS_RAW,[]),SINGLE_PARTS=J(SP_RAW,[]);
const COMMULTI=J(CM_RAW,[]), COMM_PARTS=J(CP_RAW,[]);
const HOME_DEFAULTS=J(HD_RAW,{}),SINGLE_DEFAULTS=J(SD_RAW,{}),SINGLE_MAT=J(SM_RAW,{});

COMMULTI.forEach((r, i) => {
  r._origIdx = i;
  const txt = `${r.name||''} ${r.disp||''}`;
  const rx = /(가스히트펌프|프레스티지|동시냉난방|공장전원)/i;
  const rxIgnore = /KIT|저감장치|방진가대|키트|모듈|중계기|제어기|분배기|필터/i;
  if (rx.test(txt) && !rxIgnore.test(txt)) {
    r.catL = '실외기';
    r['대분류'] = '실외기';
  }
});
COMMULTI.sort((a, b) => {
  const txtA = `${a.name||''} ${a.disp||''}`;
  const txtB = `${b.name||''} ${b.disp||''}`;
  const rx = /(가스히트펌프|프레스티지|동시냉난방|공장전원)/i;
  const rxIgnore = /KIT|저감장치|방진가대|키트|모듈|중계기|제어기|분배기|필터/i;
  const isExtA = rx.test(txtA) && !rxIgnore.test(txtA);
  const isExtB = rx.test(txtB) && !rxIgnore.test(txtB);
  if (isExtA && !isExtB) return -1;
  if (!isExtA && isExtB) return 1;
  return a._origIdx - b._origIdx;
});

const OLD_PRODUCTS=J(OLD_RAW,[]);

// catalog boundary에서만 이름/종류를 읽고, 이후 모든 단계는 이 metadata를 사용한다.
[...HOMEMULTI, ...SINGLE_SETS, ...COMMULTI, ...OLD_PRODUCTS].forEach((product) => {
  const metadata = catalogSpecialMetadata(product);
  if (metadata) Object.assign(product, metadata);
});

const oldQty=new Map();
let CUSTOMERS = [];
let MANAGERS = [];
let HOME_RATIO_VAL = '';
let HOME_RATIO_LIMIT = '';
let COMM_RATIO_VAL = '';
let COMM_RATIO_LIMIT = '';
let CONFIG=J(CFG_RAW,{
  homeDiscount: 0.45,
  commDiscount: 0.45,
  showIHose: false,
  singleSetDiscount: 0,
  oldDiscount: 0.5,
  vatRate: 0.1,
  cardFeeRate: 0.03,
  advanceDiscountRate: 0,
  comboWarnRate: 0,
  footerNotice: '※ 분기관은 임의 산정입니다.\n※ 견적 내용 확정 시 재고확인 요청 부탁드립니다.\n※ 본 견적은 견적일로부터 30일 이내에만 유효합니다.\n※ 공공기관 발주 현장의 경우 본 견적은 무효이며, 별도의 검토가 필요합니다.',
  oneWayDiscount: 0,
  deluxeDiscount: 0,
  firstGradeDiscount: 0,
  unitRoundTo: 0,
  unitRoundMode: 'ROUND'
});
const INDOOR_AY047 = (HOMEMULTI.find(r=>/^AY047BA1SBA$/i.test(r?.model||''))||{}).model || null;
const PANEL_PC1DWSK1 = (HOMEMULTI.find(r=>/^PC1DWSK1$/i.test(r?.model||''))||{}).model || null;

// 현재 세션 사업자등록번호
let CURRENT_BIZNO = '';

function getModelFlags(model) {
  const m = String(model || '').toUpperCase();
  let is360 = false, is4way = false, is1way = false, isStand = false, isDeluxe = false, isGrade1 = false;
  
  if (m.startsWith('AC') && m.length >= 9) {
      if (m[7] === '6' && m[8] === 'P') is360 = true;
      if (m[7] === '4' && (m[8] === 'P' || m[8] === 'D')) is4way = true;
      if (m[7] === '1' && (m[8] === 'P' || m[8] === 'D')) is1way = true;
  }
  if (m.startsWith('AP') && m.length >= 9) {
      if (m.length >= 11 && m[10] === 'C') {
          if (m[8] === 'D') isStand = true;
      } else {
          if (m[8] === 'P') isStand = true;
      }
      if (m.length >= 11 && m[8] === 'D' && m[10] === 'H') isDeluxe = true;

      if (m.startsWith('AP230') || m.startsWith('AP290')) {
          isStand = true;
          isDeluxe = false;
      }
  }
  if ((m.startsWith('AC') || m.startsWith('AP')) && m.length >= 9 && m[8] === 'F') {
      isGrade1 = true;
  }
  
  return { is360, is4way, is1way, isStand, isDeluxe, isGrade1 };
}

// 실제 적용 단가 조회 함수
function getRealHomePrice(model) {
  if (homeCustomPrices.has(model)) return homeCustomPrices.get(model);
  return homeUnitPrice(model);
}

function getRealCommPrice(model) {
  if (commCustomPrices.has(model)) return commCustomPrices.get(model);
  return commUnitPrice(model);
}

function getRealSinglePrice(id) {
  if (singleCustomPrices.has(id)) return singleCustomPrices.get(id);
  const s = SINGLE_SETS.find(x => x.id === id);
  return s ? calcSetUnitPrice(s) : 0;
}

function getRealOldPrice(model) {
  if (oldCustomPrices.has(model)) return oldCustomPrices.get(model);
  const item = OLD_PRODUCTS.find(p=>p.model===model);
  if(!item) return 0;
  const rateVal = parseInt(el('#old_rate')?.value || String(getOldDiscountPercent()), 10);
  
  let p = Math.round(Number(item.price)||0);
  let isCustom = false;
  // 수동 입력 출고가 반영
  if (typeof oldCustomListPrices !== 'undefined' && oldCustomListPrices.has(model)) {
    p = oldCustomListPrices.get(model);
    isCustom = true;
  }

  if(item.isDisc) {
    p = Math.round(p * (1 - rateVal/100));
  } else {
    // 사용자가 출고가를 직접 고친 경우가 아니면 기존 고정가 유지
    if (!isCustom) {
      p = Math.round(Number(item.sheetPrice)||0);
    }
  }
  return roundByConfig(p, 'old');
}

// DC 설정 적용
function applyConfigFromServer(cfg) {
  if (!cfg) return;

  // CONFIG 병합
  CONFIG = Object.assign({}, CONFIG, cfg);

  // 전역 DC 적용
  window.DISCOUNT_RATE_HOME = Number(CONFIG.homeDiscount)||0;
  window.DISCOUNT_RATE_COMM = Number(CONFIG.commDiscount)||0;
  window.SHOW_I_HOSE = !!CONFIG.showIHose;
  window.DISCOUNT_360_AMT         = Number(CONFIG.discount360)||0;
  window.DISCOUNT_4WAY_AMT        = Number(CONFIG.discount4way)||0;
  window.DISCOUNT_STAND_AMT       = Number(CONFIG.discountStand)||0;
  window.ONEWAY_DISCOUNT_AMT      = Number(CONFIG.oneWayDiscount)||0;
  window.DELUXE_DISCOUNT_AMT      = Number(CONFIG.deluxeDiscount)||0;
  window.FIRSTGRADE_DISCOUNT_AMT  = Number(CONFIG.firstGradeDiscount)||0;
  window.UNIT_ROUND_TO            = Number(CONFIG.unitRoundTo||0);
  window.UNIT_ROUND_MODE          = String(CONFIG.unitRoundMode||'').toUpperCase() || 'ROUND';
  window.ESTIMATE_CONFIG = CONFIG;
  const oldRate = document.getElementById('old_rate');
  if (oldRate) oldRate.value = getOldDiscountPercent();
}

function estimateConfigNumber(key, fallback) {
  const n = Number(CONFIG && CONFIG[key]);
  return Number.isFinite(n) ? n : fallback;
}

function getOldDiscountPercent() {
  return Math.round(estimateConfigNumber('oldDiscount', 0.5) * 100);
}

function getCardFeeRate() {
  return estimateConfigNumber('cardFeeRate', 0.03);
}

function getVatDivisor() {
  return 1 + estimateConfigNumber('vatRate', 0.1);
}

function escapeEstimateHtml(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function escapeEstimateAttr(s) {
  return escapeEstimateHtml(s);
}
function safeEstimateImageSrc(value) {
  const raw = String(value == null ? '' : value).trim();
  if (!raw) return '';
  const compact = raw.replace(/[\u0000-\u001F\u007F\s]+/g, '').toLowerCase();
  if (compact.startsWith('javascript:') || compact.startsWith('vbscript:')) return '';
  if (compact.startsWith('data:')) {
    return /^data:image\/(?:png|jpe?g|gif|webp);base64,[a-z0-9+/=]+$/i.test(compact) ? raw : '';
  }
  if (compact.startsWith('blob:')) return raw;
  try {
    const url = new URL(raw, window.location.origin);
    if (url.protocol === 'http:' || url.protocol === 'https:') return url.href;
  } catch (e) {
    return '';
  }
  return '';
}
function safeEstimateImageSrcAttr(value) {
  const safeUrl = safeEstimateImageSrc(value);
  return safeUrl ? escapeEstimateAttr(encodeURI(safeUrl)) : '';
}
function escapeEstimateJsString(s) {
  return String(s == null ? '' : s)
    .replace(/\\/g, '\\\\')
    .replace(/'/g, "\\'")
    .replace(/\r/g, '\\r')
    .replace(/\n/g, '\\n')
    .replace(/</g, '\\x3c');
}
function estimateOptionHtml(value) {
  const safe = escapeEstimateHtml(value);
  return '<option value="' + safe + '">' + safe + '</option>';
}
function estimateSpecValueHtml(value) {
  return escapeEstimateHtml(value).replace(/&lt;br&gt;/g, '<br>');
}
function sanitizeLegacyTableHtml(html) {
  const template = document.createElement('template');
  template.innerHTML = String(html == null ? '' : html);
  const allowedTags = new Set(['TABLE', 'THEAD', 'TBODY', 'TFOOT', 'TR', 'TD', 'TH', 'COLGROUP', 'COL', 'SPAN', 'DIV', 'BR', 'STRONG', 'B']);
  const allowedAttrs = new Set(['class', 'style', 'colspan', 'rowspan', 'width']);
  const walk = node => {
    Array.from(node.childNodes).forEach(child => {
      if (child.nodeType === Node.TEXT_NODE) return;
      if (child.nodeType !== Node.ELEMENT_NODE) {
        child.remove();
        return;
      }
      const el = child;
      if (!allowedTags.has(el.tagName)) {
        el.replaceWith(document.createTextNode(el.textContent || ''));
        return;
      }
      Array.from(el.attributes).forEach(attr => {
        const name = attr.name.toLowerCase();
        const value = String(attr.value || '');
        if (!allowedAttrs.has(name) || name.startsWith('on') || /javascript:/i.test(value)) {
          el.removeAttribute(attr.name);
        }
      });
      walk(el);
    });
  };
  walk(template.content);
  return template.innerHTML;
}

function getFooterNoticeHtml() {
  const text = String(CONFIG.footerNotice || '').trim();
  const fallback = '※ 분기관은 임의 산정입니다.\n※ 견적 내용 확정 시 재고확인 요청 부탁드립니다.\n※ 본 견적은 견적일로부터 30일 이내에만 유효합니다.\n※ 공공기관 발주 현장의 경우 본 견적은 무효이며, 별도의 검토가 필요합니다.';
  return (text || fallback)
    .split(/\r?\n/)
    .map(line => escapeEstimateHtml(line))
    .join('<br>');
}

function applyEstimateTotalAdjustments(rows, opts) {
  if (!Array.isArray(rows)) return { total: 0, adjustment: 0 };
  const baseTotal = rows.reduce((acc, r) => acc + (Number(r.sub) || ((Number(r.price) || 0) * (Number(r.qty) || 0))), 0);
  let adjustment = 0;
  const advanceRate = estimateConfigNumber('advanceDiscountRate', 0);

  if (opts && opts.advance === true && advanceRate > 0
      && !rows.some(r => String(r.name || '').includes('선금할인') || r.advanceDiscount)) {
    const discount = -Math.round(baseTotal * advanceRate);
    if (discount !== 0) {
      rows.push({ section:'ETC', type:'item', name:'선금할인', model:'선금할인', unit:'식', qty:1, price:discount, sub:discount, remarks:'선금 할인', cat:'기타', advanceDiscount:discount });
      adjustment += discount;
    }
  }
  return { total: baseTotal + adjustment, adjustment };
}

// 거래처 노션 할인설정 자동적용
function applyCustomerDiscounts(dc) {
  dc = dc || {};
  const numOr = (v, d) => (typeof v === 'number' && isFinite(v)) ? v : d;

  // 노션값 우선 없으면 전역 기본값
  const homeRate = numOr(dc.homeDiscount, (typeof CONFIG.homeDiscount === 'number' ? CONFIG.homeDiscount : 0.45));
  const commRate = numOr(dc.commDiscount, (typeof CONFIG.commDiscount === 'number' ? CONFIG.commDiscount : 0.45));
  const d360    = numOr(dc.discount360, 0);
  const d4way   = numOr(dc.discount4way, 0);
  const dStand  = numOr(dc.discountStand, 0);
  const d1way   = numOr(dc.oneWayDiscount, 0);
  const dDeluxe = numOr(dc.deluxeDiscount, 0);
  const dGrade1 = numOr(dc.firstGradeDiscount, 0);
  const roundTo = numOr(dc.unitRoundTo, 0);
  const roundMode = dc.unitRoundMode || 'ROUND';
  const useIHose = (dc.showIHose === true);

  // 할인율 분리적용 및 옵션바 기본값용 전역 SHOW_I_HOSE는 상업멀티 오염 방지 위해 건드리지 않음
  window.DISCOUNT_RATE_HOME = homeRate;
  window.DISCOUNT_RATE_COMM = commRate;
  window.DISCOUNT_360_AMT = d360;
  window.DISCOUNT_4WAY_AMT = d4way;
  window.DISCOUNT_STAND_AMT = dStand;
  window.ONEWAY_DISCOUNT_AMT = d1way;
  window.DELUXE_DISCOUNT_AMT = dDeluxe;
  window.FIRSTGRADE_DISCOUNT_AMT = dGrade1;

  // 이미 생성된 입력칸 즉시 갱신
  const setField = (id, val) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.value = val;
    el.dispatchEvent(new Event('change', { bubbles: true }));
  };
  const setCheck = (id, val) => {
    const el = document.getElementById(id);
    if (!el) return;
    el.checked = !!val;
    el.dispatchEvent(new Event('change', { bubbles: true }));
  };

  setField('home_rate', Math.round(homeRate * 100));
  setField('comm_rate', Math.round(commRate * 100));
  setField('ss_disc_360', d360);
  setField('ss_disc_4way', d4way);
  setField('ss_disc_1way', d1way);
  setField('ss_disc_stand', dStand);
  setField('ss_disc_deluxe', dDeluxe);
  setField('ss_disc_grade1', dGrade1);

  // 유연호스 I형 홈멀티만 적용 상업멀티 제외
  setCheck('home_hose_i', useIHose);

  // 단위처리 M원 반올림 내림 올림 홈 상업 구형 적용
  ['home', 'comm', 'old'].forEach(pfx => {
    setField(pfx + '_round_unit', roundTo);
    setField(pfx + '_round_mode', roundMode);
  });
}

