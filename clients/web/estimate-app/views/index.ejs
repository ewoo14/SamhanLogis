// 구형 렌더
function renderOld(){
  renderOldOptions(); 

  const body = document.getElementById('oldBody'); 
  if(!body) return; 
  body.innerHTML = '';
  
  const rateVal = parseInt(el('#old_rate')?.value || String(getOldDiscountPercent()), 10);
  const discountRate = rateVal / 100;

  OLD_PRODUCTS.forEach((item, idx) => {
    if(item.name === '품 명' || item.name === '품명' || item.model === '모델명') return;

    const q = oldQty.get(item.model) || 0;
    
    // 운임 절삭
    const isSpecial = item.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL;
    const isCut = item.kind === 'CUT';

    let listPrice = Math.round(Number(item.price) || 0); 
    let autoPrice;
    if(item.isDisc === true) {
      autoPrice = Math.round(listPrice * (1 - discountRate));
    } else {
      autoPrice = Math.round(Number(item.sheetPrice) || 0);
    }
    autoPrice = roundByConfig(autoPrice, 'old');

    const currentPrice = oldCustomPrices.has(item.model) ? oldCustomPrices.get(item.model) : autoPrice;
    const sub = currentPrice * q;

    const tr = document.createElement('tr');
    tr.classList.add('tint');
    // data-m 추가
    tr.dataset.m = item.model;
      
    // 규격
    const tdName = `
      <td class="colL" style="text-align:left; padding:6px 8px;">${escapeEstimateHtml(item.name||'')}</td>
      <td class="model">${escapeEstimateHtml(item.model||'')}</td>
      <td class="list-price pc-only">${makeListPriceInput(listPrice, 'old', item.model)}</td>
      <td class="spec-col pc-only">${makeSpecInput(item.spec, 'old', item.model)}</td>
    `;
    
    // 수량
    let tdQty = '';
    if (isSpecial) {
      tdQty = `<td class="qty-static">${q}</td>`;
    } else {
      const isManual = (q > 0);
      const colorStyle = isManual ? 'color:#2563eb; font-weight:bold;' : 'color:#374151; font-weight:normal;';
      tdQty = `
        <td>
          <div class="qty-box">
            <input class="qty-input" data-idx="${idx}" value="${q||''}" onfocus="this.select()" inputmode="numeric" pattern="\\d*" placeholder="0" style="${colorStyle}"/>
          </div>
        </td>`;
    }

    // 단가 셀
    let tdPrice = `<td class="ar price"></td>`;
    if(!isSpecial) {
       tdPrice = `<td class="ar">${makePriceInput(currentPrice, 'old', item.model)}</td>`;
    }

    const tdSub = `<td class="ar sub-cell" style="font-weight:bold;">${fmt(sub)}</td>`;

    tr.innerHTML = tdName + tdQty + tdPrice + tdSub;
    
    // 운임/절삭용 input 주입
    if(isSpecial) {
       const td = tr.querySelector('.price');
       
       const wrap = document.createElement('div');
       wrap.style.width='100px'; wrap.style.margin='0 auto'; wrap.style.position='relative';

       const inp = document.createElement('input');
       inp.type = 'text'; 
       inp.className = 'price-input'; 
       inp.inputMode = 'numeric';
       inp.value = formatSpecialPriceForDisplay(currentPrice, fmt);
       inp.placeholder = '0';
       
       // makePriceInput과 동일한 스타일 적용
       inp.style.width = '100%';
       inp.style.textAlign = 'right';
       inp.style.border = '1px solid #d1d5db';
       inp.style.borderRadius = '4px';
       inp.style.padding = '4px 8px';
       inp.style.fontSize = '14px';
       inp.style.background = '#fff';
       inp.style.outline = 'none';
       
       if(currentPrice) {
           inp.style.color = '#2563eb';
           inp.style.fontWeight = 'bold';
       } else {
           inp.style.color = '#374151';
           inp.style.fontWeight = 'normal';
       }

       // 핸들러 연결
       inp.addEventListener('focus', function(){ this.select(); });
       inp.addEventListener('change', (e) => handleFreightInput(e, isCut, oldCustomPrices, oldQty, item.model, syncOldTotals));
       wrap.appendChild(inp); td.appendChild(wrap);
    }

    body.appendChild(tr);
  });

  // 수량 리스너
  body.querySelectorAll('.qty-input').forEach(inp => {
    inp.addEventListener('input', e => {
      const idx = e.target.dataset.idx;
      const raw = e.target.value.replace(/[^0-9-]/g, '');
      const item = OLD_PRODUCTS[idx];
      
      let val = 0;
      if (raw === '') {
        val = 0;
      } else {
        val = parseInt(raw, 10);
      }
      oldQty.set(item.model, val);
      
      const tr = e.target.closest('tr');
      const priceInp = tr.querySelector('.price-input');
      const p = parseInt(priceInp.value.replace(/[^0-9]/g,'')||0, 10);
      
      const subCell = tr.querySelector('.sub-cell');
      if(subCell) subCell.textContent = fmt(p * val);
      
      syncOldTotals();
      refreshSelectedBadge();
    });
  });
  syncOldTotals();
}

/* 구형 합계 계산 */
function sumOld(){
  return OLD_PRODUCTS.reduce((acc, item) => {
    if(item.name === '품 명' || item.name === '품명') return acc;

    const q = oldQty.get(item.model)||0;
    
    if (oldCustomPrices.has(item.model)) {
      return acc + (oldCustomPrices.get(item.model) * q);
    }

    let listP = Math.round(Number(item.price) || 0);
    let finalP;
    
    if(item.isDisc === true) {
      finalP = Math.round(listP * 0.5);
    } else {
      finalP = Math.round(Number(item.sheetPrice) || 0);
    }
    
    return acc + (finalP * q);
  }, 0);
}

// 구형
function syncOldTotals(){
  let sum = sumOld();
  const tbody = document.getElementById('oldCustomBody');
  if (tbody) {
    tbody.querySelectorAll('.custom-item-row').forEach(tr => {
      const qty = parseInt(tr.querySelector('.custom-qty').value || '0', 10);
      const price = parseInt(tr.querySelector('.custom-price').value.replace(/[^0-9-]/g, '') || '0', 10);
      sum += (qty * price);
    });
  }
  const t = el('#oldTotal');
  if (t) t.textContent = fmt(sum);
}

/* 모바일 UI */
const mqMobile = window.matchMedia('(max-width: 1280px)');

function isMobileNow(){
  const vv = (window.visualViewport && window.visualViewport.width)
               ? window.visualViewport.width : window.innerWidth;
  return mqMobile.matches || vv <= 1280 || (navigator.maxTouchPoints > 0 && vv <= 1280);
}

let mobileActive = null; // ← 선언은 유지

function initMobileUI(){
  const apply = ()=> onViewportChange(isMobileNow());
  if (mqMobile.addEventListener) mqMobile.addEventListener('change', apply);
  else mqMobile.addListener(apply);
  window.addEventListener('resize', apply);
  window.addEventListener('orientationchange', ()=> setTimeout(apply, 0));

  el('#btnEnterHome')?.addEventListener('click',()=>enterMobile('home'));
  el('#btnEnterSingle')?.addEventListener('click',()=>enterMobile('single'));
  el('#btnEnterComm')?.addEventListener('click',()=>enterMobile('comm'))
  el('#btnSwitch')?.addEventListener('click',()=>{ 
    if(mobileActive==='home') enterMobile('single'); else enterMobile('home'); 
  });

  apply();            // 최초 1회 적용
  updateTopControls();
}

function onViewportChange(isMobile){
  // 모바일 플래그 토글
  document.body.classList.toggle('mobile-mode', isMobile);

  // 데스크톱에서도 섹터 선택 전까지 게이트 유지
  if (isMobile){
    // 모바일에서 아직 선택 전이면 게이트 노출 유지
    if (!mobileActive){
      document.body.classList.add('no-active');
      el('#mobileGate')?.removeAttribute('aria-hidden');
    }
  } else {
    // 데스크톱에서는 no-active를 건드리지 않음
    if (document.body.classList.contains('no-active')){
      el('#mobileGate')?.removeAttribute('aria-hidden');
    } else {
      el('#mobileGate')?.setAttribute('aria-hidden','true');
    }
  }

  updateTopControls();
  fixFootersForMobile(isMobile);
  fitAllTables();
  if(typeof relocateUI === 'function') relocateUI(isMobile);
}

function enterMobile(which){
  // 상태 기록
  mobileActive = which;
  // 플래그 정리
  document.body.classList.remove('no-active','home-active','single-active','comm-active');
  document.body.classList.add(which + '-active');
  // 게이트 닫기
  const g = el('#mobileGate'); if(g) g.setAttribute('aria-hidden','true');
  // 합계 갱신
  call(syncHomeTotals);
  const ssum = call(sumSingles) || 0;
  setText('#singleTotal', fmtOrRaw(ssum));
  // 상단 갱신
  call(refreshSelectedBadge);
  call(updateTopControls);
  // 스크롤 이동
  window.scrollTo({ top: 0, behavior: 'smooth' });
  // 표 레이아웃 보정
  setTimeout(()=>call(fitAllTables), 0);
}

function updateTopControls(){
  const sw=el('#btnSwitch'), pv=el('#btnPreview'), titleBox=el('.title');
  const isMobile = isMobileNow();

  if(!isMobile){
    if(sw) sw.style.display='none';
    if(titleBox) titleBox.firstChild.nodeValue='종합견적서';
    return;
  }
  if(!mobileActive){
    if(sw) sw.style.display='none';
    if(pv) pv.style.display='none';
    if(titleBox) titleBox.firstChild.nodeValue='종합견적서';
  }else{
    if(pv) pv.style.display='';
    if(sw){ sw.style.display = 'inline-flex'; sw.textContent=(mobileActive==='home')?'싱글중대형 보기':'홈멀티 보기'; }
    if(titleBox) titleBox.firstChild.nodeValue=(mobileActive==='home'?'홈멀티':'싱글중대형')+' ';
  }
  refreshBranchButton();
}

/* 수동편집상태 */
const HOME_MANUAL_PANEL = new Set();
const HOME_MANUAL_HOSE = new Set();
const HOME_MANUAL_REMOTE = new Set();
const HOME_MANUAL_BRANCH = new Set();
const HOME_MANUAL_FOOT = new Set();

const COMM_MANUAL_PANEL = new Set();
const COMM_MANUAL_HOSE = new Set();
const COMM_MANUAL_REMOTE = new Set();
const COMM_MANUAL_PUMP = new Set();
const COMM_MANUAL_BASE = new Set();

/* 홈멀티 입력 핸들러 */
function onHomeQtyInput(model, v) {
  // 데이터저장
  homeQty.set(model, v);

  // 소계즉시갱신
  const row = document.querySelector(`#homeBody .qty-input[data-m="${CSS.escape(model)}"]`)?.closest('tr');
  if (row) {
    let u = homeUnitPrice(model);
    if (typeof homeCustomPrices !== 'undefined' && homeCustomPrices.has(model)) {
      u = homeCustomPrices.get(model);
    }
    const sub = row.querySelector('[data-sub]') || row.querySelector('.sub');
    if (sub) sub.textContent = fmt(u * v);
  }

  // 품목타입확인
  const r = homeRowByModel.get(model);
  const nm = String(r?.name || '');
  
  const isP = /판넬/i.test(nm);
  const isR = /리모컨|리모콘/i.test(nm);
  const isH = /유연호스/i.test(nm);
  const isB = /분\s*기\s*관|분기관/i.test(nm);
  const isF = /발통|일자발/i.test(nm);

  // 파생품목 수동처리
  if (isP || isR || isH || isB || isF) {
    if (isP) HOME_MANUAL_PANEL.add(model);
    else if (isR) HOME_MANUAL_REMOTE.add(model);
    else if (isH) HOME_MANUAL_HOSE.add(model);
    else if (isB) HOME_MANUAL_BRANCH.add(model);
    else if (isF) HOME_MANUAL_FOOT.add(model);
    
    // 전체재계산금지 단순합계갱신
    syncHomeTotals();       
    refreshSelectedBadge(); 
  } 
  // 기준품목 자동계산
  else if (isHomeCalcTriggerModel(model)) {
    recomputeHomeDerived(true); 
  } 
  // 일반품목
  else {
    syncHomeTotals();
    refreshSelectedBadge();
  }
}

/* 싱글세 입력핸들러 */
function onSingleQtyInput(id,v){
  const s = SINGLE_SETS.find(x => String(x.id) === String(id)) || {};
  const key = (s && s.id !== undefined) ? s.id : id;
  
  const inp = document.querySelector(`#singleBody .qty-input[data-sid="${CSS.escape(id)}"]`) || document.querySelector(`#singleBody .qty-input[data-m="${CSS.escape(id)}"]`);
  const isCleared = !inp || inp.value.trim() === '';
  
  if (isCleared) {
      if (singleQty.unlock) singleQty.unlock(key);
      singleQty.set(key, v);
  } else {
      singleQty.set(key, v, true);
  }
  const unit=calcSetUnitPrice(s);
  const sCell=document.querySelector(`#singleBody [data-ss="${CSS.escape(id)}"]`);
  const uCell=document.querySelector(`#singleBody [data-ssu="${CSS.escape(id)}"]`);
  if(sCell) sCell.textContent=fmt(unit*v);
  if(uCell){ uCell.setAttribute('data-unitraw', unit); uCell.textContent = fmt(unit); }
  if(isSingleCalcTriggerId(key)){recomputeSingleBaseFoot();recomputeSingleExtras();}
  syncSingleTotals();refreshSelectedBadge();
}

