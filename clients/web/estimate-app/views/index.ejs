/* 견적서 화면 열기 */
function goPreview() {
  const total = getSelectedTotalCount();
  if (total === 0) return alert('선택된 품목이 없습니다.');

  const optVatVal = document.querySelector('input[name="optVatDisplay"]:checked')?.value || 'inc';
  const isCard = document.getElementById('chkCardPay')?.checked ?? false;
  
  const optVatPvs = document.querySelectorAll('input[name="optVatPv"]');
  optVatPvs.forEach(r => {
    r.checked = (r.value === optVatVal);
  });
  
  const cardPv = document.getElementById('chkCardPayPv');
  if(cardPv) cardPv.checked = isCard;

  renderPreviewContent();
  refreshBranchOpenButton('preview');
  clearAllActiveClasses();
  document.body.classList.add('preview-active');
  window.activeSector = 'preview';

  const hVal = HOME_RATIO_VAL;
  const hLim = HOME_RATIO_LIMIT;
  const cVal = COMM_RATIO_VAL;
  const cLim = COMM_RATIO_LIMIT;

  const parts = [];

  if (hVal === 'EXCEED') {
    parts.push(`<span style="color:#dc2626; font-weight:bold;">홈멀티 최대 실내기 허용 대수 초과 주의!</span>`);
  } else if (hVal === '조합불가') {
    parts.push(`<span style="color:#dc2626; font-weight:bold;">홈멀티 조합 불가</span>`);
  } else if (hVal && parseFloat(hVal) > 0) {
    const isBad = hLim && (parseFloat(hVal) > hLim);
    const style = isBad ? 'color:#dc2626;' : '';
    parts.push(`<span style="${style}">홈멀티 ${hVal} (최대 ${hLim}%)</span>`);
  }

  if (cVal === 'EXCEED') {
    parts.push(`<span style="color:#dc2626; font-weight:bold;">상업멀티 최대 실내기 허용 대수 초과 주의!</span>`);
  } else if (cVal && parseFloat(cVal) > 0) {
    const isBad = cLim && (parseFloat(cVal) > cLim);
    const style = isBad ? 'color:#dc2626;' : '';
    parts.push(`<span style="${style}">상업멀티 ${cVal}(최대 ${cLim}%)</span>`);
  }

  const finalHtml = parts.length > 0 
    ? (parts.some(p => p.includes('초과 주의!')) ? parts.join(' / ') : `조합비: ${parts.join(' / ')}`)
    : '';

  const pvEl = document.getElementById('previewRatioTxt');
  if (pvEl) pvEl.innerHTML = finalHtml;

  const title = document.getElementById('previewTitleTxt');
  if(title) title.textContent = (window.previewMode === 'SIMPLE') ? '견적서 (기본)' : '견적서 (상세)';
  
  const t = document.querySelector('.title');
  if(t && t.firstChild) t.firstChild.nodeValue = '견적서 ';

  window.scrollTo(0, 0);
  logAction('화면이동', '견적서');
}

