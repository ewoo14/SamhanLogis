/* 열드래그 */
function makeBranchColumnSortable() {
  const table = document.querySelector('.branch-table');
  if(!table) return;
  const thead = table.querySelector('thead tr');
  let draggedTh = null;

  thead.querySelectorAll('.pc-draggable-col').forEach(th => {
    th.addEventListener('dragstart', function(e) {
      draggedTh = this;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', this.dataset.out);
      setTimeout(() => {
        this.style.opacity = '0.4';
        this.style.background = '#f8fafc';
      }, 0);
    });
    
    th.addEventListener('dragover', function(e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';

      if (!draggedTh || this === draggedTh || !this.classList.contains('pc-draggable-col')) {
        return false;
      }

      const allThs = Array.from(thead.children);
      const fromIndex = allThs.indexOf(draggedTh);
      const toIndex = allThs.indexOf(this);

      if (fromIndex === -1 || toIndex === -1) return false;

      const rect = this.getBoundingClientRect();
      const midX = rect.left + rect.width / 2;
      const isMousePastMid = e.clientX > midX;

      if (fromIndex < toIndex && !isMousePastMid) return false;
      if (fromIndex > toIndex && isMousePastMid) return false;

      /* 좌표저장 */
      const oldThPositions = new Map();
      allThs.forEach(t => oldThPositions.set(t, t.getBoundingClientRect().left));
      
      const tbodyRows = Array.from(table.querySelectorAll('tbody tr'));
      const oldTdPositions = new Map();
      tbodyRows.forEach(tr => {
        Array.from(tr.children).forEach(td => oldTdPositions.set(td, td.getBoundingClientRect().left));
      });

      /* 위치이동 */
      if (fromIndex < toIndex) {
        thead.insertBefore(draggedTh, this.nextSibling);
      } else {
        thead.insertBefore(draggedTh, this);
      }
      
      tbodyRows.forEach(tr => {
        const tds = Array.from(tr.children);
        const draggedTd = tds[fromIndex];
        const targetTd = tds[toIndex];
        if(draggedTd && targetTd) {
          if (fromIndex < toIndex) {
            tr.insertBefore(draggedTd, targetTd.nextSibling);
          } else {
            tr.insertBefore(draggedTd, targetTd);
          }
        }
      });

      /* 전환효과 */
      const applyFlip = (el, oldLeft) => {
        const newLeft = el.getBoundingClientRect().left;
        const delta = oldLeft - newLeft;
        if (delta !== 0) {
          el.style.transform = `translateX(${delta}px)`;
          el.style.transition = 'none';
          requestAnimationFrame(() => {
            el.style.transform = '';
            el.style.transition = 'transform 0.2s ease-out';
          });
        }
      };

      Array.from(thead.children).forEach(t => {
        if (oldThPositions.has(t)) applyFlip(t, oldThPositions.get(t));
      });
      tbodyRows.forEach(tr => {
        Array.from(tr.children).forEach(td => {
          if (oldTdPositions.has(td)) applyFlip(td, oldTdPositions.get(td));
        });
      });

      return false;
    });
    
    th.addEventListener('dragenter', function(e) {
      e.preventDefault();
    });
    
    th.addEventListener('drop', function(e) {
      e.stopPropagation();
      return false;
    });
    
    th.addEventListener('dragend', function(e) {
      this.style.opacity = '1';
      this.style.background = '#fff';
      draggedTh = null;

      /* 속성초기화 */
      const allElements = [...table.querySelectorAll('th, td')];
      allElements.forEach(el => {
        el.style.transition = 'none';
        el.style.transform = '';
      });

      saveBranchState();
    });
  });
}

/* 우측압축 */
function packOutColumn(key){
  const slots = Array.from(document.querySelectorAll(`.out-slot[data-out="${key}"]`));
  const vals = slots.map(z=>{
    const c = z.querySelector('.capsule.in-grid');
    return c ? {m:c.dataset.model, c:parseInt(c.dataset.cap||'0',10)} : null;
  }).filter(Boolean);

  vals.sort((a,b)=> String(a.m).localeCompare(String(b.m),'ko'));

  slots.forEach(z=> {
    z.innerHTML = '<input type="number" class="cap-input" placeholder="용량" inputmode="numeric">';
  });

  vals.forEach((v,i)=>{
    const z = slots[i];
    z.innerHTML = ''; 
    const chip = makeCapsule(v.m, v.c, true);
    z.appendChild(chip);

    chip.querySelector('.btn-x').addEventListener('click', ()=>{
      chip.remove();
      packOutColumn(key);
      pushBackToLeft(v.m, v.c);
      repackLeft();
      updateBranchRatios();
      recomputeBranchCodes();
      saveBranchState();
    });
  });
  wireBranchInput();
}

/* 화면갱신 */
function updateBranchVisuals(){
  const allInds = pickSelectedIndoorsExpanded();
  const pool = allInds.map(x => ({ ...x, used: false }));
  const phantoms = [];

  document.querySelectorAll('.out-slot').forEach(slot => {
     // 캡슐확인
     const chip = slot.querySelector('.capsule.in-grid');
     if(chip){
        const cCap = parseInt(chip.dataset.cap, 10);
        const idx = pool.findIndex(p => !p.used && p.cap === cCap);
        if(idx>=0) pool[idx].used = true;
     }
     // 입력확인
     const inp = slot.querySelector('.cap-input');
     if(inp){
       const val = parseInt(inp.value, 10);
       if(val && !isNaN(val)){
          const idx = pool.findIndex(p => !p.used && p.cap === val);
          if(idx>=0) pool[idx].used = true;
          else phantoms.push({ model: 'AM'+String(val).padStart(3,'0'), cap: val, isPhantom: true });
       }
     }
  });

  const visibleInds = pool.filter(p => !p.used);
  visibleInds.sort((a,b) => String(a.model).localeCompare(String(b.model),'ko'));
  phantoms.sort((a,b) => a.cap - b.cap);

  const finalLeft = [...visibleInds, ...phantoms];
  const cells = document.querySelectorAll('.indoor-cell');

  cells.forEach(c => c.innerHTML = '');
  finalLeft.forEach((item, i) => {
    if(i < cells.length){
      const isRed = item.isPhantom;
      const st = isRed ? 'style="background:#fee2e2; color:#b91c1c; border:1px solid #fca5a5;"' : '';
      const chip = document.createElement('span');
      chip.className = 'capsule';
      chip.dataset.model = item.model;
      chip.dataset.cap = item.cap;
      chip.innerHTML = `<span class="m" ${st}>${escapeEstimateHtml(item.model)}</span>`;
      cells[i].appendChild(chip);
    }
  });

  updateBranchRatios();
  recomputeBranchCodes();
  saveBranchState();
}

