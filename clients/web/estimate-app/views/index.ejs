        const hasParts = !!document.querySelector(`#commBody tr[data-part-of="${CSS.escape(setModel)}"]`);
        if (!hasParts) renderCommSetParts(setModel, q);
        document.querySelectorAll(`#commBody tr[data-part-of="${CSS.escape(setModel)}"]`).forEach(ptr => {
          const pm = ptr.getAttribute('data-m');
          const pKeyStr = `${setModel}|${pm}`;
          const isManual = typeof commCustomPartQtys !== 'undefined' && commCustomPartQtys.has(pKeyStr);
          
          const pqty = toInt(ptr.getAttribute('data-part-qty') || ptr.querySelector('.part-qty-comm')?.getAttribute('data-def')) || 1;
          const effQ = isManual ? commCustomPartQtys.get(pKeyStr) : (q * pqty); // 수동 입력값이면 유지
          
          const inpPart = ptr.querySelector('.part-qty-comm');
          if (inpPart && !isManual) {
            inpPart.value = effQ ? String(effQ) : '';
            if(inpPart.nextElementSibling) inpPart.nextElementSibling.textContent = effQ;
          }
          const u = commUnitPrice(pm) || 0;
          const uCell = ptr.querySelector(`[data-cunit="${CSS.escape(pm+'|'+setModel)}"]`);
          const sCell = ptr.querySelector(`[data-csub="${CSS.escape(pm+'|'+setModel)}"]`);
          const qCell = ptr.querySelector('.qty-set');
          if (qCell) qCell.textContent = `${q} × ${pqty}`;
          if (uCell) uCell.textContent = fmt(u);
          if (sCell) sCell.textContent = fmt(u * effQ);
        });
      }

      window.LAST_EDIT_KIND = rec ? (isCommOutdoorRow(rec) ? 'outdoor' : (isCommIndoorRow(rec) ? 'indoor' : 'etc')) : 'etc';

      if (rec) {
        if (isCommPanelRow(rec)) {
          COMM_MANUAL_PANEL.add(model);
        }
        if (isCommHoseRow(rec)) {
          COMM_MANUAL_HOSE.add(model);
        }
        if (isCommRemoteRow(rec)) {
          COMM_MANUAL_REMOTE.add(model);
        }
        if (isCommPumpRow(rec)) {
          COMM_MANUAL_PUMP.add(model);
        }
        const s = ((rec.name || '') + ' ' + (rec.disp || '') + ' ' + (rec.model || '')).toLowerCase();
        if (/방진가대|받침대|발통세트|일자발|SI-AL/i.test(s)) {
          COMM_MANUAL_BASE.add(model);
        }
      }

      if (rec && (isCommIndoorRow(rec) || isCommOutdoorRow(rec))) {
        if (isCommOutdoorRow(rec)) {
          try {
            recalcCommAccessories();
          } catch (e) {
            console.warn('부자재계산오류', e);
          }
        }
        recomputeCommDerived();
        updateCommRatio();
      } else {
        syncCommTotals();
        updateCommRatio();
      }

      if (rec && isCommIndoorRow(rec)) {
        if (window.GLOBAL_BRANCH_STATE) {
          window.GLOBAL_BRANCH_STATE.outOrder = [];
        }
      }

      if (raw === '') {
         const autoQ = commQty.get(model) || 0;
         e.target.value = autoQ ? String(autoQ) : '';
         e.target.style.color = '#374151';
         e.target.style.fontWeight = 'normal';
      } else {
         e.target.style.color = '#2563eb';
         e.target.style.fontWeight = 'bold';
      }
      refreshSelectedBadge();
      updateInlineTotals();
      updateCommRatio();
      refreshBranchOpenButton('comm');
    });
  });
}

// 상업멀티 수량칸 방향키 이동
function bindCommQtyArrowNav(){
  const selector = '#commBody .qty-input';
  document.querySelectorAll(selector).forEach(inp=>{
    inp.addEventListener('keydown', e=>{
      if(e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
      e.preventDefault(); // 주석 간결  숫자 증감 방지
      const list = Array.from(document.querySelectorAll(selector));
      const idx  = list.indexOf(e.currentTarget);
      const next = e.key === 'ArrowUp'   ? list[idx - 1]
                 : e.key === 'ArrowDown' ? list[idx + 1]
                 : null;
      if(next){
        next.focus();
        next.select?.();
      }else{
      }
    });
  });
}

/* 용량 추출 */
function getCapacity(r){
  // 숫자 변환
  const v = Number(r?.capacity ?? 0);
  return Number.isFinite(v) ? v : 0;
}

/* 홈멀티 조합비 */
function updateHomeRatio(){
  let inCap = 0, outCap = 0;
  let inCount = 0, maxAllowed = 0;
  
  // 조합불가
  let hasAJ025 = false;
  let hasOtherOut = false;
  let hasRestrictedIn = false;

  HOMEMULTI.forEach(r => {
    const q = homeQty.get(r.model) || 0; if(!q) return;
    const nm = String(r?.name || '');
    
    // 수량계산
    if (/(실내기|벽걸이)/i.test(nm) && !/분기관/i.test(nm)) {
      inCount += q;
      if (r.model.startsWith('AJ072') || r.model.startsWith('AM072') || r.model.startsWith('AM083')) {
        hasRestrictedIn = true;
      }
    }
    else if(/실외기/i.test(nm)) {
      maxAllowed += (r.maxIndoor || 0) * q;
      if (r.model.startsWith('AJ025')) hasAJ025 = true;
      else hasOtherOut = true;
    }

    const cap = getCapacity(r); if(cap <= 0) return;

    if(/(실내기|벽걸이)/i.test(nm)) inCap += cap * q;
    else if(/실외기/i.test(nm))      outCap += cap * q;
  });

  // 배열
  var arr = inCount > 2 ? RECOMMEND_DATA.homeEx : RECOMMEND_DATA.home;
  // 계산
  var recHp = calcRecommendOdu(inCap, arr);
  // 반영
  var homeRecEl = document.getElementById('homeRecommendHp');
  if(homeRecEl) {
    homeRecEl.innerText = "추천 실외기: " + (recHp ? recHp : "-");
  }

  const box = document.querySelector('#homeRatio'); 
  if(!box) return;

  if(outCap <= 0){
    box.textContent = '조합비 : ---%';
    box.classList.remove('bad');
    box.style.color = ''; 
    HOME_RATIO_VAL = '';
    HOME_RATIO_LIMIT = 0;
    return;
  }
  
  // 조합불가
  if (hasAJ025 && !hasOtherOut && hasRestrictedIn) {
    box.textContent = '조합 불가';
    box.style.color = '#dc2626';
    box.classList.remove('bad');
    HOME_RATIO_VAL = '조합불가';
    HOME_RATIO_LIMIT = 0;
    return;
  }
  
  // 한도초과
  if (maxAllowed > 0 && maxAllowed < inCount) {
    box.textContent = '최대 실내기 허용 대수 초과 주의!';
    box.style.color = '#dc2626';
    box.classList.remove('bad');
    HOME_RATIO_VAL = 'EXCEED';
    HOME_RATIO_LIMIT = 0;
    return;
  }

  const ratio = (inCap / outCap) * 100;
  const ratioTxt = new Intl.NumberFormat('ko-KR',{minimumFractionDigits:1,maximumFractionDigits:1}).format(ratio);
  
  box.textContent = `조합비 : ${ratioTxt}%`;
  const isBad = ratio > 130;
  box.classList.toggle('bad', isBad);
  box.style.color = ''; 
  
  HOME_RATIO_VAL = ratioTxt + '%';
  HOME_RATIO_LIMIT = 130; 
}

/* 상업멀티 조합비 */
function updateCommRatio(){
  let inCap = 0, outCap = 0;
  let inCount = 0, outCount = 0, branchCount = 0;
  let maxAllowed = 0; // 변수선언

  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0; if(!q) return;
    
    const nm = rawNameOf(r);
    
    /* 수량 */
    if (isCommIndoorRow(r)) {
      inCount += q;
    } else if (isCommOutdoorRow(r)) {
      outCount += q;
      maxAllowed += (r.maxIndoor || 0) * q; // 허용대수합산
    } else if (nm.includes('Y형 분기관') || /AXJ-YA/i.test(r.model)) {
      branchCount += q;
    }

    const cap = getCapacity(r); 
    if(cap > 0) {
      if(isCommIndoorRow(r)) {
        inCap += cap * q;
      } else if(isCommOutdoorRow(r)) {
        outCap += cap * q;
      }
    }
  });

  // 계산
  var recHpComm = calcRecommendOdu(inCap, RECOMMEND_DATA.comm);
  // 반영
  var commRecEl = document.getElementById('commRecommendHp');
  if(commRecEl) {
    commRecEl.innerText = "추천 실외기: " + (recHpComm ? recHpComm : "-");
  }

  const box = document.querySelector('#commRatio');
  if(!box) return;

  /* 계산 */
  const missingBranch = (inCount - outCount) - branchCount;
  let missingHtml = '';
  
  if (missingBranch >= 1) {
    missingHtml = `<span style="color: #dc2626;">부족 분기관: ${missingBranch}개 / </span>`;
  }

  /* 반영 */
  if(outCap <= 0){
    box.innerHTML = `${missingHtml}조합비 : ---%`;
    box.classList.remove('bad');
    box.style.color = ''; // 색상초기화
    COMM_RATIO_VAL = '';
    COMM_RATIO_LIMIT = 0;
    return;
  }
  
  // 한도초과
  if (maxAllowed > 0 && maxAllowed < inCount) {
    box.innerHTML = `${missingHtml}<span style="color: #dc2626; font-weight: bold;">최대 실내기 허용 대수 초과 주의!</span>`;
    COMM_RATIO_VAL = 'EXCEED';
    COMM_RATIO_LIMIT = 0;
    return;
  }

  const ratio = (inCap / outCap) * 100;
  const ratioTxt = new Intl.NumberFormat('ko-KR',{minimumFractionDigits:1,maximumFractionDigits:1}).format(ratio);

  /* 검사 */
  const hasStrict = COMMULTI.some(r => {
    const q = commQty.get(r.model) || 0; if(!q) return false;
    if(!isCommOutdoorRow(r)) return false;
    const n = rawNameOf(r) + ' ' + String(r?.disp || '');
    return /(프라임|한랭지|표준형|냉난방|가스히트펌프|GHP|프레스티지|동시냉난방|공장전원)/i.test(n);
  });

  const limit = hasStrict ? 103.0 : 120.0;

  box.innerHTML = `${missingHtml}조합비 : ${ratioTxt}%`;
  const isBad = parseFloat(ratioTxt) >= limit;
  box.classList.toggle('bad', isBad);
  box.style.color = ''; // 색상초기화
  
  COMM_RATIO_VAL = ratioTxt + '%';
  COMM_RATIO_LIMIT = limit; 
}

