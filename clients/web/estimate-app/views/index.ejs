// 초기화
function setupCustomRows() {
  const configs = [
    { type: 'home', table: '.est-home', cols: 13, hasList: true, nameCols: 4 },
    { type: 'single', table: '.est-single', cols: 8, hasList: false, nameCols: 4 },
    { type: 'comm', table: '.est-comm', cols: 13, hasList: true, nameCols: 4 },
    { type: 'old', table: '.est-old', cols: 7, hasList: true, nameCols: 1 }
  ];

  configs.forEach(cfg => {
    const table = document.querySelector(cfg.table);
    if (!table) return;

    const cBody = document.createElement('tbody');
    cBody.id = cfg.type + 'CustomBody';
    
    const tfoot = table.querySelector('tfoot');
    if (tfoot) {
      table.insertBefore(cBody, tfoot);
    } else {
      table.appendChild(cBody);
    }
    window.addCustomRow(cfg.type);
  });
}

