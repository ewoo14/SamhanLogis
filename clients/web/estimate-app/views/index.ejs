/* 홈멀티 바인딩 */
function bindQty(sel,onChange){
  const arr = Array.from(document.querySelectorAll(sel));
  arr.forEach((inp,i)=>{
    inp.addEventListener('keydown',e=>{
      if(e.key==='ArrowUp'){e.preventDefault();(arr[i-1]||arr[i]).focus();}
      if(e.key==='ArrowDown'){e.preventDefault();(arr[i+1]||arr[i]).focus();}
      if(e.key==='-'||e.key==='.'){e.preventDefault();}
    });
    inp.addEventListener('wheel',e=>e.preventDefault(),{passive:false});

    // 입력 처리
    inp.addEventListener('input',e=>{
      const v = toInt(e.target.value);
      e.target.value = v ? String(v) : '';
      const m   = e.target.dataset.m;
      const sid = e.target.dataset.sid;
      if(m!=null) onChange(m, v); else onChange(sid, v);
      refreshSelectedBadge();
    });
  });
}
