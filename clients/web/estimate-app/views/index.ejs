function handleListPriceInput(e, type, key) {
  const inp = e.target;
  const raw = inp.value.replace(/[^0-9]/g, '');

  // 출고가 탐색
  let autoList = 0;
  if (type === 'home') { const r = homeRowByModel.get(key); autoList = getBaseListPrice('home', key, Math.round(Number(r?.list)||0)); }
  else if (type === 'comm') { const r = COMMULTI.find(x=>x.model===key); autoList = getBaseListPrice('comm', key, Math.round(Number(r?.list)||0)); }
  else if (type === 'single') { const s = SINGLE_SETS.find(x=>String(x.id)===String(key)); autoList = getBaseListPrice('single', s?.model, Math.round(Number(s?.list)||0)); }
  else if (type === 'old') { const r = OLD_PRODUCTS.find(x=>x.model===key); autoList = Math.round(Number(r?.price)||0); }

  // 빈칸 입력 시 기본값 복귀
  if (inp.value.trim() === '') {
    if (type === 'home') homeCustomListPrices.delete(key);
    else if (type === 'comm') commCustomListPrices.delete(key);
    else if (type === 'single') { if(typeof singleCustomListPrices !== 'undefined') singleCustomListPrices.delete(key); }
    else if (type === 'old') oldCustomListPrices.delete(key);

    inp.value = autoList > 0 ? autoList.toLocaleString() : '';
    inp.style.color = '#374151'; inp.style.fontWeight = 'normal';
  } else {
    // 직접 입력 시 커스텀 데이터 저장
    const val = parseInt(raw, 10);
    inp.value = val.toLocaleString();
    inp.style.color = '#2563eb'; inp.style.fontWeight = 'bold';

    if (type === 'home') homeCustomListPrices.set(key, val);
    else if (type === 'comm') commCustomListPrices.set(key, val);
    else if (type === 'single') { if(typeof singleCustomListPrices === 'undefined') window.singleCustomListPrices = new Map(); singleCustomListPrices.set(key, val); }
    else if (type === 'old') oldCustomListPrices.set(key, val);
  }

  // 출고가 및 납품가 업데이트
  const tr = inp.closest('tr');
  if (!tr) return;

  if (type === 'home') {
    const u = homeUnitPrice(key);
    const q = homeQty.get(key)||0;
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !homeCustomPrices.has(key)){
      priceInp.value = u.toLocaleString();
      priceInp.style.color = '#374151'; 
      priceInp.style.fontWeight = 'normal';
    }
    const subCell = tr.querySelector(`[data-sub="${CSS.escape(key)}"]`);
    if(subCell) subCell.textContent = fmt(u * q);
    syncHomeTotals();
  } else if (type === 'comm') {
    const u = commUnitPrice(key);
    const q = commQty.get(key)||0;
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !commCustomPrices.has(key)){
      priceInp.value = u.toLocaleString();
      priceInp.style.color = '#374151'; 
      priceInp.style.fontWeight = 'normal';
    }
    const subCell = tr.querySelector(`[data-csub="${CSS.escape(key)}"]`);
    if(subCell) subCell.textContent = fmt(u * q);
    syncCommTotals();
  } else if (type === 'single') {
    const s = SINGLE_SETS.find(x => String(x.id) === String(key));
    const u = s ? calcSetUnitPrice(s) : 0;
    const q = singleQty.get(key)||0;
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !singleCustomPrices.has(key)){
      priceInp.value = u.toLocaleString();
      priceInp.style.color = '#374151'; 
      priceInp.style.fontWeight = 'normal';
    }
    const subCell = tr.querySelector(`[data-ss="${CSS.escape(key)}"]`);
    if(subCell) subCell.textContent = fmt(u * q);
    syncSingleTotals();
    if(typeof updateInlineTotals === 'function') updateInlineTotals();
  } else if (type === 'old') {
    const u = getRealOldPrice(key);
    const q = oldQty.get(key)||0;
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !oldCustomPrices.has(key)){
      priceInp.value = u.toLocaleString();
      priceInp.style.color = '#374151'; 
      priceInp.style.fontWeight = 'normal';
    }
    const subCell = tr.querySelector('.sub-cell');
    if(subCell) subCell.textContent = fmt(u * q);
    syncOldTotals();
  }
  
  if(typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
}

