/* 동기화 */
function syncRepTel() {
  const custTel = document.getElementById('custTel');
  const telField = document.getElementById('tel');
  if (!custTel || !telField) return;

  const raw = custTel.value || '';
  const match = raw.match(/010[-\s]?\d{4}[-\s]?\d{4}/);

  if (match) {
    const num = match[0].replace(/\D/g, '');
    if (num.length === 11) {
      telField.value = '010-' + num.slice(3, 7) + '-' + num.slice(7);
      telField.dispatchEvent(new Event('input', { bubbles: true }));
    }
  } else {
    alert('동기화할 번호가 없습니다.');
  }
}

