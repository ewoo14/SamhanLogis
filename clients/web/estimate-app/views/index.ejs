// 태그수정
function updateOrderTags() {
  const chkYard = document.getElementById('chkYard')?.checked;
  const chkLocal = document.getElementById('chkLocal')?.checked;
  const hasTag = chkYard || chkLocal;
  
  const addrBase = document.getElementById('addrBase');
  if(addrBase) {
    let prefix = '';
    if (chkYard) prefix = '야적/';
    else if (chkLocal) prefix = '지방/';
    
    let coreAddr = addrBase.value.replace(/^(야적\/|지방\/)/, '');
    addrBase.dataset.coreValue = coreAddr;
    addrBase.value = prefix + coreAddr;
  }
  
  const dueVal = document.getElementById('due')?.value;
  const memoEl = document.getElementById('memo');
  if(memoEl) {
    let coreMemo = memoEl.value.replace(/^\d+상\d+하\s*/, '');
    memoEl.dataset.coreValue = coreMemo;
    
    if (hasTag && dueVal) {
      const d = new Date(dueVal);
      const next = new Date(d);
      next.setDate(d.getDate() + 1);
      if (next.getDay() === 0) {
        if (!(chkYard && d.getDay() === 6)) {
          next.setDate(next.getDate() + 1);
        }
      }
      const tag = d.getDate() + '상' + next.getDate() + '하 ';
      memoEl.value = tag + coreMemo;
    } else {
      memoEl.value = coreMemo;
    }
  }
}

// 태그강제
function enforceTagsOnInput(e) {
  const chkYard = document.getElementById('chkYard')?.checked;
  const chkLocal = document.getElementById('chkLocal')?.checked;
  const hasTag = chkYard || chkLocal;
  
  if (e.target.id === 'addrBase') {
    let prefix = '';
    if (chkYard) prefix = '야적/';
    else if (chkLocal) prefix = '지방/';
    
    if (prefix) {
      if (!e.target.value.startsWith(prefix)) {
        e.target.value = prefix + (e.target.dataset.coreValue || '');
      } else {
        e.target.dataset.coreValue = e.target.value.substring(prefix.length);
      }
    } else {
      e.target.dataset.coreValue = e.target.value;
    }
  } else if (e.target.id === 'memo') {
    if (!hasTag) {
      e.target.dataset.coreValue = e.target.value;
      return;
    }
    
    const dueVal = document.getElementById('due')?.value;
    if (!dueVal) return;
    
    const d = new Date(dueVal);
    const next = new Date(d);
    next.setDate(d.getDate() + 1);
    if (next.getDay() === 0) {
      if (!(chkYard && d.getDay() === 6)) {
        next.setDate(next.getDate() + 1);
      }
    }
    const tag = d.getDate() + '상' + next.getDate() + '하 ';
    
    if (!e.target.value.startsWith(tag)) {
      e.target.value = tag + (e.target.dataset.coreValue || '');
    } else {
      e.target.dataset.coreValue = e.target.value.substring(tag.length);
    }
  }
}

// 메모추가
function appendMemo(text) {
  const el = document.getElementById('memo');
  if (el) {
    const val = el.value;
    if (!val) {
      el.value = text;
    } else if (val.endsWith(' ')) {
      el.value = val + text;
    } else {
      el.value = val + ' ' + text;
    }
    el.dispatchEvent(new Event('input'));
  }
}

