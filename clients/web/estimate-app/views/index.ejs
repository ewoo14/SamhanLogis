/* 표시명 */
function singleDispNameTrimmed(s,cls){
  if (/^ADP-F075SP$/i.test(String(s?.model||''))) {return '실링용 드레인펌프';}
  const base=String(s?.name||'');const tokens=[];
  if(cls?.catL){tokens.push(...cls.catL.split(/\s+/));if(/냉방전용/.test(cls.catL))tokens.push('냉전');if(/4way/i.test(cls.catL))tokens.push('4WAY','4 Way','4-Way');if(/1way/i.test(cls.catL))tokens.push('1WAY','1 Way','1-Way');tokens.push('25년형','가정용','비스포크','스탠드','벽걸이','실링','덕트');}
  if(cls?.catM){tokens.push(cls.catM,'디럭스');}
  let t=base;tokens.filter(Boolean).forEach(tok=>{const rx=new RegExp(tok.replace(/\s+/g,'\\s*'),'gi');t=t.replace(rx,' ');});
  t=cleanDisplayName(t,t).replace(/\s{2,}/g,' ').trim();t=displayOverrides(t,'single');
  const size=(s?.sizeText&&String(s.sizeText).trim())||(s?.size||'');
  return `${t}${size?` ${size}평형`:''}`.trim();
}

