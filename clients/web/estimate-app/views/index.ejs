        };
        if (['name', 'model', 'list', 'spec', 'qty', 'price', 'fixDc']
            .some(key => String(row[key] || '').trim() !== '') || row.varDc) {
          rows.push(row);
        }
      });
      customRowsData[type] = rows;
    }
  });

  // 데이터코어
  const core = {
    homeQty: Array.from(homeQty.entries()),
    singleQty: Array.from(singleQty.entries()),
    commQty: Array.from(commQty.entries()),
    oldQty: Array.from(oldQty.entries()),
    
    homePrices: typeof homeCustomPrices !== 'undefined' ? Array.from(homeCustomPrices.entries()) : [],
    singlePrices: typeof singleCustomPrices !== 'undefined' ? Array.from(singleCustomPrices.entries()) : [],
    commPrices: typeof commCustomPrices !== 'undefined' ? Array.from(commCustomPrices.entries()) : [],
    oldPrices: typeof oldCustomPrices !== 'undefined' ? Array.from(oldCustomPrices.entries()) : [],
    
    homeListPrices: typeof homeCustomListPrices !== 'undefined' ? Array.from(homeCustomListPrices.entries()) : [],
    singleListPrices: typeof singleCustomListPrices !== 'undefined' ? Array.from(singleCustomListPrices.entries()) : [],
    commListPrices: typeof commCustomListPrices !== 'undefined' ? Array.from(commCustomListPrices.entries()) : [],
    oldListPrices: typeof oldCustomListPrices !== 'undefined' ? Array.from(oldCustomListPrices.entries()) : [],

    homeSpecs: typeof homeCustomSpecs !== 'undefined' ? Array.from(homeCustomSpecs.entries()) : [],
    commSpecs: typeof commCustomSpecs !== 'undefined' ? Array.from(commCustomSpecs.entries()) : [],
    oldSpecs: typeof oldCustomSpecs !== 'undefined' ? Array.from(oldCustomSpecs.entries()) : [],

    singlePartQtys: typeof singleCustomPartQtys !== 'undefined' ? Array.from(singleCustomPartQtys.entries()) : [],
    commPartQtys: typeof commCustomPartQtys !== 'undefined' ? Array.from(commCustomPartQtys.entries()) : [],

    homeManualPanel: typeof HOME_MANUAL_PANEL !== 'undefined' ? Array.from(HOME_MANUAL_PANEL) : [],
    homeManualHose: typeof HOME_MANUAL_HOSE !== 'undefined' ? Array.from(HOME_MANUAL_HOSE) : [],
    homeManualRemote: typeof HOME_MANUAL_REMOTE !== 'undefined' ? Array.from(HOME_MANUAL_REMOTE) : [],
    homeManualBranch: typeof HOME_MANUAL_BRANCH !== 'undefined' ? Array.from(HOME_MANUAL_BRANCH) : [],
    homeManualFoot: typeof HOME_MANUAL_FOOT !== 'undefined' ? Array.from(HOME_MANUAL_FOOT) : [],

    commManualPanel: typeof COMM_MANUAL_PANEL !== 'undefined' ? Array.from(COMM_MANUAL_PANEL) : [],
    commManualHose: typeof COMM_MANUAL_HOSE !== 'undefined' ? Array.from(COMM_MANUAL_HOSE) : [],
    commManualRemote: typeof COMM_MANUAL_REMOTE !== 'undefined' ? Array.from(COMM_MANUAL_REMOTE) : [],
    commManualPump: typeof COMM_MANUAL_PUMP !== 'undefined' ? Array.from(COMM_MANUAL_PUMP) : [],
    commManualBase: typeof COMM_MANUAL_BASE !== 'undefined' ? Array.from(COMM_MANUAL_BASE) : [],
    
    absoluteLock: window.ABSOLUTE_LOCK ? Array.from(window.ABSOLUTE_LOCK) : [],

    homeDc: homeDc,
    commDc: commDc,
    partCustomData: partCustomData,
    customRows: customRowsData,
    customFinalOrder: window.CUSTOM_FINAL_ORDER || null,
    customFinalHash: window.CUSTOM_FINAL_HASH || null
  };

  return {
    timestamp: Date.now(),
    form: formData,
    branch: brData,
    core: core
  };
}

/* 상태복원 */
function applySnapshot(shot, custName) {
  if(!confirm('현재 내용을 지우고 해당 견적으로 복원하시겠습니까?')) return;
  try {
    const prevSector = window.activeSector;
    const form = shot.form || {};

    // 일차복원
    for(const [k, valObj] of Object.entries(form)){
      const v = (valObj !== null && typeof valObj === 'object') ? valObj.v : valObj;
      if(document.querySelector(`input[type="radio"][name="${k}"]`)){
        const r = document.querySelector(`input[name="${k}"][value="${v}"]`);
        if(r) r.checked = true;
      } else {
        const el = document.getElementById(k) || document.querySelector(`[name="${k}"]`);
        if(el){
          if(el.type === 'checkbox') el.checked = v;
          else if(el.tagName === 'SELECT') el.value = v;
        }
      }
    }

    // 코어세팅
    if(shot.core){
      const res = (m, d) => { if(m&&d) { m.clear(); d.forEach(([k,v])=>m.set(k,v)); } };
      const resSet = (set, arr) => { if(set && arr) { set.clear(); arr.forEach(v => set.add(v)); } };

      res(homeQty, shot.core.homeQty);
      res(singleQty, shot.core.singleQty);
      res(commQty, shot.core.commQty);
      res(oldQty, shot.core.oldQty);

      if (shot.core.customFinalOrder) {
        window.CUSTOM_FINAL_ORDER = shot.core.customFinalOrder;
        window.CUSTOM_FINAL_HASH = shot.core.customFinalHash;
      } else {
        window.CUSTOM_FINAL_ORDER = null;
        window.CUSTOM_FINAL_HASH = null;
      }

      if(typeof homeCustomPrices!=='undefined') res(homeCustomPrices, shot.core.homePrices);
      if(typeof singleCustomPrices!=='undefined') res(singleCustomPrices, shot.core.singlePrices);
      if(typeof commCustomPrices!=='undefined') res(commCustomPrices, shot.core.commPrices);
      if(typeof oldCustomPrices!=='undefined') res(oldCustomPrices, shot.core.oldPrices);

      if(typeof homeCustomListPrices!=='undefined') res(homeCustomListPrices, shot.core.homeListPrices);
      if(typeof singleCustomListPrices!=='undefined') res(singleCustomListPrices, shot.core.singleListPrices);
      if(typeof commCustomListPrices!=='undefined') res(commCustomListPrices, shot.core.commListPrices);
      if(typeof oldCustomListPrices!=='undefined') res(oldCustomListPrices, shot.core.oldListPrices);

      if(typeof homeCustomSpecs!=='undefined') res(homeCustomSpecs, shot.core.homeSpecs);
      if(typeof commCustomSpecs!=='undefined') res(commCustomSpecs, shot.core.commSpecs);
      if(typeof oldCustomSpecs!=='undefined') res(oldCustomSpecs, shot.core.oldSpecs);

      if(typeof singleCustomPartQtys!=='undefined') res(singleCustomPartQtys, shot.core.singlePartQtys);
      if(typeof commCustomPartQtys!=='undefined') res(commCustomPartQtys, shot.core.commPartQtys);

      resSet(typeof HOME_MANUAL_PANEL !== 'undefined' ? HOME_MANUAL_PANEL : null, shot.core.homeManualPanel);
      resSet(typeof HOME_MANUAL_HOSE !== 'undefined' ? HOME_MANUAL_HOSE : null, shot.core.homeManualHose);
      resSet(typeof HOME_MANUAL_REMOTE !== 'undefined' ? HOME_MANUAL_REMOTE : null, shot.core.homeManualRemote);
      resSet(typeof HOME_MANUAL_BRANCH !== 'undefined' ? HOME_MANUAL_BRANCH : null, shot.core.homeManualBranch);
      resSet(typeof HOME_MANUAL_FOOT !== 'undefined' ? HOME_MANUAL_FOOT : null, shot.core.homeManualFoot);

      resSet(typeof COMM_MANUAL_PANEL !== 'undefined' ? COMM_MANUAL_PANEL : null, shot.core.commManualPanel);
      resSet(typeof COMM_MANUAL_HOSE !== 'undefined' ? COMM_MANUAL_HOSE : null, shot.core.commManualHose);
      resSet(typeof COMM_MANUAL_REMOTE !== 'undefined' ? COMM_MANUAL_REMOTE : null, shot.core.commManualRemote);
      resSet(typeof COMM_MANUAL_PUMP !== 'undefined' ? COMM_MANUAL_PUMP : null, shot.core.commManualPump);
      resSet(typeof COMM_MANUAL_BASE !== 'undefined' ? COMM_MANUAL_BASE : null, shot.core.commManualBase);
    }

    // 커스텀행복원
    if (shot.core && shot.core.customRows) {
      ['home', 'single', 'comm', 'old'].forEach(type => {
        const rows = shot.core.customRows[type];
        if (rows && rows.length > 0) {
          const tbody = document.getElementById(type + 'CustomBody');
          if (tbody) {
            tbody.innerHTML = '';
            rows.forEach(r => {
              if (typeof window.addCustomRow === 'function') {
                window.addCustomRow(type);
                const lastTr = tbody.lastElementChild;
                if (lastTr) {
                  const nameNode = lastTr.querySelector('.pc-name');
                  const moNameNode = lastTr.querySelector('.mo-name');
                  if (nameNode) nameNode.value = r.name || '';
                  if (moNameNode) moNameNode.value = r.name || '';
                  
                  const modelNode = lastTr.querySelector('.custom-model');
                  if (modelNode) modelNode.value = r.model || '';

                  const listNode = lastTr.querySelector('.list-price-input');
                  if (listNode) listNode.value = r.list || '';

                  const specNode = lastTr.querySelector('.custom-spec');
                  if (specNode) specNode.value = r.spec || '';

                  const qtyNode = lastTr.querySelector('.custom-qty');
                  if (qtyNode) {
                    qtyNode.value = r.qty || '';
                    qtyNode.setAttribute('value', r.qty || '');
                  }

                  const priceNode = lastTr.querySelector('.custom-price');
                  if (priceNode) priceNode.value = r.price || '';

                  const fixNode = lastTr.querySelector('.custom-fix-dc');
                  if (fixNode) fixNode.value = r.fixDc || '';

                  const varNode = lastTr.querySelector('.custom-var-dc');
                  if (varNode && r.varDc !== undefined) varNode.checked = r.varDc;

                  if (typeof window.updateCustomSubtotal === 'function') {
                    window.updateCustomSubtotal(qtyNode, type);
                  }
                }
              }
            });
          }
        }
      });
    }

    // 렌더링
    if(typeof renderHome==='function') renderHome();
    if(typeof renderSingle==='function') renderSingle();
    if(typeof renderComm==='function') renderComm();
    if(typeof renderOld==='function') renderOld();

    // 파생연산
    if(typeof recomputeHomeDerived==='function') recomputeHomeDerived(true);
    if(typeof recomputeSingleBaseFoot==='function') recomputeSingleBaseFoot();
    if(typeof recomputeCommDerived==='function') recomputeCommDerived();
    if(typeof refreshSelectedBadge==='function') refreshSelectedBadge();

    // 이차코어복원
    if(shot.core){
      const res = (m, d) => { if(m&&d) { m.clear(); d.forEach(([k,v])=>m.set(k,v)); } };
      res(homeQty, shot.core.homeQty);
      res(singleQty, shot.core.singleQty);
      res(commQty, shot.core.commQty);
      res(oldQty, shot.core.oldQty);
    }

    // 메인행동기화
    if (shot.core && shot.core.homeQty) {
      shot.core.homeQty.forEach(([k, v]) => {
        const inp = document.querySelector(`#homeBody .qty-input[data-m="${CSS.escape(k)}"]`);
        if (inp && !inp.classList.contains('fix-dc-inp')) {
          inp.value = v > 0 ? v : '';
          inp.style.color = '';
          inp.style.fontWeight = '';
        }
      });
      if(typeof syncHomeUIFromState === 'function') syncHomeUIFromState();
    }

    if (shot.core && shot.core.singleQty) {
      shot.core.singleQty.forEach(([k, v]) => {
        const inp = document.querySelector(`#singleBody .qty-input[data-sid="${CSS.escape(k)}"]`);
        if (inp) {
          inp.value = v > 0 ? v : '';
          inp.style.color = '';
          inp.style.fontWeight = '';
        }
      });
      if(typeof syncSingleUIFromState === 'function') syncSingleUIFromState();
    }

    if (shot.core && shot.core.commQty) {
      shot.core.commQty.forEach(([k, v]) => {
        const inp = document.querySelector(`#commBody .qty-input[data-model="${CSS.escape(k)}"]`);
        if (inp) {
          inp.value = v > 0 ? v : '';
          inp.style.color = '';
          inp.style.fontWeight = '';
        }
      });
    }

    if (shot.core && shot.core.oldQty) {
      shot.core.oldQty.forEach(([k, v]) => {
        const itemIdx = typeof OLD_PRODUCTS !== 'undefined' ? OLD_PRODUCTS.findIndex(x => x.model === k) : -1;
        if (itemIdx >= 0) {
          const inp = document.querySelector(`#oldBody .qty-input[data-idx="${itemIdx}"]`);
          if (inp) {
            inp.value = v > 0 ? v : '';
            inp.style.color = '';
            inp.style.fontWeight = '';
          }
        }
      });
    }

    // 이차폼복원
    for(const [k, valObj] of Object.entries(form)){
      const isObj = (valObj !== null && typeof valObj === 'object');
      const v = isObj ? valObj.v : valObj;
      const l = isObj ? valObj.l : false;

      const el = document.getElementById(k) || document.querySelector(`[name="${k}"]`);
      if(el && el.type !== 'checkbox' && el.type !== 'radio' && el.tagName !== 'SELECT'){
        el.value = v;
        
        if (k === 'custSearch' && v) {
          const matched = (typeof CUSTOMERS !== 'undefined') ? CUSTOMERS.find(c => c.name === v) : null;
          if (matched) {
            el.dataset.code = matched.code;
            if(document.getElementById('custRep')) document.getElementById('custRep').value = matched.rep || '';
            if(document.getElementById('custTel')) document.getElementById('custTel').value = matched.tel || '';
            if(document.getElementById('custAddr')) document.getElementById('custAddr').value = matched.addr || '';
            if(document.getElementById('custGroup')) document.getElementById('custGroup').value = matched.group || '';
            if(document.getElementById('custNote')) document.getElementById('custNote').value = matched.note || '';
          }
        }

        if (k === 'managerSearch' && v) {
          const matched = (typeof MANAGERS !== 'undefined') ? MANAGERS.find(m => getManagerName_(m) === v) : null;
          if (matched) el.dataset.code = getManagerCode_(matched);
        }

        // 예외처리
        const isDc = /dc|disc|rate/i.test(k);
        if (isDc) continue;

        // 스타일복원
        if (l === true) {
          el.style.color = '#2563eb';
          el.style.fontWeight = 'bold';
        } else if (typeof l === 'string' && l !== '') {
          el.style.color = l;
          el.style.fontWeight = (l.includes('2563eb') || l.includes('rgb(37, 99, 235)')) ? 'bold' : '';
        } else {
          el.style.color = '';
          el.style.fontWeight = '';
        }
      }
    }

    // 디씨복원
    ['home', 'comm'].forEach(type => {
      const isHome = type === 'home';
      const dcData = isHome ? shot.core?.homeDc : shot.core?.commDc;
      const getPrice = isHome ? homeUnitPrice : commUnitPrice;
      const getQty = isHome ? homeQty : commQty;
      if (dcData) {
        for (const [m, dc] of Object.entries(dcData)) {
          const tr = document.querySelector(`#${type}Body tr[data-m="${CSS.escape(m)}"]`);
          if (tr) {
            const fixInp = tr.querySelector('.fix-dc-inp');
            if (fixInp && dc.fix !== undefined) fixInp.value = dc.fix;
            const varChk = tr.querySelector('.var-dc-chk');
            if (varChk && dc.var !== undefined) varChk.checked = dc.var;
            
            const u = getPrice(m);
            const q = getQty.get(m) || 0;
            const priceInp = tr.querySelector('.price-input');
            const customPrices = isHome ? homeCustomPrices : commCustomPrices;
            if (priceInp && typeof customPrices !== 'undefined' && !customPrices.has(m)) {
                priceInp.value = typeof fmt === 'function' ? fmt(u) : u.toLocaleString();
            }
            const subCell = tr.querySelector(isHome ? '.sub' : '[data-csub]');
            if (subCell) {
              if (subCell.childNodes.length > 0 && subCell.childNodes[0].nodeType === 3) {
                  subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(u * q) : (u * q).toLocaleString();
              } else {
                  subCell.textContent = typeof fmt === 'function' ? fmt(u * q) : (u * q).toLocaleString();
              }
            }
          }
        }
      }
    });

    // 서브파트복원
    if(shot.core && shot.core.partCustomData){
      for (const [key, partsMap] of Object.entries(shot.core.partCustomData)) {
        if (key.startsWith('single_')) {
          const setId = key.replace('single_', '');
          document.querySelectorAll(`.set-part-single[data-part-of="${CSS.escape(setId)}"]`).forEach(ptr => {
            const model = ptr.getAttribute('data-m');
            const data = partsMap[model];
            if (data) {
              const qtyInp = ptr.querySelector('.part-qty-single');
              const priceInp = ptr.querySelector('.price-input');
              const specInp = ptr.querySelector('.spec-input');
              let qVal = 0, pVal = 0;

              if(qtyInp && data.q !== undefined) {
                qtyInp.value = data.q;
                qtyInp.setAttribute('value', data.q);
                qVal = parseInt(data.q, 10) || 0;
                const span = ptr.querySelector('.val-for-text');
                if (span) span.textContent = qVal;
                
                if(data.qL) {
                  qtyInp.style.color = '#2563eb';
                  qtyInp.style.fontWeight = 'bold';
                } else {
                  qtyInp.style.color = '';
                  qtyInp.style.fontWeight = '';
                }
              } else {
                qVal = parseInt(qtyInp?.value||'0', 10);
              }

              if(priceInp && data.p !== undefined) {
                pVal = parseInt(data.p, 10) || 0;
                priceInp.value = typeof fmt === 'function' ? fmt(pVal) : pVal.toLocaleString();
                if(data.pL) {
                  priceInp.style.color = '#2563eb';
                  priceInp.style.fontWeight = 'bold';
                } else {
                  priceInp.style.color = '';
                  priceInp.style.fontWeight = '';
                }
              } else {
                pVal = parseInt(priceInp?.value.replace(/[^0-9]/g,'')||'0', 10);
              }

              if(specInp && data.spec !== undefined) {
                specInp.value = data.spec;
                if(data.sL) {
                  specInp.style.color = '#2563eb';
                  specInp.style.fontWeight = 'bold';
                } else {
                  specInp.style.color = '';
                  specInp.style.fontWeight = '';
                }
              }

              const subCell = ptr.querySelector('.sub');
              if(subCell) {
                subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(qVal * pVal) : (qVal * pVal).toLocaleString();
                const subSpan = subCell.querySelector('.val-for-text');
                if (subSpan) subSpan.textContent = qVal * pVal;
              }
            }
          });
        } else if (key.startsWith('comm_')) {
          const setId = key.replace('comm_', '');
          document.querySelectorAll(`#commBody tr[data-part-of="${CSS.escape(setId)}"]`).forEach(ptr => {
            const model = ptr.getAttribute('data-m');
            const data = partsMap[model];
            if (data) {
              const qtyInp = ptr.querySelector('.part-qty-comm, .qty-input');
              const priceInp = ptr.querySelector('.price-input, .part-price-comm');
              const specInp = ptr.querySelector('.spec-input');
              let qVal = 0, pVal = 0;

              if(qtyInp && data.q !== undefined) {
                qtyInp.value = data.q;
                qtyInp.setAttribute('value', data.q);
                qVal = parseInt(data.q, 10) || 0;
                const span = ptr.querySelector('.val-for-text');
                if (span) span.textContent = qVal;
                
                if(data.qL) {
                  qtyInp.style.color = '#2563eb';
                  qtyInp.style.fontWeight = 'bold';
                } else {
                  qtyInp.style.color = '';
                  qtyInp.style.fontWeight = '';
                }
              } else {
                qVal = parseInt(qtyInp?.value||'0', 10);
              }

              if(priceInp && data.p !== undefined) {
                pVal = parseInt(data.p, 10) || 0;
                priceInp.value = typeof fmt === 'function' ? fmt(pVal) : pVal.toLocaleString();
                if(data.pL) {
                  priceInp.style.color = '#2563eb';
                  priceInp.style.fontWeight = 'bold';
                } else {
                  priceInp.style.color = '';
                  priceInp.style.fontWeight = '';
                }
              } else {
                pVal = parseInt(priceInp?.value.replace(/[^0-9]/g,'')||'0', 10);
              }

              if(specInp && data.spec !== undefined) {
                specInp.value = data.spec;
                if(data.sL) {
                  specInp.style.color = '#2563eb';
                  specInp.style.fontWeight = 'bold';
                } else {
                  specInp.style.color = '';
                  specInp.style.fontWeight = '';
                }
              }

              const subCell = ptr.querySelector('.sub, [data-csub]');
              if(subCell) {
                if (subCell.childNodes.length > 0 && subCell.childNodes[0].nodeType === 3) {
                  subCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(qVal * pVal) : (qVal * pVal).toLocaleString();
                } else {
                  subCell.textContent = typeof fmt === 'function' ? fmt(qVal * pVal) : (qVal * pVal).toLocaleString();
                }
                const subSpan = subCell.querySelector('.val-for-text');
                if (subSpan) subSpan.textContent = qVal * pVal;
              }
            }
          });
        }
      }
    }

    // 합계동기화
    if(typeof syncHomeTotals==='function') syncHomeTotals();
    if(typeof syncSingleTotals==='function') syncSingleTotals();
    if(typeof syncCommTotals==='function') syncCommTotals();
    if(typeof syncOldTotals==='function') syncOldTotals();

    // 분기복원
    if(shot.branch){
      window.GLOBAL_BRANCH_STATE = shot.branch;
      try { sessionStorage.setItem('branch_state_v2', JSON.stringify(shot.branch)); } catch(e){}
      if(typeof buildBranchView === 'function') {
        document.getElementById('branchBoard').innerHTML = '';
        buildBranchView();
      }
      if(typeof applyBranchState === 'function') applyBranchState(shot.branch);
      setTimeout(() => {
        if (window.GLOBAL_BRANCH_STATE && window.GLOBAL_BRANCH_STATE.grid) {
          for (const groupKey in window.GLOBAL_BRANCH_STATE.grid) {
            const inputs = document.querySelectorAll(`.out-slot[data-out="${groupKey}"] input`);
            const dataList = window.GLOBAL_BRANCH_STATE.grid[groupKey];
            inputs.forEach((inp, idx) => {
              if (dataList[idx] && dataList[idx].val !== undefined) {
                inp.value = dataList[idx].val || '';
              }
            });
          }
        }
        if(typeof recomputeBranchCodes === 'function') recomputeBranchCodes();
        if(prevSector && prevSector !== 'branch') {
          document.body.classList.remove('branch-active');
          window.activeSector = prevSector;
          document.body.classList.add(prevSector + '-active');
          if(typeof refreshBranchOpenButton === 'function') refreshBranchOpenButton();
        }
      }, 100);
    } else {
      window.GLOBAL_BRANCH_STATE = null;
      try { sessionStorage.removeItem('branch_state_v2'); } catch(e){}
    }

    // 상태복원
    if (window.ABSOLUTE_LOCK) {
      window.ABSOLUTE_LOCK.clear();
      
      if (shot.core && shot.core.absoluteLock && shot.core.absoluteLock.length > 0) {
        shot.core.absoluteLock.forEach(k => window.ABSOLUTE_LOCK.add(k));
      } else if (shot.core) {
        // 과거데이터호환
        const manualLists = [
          shot.core.homeManualPanel, shot.core.homeManualHose, shot.core.homeManualRemote, shot.core.homeManualBranch, shot.core.homeManualFoot,
          shot.core.commManualPanel, shot.core.commManualHose, shot.core.commManualRemote, shot.core.commManualPump, shot.core.commManualBase
        ];
        manualLists.forEach(list => {
          if (list) list.forEach(k => window.ABSOLUTE_LOCK.add(k));
        });

        if (shot.core.homeQty) {
          shot.core.homeQty.forEach(([k, v]) => {
            if (v > 0) {
              const nm = String(typeof homeRowByModel !== 'undefined' && homeRowByModel.has(k) ? homeRowByModel.get(k).name : '');
              if (!/(판넬|패널|panel|리모컨|리모콘|유연호스|분\s*기\s*관|분기관|발통|일자발)/i.test(nm)) {
                window.ABSOLUTE_LOCK.add(k);
              }
            }
          });
        }
        
        if (shot.core.commQty) {
          shot.core.commQty.forEach(([k, v]) => {
            if (v > 0) {
              const rec = typeof COMMULTI !== 'undefined' ? COMMULTI.find(x => x.model === k) : null;
              if (rec) {
                if ((typeof isCommPanelRow === 'function' && isCommPanelRow(rec)) ||
                    (typeof isCommHoseRow === 'function' && isCommHoseRow(rec)) ||
                    (typeof isCommRemoteRow === 'function' && isCommRemoteRow(rec)) ||
                    (typeof isCommPumpRow === 'function' && isCommPumpRow(rec))) return;
                const s = ((rec.name||'')+' '+(rec.disp||'')+' '+(rec.model||'')).toLowerCase();
                if (/방진가대|받침대|발통세트|일자발|SI-AL/i.test(s)) return;
              }
              window.ABSOLUTE_LOCK.add(k);
            }
          });
        }
        
        ['singleQty', 'oldQty'].forEach(m => {
          if (shot.core[m]) {
            shot.core[m].forEach(([k, v]) => {
              if (v !== undefined && v !== null && v !== 0 && v !== '') {
                window.ABSOLUTE_LOCK.add(k);
              }
            });
          }
        });
      }
    }

    // 화면스타일복구
    if (window.ABSOLUTE_LOCK) {
      window.ABSOLUTE_LOCK.forEach(key => {
        let qs = `.qty-input[data-m="${CSS.escape(key)}"], .qty-input[data-model="${CSS.escape(key)}"], .qty-input[data-id="${CSS.escape(key)}"]`;
        if (key.includes('|')) {
          const parts = key.split('|');
          qs += `, input[data-set="${CSS.escape(parts[0])}"][data-part="${CSS.escape(parts[1])}"]`;
        }
        
        document.querySelectorAll(qs).forEach(inp => {
          // 전역방어통과
          window.CURRENT_INTERACTING_KEY = key; 
          inp.style.setProperty('color', '#2563eb', 'important');
          inp.style.setProperty('font-weight', 'bold', 'important');
          window.CURRENT_INTERACTING_KEY = null;
        });
      });
    }

    alert('✅ 복원 완료');
    logAction('기능', '견적복원 성공 - ' + (custName || '미상'));
    if(typeof closeSnapshotPage==='function') closeSnapshotPage();
  } catch(e) {
    console.error(e);
    alert('❌ 복원 실패: ' + e.message);
  }
}

/* 페이지 전환 함수 */
function hideAllPages() {
  const ids = ['divOrderInfo', 'divHome', 'divSingle', 'divComm', 'divOld', 'divPreviewSimple', 'divPreview', 'divFinal', 'divHistory', 'divSnapshotPage'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if(el) el.style.display = 'none';
  });
}

/* 저장 내역 페이지 열기 */
function goSnapshotPage() {
  const page = document.getElementById('divSnapshotPage');
  if(page) {
    page.style.display = 'block'; 
    page.style.zIndex = '210000'; // 모바일 최상단 노출
    document.body.classList.add('history-snapshot-open');
    
    const topDrawer = document.getElementById('drawerTop');
    if(topDrawer) topDrawer.classList.remove('active'); // 상단 서랍 닫기

    refreshBranchOpenButton('snapshot');

    // 범위
    const today = new Date();
    const past = new Date();
    past.setDate(today.getDate() - 7);

    const elStart = document.getElementById('snapStart');
    const elEnd = document.getElementById('snapEnd');
    
    if (elStart) elStart.value = toYMD(past);
    if (elEnd) elEnd.value = toYMD(today);

    // 열자마자 즉시 조회 실행
    loadSnapshotHistory();
  } else {
    alert('오류: 저장내역 페이지(divSnapshotPage) 코드가 HTML에 없습니다.');
  }
}

// 데이터조회
function loadSnapshotHistory() {
  logAction('화면이동', '저장내역');
  const tbody = document.getElementById('snapshotTableBody');
  if (!tbody) return;

  const sDate = document.getElementById('snapStart')?.value;
  const eDate = document.getElementById('snapEnd')?.value;

  tbody.innerHTML = '<tr><td colspan="4" style="padding:50px; color:#666;">⏳ 지정된 날짜의 내역을 불러오는 중입니다...</td></tr>';

  // 서버 요청
  google.script.run
    .withSuccessHandler(data => {
      if (data && data.length > 0) {
        const sd = sDate ? new Date(sDate + 'T00:00:00') : null;
        const ed = eDate ? new Date(eDate + 'T23:59:59') : null;
        
        // 프론트엔드 자체 날짜 필터링 적용
        const filtered = data.filter(item => {
          const itemDate = new Date(item.created);
          if (sd && itemDate < sd) return false;
          if (ed && itemDate > ed) return false;
          return true;
        });
        renderSnapshotTable(filtered);
      } else {
        renderSnapshotTable(data);
      }
    })
    .withFailureHandler(err => {
      tbody.innerHTML = `<tr><td colspan="3" style="padding:30px; color:red;">오류 발생: ${escapeEstimateHtml(err)}</td></tr>`;
    })
    .getQuoteHistory(sDate, eDate);
}

// 거래처명으로 최근 30건 조회
function loadSnapshotByCustomer() {
  logAction('화면이동', '저장내역 거래처조회');
  const tbody = document.getElementById('snapshotTableBody');
  if (!tbody) return;

  const custName = document.getElementById('snapCustName')?.value.trim() || '';
  if (!custName) {
    alert('거래처명을 입력해주세요.');
    return;
  }

  tbody.innerHTML = '<tr><td colspan="4" style="padding:50px; color:#666;">⏳ 거래처 내역을 불러오는 중입니다...</td></tr>';

  // 서버 요청
  google.script.run
    .withSuccessHandler(data => {
      renderSnapshotTable(data || []);
    })
    .withFailureHandler(err => {
      tbody.innerHTML = `<tr><td colspan="3" style="padding:30px; color:red;">오류 발생: ${escapeEstimateHtml(err)}</td></tr>`;
    })
    .getQuoteHistoryByCustomer(custName);
}

