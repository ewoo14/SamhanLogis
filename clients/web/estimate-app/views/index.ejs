/* 이미지 클립보드 복사 */
async function copyToClipboardImage() {
  const target = document.querySelector('#cardPreview'); // 캡처 대상
  if (!target) return;

  // 캡처 전 UI 정리 (버튼 숨기기, 스크롤바 제거 등)
  const foot = target.querySelector('.modal-foot');
  const head = target.querySelector('.card-head'); // 헤더(제목) 포함 여부 결정
  if(foot) foot.style.display = 'none'; // 하단 버튼은 캡처에서 제외

  try {
    // html2canvas로 캡처
    const canvas = await html2canvas(target, {
      scale: 2, // 고해상도
      backgroundColor: "#ffffff",
      logging: false,
      useCORS: true
    });

    // 클립보드에 쓰기
    canvas.toBlob(async (blob) => {
      try {
        const item = new ClipboardItem({ "image/png": blob });
        await navigator.clipboard.write([item]);
        alert("이미지가 클립보드에 복사되었습니다.\n(카카오톡 등에 붙여넣기 하세요)");
      } catch (err) {
        console.error(err);
        alert("클립보드 복사에 실패했습니다.\n(보안 정책상 지원되지 않을 수 있습니다)");
      }
    });
  } catch (err) {
    console.error(err);
    alert("이미지 생성 중 오류가 발생했습니다.");
  } finally {
    // UI 복구
    if(foot) foot.style.display = ''; 
  }
}

/* 파일 다운로드 (PNG, JPEG, PDF) */
async function downloadFile(type) {
  closeSaveOptions(); // 옵션창 닫기
  
  const target = document.querySelector('#cardPreview');
  const foot = target.querySelector('.modal-foot');
  const closeBtn = target.querySelector('.card-head button'); // 상단 X버튼

  // 캡처를 위해 불필요한 요소 임시 숨김
  if(foot) foot.style.display = 'none';
  if(closeBtn) closeBtn.style.display = 'none';

  try {
    const canvas = await html2canvas(target, {
      scale: 2,
      backgroundColor: "#ffffff"
    });

    const fileName = "종합견적(상세)";

    if (type === 'pdf') {
      // PDF 생성 (jsPDF 사용)
      const { jsPDF } = window.jspdf;
      // A4 크기 기준 비율 계산
      const imgData = canvas.toDataURL('image/png');
      const imgWidth = 210;
      const pageHeight = 297;
      const imgHeight = canvas.height * imgWidth / canvas.width;
      
      const doc = new jsPDF('p', 'mm', 'a4');
      let heightLeft = imgHeight;
      let position = 0;

      // 첫 페이지
      doc.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
      heightLeft -= pageHeight;

      // 내용이 길면 페이지 추가
      while (heightLeft >= 0) {
        position = heightLeft - imgHeight;
        doc.addPage();
        doc.addImage(imgData, 'PNG', 0, position, imgWidth, imgHeight);
        heightLeft -= pageHeight;
      }
      doc.save(`${fileName}.pdf`);

    } else {
      // 이미지 다운로드 (PNG, JPEG)
      const link = document.createElement('a');
      link.download = `${fileName}.${type}`;
      link.href = canvas.toDataURL(`image/${type}`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

  } catch (err) {
    console.error(err);
    alert("파일 저장 중 오류가 발생했습니다.");
  } finally {
    // UI 복구
    if(foot) foot.style.display = '';
    if(closeBtn) closeBtn.style.display = '';
  }
}

// 기본라벨
function getSingleSetOptionLabel(s) {
  // 예외확인
  var cls = (typeof classifySingleSetFixed === 'function') ? classifySingleSetFixed(s) : {};
  var cat = String(cls.catL || s.catL || '');
  if(cat === '부자재' || cat === '실외기 받침') return '';
  if(/발통/.test(s.name||'')) return '';

  var opts = [];
  
  // 부품분해
  var parts = [];
  if (typeof partsForSetStrict_ === 'function') parts = partsForSetStrict_(s);
  else if (typeof explodeSetParts === 'function') parts = explodeSetParts(s, 1, 0);

  // 리모컨
  var hasRem = parts.some(function(p){ return /리모컨|remote/i.test(p.kind||p.name||''); });
  var canRem = (typeof allowRemoteChange_ === 'function') ? allowRemoteChange_(s) : true;
  if(hasRem){
    var rEx = document.getElementById('ss_remote_ex');
    var rSel = document.getElementById('ss_remote');
    if(rEx && rEx.checked) opts.push('리모컨 제외');
    else if(canRem && rSel && rSel.value && rSel.value !== '기본' && rSel.value !== '무선') opts.push(rSel.value);
  }

  // 특성
  var is4Way = /4way|4-way/i.test(s.name||'') || parts.some(function(p){ return /4way|4-way/i.test(p.name||''); });
  var is360 = /360/.test(s.name||'') || parts.some(function(p){ return /360/.test(p.name||''); });
  var hasPan = parts.some(function(p){ return /(판넬|패널|panel)/i.test(p.kind||p.name||''); });

  // 판넬
  if(hasPan){
    var pSel = document.getElementById('ss_panel');
    if(pSel && pSel.value && pSel.value !== '기본' && pSel.value !== '선택 안함'){
      var val = pSel.value;
      
      // 승강제한
      if(val === '블랙판넬' || val === '승강판넬'){
        if(is4Way || is360) opts.push(val);
      } else {
        opts.push(val);
      }
    }
  }

  // 원형
  if(is360){
    var p360 = document.getElementById('ss_p360');
    
    // 원형표기
    if(p360 && p360.value && p360.value !== '기본') opts.push(p360.value);
  }

  // 자재
  var isAC = /^AC/i.test(s.model||'');
  if(!isAC){
    var mSel = document.getElementById('ss_mat');
    if(mSel && mSel.value === '포함') opts.push('자재포함');
  }

  if(!opts.length) return '';
  return ' (' + opts.join('/') + ')';
}

// 라이브라벨
function getSingleSetOptionLabelLive(s) {
  const domParts = Array.from(document.querySelectorAll(`.set-part-single[data-part-of="${CSS.escape(s.id)}"]`));
  if (domParts.length === 0) return typeof getSingleSetOptionLabel === 'function' ? getSingleSetOptionLabel(s) : '';

  const activeParts = [];
  domParts.forEach(ptr => {
      const pq = parseInt(ptr.querySelector('.part-qty-single')?.value || '0', 10);
      if(pq !== 0) activeParts.push(ptr.querySelector('.colD').textContent);
  });

  const opts = [];
  const hasPart = (rx) => activeParts.some(text => rx.test(text));

  if (hasPart(/유선.*리모컨/i)) opts.push('유선리모컨');
  else if (hasPart(/컬러.*리모컨/i)) opts.push('컬러유선');
  if (!hasPart(/리모컨|리모콘/i)) opts.push('리모컨 제외');

  if (hasPart(/블랙.*판넬/i)) opts.push('블랙판넬');
  else if (hasPart(/승강.*판넬/i)) opts.push('승강판넬');
  else if (hasPart(/공청.*판넬/i)) opts.push('공청판넬');

  if (hasPart(/360/i) && hasPart(/사각/i)) opts.push('사각');

  if(!opts.length) return '';
  return ' (' + opts.join('/') + ')';
}

/* 구조화 */
function getStructuredQuoteData() {
  const sections = [];
  const isSimple = window.previewMode === 'SIMPLE'; 
  
  // 상업
  const commRows = [];
  if (typeof COMMULTI !== 'undefined' && typeof commQty !== 'undefined') {
    COMMULTI.forEach(r => {
      const q = commQty.get(r.model) || 0;
      if (!q) return;
      
      // 출고가
      const baseListP = getBaseListPrice('comm', r.model, r.list || r.listPrice || 0);
      const listP = getRealListPrice('COMM', r.model, baseListP);
      
      const isSet = String(r.unit || '').toUpperCase() === 'SET' && isCommOutdoorRow(r);
      
      // 분해
      if(isSet && !isSimple) {
        commRows.push({
          type:'set-head',
          name:r.name,
          originalName:r.name,
          model:r.model,
          qty:q,
          list:listP
        });

        let partsToUse = [];
        const domParts = Array.from(document.querySelectorAll(`.set-part[data-part-of="${CSS.escape(r.model)}"]`));
        
        if (domParts.length > 0) {
          domParts.forEach(ptr => {
            const pm = ptr.getAttribute('data-m');
            const pname = ptr.querySelector('.colD').textContent.replace('└ [구성]', '').trim();
            const pq = parseInt(ptr.querySelector('.part-qty-comm')?.value || '0', 10);
            const pPrice = parseInt(ptr.querySelector('.price-input')?.value.replace(/[^0-9]/g, '') || '0', 10);
            if (pq !== 0) {
              partsToUse.push({
                model: pm,
                name: pname,
                originalName: pname,
                qty: pq,
                price: pPrice,
                unit: 'EA'
              });
            }
          });
        } else {
          partsToUse = typeof explodeCommPreviewParts === 'function' ? explodeCommPreviewParts(r.model, q) : [];
          partsToUse.forEach(p => p.originalName = p.name);
        }

        partsToUse.forEach(p => {
          // 부품
          let pList = 0;
          if(typeof COMM_PARTS !== 'undefined') {
            const found = COMM_PARTS.find(cp => cp.model === p.model);
            if(found) pList = found.list || found.listPrice || 0;
          }
          const pBase = getBaseListPrice('comm', p.model, pList);
          pList = getRealListPrice('COMM', p.model, pBase);

          commRows.push({
            type:'item',
            isChild:true,
            name:p.name,
            originalName:p.originalName || p.name,
            model:p.model,
            unit:p.unit || 'EA',
            qty:p.qty,
            price:p.price,
            sub:(p.qty*p.price),
            list: pList
          });
        });
      } else {
        // 일반
        const price = getRealCommPrice(r.model);
        commRows.push({ 
          type:'item', name:r.name, originalName:r.name, model:r.model, unit:r.unit, 
          qty:q, price:price, sub:(q*price), source: r.source,
          list: listP
        });
      }
    });
  }
  if(commRows.length > 0) {
    const sum = commRows.reduce((acc, curr) => acc + (curr.sub || 0), 0);
    sections.push({ id: 'COMM', title: '<상업멀티>', subLabel: '상업멀티 합계', rows: commRows, total: sum });
  }

  // 홈
  const homeRows = [];
  if (typeof HOMEMULTI !== 'undefined' && typeof homeQty !== 'undefined') {
    HOMEMULTI.forEach(r => {
      const q = homeQty.get(r.model) || 0;
      if (!q) return;
      const price = getRealHomePrice(r.model);
      
      // 출고가
      const baseListP = getBaseListPrice('home', r.model, r.list || r.listPrice || 0);
      const listP = getRealListPrice('HOME', r.model, baseListP);

      homeRows.push({ 
        type:'item', name:r.name, originalName:r.name, model:r.model, unit:r.unit, 
        qty:q, price:price, sub:(q*price), source: r.source,
        list: listP
      });
    });
  }
  if(homeRows.length > 0) {
    const sum = homeRows.reduce((acc, curr) => acc + (curr.sub || 0), 0);
    sections.push({ id: 'HOME', title: '<홈멀티>', subLabel: '홈멀티 합계', rows: homeRows, total: sum });
  }

  // 싱글
  const singleRows = [];
  if (typeof SINGLE_SETS !== 'undefined' && typeof singleQty !== 'undefined') {
    SINGLE_SETS.forEach(s => {
      const q = singleQty.get(s.id) || 0;
      if (!q) return;

      const cls = typeof classifySingleSetFixed==='function' ? classifySingleSetFixed(s) : {};
      const catL = String(cls.catL || '');
      const isAccessory = catL === '부자재' || catL === '실외기 받침';
      const isSpecial = s.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL;
      const isSet = !isSpecial && !isAccessory;

      // 이름
      let baseName = s.name || '';
      let gradeTxt = '';

      // 검사
      if (isSet && !/등급/.test(baseName)) {
        // 규격
        const specData = typeof SPEC_DETAIL_MAP !== 'undefined' ? SPEC_DETAIL_MAP[s.model] : null;
        const sSpec = (specData && specData.single) ? specData.single : {};
        const gVal = sSpec.grade || s.grade || s.effGrade || '';
        
        if (gVal) {
          const gMatch = String(gVal).match(/([1-5A-Za-z/]+)/);
          if (gMatch) gradeTxt = ' ' + gMatch[1] + '등급';
        } else {
          // 검색
          const hay = ((s.nameRaw || '') + ' ' + (s.spec || '')).toUpperCase();
          const hMatch = hay.match(/([1-5A-Z/]+)\s*등급/);
          if (hMatch) gradeTxt = ' ' + hMatch[1] + '등급';
        }
      }

      // 평형
      const sizeTxt = s.size ? (' ' + s.size + '평형') : '';
      
      // 라벨
      const optLabel = getSingleSetOptionLabel(s);
      const finalName = baseName + sizeTxt + gradeTxt + optLabel;

      const realPrice = getRealSinglePrice(s.id);
      
      // 출고가
      const baseListP = getBaseListPrice('single', s.model, s.list || s.listLeft || 0);
      const listP = getRealListPrice('SINGLE', s.id, baseListP);

      // 조건
      if ((typeof SEND_AS_SET_IDS!=='undefined' && SEND_AS_SET_IDS.has(s.id)) || isAccessory || isSpecial || isSimple) {
         singleRows.push({ 
           type:'item', name:finalName, originalName:s.name, model:s.model, unit:s.unit||'식', 
           qty:q, price:realPrice, sub:(q*realPrice), source: isSpecial ? SPECIAL_ROW_SOURCE.CATALOG_SPECIAL : undefined,
           list: listP
         });
      } else {
          singleRows.push({
            type:'set-head', name:finalName, originalName:s.name, model:s.model, qty:q, list: listP
          });
          
          const domParts = Array.from(document.querySelectorAll(`.set-part-single[data-part-of="${CSS.escape(s.id)}"]`));
          let partsToUse = [];
          if (domParts.length > 0) {
            domParts.forEach(ptr => {
              const pm = ptr.getAttribute('data-m');
              const pname = ptr.querySelector('.colD').textContent.replace('└ [구성]', '').trim();
              const pq = parseInt(ptr.querySelector('.part-qty-single')?.value || '0', 10);
              const pPrice = parseInt(ptr.querySelector('.price-input')?.value.replace(/[^0-9]/g, '') || '0', 10);
              
              if (pq !== 0) {
                partsToUse.push({ model: pm, name: pname, originalName: pname, qty: pq, price: pPrice, unit: 'EA' });
              }
            });
          } else {
            partsToUse = typeof explodeSetParts==='function' ? explodeSetParts(s, q, realPrice) : [];
            partsToUse.forEach(p => p.originalName = p.name);
          }

          partsToUse.sort((a, b) => {
            const getRank = p => {
              const k = String(p.name || p.model || '').toLowerCase();
              if (k.includes('실내기')) return 1;
              if (k.includes('실외기')) return 2;
              if (k.includes('판넬')) {
                  if (k.includes('블랙')) return 4.3;
                  if (k.includes('승강')) return 4.2;
                  if (k.includes('공기청정') || k.includes('공청')) return 4.1;
                  return 4.0;
              }
              if (k.includes('리모컨')) {
                  if (k.includes('스탠드')) return 5.1;
                  if (k.includes('벽걸이')) return 5.2;
                  return 5.3;
              }
              if (k.includes('자재')) return 6;
              if (k.includes('벽걸이')) return 3;
              return 7;
            };
            const rankA = getRank(a);
            const rankB = getRank(b);
            if (rankA !== rankB) return rankA - rankB;
            return String(a.model || a.name || '').localeCompare(String(b.model || b.name || ''));
          });

          partsToUse.forEach(p => {
            // 부품
            let pList = 0;
            if(typeof SINGLE_PARTS !== 'undefined') {
               const found = SINGLE_PARTS.find(sp => sp.model === p.model || (sp.name||'').trim() === (p.name||'').trim());
               if(found) {
                  pList = found.list || found.listPrice || 0;
                  p.originalName = found.name || p.originalName;
               }
            }
            const pBase = getBaseListPrice('single', p.model, pList);
            pList = getRealListPrice('SINGLE', p.model, pBase);

            singleRows.push({ 
              type:'item', isChild:true, name:p.name, originalName:p.originalName || p.name, model:p.model, unit:p.unit, 
              qty:p.qty, price:p.price, sub:(p.qty*p.price),
              list: pList
            });
          });
      }
    });
  }
  if(singleRows.length > 0) {
    const sum = singleRows.reduce((acc, curr) => acc + (curr.sub || 0), 0);
    sections.push({ id: 'SINGLE', title: '<싱글중대형>', subLabel: '싱글중대형 합계', rows: singleRows, total: sum });
  }

  // 구형
  const oldRows = [];
  if (typeof OLD_PRODUCTS !== 'undefined' && typeof oldQty !== 'undefined') {
    OLD_PRODUCTS.forEach(item => {
      if (item.name === '품 명' || item.name === '품명') return;
      const q = oldQty.get(item.model) || 0;
      if (!q) return;
      const price = getRealOldPrice(item.model);
      
      // 출고가
      const baseListP = getBaseListPrice('old', item.model, item.list || item.listPrice || item.price || 0);
      const listP = getRealListPrice('OLD', item.model, baseListP);

      oldRows.push({ 
        type:'item', name:item.name, originalName:item.name, model:item.model, unit:item.unit||'EA', 
        qty:q, price:price, sub:(q*price), source: item.source,
        list: listP
      });
    });
  }
  if(oldRows.length > 0) {
    const sum = oldRows.reduce((acc, curr) => acc + (curr.sub || 0), 0);
    sections.push({ id: 'OLD', title: '<구형>', subLabel: '구형 합계', rows: oldRows, total: sum });
  }

  // 총액 조정(카드수수료/선금할인)
  const box = document.getElementById('chkCardPay');
  const pre = document.getElementById('payDuePre');
  if ((box && box.checked) || (pre && pre.checked)) {
    // 평탄화
    const allRows = [];
    sections.forEach(s => allRows.push(...s.rows));
    const oldLen = allRows.length;
    
    applyCardFeeLogic(allRows);
    applyEstimateTotalAdjustments(allRows, {
      advance: !!(pre && pre.checked)
    });
    
    if (allRows.length > oldLen) {
      const newRows = allRows.slice(oldLen);
      sections.push({
        title: '기타',
        rows: newRows,
        total: newRows.reduce((sum, r) => sum + (r.sub || 0), 0),
        subLabel: '소계'
      });
    }

    // 재계산
    sections.forEach(s => {
      s.total = s.rows.reduce((sum, r) => sum + (r.sub || 0), 0);
    });
  }

  // 절삭
  const cutEl = document.getElementById('selCutUnit');
  const cutUnit = parseInt(cutEl ? cutEl.value : 0) || 0;

  if (cutUnit > 0) {
    // 합계
    let grandTotal = sections.reduce((acc, s) => acc + s.total, 0);
    const rem = grandTotal % cutUnit;

    if (rem > 0) {
      let target = null;
      for (let i = sections.length - 1; i >= 0; i--) {
        const sec = sections[i];
        const found = sec.rows.find(r => r.qty === 1
          && r.type !== 'set-head'
          && r.source !== SPECIAL_ROW_SOURCE.CATALOG_SPECIAL);
        if (found) {
          target = found;
          break;
        }
      }

      if (target) {
        target.price -= rem;
        target.sub -= rem;
      } else {
        const cutRow = { 
            type:'item', name:'절삭', originalName:'절삭', model:'절삭', unit:'식', 
            qty:1, price:-rem, sub:-rem, list:0, spec:'\u200B',
            source: SPECIAL_ROW_SOURCE.AUTO_CUTOFF,
            identity: `auto-cutoff:${cutUnit}:${sections.length}`
        };
        
        let etcSec = sections.find(s => s.title === '기타');
        if (!etcSec) {
          etcSec = { title:'기타', subLabel:'소계', rows:[], total:0 };
          sections.push(etcSec);
        }
        etcSec.rows.push(cutRow);
      }

      // 재계산
      sections.forEach(s => {
        s.total = s.rows.reduce((acc, r) => acc + (r.sub || 0), 0);
      });
    }
  }

  const getCustoms = (type, title, subLabel, hasList, unit, secId) => {
    const tbody = document.getElementById(type + 'CustomBody');
    if (!tbody) return;
    const customs = [];
    tbody.querySelectorAll('.custom-item-row').forEach(tr => {
      const qty = parseInt(tr.querySelector('.custom-qty').value || '0', 10);
      if (qty !== 0) {
        const name = tr.querySelector('.pc-name')?.value.trim() || '사용자 정의 품목';
        const model = tr.querySelector('.custom-model')?.value.trim() || '';
        const price = parseInt(tr.querySelector('.custom-price')?.value.replace(/[^0-9-]/g, '') || '0', 10);
        const list = hasList && tr.querySelector('.custom-list') ? parseInt(tr.querySelector('.custom-list').value.replace(/[^0-9-]/g, '') || '0', 10) : 0;
        customs.push({
          type: 'item',
          name: name,
          originalName: name,
          model: model,
          unit: unit,
          qty: qty,
          price: price,
          sub: qty * price,
          list: list,
          isCustom: true,
          catL: '기타'
        });
      }
    });
    if (customs.length > 0) {
      let sec = sections.find(s => s.title === title);
      if (!sec) {
        sec = { id: secId, title: title, subLabel: subLabel, rows: [], total: 0 };
        sections.push(sec);
      } else {
        sec.id = secId;
      }
      sec.rows.push(...customs);
      sec.total += customs.reduce((acc, curr) => acc + curr.sub, 0);
    }
  };

  getCustoms('home', '<홈멀티>', '홈멀티 합계', true, 'EA', 'HOME');
  getCustoms('single', '<싱글중대형>', '싱글중대형 합계', false, 'EA', 'SINGLE');
  getCustoms('comm', '<상업멀티>', '상업멀티 합계', true, 'EA', 'COMM');
  getCustoms('old', '<구형>', '구형 합계', true, 'EA', 'OLD');
  return sections;
}

// 합계 우측 라벨 생성
function getVatLabel() {
  const optVatVal = document.querySelector('input[name="optVatDisplay"]:checked')?.value || 'inc';
  const isCard = document.getElementById('chkCardPay')?.checked;
  const isAdvance = document.getElementById('payDuePre')?.checked;
  const parts = [];
  
  if (optVatVal === 'inc') parts.push('VAT 포함');
  else if (optVatVal === 'exc') parts.push('VAT 별도');
  
  if (isCard) parts.push('카드 수수료 포함');
  if (isAdvance) parts.push('선금 할인 포함');
  
  if (parts.length === 0) return '';
  return `(${parts.join('/')})`;
}

/* 카드결제 동기화 */
function syncVatCardPv() {
  const vatPvVal = document.querySelector('input[name="optVatPv"]:checked')?.value || 'inc';
  const cardPv = document.getElementById('chkCardPayPv');

  const optVatDisplays = document.querySelectorAll('input[name="optVatDisplay"]');
  optVatDisplays.forEach(r => {
    r.checked = (r.value === vatPvVal);
  });

  if (cardPv) {
    const chkCard = document.getElementById('chkCardPay');
    if (chkCard) {
      chkCard.checked = cardPv.checked;
    }
  }

  if(window.activeSector === 'preview') {
    if(typeof goPreview === 'function') goPreview();
  }
}

/* VAT 동기화 */
function syncVatFromOrderInfo() {
  const vatDisplayVal = document.querySelector('input[name="optVatDisplay"]:checked')?.value || 'inc';
  const optVatPvs = document.querySelectorAll('input[name="optVatPv"]');
  optVatPvs.forEach(r => {
    r.checked = (r.value === vatDisplayVal);
  });
}

