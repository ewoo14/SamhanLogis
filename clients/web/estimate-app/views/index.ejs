function startAuth() {
  if(!USER_EMAIL) {
    showAuthFail();
    return;
  }
  
  google.script.run
    .withSuccessHandler(function(res) {
      if (res && res.authorized) {
        const authGate = document.getElementById('pageBizGate');
        const menuGate = document.getElementById('mobileGate');
        
        if(authGate) authGate.classList.add('hidden');
        if(menuGate) menuGate.classList.remove('hidden');
        
        logAction('접속', '로그인 성공');
      } else {
        showAuthFail();
        logAction('접속', USER_EMAIL + ' 로그인 시도 - 실패');
