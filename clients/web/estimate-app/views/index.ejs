// 수량집계
function getSelectedTotalCount() {
  const selHome = Array.from(homeQty.values()).reduce((n,v)=>n+(v!==0?1:0),0);
  let selSingle = Array.from(singleQty.values()).reduce((n,v)=>n+(v!==0?1:0),0);
  if(selSingle===0) document.querySelectorAll('#singleBody .qty-input').forEach(inp=>{if(toInt(inp.value)!==0)selSingle++});
  let selComm = Array.from(commQty.values()).reduce((n,v)=>n+(v!==0?1:0),0);
  if(selComm===0) document.querySelectorAll('#commBody .qty-input').forEach(inp=>{if(toInt(inp.value)!==0)selComm++});
  const selOld = Array.from(oldQty.values()).reduce((n,v)=>n+(v!==0?1:0),0);
  let customCount = 0;
  document.querySelectorAll('.custom-qty').forEach(inp => {
    if (parseInt(inp.value || '0', 10) !== 0) customCount++;
  });
  return selHome + selSingle + selComm + selOld + customCount;
}

