  if(text) re = new RegExp(escapeFilterRe_(text),'i');
  
  return (rows||[]).filter(row=>{
    const r = row.r||{};

    if(re){
      const name = String(r.name||'');
      const model = String(r.model||'');
      if(!re.test(name) && !re.test(model)) return false;
    }
    if(st.L && row.L!==st.L) return false;
    if(st.M && row.M!==st.M) return false;
    if(st.S && row.S!==st.S) return false;
    return true;
  });
}

/* 홈멀티용 필터 셀렉트 갱신 */
function updateHomeFilterOptions(){
  const selL = document.getElementById('homeFilterL');
  const selM = document.getElementById('homeFilterM');
  const selS = document.getElementById('homeFilterS');
  if(!selL) return;
  const text = (HOME_FILTER.text||'').trim();

  let rows = HOMEMULTI.filter(r=>{
    if(/운임|절삭/i.test(r?.name||'')) return false;
    return true;
  }).map(r=>{
    const c = normalizeHomeCategory(r);
    return {r,L:unifyCatL_(c.catL)||'',M:c.catM||'',S:c.catS||''};
  });

  if(text){
    const re = new RegExp(escapeFilterRe_(text),'i');
    rows = rows.filter(row=>{
      const r = row.r||{};
      const name = String(r.name||'');
      const model = String(r.model||'');
      return re.test(name) || re.test(model);
    });
  }

  const Ls = [];
  rows.forEach(v=>{ if(v.L && !Ls.includes(v.L)) Ls.push(v.L); });
  if(HOME_FILTER.L && !Ls.includes(HOME_FILTER.L)){
    HOME_FILTER.L='';
    HOME_FILTER.M='';
    HOME_FILTER.S='';
  }
  selL.innerHTML = '<option value="">대분류 전체</option>' + Ls.map(estimateOptionHtml).join('');
  selL.value = HOME_FILTER.L||'';

  let rowsM = rows;
  if(HOME_FILTER.L) rowsM = rowsM.filter(v=>v.L===HOME_FILTER.L);
  const Ms = [];
  rowsM.forEach(v=>{ if(v.M && !Ms.includes(v.M)) Ms.push(v.M); });
  if(HOME_FILTER.M && !Ms.includes(HOME_FILTER.M)){
    HOME_FILTER.M='';
    HOME_FILTER.S='';
  }
  selM.innerHTML = '<option value="">중분류 전체</option>' + Ms.map(estimateOptionHtml).join('');
  selM.disabled = !HOME_FILTER.L;
  selM.value = HOME_FILTER.M||'';

  let rowsS = rowsM;
  if(HOME_FILTER.M) rowsS = rowsS.filter(v=>v.M===HOME_FILTER.M);
  const Ss = [];
  rowsS.forEach(v=>{ if(v.S && !Ss.includes(v.S)) Ss.push(v.S); });
  if(HOME_FILTER.S && !Ss.includes(HOME_FILTER.S)){
    HOME_FILTER.S='';
  }
  if(selS){
    selS.innerHTML = '<option value="">소분류 전체</option>' + Ss.map(estimateOptionHtml).join('');
    selS.disabled = !HOME_FILTER.M;
    selS.value = HOME_FILTER.S||'';
  }
}

