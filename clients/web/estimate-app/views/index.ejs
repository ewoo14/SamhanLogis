  box.appendChild(sel('유선리모컨',['','유선리모컨','컬러유선리모컨'],SINGLE_DEFAULTS['유선리모컨']||'','ss_remote'));
  box.appendChild(chk('리모컨 제외',!!SINGLE_DEFAULTS['리모컨 제외'],'ss_remote_ex'));
  box.appendChild(chk('실외기 받침대 포함',!!SINGLE_DEFAULTS['실외기 받침대 포함'],'ss_base'));
  box.appendChild(sel('판넬변경',['','판넬제외','블랙판넬','승강판넬','공청판넬'],SINGLE_DEFAULTS['판넬변경']||'','ss_panel'));
  box.appendChild(sel('360판넬',['원형','사각'],SINGLE_DEFAULTS['360판넬']||'원형','ss_p360'));
  box.appendChild(sel('자재 포함 여부',['포함','별도'],SINGLE_DEFAULTS['자재 포함 여부']||'별도','ss_mat'));
  box.appendChild(chk('인상 전 단가', !!PRICE_DEFAULT_VARIANT.singleSets, 'chkSingleInc'));
  box.appendChild(chk('품목확장', false, 'ss_expand'));

  box.querySelectorAll('input,select').forEach(c => {
    if(c.id.includes('singleFilter')) return;

    c.addEventListener('change', (e) => {
      if (e.target && (e.target.id === 'chkSingleInc' || e.target.id === 'ss_expand')) {
        if (e.target.id === 'ss_expand') {
          if (!e.target.checked) {
            SINGLE_SETS.forEach(s => {
              if (typeof isExpansionModel === 'function' && isExpansionModel(s)) {
                if (singleQty.unlock) singleQty.unlock(s.id);
                singleQty.set(s.id, 0);
              }
            });
            if (typeof syncSingleTotals === 'function') syncSingleTotals();
            if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
          }
          if (typeof updateSingleFilterOptions === 'function') updateSingleFilterOptions();
        }
        if (typeof renderSingle === 'function') renderSingle();
      } else {
        SINGLE_SETS.forEach(s => {
          if(/운임|절삭/i.test(s?.name||'')) return;
          const uCell = document.querySelector(`#singleBody [data-ssu="${s.id}"]`);
          if(!uCell) return;

          const q = singleQty.get(s.id) || 0;
          const autoUnit = calcSetUnitPrice(s); 
          
          uCell.innerHTML = makePriceInput(autoUnit, 'single', s.id);
          uCell.setAttribute('data-unitraw', autoUnit);

          const inp = uCell.querySelector('input');
          const finalUnit = parseInt(inp.value.replace(/[^0-9]/g,'')||0, 10);
          const sCell = document.querySelector(`#singleBody [data-ss="${s.id}"]`);
          if(sCell) sCell.textContent = fmt(finalUnit * q);

          const selector = `.set-part-single[data-part-of="${CSS.escape(s.id)}"]`;
          const domParts = document.querySelectorAll(selector);
          if (domParts.length > 0 && typeof explodeSetParts === 'function') {
            const activeParts = explodeSetParts(s, 1, autoUnit);
            const activeModels = new Set(activeParts.map(ap => (ap.model || ap.name || '').trim()));

            domParts.forEach(ptr => {
              const qtyInp = ptr.querySelector('.part-qty-single');
              if (qtyInp) {
                const pModel = ptr.getAttribute('data-m');
                const pKeyStr = `${s.id}|${pModel}`;
                const isManual = typeof singleCustomPartQtys !== 'undefined' && singleCustomPartQtys.has(pKeyStr);

                const defQ = parseFloat(qtyInp.dataset.def || '1');
                let newCompQty = activeModels.has(pModel) ? Math.floor(q * defQ) : 0;
                
                if (isManual) {
                  newCompQty = singleCustomPartQtys.get(pKeyStr);
                }
                
                if (!isManual) {
                  qtyInp.value = newCompQty || '';
                  qtyInp.setAttribute('value', newCompQty || '');
                  const span = ptr.querySelector('.val-for-text');
                  if(span) span.textContent = newCompQty || 0;
                }
                
                let pUnit = 0;
                const pNode = ptr.querySelector('.price-input');
                const matchedPart = activeParts.find(ap => (ap.model || ap.name || '').trim() === pModel);
                if (matchedPart) {
                    pUnit = matchedPart.price;
                    if (pNode) {
                        pNode.value = pUnit > 0 ? fmt(pUnit) : '';
                        pNode.setAttribute('value', pNode.value);
                        const valSpan = pNode.closest('td').querySelector('.val-for-text');
                        if(valSpan) valSpan.textContent = pUnit;
                    }
                } else {
                    pUnit = parseInt(pNode ? pNode.value.replace(/[^0-9]/g, '') : '0', 10);
                }
                
                const compSub = newCompQty * pUnit;

                const subCell = ptr.querySelector('.sub');
                if(subCell) {
                  subCell.childNodes[0].nodeValue = (typeof fmt === 'function' ? fmt(compSub) : compSub.toLocaleString());
                  const subSpan = subCell.querySelector('.val-for-text');
                  if(subSpan) subSpan.textContent = compSub;
                }
              }
            });
          }
        });
        recomputeFootAll();
        recomputeSingleBaseFoot(); 
        recomputeSingleExtras();
      }
      syncSingleTotals();
      setTimeout(fitAllTables, 0);
      
      if(typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
    });
  });
}

/* 홈발통계산 */
function recomputeFootAll() {
  const want = !!el('#home_foot')?.checked;

  // 발통의 legacy source는 원시 품목만 읽는다. 자동 파생품과 규칙 target이
  // 품명에 '실외기'를 포함하더라도, 이전 계산 결과가 다음 계산의 입력이
  // 되지 않도록 모델 경계에서 제외한다.
  const ruleTargetModels = new Set(Array.isArray(ACTIVE_HOME_QUANTITY_SYNC_RULES)
    ? ACTIVE_HOME_QUANTITY_SYNC_RULES.flatMap(rule => Array.isArray(rule?.targets)
      ? rule.targets.map(target => String(target?.productCode || '').trim())
      : [])
    : []);
  const footRuleSourceModels = new Set(Array.isArray(ACTIVE_HOME_QUANTITY_SYNC_RULES)
    ? ACTIVE_HOME_QUANTITY_SYNC_RULES
      .filter(rule => Array.isArray(rule?.targets)
        && rule.targets.some(target => {
          const model = String(target?.productCode || '').trim();
          return model === FOOT_ROUND || FOOT_FLAT_MODELS.includes(model);
        }))
      .flatMap(rule => Array.isArray(rule?.sources)
        ? rule.sources.map(source => String(source?.productCode || '').trim())
        : [])
    : []);
  const isDerivedFootSource = model => AUTO_HOME_MODELS.has(String(model || ''))
    || ruleTargetModels.has(String(model || ''))
    || footRuleSourceModels.has(String(model || ''));
  const outQ = HOMEMULTI.reduce((t, r) => t
    + (/실외기/i.test(r?.name) && !isDerivedFootSource(r?.model)
      ? (homeQty.get(r.model) || 0)
      : 0), 0);

  if (FOOT_ROUND && !HOME_MANUAL_FOOT.has(FOOT_ROUND)
      && !(want && ruleTargetModels.has(String(FOOT_ROUND)))) {
    homeQty.set(FOOT_ROUND, want ? outQ : 0);
  }
  FOOT_FLAT_MODELS.forEach(model => {
    if (!HOME_MANUAL_FOOT.has(model)
        && !(want && ruleTargetModels.has(String(model)))) homeQty.set(model, 0);
  });
}

/* 싱글중대형 발통계산 */
function recomputeSingleBaseFoot(){
  const baseOn = !!document.getElementById('ss_base')?.checked;
  let round = 0, flat = 0;

  if (baseOn) {
    const skip = new Set([SS_FOOT_ROUND_ID, SS_FOOT_FLAT_ID].filter(Boolean));
    
    SINGLE_SETS.forEach(s => {
      // 제외처리
      if (skip.has(s.id)) return;
      if (/운임|절삭|비용|설치비/i.test(s?.name || '')) return;

      const q = singleQty.get(s.id) || 0;
      if (!q) return;

      // 부자재제외
      const cat = String(s.catL || '').trim();
      const unit = String(s.unit || '').trim().toUpperCase();

      if (cat === '부자재' || cat === '실외기 받침' || cat === '자재') return;
      
      // 세트확인
      if (unit !== 'SET' && unit !== '식') return;

      // 타입구분
      const mdl = String(s?.model || '');
      if (/^(AP230DAPDHH1S|AP290DAPDHH1S)$/i.test(mdl)) {
        flat += q; 
      } else {
        round += q;
      }
    });
  }

  // 수량반영
  if (SS_FOOT_ROUND_ID != null) singleQty.set(SS_FOOT_ROUND_ID, round);
  if (SS_FOOT_FLAT_ID != null) singleQty.set(SS_FOOT_FLAT_ID, flat);
  
  syncSingleUIFromState();
}

function recomputeSingleExtras(){
  let boardQty=0;
  const remoteExcluded=!!el('#ss_remote_ex')?.checked;const remoteOpt=el('#ss_remote')?.value||'';
  if(!remoteExcluded&&(remoteOpt==='유선리모컨'||remoteOpt==='컬러유선리모컨')){
    SINGLE_SETS.forEach(s=>{
      if(/운임|절삭/i.test(s?.name||'')) return;
      if(!is1WaySet_(s)) return;
      if(!allowRemoteChange_(s)) return;
      boardQty+=(singleQty.get(s.id)||0);
    });
  }
  if(SS_WIRED_BOARD_ID!=null) singleQty.set(SS_WIRED_BOARD_ID,boardQty);
  if(SS_CEILING_PUMP_ID!=null){
    let pumpQty=0;
    SINGLE_SETS.forEach(s=>{
      if(s.id===SS_CEILING_PUMP_ID) return;
      if(/운임|절삭/i.test(s?.name||'')) return;
      if(/실링/i.test(((s?.name)||'')+' '+((s?.model)||''))){pumpQty+=(singleQty.get(s.id)||0);}
    });
    singleQty.set(SS_CEILING_PUMP_ID,pumpQty);
  }
  syncSingleUIFromState();
}

/* 트리거 판별 */
function isHomeCalcTriggerModel(model){
  const r=homeRowByModel.get(model);if(!r) return false;const nm=String(r?.name||'');
  if (/(분\s*기\s*관|분기관)/i.test(nm)) return false;
  if(/(일자발|발통)/i.test(nm)) return false;
  if(/(유연호스)/i.test(nm)) return false;
  if(/(판넬)/i.test(nm)) return false;
  if(/(실내기|벽걸이)/i.test(nm)) return true;
  if(/(단배관|다배관)/i.test(nm)) return true;
  if(/(전열\s*교환기|에어콤보)/i.test(nm)) return true;
  return false;
}
function isSingleCalcTriggerId(id){
  const s=SINGLE_SETS.find(x=>String(x.id)===String(id)); if(!s) return false;
  const cls=classifySingleSetFixed(s);
  if(SEND_AS_SET_IDS.has(id)) return false;
  if(id===SS_WIRED_BOARD_ID||id===SS_CEILING_PUMP_ID) return false;
  return (cls.catL!=='부자재');
}

/* 4WAY 기본→공청으로 바꿔야 하는 고정 맵 */
const PANEL_SWAP_4WAY_TO_AIR = new Map([
  ['PC4NUFK1NW','PC4NUCK4NW'],
  ['PC6NUDK1NW','PC6NUCK1NW'],
  ['PC4NUFK1N' ,'PC4NUCK1N' ],
  ['PC6NUDK1N' ,'PC6NUCK1N' ],
]);

/* 인피니트(중/대) 기본 모델 세트 */
const INF_BASE = {
  // 중형: 25년형으로 기본 설정
  mid:  { base:'PC1YNWK1NW', air:'PC1YNCK1NW', ai:'PC1YNRK1NW' },
  // 대형
  big:  { base:'PC1ZNSK1NW', base25:'PC1ZNWK1NW', air:'PC1ZNCK1NW', ai:'PC1ZNRK1NW' },
};

/* 360/4WAY 판넬 후보 중 "기본형" 우선 선택 */
function findHomePanelModel(kind, wifi){
  const has = (r, rx) => rx.test(((r?.name||'')+' '+(r?.disp||'')+' '+(r?.model||'')).toLowerCase());
  const matchKind = r => kind==='360'
    ? has(r,/360/i)
    : (/(4\s*-?\s*way|4way)/i.test(((r?.name||'')+' '+(r?.disp||'')).toLowerCase()) && !has(r,/360/i));
  const matchWifi = r => wifi ? has(r,/(wi\s*[-\s]?fi|wifi)/i) : has(r,/(미내장|non[-\s]?wifi|no[-\s]?wifi)/i);
  const cands = HOMEMULTI.filter(r => isPanelRow(r) && matchKind(r) && matchWifi(r));
  if(!cands.length) return null;
  // "기본" 우선, 블랙/승강/공청/AI/동작감지 비우선
  const score = rr => (/(기본)/i.test(rr?.name||'')?-2:0) + (/(블랙|승강|공청|ai|동작감지)/i.test(rr?.name||'')?2:-1);
  cands.sort((a,b)=>score(a)-score(b));
  return cands[0]?.model || null;
}

/* 현재 옵션에 맞춰 인피니트 목표 모델(중/대)을 결정 */
function pickInfinitePanelModel(size, opt){
  if(size==='mid'){
    if(opt==='공청판넬') return INF_BASE.mid.air;
    if(opt==='인피니트 공청+동작감지 AI') return INF_BASE.mid.ai;
    // 기본 / 인피니트 25년형 모두 mid는 PC1YNWK1NW 사용
    return INF_BASE.mid.base;
  }else{
    if(opt==='공청판넬') return INF_BASE.big.air;
    if(opt==='인피니트 공청+동작감지 AI') return INF_BASE.big.ai;
    if(opt==='인피니트 25년형') return INF_BASE.big.base25;
    return INF_BASE.big.base;
  }
}

/* 텍스트에서 인피니트 중/대형 구분 */
function inferInfiniteSize(nameLike){
  const t=String(nameLike||'');
  if(/대형/i.test(t)) return 'big';
  if(/중형/i.test(t)) return 'mid';
  // 명시 없으면 중형으로 기본 처리
  return 'mid';
}

/* 홈판넬계산 */
function recomputeHomePanels() {
  const opt = el('#home_panel')?.value || '';

  // 수동제외초기화
  HOMEMULTI.forEach(r => {
    if (isPanelRow(r) && !HOME_MANUAL_PANEL.has(r.model)) homeQty.set(r.model, 0);
  });

  if (opt === '판넬제외') return;

  // 타입별집계
  let c360Wi=0, c360No=0, c4Wi=0, c4No=0;
  let c1WiS=0, c1WiM=0, c1WiB=0;
  let c1NoS=0, c1NoM=0, c1NoB=0;
  let infMid=0, infBig=0;

  HOMEMULTI.forEach(r => {
    const q = homeQty.get(r.model) || 0;
    if (!q) return;
    const nm = String(r?.name || '');
    if (!/(실내기|벽걸이)/i.test(nm)) return;

    // 인피니트를 최우선으로 체크하도록 순서 변경
    if (/인피니트/i.test(nm)) {
      if (/대형/i.test(nm)) infBig += q; 
      else infMid += q;
    } 
    else if (/360/i.test(nm)) {
      if (/(wi\s*[-\s]?fi|wifi)/i.test(nm)) c360Wi += q;
      else if (/미내장/i.test(nm)) c360No += q;
    } 
    else if (/(4\s*-?\s*way|4way)/i.test(nm)) {
      if (/(wi\s*[-\s]?fi|wifi)/i.test(nm)) c4Wi += q;
      else if (/미내장/i.test(nm)) c4No += q;
    } 
    else if (/(1\s*-?\s*way|1way)/i.test(nm) && !/벽걸이/i.test(nm)) {
      const sz = inferOneWaySize(nm);
      const isWi = /(wi\s*[-\s]?fi|wifi)/i.test(nm);
      if (isWi) {
        if (sz === 's') c1WiS += q; else if (sz === 'b') c1WiB += q; else c1WiM += q;
      } else if (/미내장/i.test(nm)) {
        if (sz === 's') c1NoS += q; else if (sz === 'b') c1NoB += q; else c1NoM += q;
      }
    }
  });

  // 판넬값적용
  const setP = (m, q) => {
    if (m && !HOME_MANUAL_PANEL.has(m)) homeQty.set(m, q);
  };

  const m360Wi = pickPanelBy('360', true, opt);
  const m360No = pickPanelBy('360', false, opt);
  const m4Wi = pickPanelBy('4way', true, opt);
  const m4No = pickPanelBy('4way', false, opt);

  if (m360Wi) setP(m360Wi, c360Wi);
  if (m360No) setP(m360No, c360No);
  if (m4Wi) setP(m4Wi, c4Wi);
  if (m4No) setP(m4No, c4No);

  const pick = key => homeRowByModel.has(PANEL_MODELS[key]) ? PANEL_MODELS[key] : null;
  const useAir = (opt === '공청판넬' || opt === '인피니트 공청+동작감지 AI');

  const m1WiS = pick(useAir ? 'a1sWi' : 'p1sWi');
  const m1WiM = pick(useAir ? 'a1mWi' : 'p1mWi');
  const m1WiB = pick(useAir ? 'a1bWi' : 'p1bWi');
  if (m1WiS) setP(m1WiS, c1WiS);
  if (m1WiM) setP(m1WiM, c1WiM);
  if (m1WiB) setP(m1WiB, c1WiB);

  const m1NoS = pick(useAir ? 'a1sNo' : 'p1sNo');
  const m1NoM = pick(useAir ? 'a1mNo' : 'p1mNo');
  const m1NoB = pick(useAir ? 'a1bNo' : 'p1bNo');
  if (m1NoS) setP(m1NoS, c1NoS);
  if (m1NoM) setP(m1NoM, c1NoM);
  if (m1NoB) setP(m1NoB, c1NoB);

  // 인피니트 모델 매핑
  const INF = {
    mid: { base: 'PC1YNWK1NW', air: 'PC1YNCK1NW', ai: 'PC1YNRK1NW' },
    big: { base: 'PC1ZNSK1NW', base25: 'PC1ZNWK1NW', air: 'PC1ZNCK1NW', ai: 'PC1ZNRK1NW' }
  };
  
  // 옵션에 따른 모델 선택 로직
  const midM = opt === '공청판넬' ? INF.mid.air : (opt === '인피니트 공청+동작감지 AI' ? INF.mid.ai : INF.mid.base);
  
  const bigM = opt === '공청판넬' ? INF.big.air : (opt === '인피니트 공청+동작감지 AI' ? INF.big.ai : (opt === '인피니트 25년형' ? INF.big.base25 : INF.big.base));

  if (homeRowByModel.has(midM)) setP(midM, infMid);
  if (homeRowByModel.has(bigM)) setP(bigM, infBig);

  // 공청치환 로직
  if (opt === '공청판넬') {
    const map = new Map([
      ['PC4NUFK1NW', 'PC4NUCK4NW'], ['PC6NUDK1NW', 'PC6NUCK1NW'],
      ['PC4NUFK1N', 'PC4NUCK1N'], ['PC6NUDK1N', 'PC6NUCK1N']
    ]);
    for (const [from, to] of map) {
      if (homeRowByModel.has(from) && homeRowByModel.has(to)) {
        if (!HOME_MANUAL_PANEL.has(to) && !HOME_MANUAL_PANEL.has(from)) {
          const n = homeQty.get(from) || 0;
          if (n > 0) {
            homeQty.set(from, 0);
            homeQty.set(to, n);
          }
        }
      }
    }
  }
}

/* 홈리모컨계산 */
function recomputeHomeRemotes() {
  const opt = el('#home_remote')?.value || '기본';
  // 레거시 isRemoteRow를 우선하되, 카탈로그 분류가 리모컨인 행도 계약 대상으로 본다.
  // 모델 코드 목록을 별도로 유지하지 않아 새 리모컨 target도 자동으로 포함된다.
  function isHomeRemoteContractRow(row){
    return isRemoteRow(row) || String(row?.catM || '').trim() === '리모컨';
  }

  // 초기화
  HOMEMULTI.forEach(r => {
    if (isHomeRemoteContractRow(r) && !HOME_MANUAL_REMOTE.has(r.model)) homeQty.set(r.model, 0);
  });

  let cntC=0, cntI=0, cntW=0, cntWall=0, cntCombo=0;
  HOMEMULTI.forEach(r => {
    const q = homeQty.get(r.model) || 0;
    if (!q) return;
    const nm = String(r?.name || '');
    if (/360/i.test(nm) && !/(판넬|패널|리모컨|호스)/i.test(nm)) cntC += q;
    if (/실내기.*인피니트/i.test(nm)) cntI += q;
    if (/실내기/i.test(nm) && /(1\s*-?\s*way|4\s*-?\s*way)/i.test(nm) && !/벽걸이/i.test(nm) && !/인피니트|360/i.test(nm)) cntW += q;
    if (/벽걸이/i.test(nm)) cntWall += q;
    if (/(전열\s*교환기|에어콤보)/i.test(nm) && !/리모컨/i.test(nm)) {
      if (r.model !== REMOTE_COLOR_AIRCOMBO) cntCombo += q;
    }
  });

  // 동일 모델로 수렴하는 legacy 매핑(360 기본·일반 무선)을 먼저 합산한다.
  const wantedRemotes = new Map();
  const setR = (m, q) => {
    if (m && !HOME_MANUAL_REMOTE.has(m)) wantedRemotes.set(m, (wantedRemotes.get(m) || 0) + q);
  };

  if (opt === '제외') return;
  if (REMOTE_COLOR_AIRCOMBO) setR(REMOTE_COLOR_AIRCOMBO, Math.max(0, cntCombo));

  const R_WE = (HOMEMULTI.find(r => /^AWR-WE13N$/i.test(r?.model)) || {}).model;
  const R_WG = (HOMEMULTI.find(r => /^AWR-WG00N$/i.test(r?.model)) || {}).model;
  const R_CH = (HOMEMULTI.find(r => /^AR-CH01$/i.test(r?.model)) || {}).model;

  if (opt === '기본') {
    if (REMOTE_360_DEFAULT) setR(REMOTE_360_DEFAULT, cntC);
    if (R_CH) setR(R_CH, cntI);
    if (REMOTE_WIRELESS) setR(REMOTE_WIRELESS, cntW + cntWall);
  } else {
    const tot = cntC + cntI + cntW + cntWall;
    const main = (opt === '유선') ? R_WE : R_WG;
    if (main) setR(main, tot);
    if (REMOTE_WIRED_KIT) setR(REMOTE_WIRED_KIT, tot);
  }
  wantedRemotes.forEach((q, model) => homeQty.set(model, q));
}

/* 홈분기관계산 */
function recomputeHomeBranches() {
  const noBranch = !!document.getElementById('home_no_branch')?.checked;
  const setB = (m, q) => {
    if (m && !HOME_MANUAL_BRANCH.has(m)) homeQty.set(m, q);
  };

  // 스킵
  if (noBranch) {
    if (BRANCH_1509) setB(BRANCH_1509, 0);
    if (BRANCH_2512) setB(BRANCH_2512, 0);
    return;
  }

  let iCnt = 0;
  let sOut = 0;
  let h6 = 0;

  // 실내기 에어콤보 포함
  HOMEMULTI.forEach(r => {
    const nm = String(r?.name || '');
    const q = homeQty.get(r.model) || 0;
    if (!q) return;
    if (/(실내기|벽걸이|에어콤보|전열교환기)/i.test(nm) && !/(판넬|리모컨|리모콘|호스|분기관|발통)/i.test(nm)) {
      iCnt += q;
    }
  });

  // 실외기
  HOMEMULTI.forEach(r => {
    const nm = String(r?.name || '');
    const q = homeQty.get(r.model) || 0;
    if (!q) return;
    if (/실외기/i.test(nm) && /단배관/i.test(nm)) {
      sOut += q;
      // 육마력
      if (r.model === 'AJ060MXHNBC1' || (typeof MODEL_6HP_SINGLE !== 'undefined' && r.model === MODEL_6HP_SINGLE)) {
        h6 += q;
      }
    }
  });

  // 계산
  let b25 = 0;
  let b15 = 0;

  // 조건
  if (iCnt >= 2 && sOut > 0) {
    b25 = h6;
    b15 = iCnt - sOut - h6;
  }

  // 규격화
  b25 = Math.max(0, b25);
  b15 = Math.max(0, b15);

  // 적용
  if (BRANCH_2512) setB(BRANCH_2512, b25);
  if (BRANCH_1509) setB(BRANCH_1509, b15);
}

/* 레거시 홈멀티 유연호스 계산. 서버 규칙 적용 전·후 옵션 계약 재수렴에 공통 사용한다. */
function recomputeHomeHoses_() {
  let n1w=0, n4w=0, c360=0;
  HOMEMULTI.forEach(r => {
    const q = homeQty.get(r.model) || 0;
    if (!q) return;
    const nm = String(r?.name || '');
    if (/(실내기|벽걸이)/i.test(nm)) {
      if (/벽걸이/i.test(nm)) { /* 제외 */ }
      else if (/(1\s*-?\s*way|1\s*way)/i.test(nm)) n1w += q;
      else if (/(4\s*-?\s*way|4\s*way)/i.test(nm)) n4w += q;
      if (/360/i.test(nm)) c360 += q;
    }
  });
  n4w += c360;

  const noHose = !!el('#home_no_hose')?.checked;
  const useIHose = !!el('#home_hose_i')?.checked;
  const hasServerHomeRules = Array.isArray(ACTIVE_HOME_QUANTITY_SYNC_RULES)
    && ACTIVE_HOME_QUANTITY_SYNC_RULES.length > 0;
  const hoseI4Model = hasServerHomeRules ? (HOSE_I_4W || HOSE_I_1W) : '';
  const setH = (m, q) => {
    if (m && !HOME_MANUAL_HOSE.has(m)) homeQty.set(m, q);
  };

  if (noHose) {
    if(HOSE_1W) setH(HOSE_1W, 0);
    if(HOSE_4W) setH(HOSE_4W, 0);
    if(HOSE_I_1W) setH(HOSE_I_1W, 0);
    if(HOSE_I_4W) setH(HOSE_I_4W, 0);
  } else {
    if (useIHose) {
      if (hasServerHomeRules) {
        if(HOSE_I_1W) setH(HOSE_I_1W, hoseI4Model === HOSE_I_1W ? n1w + n4w : n1w);
        if(HOSE_1W) setH(HOSE_1W, 0);
        if(hoseI4Model) setH(hoseI4Model, n4w + (hoseI4Model === HOSE_I_1W ? n1w : 0));
        if(HOSE_4W) setH(HOSE_4W, 0);
      } else {
        // 규칙이 없을 때는 기존 레거시의 4WAY L형 계약을 그대로 보존한다.
        if(HOSE_I_1W) setH(HOSE_I_1W, n1w);
        if(HOSE_1W) setH(HOSE_1W, 0);
        if(HOSE_4W) setH(HOSE_4W, n4w);
        if(HOSE_I_4W) setH(HOSE_I_4W, 0);
      }
    } else {
      if(HOSE_1W) setH(HOSE_1W, n1w);
      if(HOSE_I_1W) setH(HOSE_I_1W, 0);
      if(HOSE_4W) setH(HOSE_4W, n4w);
      if(HOSE_I_4W) setH(HOSE_I_4W, 0);
    }
  }
}

/* 서버 규칙 기반 홈멀티 파생수량. 반환값은 규칙이 소유한 target 모델 집합이다. */
function applyServerHomeQuantitySync_() {
  if (!Array.isArray(ACTIVE_HOME_QUANTITY_SYNC_RULES)
      || ACTIVE_HOME_QUANTITY_SYNC_RULES.length === 0) return new Set();
  const evaluator = window.SamhanQuantitySync && window.SamhanQuantitySync.evaluateQuantitySyncRules;
  if (typeof evaluator !== 'function') return new Set();
  // 서버 규칙 target은 카탈로그 분류로 홈 리모컨 계약 여부를 판정한다.
  function isHomeRemoteContractRow(row){
    return isRemoteRow(row) || String(row?.catM || '').trim() === '리모컨';
  }

  const configured = evaluator(ACTIVE_HOME_QUANTITY_SYNC_RULES, HOMEMULTI, homeQty);
  if (!configured || typeof configured.forEach !== 'function') return new Set();

  const targetCodes = new Set(ACTIVE_HOME_QUANTITY_SYNC_RULES.flatMap(rule =>
    Array.isArray(rule?.targets) ? rule.targets.map(target => String(target?.productCode || '').trim()) : []));
  const isManual = model => HOME_MANUAL_PANEL.has(model) || HOME_MANUAL_HOSE.has(model)
    || HOME_MANUAL_REMOTE.has(model) || HOME_MANUAL_BRANCH.has(model) || HOME_MANUAL_FOOT.has(model);
  const ownedTargets = new Set(HOMEMULTI
    .filter(row => targetCodes.has(String(row?.model || '')) && !isManual(row.model))
    .map(row => String(row.model || '')));
  HOMEMULTI.forEach(row => {
    if (targetCodes.has(String(row?.model || '')) && !isManual(row.model)) homeQty.set(row.model, 0);
  });
  configured.forEach((quantity, key) => {
    const row = HOMEMULTI.find(candidate => String(candidate?.id ?? candidate?.model) === String(key));
    if (row && targetCodes.has(String(row.model || '')) && !isManual(row.model)) {
      homeQty.set(row.model, Number(quantity) || 0);
    }
  });
  return ownedTargets;
}

/* 홈파생계산 */
function recomputeHomeDerived(updateUI) {
  /* 서버 규칙을 읽지 못한 구버전/장애 fallback — legacy 계산은 항상 먼저 실행한다. */
  // 기존 환경 호환 경계(typeof applyServerHomeQuantitySync_ === 'function')는 유지한다.

  // source별 legacy 기여를 계산할 수 있도록 규칙 source의 원수량을
  // snapshot한다. 전체 legacy 계산은 모든 source로 먼저 실행해 source 간
  // 상호작용 결과를 보존하고, 중립 계열 병합에서 단독 기여만 차감한다.
  const ruleSourceQuantities = new Map();
  const quantitySyncEvaluator = window.SamhanQuantitySync
    && window.SamhanQuantitySync.evaluateQuantitySyncRules;
  const evaluatedBeforeLegacy = typeof quantitySyncEvaluator === 'function'
    ? quantitySyncEvaluator(ACTIVE_HOME_QUANTITY_SYNC_RULES, HOMEMULTI, homeQty)
    : null;
  if (evaluatedBeforeLegacy && typeof evaluatedBeforeLegacy.forEach === 'function') {
    const ruleSourceCodes = new Set(ACTIVE_HOME_QUANTITY_SYNC_RULES.flatMap(rule =>
      Array.isArray(rule?.sources)
        ? rule.sources.map(source => String(source?.productCode || '').trim())
        : []));
    HOMEMULTI.forEach(row => {
      const model = String(row?.model || '');
      if (ruleSourceCodes.has(model)) {
        ruleSourceQuantities.set(model, homeQty.get(row.model));
      }
    });
  }

  // 하위계산호출
  recomputeHomeHoses_();
  recomputeHomeBranches();
  recomputeFootAll();
  recomputeHomePanels();
  recomputeHomeRemotes();

  // 서버 적용 전 snapshot은 source별 legacy 결과다. 규칙이 소유하지 않은
  // 같은 계열 모델은 이 값을 끝까지 보존해야 하므로 계열 전체를 초기화하지 않는다.
  const legacyHomeQuantities = new Map(HOMEMULTI.map(row => [
    String(row?.model || ''),
    Number(homeQty.get(row.model)) || 0,
  ]));

  ruleSourceQuantities.forEach((quantity, model) => homeQty.set(model, quantity));

  // 레거시 함수에는 source provenance가 없으므로, 규칙 source를 하나씩
  // 단독 입력한 결과만 해당 source의 legacy 기여로 간주해 중립 결과에서
  // 차감한다. 여러 source가 함께 있어야 생기는 분기관 같은 상호작용은
  // 단독 실행에서 나오지 않으므로 그대로 보존된다.
  const legacyHomeQuantitiesWithoutRuleSources = (predicate, recompute) => {
    const adjusted = new Map(legacyHomeQuantities);
    if (ruleSourceQuantities.size === 0) return adjusted;

    // 임시 source 계산이 끝난 뒤에는 현재 계열만 legacy 상태로 돌리고,
    // 이미 확정된 다른 계열은 이 계열의 재수렴으로 덮어쓰지 않는다.
    const currentHomeQuantities = new Map(
      HOMEMULTI.map(row => [row.model, Number(homeQty.get(row.model)) || 0])
    );

    ruleSourceQuantities.forEach((sourceQuantity, sourceModel) => {
      legacyHomeQuantities.forEach((quantity, model) => homeQty.set(model, 0));
      homeQty.set(sourceModel, Number(sourceQuantity) || 0);
      recompute();
      HOMEMULTI.filter(predicate).forEach(row => {
        const model = String(row?.model || '');
        adjusted.set(model, Math.max(0,
          (adjusted.get(model) || 0) - (Number(homeQty.get(row.model)) || 0)));
      });
    });

    HOMEMULTI.forEach(row => {
      const model = String(row?.model || '');
      const quantity = predicate(row)
        ? legacyHomeQuantities.get(model) || 0
        : currentHomeQuantities.get(model) || 0;
      homeQty.set(model, quantity);
    });
    return adjusted;
  };

  // 서버 규칙은 레거시 파생계산을 모두 실행한 뒤 소유 target만 덮어쓴다.
  // 규칙이 없거나 읽히지 않으면 빈 Set이므로 순수 legacy 결과가 유지된다.
  const serverOwnedTargets = typeof applyServerHomeQuantitySync_ === 'function'
    ? applyServerHomeQuantitySync_()
    : new Set();

  // 규칙이 소유한 target이 있는 계열만 재수렴한다. 중립 옵션은 target별로
  // 규칙값/legacy snapshot을 병합하고, 치환·제외 옵션은 옵션 결과를 계열
  // 전체에 적용한 뒤 선택 모델에 남은 규칙 target만 규칙값을 유지한다.
  const reconcileHomeFamily = (predicate, manualSet, useOptionResult, recompute) => {
    const familyRows = HOMEMULTI.filter(predicate);
    const ownedRows = familyRows.filter(row =>
      serverOwnedTargets.has(String(row?.model || '')) && !manualSet.has(row.model));
    if (ownedRows.length === 0) return;

    const ruleQuantities = new Map(ownedRows.map(row => [
      String(row.model || ''),
      Number(homeQty.get(row.model)) || 0,
    ]));
    let desiredQuantities;
    if (useOptionResult) {
      recompute();
      const optionQuantities = new Map(familyRows
        .filter(row => !manualSet.has(row.model))
        .map(row => [String(row.model || ''), Number(homeQty.get(row.model)) || 0]));
      const optionModels = new Set([...optionQuantities]
        .filter(([, quantity]) => quantity > 0)
        .map(([model]) => model));
      desiredQuantities = new Map(familyRows
        .filter(row => !manualSet.has(row.model))
        .map(row => {
          const model = String(row.model || '');
          const optionQuantity = optionQuantities.get(model) || 0;
          // 치환에서 선택 전 모델은 규칙 소유라도 0이어야 한다. 선택 모델에
          // 남은 규칙 target은 규칙값을 사용해 target 단위 계약을 보존한다.
          const quantity = ruleQuantities.has(model) && optionModels.has(model)
            ? ruleQuantities.get(model)
            : optionQuantity;
          return [model, quantity];
        }));
    } else {
      const legacyQuantities = legacyHomeQuantitiesWithoutRuleSources(predicate, recompute);
      desiredQuantities = new Map(familyRows
        .filter(row => !manualSet.has(row.model))
        .map(row => {
          const model = String(row.model || '');
          return [model, ruleQuantities.has(model)
            ? ruleQuantities.get(model)
            : legacyQuantities.get(model) || 0];
        }));
    }

    // 계열을 비우는 것은 옵션 결과를 재수렴할 때도 비수동 행에 한정한다.
    // 규칙 0건이면 이 함수가 호출되지 않아 순수 legacy 결과가 그대로 남는다.
    HOMEMULTI.forEach(row => {
      if (predicate(row) && !manualSet.has(row.model)) homeQty.set(row.model, 0);
    });
    desiredQuantities.forEach((quantity, model) => {
      if (!manualSet.has(model)) homeQty.set(model, quantity);
    });
  };

  reconcileHomeFamily(
    row => row.model === BRANCH_1509 || row.model === BRANCH_2512,
    HOME_MANUAL_BRANCH,
    !!el('#home_no_branch')?.checked,
    recomputeHomeBranches,
  );

  reconcileHomeFamily(
    row => row.model === FOOT_ROUND || FOOT_FLAT_MODELS.includes(String(row?.model || '')),
    HOME_MANUAL_FOOT,
    !el('#home_foot')?.checked,
    recomputeFootAll,
  );

  reconcileHomeFamily(
    row => /유연\s*호스|호스/i.test(String(row?.name || '')),
    HOME_MANUAL_HOSE,
    !!el('#home_no_hose')?.checked || !!el('#home_hose_i')?.checked,
    recomputeHomeHoses_,
  );

  reconcileHomeFamily(
    row => isRemoteRow(row) || String(row?.catM || '').trim() === '리모컨',
    HOME_MANUAL_REMOTE,
    (el('#home_remote')?.value || '기본') !== '기본',
    recomputeHomeRemotes,
  );

  reconcileHomeFamily(
    row => isPanelRow(row),
    HOME_MANUAL_PANEL,
    (el('#home_panel')?.value || '') !== '',
    recomputeHomePanels,
  );

  if (updateUI) {
    syncHomeUIFromState();
    syncHomeTotals();
    refreshSelectedBadge();
    updateHomeRatio();
  }
}

/* 상업파생계산 */
function recomputeCommDerived() {
  const want = new Map();
  const requireCommCatalogRow_ = (model, reason) => {
    const row = (COMMULTI||[]).find(x=>x.model===model);
    if(!row){
      if(!['AR-EH05','방진가대S2중'].includes(String(model))) return null;
      const suffix = reason ? ` (${reason})` : '';
      throw new Error(`상업멀티 파생 품목이 카탈로그에 없습니다: ${model}${suffix}`);
    }
    return row;
  };

  /* 수동제외초기화 */
  COMMULTI.forEach(r => {
    if (isCommPanelRow(r)) want.set(r.model, 0);
    if (isCommHoseRow(r)) want.set(r.model, 0);
    if (isCommRemoteRow(r)) want.set(r.model, 0);
    if (isCommPumpRow(r)) want.set(r.model, 0);
    
    const s = ((r?.name||'')+' '+(r?.disp||'')+' '+(r?.model||'')).toLowerCase();
    if (/방진가대|받침대|발통세트|일자발|SI-AL/i.test(s)) want.set(r.model, 0);
  });

  /* 판넬계산 */
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0;
    if (!q || !isCommIndoorRow(r)) return;
    const pm = computeCommPanelModelForIndoor_(r);
    if (pm) want.set(pm, (want.get(pm) || 0) + q);
  });

  /* 호스계산 */
  let nTarget = 0, nNormal = 0;
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0;
    if (!q || !isCommIndoorRow(r)) return;
    if (/벽걸이|덕트|DUCT|실링|스탠드/i.test(r.name || '')) return;
    const kind = commIndoorKind(r);
    if (kind === '1way' || kind === '2way') nTarget += q;
    else nNormal += q;
  });

  const hose1L = HOSE_1W;
  const hose4L = pickHoseModel('4way');
  const hose1I = (typeof HOSE_I_1W !== 'undefined' ? HOSE_I_1W : '');

  const isHoseExcluded = el('#comm_ex_hose')?.checked;
  if (!isHoseExcluded) {
    const useIHose = !!window.SHOW_I_HOSE || !!el('#comm_hose_i')?.checked;
    if (useIHose && hose1I) {
      want.set(hose1I, nTarget);
      if (hose1L) want.set(hose1L, 0);
    } else {
      if (hose1L) want.set(hose1L, nTarget);
      if (hose1I) want.set(hose1I, 0);
    }
    if (hose4L) want.set(hose4L, (want.get(hose4L) || 0) + nNormal);
  }

  /* 리모컨계산 */
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0;
    if (!q) return;

    if (isCommRemoteRow(r)) return;
    
    const nm = rawNameOf(r);
  
    if (!isCommIndoorRow(r) && !/전열교환기/i.test(nm)) return;

    const rm = computeCommRemoteModelForIndoor_(r);

    if (rm) want.set(rm, (want.get(rm) || 0) + q);
  });

  /* 펌프집계 */
  const PUMP_MAP = {
    'MDP-Z075SZED': ['AM052DNLDBH1', 'AM072DNLDBH1'],
    'ADP-E075SEK3D': ['AM100FNLDBH1'],
    'MDP-M075SGK2D': ['AM130DNMDBH1', 'AM145DNMDBH1'],
    'ADP-G075SPK1D': ['AM083DNMDBH1', 'AM100DNMDBH1', 'AM110DNMDBH1', 'AM052ANHDBH1', 'AM060ANHDBH1', 'AM072ANHDBH1', 'AM083ANHDBH1', 'AM100ANHDBH1', 'AM110ANHDBH1', 'AM130ANHDBH1', 'AM145ANHDBH1', 'AM230ANHDBH1'],
    'ADP-N047SNK1D': ['AM290HNHDBH1'],
    'ADP-F075SP': ['AM072TNCDBH1', 'AM110TNCDBH1', 'AM130TNCDBH1', 'AM145TNCDBH1']
  };
  Object.entries(PUMP_MAP).forEach(([pump, list]) => {
    let sum = 0;
    list.forEach(m => sum += Number(commQty.get(m)||0));
    want.set(pump, sum);
  });

  /* 받침대분기관 */
  let branchCnt = 0;
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model) || 0;
    if (!q || !isCommOutdoorRow(r)) return;
    const nm = rawNameOf(r);

    if (String(r.unit).toUpperCase() === 'SET') {
      const hps = parseSetHPs(nm);
      hps.forEach(hp => {
        const baseNames = chooseBaseModel(nm.replace(/\(([^)]*)\)/, `(${hp}HP)`));
        baseNames.forEach(bn => {
          const m = modelByNameLike(bn) || bn;
          if(!COMM_MANUAL_BASE.has(m)) want.set(m, (want.get(m)||0)+q);
        });
      });
      branchCnt += countBranchForSet(nm) * q;
    } else {
      const baseNames = chooseBaseModel(nm);
      baseNames.forEach(bn => {
        const m = modelByNameLike(bn) || bn;
        if(!COMM_MANUAL_BASE.has(m)) want.set(m, (want.get(m)||0)+q);
      });
    }
  });
  if (branchCnt > 0) want.set('AXJ-TA3419M', (want.get('AXJ-TA3419M')||0)+branchCnt);

  /* 리뉴얼필터 */
  COMMULTI.forEach(r => {
    const q = commQty.get(r.model)||0;
    if (!q || !isCommOutdoorRow(r)) return;
    for (const [fModel, list] of Object.entries(RENEW_FILTER_MAP)) {
      if (list.includes(r.model) && !COMM_MANUAL_BASE.has(fModel)) {
        want.set(fModel, (want.get(fModel)||0) + q);
      }
    }
  });

  /* 제외옵션처리 */
  if (el('#comm_panel')?.value === '판넬제외') {
    COMMULTI.forEach(r => { if(isCommPanelRow(r)) want.set(r.model, 0); });
  }
  if (el('#comm_remote')?.value === '제외') {
    COMMULTI.forEach(r => { if(isCommRemoteRow(r)) want.set(r.model, 0); });
  }

  const isBaseExcluded = el('#comm_ex_base')?.checked;
  if (isBaseExcluded) {
    COMMULTI.forEach(r => {
      if(/방진가대|받침대|발통세트|일자발|SI-AL/i.test(((r.name||'')+' '+(r.disp||'')+' '+(r.model||'')).toLowerCase())) {
        want.set(r.model, 0);
      }
    });
  }

  COMMULTI.forEach(r => {
    const s = ((r.name||'')+' '+(r.disp||'')+' '+(r.model||'')).toLowerCase();
    const isBaseItem = /방진가대|받침대|발통세트|일자발|si-al|AXJ-TA3419M|ACL-KORGHP07|AF-R09A|AF-R12A/i.test(s);
    if (isBaseItem && !COMM_MANUAL_BASE.has(r.model)) {
      if (!want.has(r.model)) want.set(r.model, 0);
    }
  });

  /* UI반영 */
  want.forEach((q, m) => {
    const row = requireCommCatalogRow_(m, '파생 품목 반영');
    if(!row) return;

    if (window.ABSOLUTE_LOCK && window.ABSOLUTE_LOCK.has(m)) {
      return;
    }

    if (isCommPanelRow(row) && COMM_MANUAL_PANEL.has(m)) return;
    if (isCommHoseRow(row) && COMM_MANUAL_HOSE.has(m)) return;
    if (isCommPumpRow(row) && COMM_MANUAL_PUMP.has(m)) return;

    const isSpecialRemote = (m === 'AWR-WE13N' || m === 'AWR-VH12N');
    if ((isCommRemoteRow(row) || isSpecialRemote) && COMM_MANUAL_REMOTE.has(m)) return;
    
    const isBase = /방진가대|받침대|발통세트|일자발|SI-AL/i.test(((row.name||'')+' '+(row.disp||'')+' '+(row.model||'')).toLowerCase());
    
    if (isBase && !isBaseExcluded && COMM_MANUAL_BASE.has(m)) return;

    commQty.set(m, q);

    const inp = document.querySelector(`#commBody .qty-input[data-model="${CSS.escape(m)}"]`);
    if (inp && document.activeElement !== inp) inp.value = q ? String(q) : '';

    const unit = commUnitPrice(m) || 0;
    let finalUnit = unit;
    if(typeof commCustomPrices !== 'undefined' && commCustomPrices.has(m)) {
        finalUnit = commCustomPrices.get(m);
    }
    
    const sCel = document.querySelector(`#commBody [data-csub="${CSS.escape(m)}"]`);
    if (sCel) sCel.textContent = fmt(finalUnit * q);
  });

  syncCommTotals();
  updateInlineTotals();
  updateCommRatio();
  refreshBranchOpenButton();

  // 화면복원
  if (window.ABSOLUTE_LOCK) {
    window.ABSOLUTE_LOCK.forEach(key => {
      const inp = document.querySelector(`#commBody .qty-input[data-model="${CSS.escape(key)}"]`);
      if (inp) {
        const val = commQty.get(key);
        
        window.CURRENT_INTERACTING_KEY = key;
        
        // 값 및 색상 복구
        if (val !== undefined && val !== null) {
          inp.value = String(val);
        }
        inp.style.setProperty('color', '#2563eb', 'important');
        inp.style.setProperty('font-weight', 'bold', 'important');
        
        // 복구 완료
        window.CURRENT_INTERACTING_KEY = null;
      }
    });
  }
}

// 키워드 포함 여부
function has_(s, re){ return re.test(String(s||'')); }
function computeCommPanelModelForIndoor_(row){
  const nm = rawNameOf(row);                 // 원본 기준
  const panelOpt = (document.getElementById('comm_panel')?.value)||'기본판넬';
  const shape360 = (document.getElementById('comm_p360')?.value)||'원형';

  const is1w   = /(1\s*-?\s*way|1way)/i.test(nm);
  const is2w   = /(2\s*-?\s*way|2way)/i.test(nm);
  const is4w   = /(4\s*-?\s*way|4way)/i.test(nm);
  const is360 = /360/.test(nm);
  const wifi  = /WIFI\s*내장|WIFI내장/i.test(nm) ? 'WIFI내장' : (/미내장/.test(nm) ? '미내장' : null);

  const isSmall = /소형/i.test(nm);
  const isMid   = /중형/i.test(nm);
  const isBig   = /대형/i.test(nm);

  const hasWifi  = /WIFI\s*내장|Wi[-\s]*Fi\s*내장/i.test(nm);
  const noWifi   = /미내장/i.test(nm);
  const infinite = /인피니트/i.test(nm);
  const isMini   = /MINI/i.test(nm);

  if(panelOpt==='판넬제외') return null;      // 완전 제외

  const swap = (base)=>{
    if(panelOpt==='블랙판넬')   return base.replace(/NUF(K1N|K1NW|DK1N|DK1NW)/i, m=>m.replace('NUF','NBF'));
    if(panelOpt==='승강판넬')   return base.replace(/NUF(K1N|K1NW|DK1N|DK1NW)/i, m=>m.replace('NUF','NUX'));
    if(panelOpt==='공청판넬')   return base.replace(/NUF(K1N|K1NW|DK1N|DK1NW)|WSK3(NW|N)/i, m=>{
      if(/WSK3/i.test(m)) return m.replace('WSK3','WCK3');
      return m.replace('NUF','NUC').replace('K1','K4');
    });
    if(panelOpt==='동작감지'){
      if(/PC1Y.NWK1NW/i.test(base)) return 'PC1YNRK1NW';
      if(/PC1Z.NWK1NW/i.test(base)) return 'PC1ZNRK1NW';
    }
    return base;
  };

  if(is2w) return 'PC2NWSK1N';

  if(is1w && hasWifi){
    if(isSmall) return panelOpt==='공청판넬' ? 'PC1MWCK3NW' : 'PC1MWSK3NW';
    if(isMid)   return panelOpt==='공청판넬' ? 'PC1NWCK3NW' : 'PC1NWSK3NW';
    if(isBig)   return panelOpt==='공청판넬' ? 'PC1BWCK3NW' : 'PC1BWSK3NW';
  }
  if(is1w && noWifi){
    if(isSmall) return panelOpt==='공청판넬' ? 'PC1MWCK3N' : 'PC1MWSK3N';
    if(isMid)   return panelOpt==='공청판넬' ? 'PC1NWCK3N' : 'PC1NWSK3N';
    if(isBig)   return panelOpt==='공청판넬' ? 'PC1BWCK3N' : 'PC1BWSK3N';
  }
  if(is1w && infinite){
    if(isMid)   return panelOpt==='동작감지' ? 'PC1YNRK1NW' : 'PC1YNWK1NW';
    if(isBig)   return panelOpt==='동작감지' ? 'PC1ZNRK1NW' : 'PC1ZNWK1NW';
  }

  if(is4w && hasWifi){
    if(isMini) return 'PC4SUFK1NW';
    return swap('PC4NUFK1NW');
  }
  if(is4w && noWifi){
    if(isMini) return 'PC4SUFK1N';
    return swap('PC4NUFK1N');
  }

  if (is360 && wifi) {
    const MAP360 = {
      'WIFI내장': {
        '원형': { base:'PC6NUNK1NW', '블랙판넬':'PC6NBNK1NW', '공청판넬':'PC6EUCK1NW', '승강판넬':'PC6EUXK1NW' },
        '사각': { base:'PC6NUDK1NW', '블랙판넬':'PC6NBDK1NW', '공청판넬':'PC6NUCK1NW', '승강판넬':'PC6NUXK1NW' }
      },
      '미내장': {
        '원형': { base:'PC4NUNK1N',  '블랙판넬':'PC4NBNK1N',  '공청판넬':'PC6EUCK1N',  '승강판넬':'PC6EUXK1N'  },
        '사각': { base:'PC4NUDK1N',  '블랙판넬':'PC4NBDK1N',  '공청판넬':'PC6NUCK1N',  '승강판넬':'PC6NUXK1N'  }
      }
    };

    if (panelOpt === '판넬제외') return null;

    const table  = MAP360[wifi]?.[shape360];
    const target = table ? (table[panelOpt] || table.base) : null;
    if (target) {
      return target;
    }
  }
  return null;
}

/* UI 동기화 */
function syncHomeUIFromState() {
  homeRowByModel.forEach((row, model) => {
    const q = homeQty.get(model) || 0;

    // 특수행은 수량 입력이 없고 저장용 단가 Map이 유일한 표시 단가 출처다.
    // 일반행용 자동 단가(특수행에서는 0)를 소계에 사용하면 입력·복원 후 소계가 0으로 덮인다.
    if (row?.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL) {
      const specialUnit = homeCustomPrices.has(model)
        ? homeCustomPrices.get(model)
        : homeUnitPrice(model);
      const specialSubCell = document.querySelector(`#homeBody [data-sub="${CSS.escape(model)}"]`);
      if (specialSubCell) specialSubCell.textContent = fmt(specialUnit * q);
      return;
    }

    // 수량입력창 동기화
    const qtyInp = document.querySelector(`#homeBody .qty-input[data-m="${CSS.escape(model)}"]`);
    if (qtyInp && document.activeElement !== qtyInp) {
      let isManual = false;
      const nm = String(row?.name || '');
      if (/(판넬|패널|panel)/i.test(nm)) isManual = typeof HOME_MANUAL_PANEL !== 'undefined' && HOME_MANUAL_PANEL.has(model);
      else if (/리모컨|리모콘/i.test(nm)) isManual = typeof HOME_MANUAL_REMOTE !== 'undefined' && HOME_MANUAL_REMOTE.has(model);
      else if (/유연호스/i.test(nm)) isManual = typeof HOME_MANUAL_HOSE !== 'undefined' && HOME_MANUAL_HOSE.has(model);
      else if (/분\s*기\s*관|분기관/i.test(nm)) isManual = typeof HOME_MANUAL_BRANCH !== 'undefined' && HOME_MANUAL_BRANCH.has(model);
      else if (/발통|일자발/i.test(nm)) isManual = typeof HOME_MANUAL_FOOT !== 'undefined' && HOME_MANUAL_FOOT.has(model);
      else isManual = (q !== 0 || qtyInp.value === '0'); 

      if (q === 0 && qtyInp.value === '0') {
         // 영유지
      } else if (q === 0 && qtyInp.value === '') {
         // 공백유지
      } else {
         qtyInp.value = (q !== 0 || isManual) ? String(q) : '';
      }
      qtyInp.style.color = isManual ? '#2563eb' : '#374151';
      qtyInp.style.fontWeight = isManual ? 'bold' : 'normal';
    }

    // 단가 및 소계 계산
    const autoUnit = homeUnitPrice(model);
    let finalUnit = autoUnit;
    
    // 단가 셀 처리
    const priceCell = document.querySelector(`#homeBody [data-unit="${CSS.escape(model)}"]`);
    if (priceCell) {
      const inp = priceCell.querySelector('input');
      if (inp) {
        if (typeof homeCustomPrices !== 'undefined' && homeCustomPrices.has(model)) {
          finalUnit = homeCustomPrices.get(model);
          inp.style.color = '#2563eb';
          inp.style.fontWeight = 'bold';
        } else {
          if (inp.value.replace(/[^0-9]/g, '') !== String(autoUnit)) {
            inp.value = autoUnit.toLocaleString();
          }
          finalUnit = autoUnit;
          inp.style.color = '#374151';
          inp.style.fontWeight = 'normal';
        }
      } else {
        priceCell.textContent = fmt(autoUnit);
      }
    }

    // 소계 셀 업데이트
    const subCell = document.querySelector(`#homeBody [data-sub="${CSS.escape(model)}"]`);
    if (subCell) {
      subCell.textContent = fmt(finalUnit * q);
    }
  });

  // 총 합계 갱신
  syncHomeTotals();
}

