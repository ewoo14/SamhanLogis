/* 복원 */
const historyStack = [];
let historyIndex = -1;
let isUndoRedo = false;

/* 경로 */
function getElPath(el) {
  if (!el || !el.tagName) return null;
  if (el.id) return '#' + CSS.escape(el.id);
  if (el.name && (el.type === 'radio' || el.type === 'checkbox')) {
    return `input[name="${CSS.escape(el.name)}"][value="${CSS.escape(el.value)}"]`;
  }
  const clsArr = ['qty-input', 'price-input', 'list-price-input', 'spec-input', 'fix-dc-inp', 'var-dc-chk', 'part-qty-single', 'part-price-single', 'part-qty-comm', 'part-price-comm', 'custom-qty', 'custom-price', 'custom-name', 'custom-model', 'custom-list', 'custom-spec', 'custom-fix-dc', 'custom-var-dc', 'mo-name', 'pc-name', 'cap-input', 'out-name-input', 'extra-branch'];
  const cls = clsArr.find(c => el.classList.contains(c));
  
  if (cls) {
    if (cls === 'cap-input') {
      const slot = el.closest('.out-slot');
      if (slot) return `.out-slot[data-out="${CSS.escape(slot.dataset.out)}"][data-row="${CSS.escape(slot.dataset.row)}"] .cap-input`;
    }
    if (cls === 'out-name-input') return `.out-name-input[data-out="${CSS.escape(el.dataset.out)}"]`;
    if (cls === 'extra-branch') {
      const span = el.closest('span[data-k]');
      if (span) return `span[data-k="${CSS.escape(span.dataset.k)}"] .extra-branch`;
    }
    const tr = el.closest('tr');
    if (tr) {
      if (tr.classList.contains('custom-item-row')) {
        const tb = tr.closest('tbody');
        if (tb) {
          const rs = Array.from(tb.querySelectorAll('.custom-item-row'));
          return `#${CSS.escape(tb.id)} .custom-item-row:nth-child(${rs.indexOf(tr) + 1}) .${cls}`;
        }
      }
      const pSet = el.dataset.set;
      const pPart = el.dataset.part;
      if (pSet && pPart) return `tr[data-part-of="${CSS.escape(pSet)}"][data-m="${CSS.escape(pPart)}"] .${cls}`;
      const m = tr.dataset.m || tr.dataset.id || tr.dataset.setModel || tr.dataset.idx;
      if (m) return `tr[data-m="${CSS.escape(m)}"] .${cls}, tr[data-id="${CSS.escape(m)}"] .${cls}, tr[data-setModel="${CSS.escape(m)}"] .${cls}, tr[data-idx="${CSS.escape(m)}"] .${cls}`;
    }
    const elM = el.dataset.m || el.dataset.model || el.dataset.id || el.dataset.sid || el.dataset.idx || el.dataset.part;
    if (elM) return `.${cls}[data-m="${CSS.escape(elM)}"], .${cls}[data-model="${CSS.escape(elM)}"], .${cls}[data-sid="${CSS.escape(elM)}"], .${cls}[data-id="${CSS.escape(elM)}"], .${cls}[data-idx="${CSS.escape(elM)}"]`;
  }
  return null;
}

/* 수동확인 */
function isMan(el) {
  if (!el.style) return false;
  const c = el.style.color;
  const w = el.style.fontWeight;
  return c === 'rgb(37, 99, 235)' || c === '#2563eb' || w === 'bold' || w === '700';
}

/* 값 */
function getElVal(el) {
  if (el.type === 'checkbox' || el.type === 'radio') return el.checked;
  const isPrice = ['price-input', 'list-price-input', 'part-price-single', 'part-price-comm', 'custom-price', 'custom-list'].some(c => el.classList.contains(c));
  if (isPrice) return el.value.replace(/,/g, '');
  return el.value;
}

/* 할당 */
function setElVal(el, val, man) {
  if (el.type === 'checkbox' || el.type === 'radio') {
    el.checked = (val === 'true' || val === true);
  } else {
    const isPrice = ['price-input', 'list-price-input', 'part-price-single', 'part-price-comm', 'custom-price', 'custom-list'].some(c => el.classList.contains(c));
    const hasAuto = ['qty-input', 'price-input', 'list-price-input', 'spec-input', 'fix-dc-inp', 'part-qty-single', 'part-qty-comm'].some(c => el.classList.contains(c));
    
    if (!man && hasAuto) {
      el.value = '';
      el.style.color = '';
      el.style.fontWeight = '';
    } else {
      el.value = (isPrice && val && !isNaN(Number(val))) ? Number(val).toLocaleString('ko-KR') : val;
      if (man) {
        el.style.setProperty('color', '#2563eb', 'important');
        el.style.setProperty('font-weight', 'bold', 'important');
      } else {
        el.style.color = '';
        el.style.fontWeight = '';
      }
    }
  }
}

/* 저장 */
function saveState(el, isInit) {
  if (isUndoRedo) return;
  const path = getElPath(el);
  if (!path) return;
  const val = getElVal(el);
  const man = isMan(el);
  
  if (isInit) {
    el.dataset.undoInit = String(val);
    el.dataset.undoMan = String(man);
  } else {
    const oldVal = el.dataset.undoInit !== undefined ? el.dataset.undoInit : '';
    const oldMan = el.dataset.undoMan === 'true';
    if (oldVal !== String(val) || oldMan !== man) {
      historyStack.splice(historyIndex + 1);
      historyStack.push({ path: path, oldVal: oldVal, newVal: String(val), oldMan: oldMan, newMan: man, type: el.type });
      historyIndex++;
      el.dataset.undoInit = String(val);
      el.dataset.undoMan = String(man);
    }
  }
}

/* 반영 */
function applyState(action, isUndo) {
  const el = document.querySelector(action.path);
  if (!el) return;
  isUndoRedo = true;
  const val = isUndo ? action.oldVal : action.newVal;
  const man = isUndo ? action.oldMan : action.newMan;

  const m = el.dataset.m || el.dataset.model || el.dataset.id || el.dataset.sid || el.dataset.idx || el.dataset.part;
  const setModel = el.dataset.set;
  let key = null;
  if (m) key = (setModel && m) ? setModel + '|' + m : m;
  if (key) window.CURRENT_INTERACTING_KEY = key;

  setElVal(el, val, man);
  el.dataset.undoInit = String(val);
  el.dataset.undoMan = String(man);

  el.dispatchEvent(new Event('input', { bubbles: true }));
  el.dispatchEvent(new Event('change', { bubbles: true }));

  if (key) window.CURRENT_INTERACTING_KEY = null;
  el.focus();
  setTimeout(() => { isUndoRedo = false; }, 10);
}

/* 이벤트 */
['focusin', 'change', 'focusout'].forEach(evt => {
  document.addEventListener(evt, e => {
    if (e.target && ['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) {
      saveState(e.target, evt === 'focusin');
    }
  }, true);
});

/* 조작 */
document.addEventListener('keydown', e => {
  if (e.ctrlKey && e.key.toLowerCase() === 'z') {
    e.preventDefault();
    if (document.activeElement && ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
      const el = document.activeElement;
      const currentVal = getElVal(el);
      const currentMan = isMan(el);
      const initVal = el.dataset.undoInit !== undefined ? el.dataset.undoInit : '';
      const initMan = el.dataset.undoMan === 'true';
      
      if (String(currentVal) !== String(initVal) || currentMan !== initMan) {
        isUndoRedo = true;
        let key = null;
        const m = el.dataset.m || el.dataset.model || el.dataset.id || el.dataset.sid || el.dataset.idx || el.dataset.part;
        const setModel = el.dataset.set;
        if (m) key = (setModel && m) ? setModel + '|' + m : m;
        if (key) window.CURRENT_INTERACTING_KEY = key;

        setElVal(el, initVal, initMan);

        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
        
        if (key) window.CURRENT_INTERACTING_KEY = null;
        setTimeout(() => { isUndoRedo = false; }, 10);
        return;
      }
    }
    if (historyIndex >= 0) {
      applyState(historyStack[historyIndex], true);
      historyIndex--;
    }
  } else if (e.ctrlKey && e.key.toLowerCase() === 'y') {
    e.preventDefault();
    if (historyIndex < historyStack.length - 1) {
      historyIndex++;
      applyState(historyStack[historyIndex], false);
    }
  }
});

