  if(singleM) singleM.addEventListener('change',()=>{SINGLE_FILTER.M=singleM.value||'';updateSingleFilterOptions();renderSingle();});
  if(singleT){
    const icon = document.getElementById('singleFilterIcon');
    const syncIcon=()=>{const v=(singleT.value||'').trim();if(icon) icon.style.display=(document.activeElement===singleT||v)?'none':'inline';};
    singleT.addEventListener('focus',syncIcon);
    singleT.addEventListener('blur',syncIcon);
    singleT.addEventListener('input',()=>{SINGLE_FILTER.text=singleT.value||'';updateSingleFilterOptions();renderSingle();syncIcon();});
    syncIcon();
  }

  const commL = document.getElementById('commFilterL');
  const commM = document.getElementById('commFilterM');
  const commS = document.getElementById('commFilterS');
  const commT = document.getElementById('commFilterText');
  if(commL) commL.addEventListener('change',()=>{COMM_FILTER.L=commL.value||'';COMM_FILTER.M='';COMM_FILTER.S='';updateCommFilterOptions();renderComm();});
  if(commM) commM.addEventListener('change',()=>{COMM_FILTER.M=commM.value||'';COMM_FILTER.S='';updateCommFilterOptions();renderComm();});
  if(commS) commS.addEventListener('change',()=>{COMM_FILTER.S=commS.value||'';updateCommFilterOptions();renderComm();});
  if(commT){
    const icon = document.getElementById('commFilterIcon');
    const syncIcon=()=>{const v=(commT.value||'').trim();if(icon) icon.style.display=(document.activeElement===commT||v)?'none':'inline';};
    commT.addEventListener('focus',syncIcon);
    commT.addEventListener('blur',syncIcon);
    commT.addEventListener('input',()=>{COMM_FILTER.text=commT.value||'';updateCommFilterOptions();renderComm();syncIcon();});
    syncIcon();
  }
}

// 홈렌더
function renderHome(){
  const body=el('#homeBody');body.innerHTML='';

  // 데이터 매핑
  let rows=HOMEMULTI.map((r,idx)=>{
    if(r.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL) {
        return {r, L:'기타', M:'', S:'', _idx:idx};
    }
    const {catL,catM,catS}=normalizeHomeCategory(r);
    return {r,L:unifyCatL_(catL)||'',M:catM||'',S:catS||'',_idx:idx};
  });

  // 정렬
  rows.sort((a,b)=>{
    if(a.r.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL) return 1;
    if(b.r.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL) return -1;
    if(a.L==='실외기 받침대' && b.L==='인테리어핏') return -1;
    if(a.L==='인테리어핏'    && b.L==='실외기 받침대') return 1;
    if(a.L==='실외기 받침대'&&b.L==='실외기 받침대'){
      const rank=v=>v==='원형발통'?0:(v==='일자발'?1:9);
      const m = rank(a.M)-rank(b.M);
      if(m) return m;
    }
    return (a._idx||0)-(b._idx||0);
  });

  rows = applyHomeFilter(rows);

  // 헤더
  const thead = document.querySelector('#wrapHome thead tr');
  if(thead) {
    thead.innerHTML = `
      <th class="colL pc-only" colspan="4">품목명</th>
      <th class="colL mobile-only">품목명</th>
      <th class="model">모델명</th>
      <th class="list-price pc-only">출고가</th>
      <th class="spec-col pc-only">규격</th>
      <th style="width:60px;">수량</th>
      <th class="h-price" style="width:100px;">납품가</th>
      <th class="sub pc-only" style="width:100px;">소계</th>
      <th class="pc-only" style="width:60px;">고정DC</th>
      <th class="pc-only" style="width:60px;">변동DC</th>
      <th class="capa pc-only" style="width:60px;">용량</th> `;
  }

  // 병합
  for(let i=0;i<rows.length;){
    const L=rows[i].L; let j=i,anyM=false;
    while(j<rows.length&&rows[j].L===L){ if(rows[j].M) anyM=true; j++; }
    rows[i].rowSpanL=j-i;
    for(let k=i;k<j;k++){ rows[k].isFirstL=(k===i); rows[k].lOnlyL=!anyM; rows[k].lIndex=k-i; }
    i=j;
  }
  for(let i=0;i<rows.length;){
    const L=rows[i].L,M=rows[i].M; let j=i;
    while(j<rows.length&&rows[j].L===L&&rows[j].M===M) j++;
    const spanM=j-i; const hasS=rows.slice(i,j).some(x=>!!x.S);
    rows[i].rowSpanM=spanM;
    for(let k=i;k<j;k++){ rows[k].mHasS=hasS; rows[k].mIndex=k-i; }
    i=j;
  }
  for(let i=0;i<rows.length;){
    const L=rows[i].L,M=rows[i].M,S=rows[i].S; let j=i;
    while(j<rows.length&&rows[j].L===L&&rows[j].M===M&&rows[j].S===S) j++;
    rows[i].rowSpanS=j-i; i=j;
  }

  let prevKey='';
  rows.forEach(row=>{
    const r=row.r;
    const q=homeQty.get(r.model)||0;
    
    const isSpecial = r.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL;
    const isCut = r.kind === 'CUT';

    if(isSpecial && typeof HOME_MANUAL_BRANCH !== 'undefined') {
        HOME_MANUAL_BRANCH.add(r.model);
    }

    const unit=homeUnitPrice(r.model);
    const currentPrice = homeCustomPrices.has(r.model) ? homeCustomPrices.get(r.model) : unit;
    const sub = currentPrice * q;
    
    const key=row.L+'|'+row.M+'|'+row.S;
    const groupTop=(key!==prevKey);prevKey=key;

    const tr=document.createElement('tr');
    tr.classList.add('tint');
    tr.style.setProperty('--lRGB',rgbForL(row.L));
    tr.style.setProperty('--mRGB',row.M?rgbForMid(row.M,row.L):rgbForL(row.L));
    tr.style.setProperty('--mA',(Math.min(0.28,0.12+0.03*((row.M?row.mIndex:row.lIndex)||0))).toFixed(2));
    if(groupTop) tr.classList.add('group-top');
    tr.setAttribute('data-m',r.model||'');

    if(row.isFirstL&&row.rowSpanL){
      const tdL=document.createElement('td'); tdL.className='colL pc-only'; tdL.textContent=row.L; tdL.rowSpan=row.rowSpanL;
      if(row.lOnlyL) tdL.colSpan=3;
      tr.appendChild(tdL);
    }
    if(!row.lOnlyL){
      if(row.rowSpanM&&row.mIndex===0){
        const tdM=document.createElement('td'); tdM.className='colM pc-only'; tdM.textContent=row.M||''; tdM.rowSpan=row.rowSpanM;
        if(!row.mHasS) tdM.colSpan=2;
        tr.appendChild(tdM);
      }
      if(row.mHasS&&row.rowSpanS){
        const tdS=document.createElement('td'); tdS.className='colS pc-only'; tdS.textContent=row.S||''; tdS.rowSpan=row.rowSpanS;
        tr.appendChild(tdS);
      }
    }

    const disp=displayOverrides(cleanDisplayName(r?.disp||'',r?.name||''),'home');
    const baseItem={catL:row.L,catM:row.M,catS:row.S,model:r?.model||'',name:disp};

    const tdD_PC=document.createElement('td'); tdD_PC.className='colD spec-click pc-only'; tdD_PC.textContent=disp;
    tdD_PC.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'home')); tr.appendChild(tdD_PC);

    const tdD_MO=document.createElement('td'); tdD_MO.className='colD spec-click mobile-only'; tdD_MO.textContent=r?.name||''; 
    tdD_MO.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'home')); tr.appendChild(tdD_MO);

    const tdModel=document.createElement('td');
    tdModel.className='model spec-click';
    tdModel.textContent=r?.model||'';
    tdModel.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'home'));
    tr.appendChild(tdModel);

    // 출고가
    const tdList = document.createElement('td');
    tdList.className = 'list-price pc-only';
    if(isSpecial) {
      tdList.textContent = '';
    } else {
      const listPrice = getBaseListPrice('home', r.model, Math.round(Number(r.list) || 0));
      tdList.innerHTML = makeListPriceInput(listPrice, 'home', r.model);
    }
    tr.appendChild(tdList);

    // 규격
    const tdSpec = document.createElement('td');
    tdSpec.className = 'spec-col pc-only';
    if (isSpecial) {
      tdSpec.textContent = '';
    } else {
      tdSpec.innerHTML = makeSpecInput(r.spec, 'home', r.model);
    }
    tr.appendChild(tdSpec);

    // 수량
    const tdQty=document.createElement('td');
    const state = getStockState_(r?.note);
    if (state.type === 'SOLD') {
      tdQty.textContent = '품절';
    } else if (state.type === 'FUTURE') {
      tdQty.innerHTML = `<span style="font-size:8pt">${escapeEstimateHtml(state.label)}</span>`;
    } else if (isSpecial) {
      tdQty.className = 'qty-static';
      tdQty.textContent = q;
      const hidden = document.createElement('input');
      hidden.type = 'hidden'; hidden.className = 'qty-input'; 
      hidden.setAttribute('data-m', r.model); hidden.value = q;
      tdQty.appendChild(hidden);
    } else {
      let isManual = false;
      const nm = String(r.name || '');
      if (/(판넬|패널|panel)/i.test(nm)) isManual = typeof HOME_MANUAL_PANEL !== 'undefined' && HOME_MANUAL_PANEL.has(r.model);
      else if (/리모컨|리모콘/i.test(nm)) isManual = typeof HOME_MANUAL_REMOTE !== 'undefined' && HOME_MANUAL_REMOTE.has(r.model);
      else if (/유연호스/i.test(nm)) isManual = typeof HOME_MANUAL_HOSE !== 'undefined' && HOME_MANUAL_HOSE.has(r.model);
      else if (/분\s*기\s*관|분기관/i.test(nm)) isManual = typeof HOME_MANUAL_BRANCH !== 'undefined' && HOME_MANUAL_BRANCH.has(r.model);
      else if (/발통|일자발/i.test(nm)) isManual = typeof HOME_MANUAL_FOOT !== 'undefined' && HOME_MANUAL_FOOT.has(r.model);
      else isManual = (q > 0);

      const colorStyle = isManual ? 'color:#2563eb; font-weight:bold;' : 'color:#374151; font-weight:normal;';
      tdQty.innerHTML = `<div class="qty-box"><input class="qty-input" data-m="${escapeEstimateAttr(r?.model||'')}" value="${escapeEstimateAttr((q !== 0 || isManual) ? q : '')}" onfocus="this.select()" inputmode="numeric" pattern="\\d*" placeholder="0" style="${colorStyle}"/></div>`;
    }
    tr.appendChild(tdQty);

    // 단가
    const tdUnit=document.createElement('td');
    tdUnit.className='price';
    if(isSpecial){
        const wrap = document.createElement('div');
        wrap.style.maxWidth='100px'; wrap.style.margin='0 auto';
        
        const inp = document.createElement('input');
        inp.type = 'text'; inp.className = 'price-input'; inp.inputMode = 'numeric';
            inp.value = formatSpecialPriceForDisplay(currentPrice, fmt);
        inp.placeholder = '0';
        inp.style.width = '100%'; inp.style.textAlign='right';
        inp.style.border='1px solid #d1d5db'; inp.style.borderRadius='4px'; inp.style.padding='4px';
        if(currentPrice) { inp.style.color = '#2563eb'; inp.style.fontWeight = 'bold'; }
        
        // 포커스 및 변경
        inp.addEventListener('focus', function(){ this.select(); });
        inp.addEventListener('change', (e) => handleFreightInput(e, isCut, homeCustomPrices, homeQty, r.model, recomputeHomeDerived));
        
        wrap.appendChild(inp);
        tdUnit.appendChild(wrap);
    } else {
        tdUnit.setAttribute('data-unit',r?.model||''); 
        tdUnit.innerHTML = makePriceInput(unit, 'home', r.model);
    }
    tr.appendChild(tdUnit);

    // 소계
    const tdSub=document.createElement('td');
    tdSub.className='sub pc-only';
    tdSub.setAttribute('data-sub',r?.model||'');
    tdSub.textContent=fmt(sub);
    tr.appendChild(tdSub);

    // 고정DC
    const tdFix = document.createElement('td');
    tdFix.className = 'pc-only';
    if(!isSpecial){
      let val = r['고정DC'] ?? r.fixedDC;
      if(typeof val === 'number' && val <= 1) val = (val*100);
      val = String(val || '').replace(/%/g, '');
      tdFix.innerHTML = `<div class="qty-box"><input class="qty-input fix-dc-inp" data-m="${escapeEstimateAttr(r.model||'')}" value="${escapeEstimateAttr(val)}" onfocus="this.select()" placeholder="%" style="font-size:13px; text-align:center;"/></div>`;
    }
    tr.appendChild(tdFix);

    // 변동DC
    const tdVar = document.createElement('td');
    tdVar.className = 'pc-only';
    if(!isSpecial){
      const checked = r.useK2 ? 'checked' : '';
      tdVar.innerHTML = `<input type="checkbox" class="var-dc-chk" data-m="${escapeEstimateAttr(r.model||'')}" ${checked} style="transform:scale(1.2); cursor:pointer;">`;
    }
    tr.appendChild(tdVar);

    // 용량
    const tdCapa = document.createElement('td');
    tdCapa.className = 'capa pc-only';
    tdCapa.style.textAlign = 'center';
    tdCapa.style.color = '#6b7280';
    tdCapa.style.fontSize = '13px';
    tdCapa.textContent = (r.capacity && Number(r.capacity) > 0) ? r.capacity : '-';
    tr.appendChild(tdCapa);

    body.appendChild(tr);
  });

  // DC 갱신
  const updateHomeRowPrice = (model, tr) => {
    let u = homeUnitPrice(model);
    const q = homeQty.get(model)||0;
    
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !homeCustomPrices.has(model)){
        priceInp.value = u.toLocaleString();
        priceInp.style.color = '#374151';
        priceInp.style.fontWeight = 'normal';
    } else if (homeCustomPrices.has(model)) {
        u = homeCustomPrices.get(model);
    }
    const subCell = tr.querySelector('.sub');
    if(subCell) subCell.textContent = fmt(u * q);
    syncHomeTotals();
  };

  // DC 리스너
  body.querySelectorAll('.fix-dc-inp').forEach(inp => {
    inp.addEventListener('change', e => updateHomeRowPrice(e.target.dataset.m, e.target.closest('tr')));
  });
  body.querySelectorAll('.var-dc-chk').forEach(chk => {
    chk.addEventListener('change', e => updateHomeRowPrice(e.target.dataset.m, e.target.closest('tr')));
  });

  // 수량 리스너
  body.querySelectorAll('.qty-input:not(.fix-dc-inp):not([type="hidden"])').forEach(inp=>{
    inp.addEventListener('change', e=>{
      const m = e.target.dataset.m;
      const raw = e.target.value.replace(/[^0-9-]/g, '');
      const r = homeRowByModel.get(m);
      const nm = String(r?.name || '');

      if (raw === '') {
        homeQty.set(m, 0);
        if (/(판넬|패널|panel)/i.test(nm)) HOME_MANUAL_PANEL.delete(m);
        else if (/리모컨|리모콘/i.test(nm)) HOME_MANUAL_REMOTE.delete(m);
        else if (/유연호스/i.test(nm)) HOME_MANUAL_HOSE.delete(m);
        else if (/분\s*기\s*관|분기관/i.test(nm)) HOME_MANUAL_BRANCH.delete(m);
        else if (/발통|일자발/i.test(nm)) HOME_MANUAL_FOOT.delete(m);
      } else {
        const v = parseInt(raw, 10);
        homeQty.set(m, v);
        if (/(판넬|패널|panel)/i.test(nm)) HOME_MANUAL_PANEL.add(m);
        else if (/리모컨|리모콘/i.test(nm)) HOME_MANUAL_REMOTE.add(m);
        else if (/유연호스/i.test(nm)) HOME_MANUAL_HOSE.add(m);
        else if (/분\s*기\s*관|분기관/i.test(nm)) HOME_MANUAL_BRANCH.add(m);
        else if (/발통|일자발/i.test(nm)) HOME_MANUAL_FOOT.add(m);
      }

      const tr = e.target.closest('tr');
      const priceInp = tr.querySelector('.price-input');
      const p = priceInp ? parseInt(priceInp.value.replace(/[^0-9]/g,'')||0, 10) : 0;
      const subCell = tr.querySelector('.sub');
      const q = homeQty.get(m) || 0;
      if(subCell) subCell.textContent = fmt(p * q);

      /* 계산 */
      if (isHomeCalcTriggerModel(m)) {
        if (typeof recomputeHomeDerived === 'function') recomputeHomeDerived(true);
      } else {
        syncHomeTotals();
        if (typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
      }
    });
  });

  syncHomeTotals();
  updateHomeRatio();
  refreshBranchOpenButton('home');

  const tfoot = document.querySelector('#wrapHome tfoot td[colspan]');
      if(tfoot) tfoot.colSpan = 11;
}

// 부품 (싱글)
function renderSingleSetParts(s, setQty) {
  const tbody = el('#singleBody');
  const anchor = tbody.querySelector(`tr[data-id="${CSS.escape(s.id)}"]`);

  let baseParts = (typeof SINGLE_PARTS !== 'undefined') ? SINGLE_PARTS.filter(p => p.setModel === s.model || p.refId === s.id || p.refModel === s.model) : [];
  
  // 단가
  const currentUnit = typeof getRealSinglePrice === 'function' ? getRealSinglePrice(s.id) : ((typeof singleCustomPrices !== 'undefined' && singleCustomPrices.has(s.id)) ? singleCustomPrices.get(s.id) : calcSetUnitPrice(s));

  // 배분
  let activeParts = (typeof explodeSetParts === 'function') ? explodeSetParts(s, 1, currentUnit) : [];
  let allPossibleParts = [...baseParts];

  if (typeof explodeSetParts === 'function') {
    const partMap = new Map();
    allPossibleParts.forEach(p => partMap.set((p.model || p.name || '').trim(), p));

    const pnlEl = document.getElementById('ss_panel');
    const remEl = document.getElementById('ss_remote');
    const matEl = document.getElementById('ss_mat');
    const p360El = document.getElementById('ss_p360');

    const backupPnl = pnlEl ? pnlEl.value : '';
    const backupRem = remEl ? remEl.value : '';
    const backupMat = matEl ? matEl.value : '';
    const backupP360 = p360El ? p360El.value : '';

    const panels = ['', '판넬제외', '블랙판넬', '승강판넬', '공청판넬'];
    const remotes = ['', '유선리모컨', '컬러유선리모컨'];

    if (matEl) matEl.value = '포함';

    panels.forEach(pan => {
      if (pnlEl) pnlEl.value = pan;
      remotes.forEach(rem => {
        if (remEl) remEl.value = rem;
        ['원형', '사각'].forEach(shape => {
          if (p360El) p360El.value = shape;
          const parts = explodeSetParts(s, 1, currentUnit);
          parts.forEach(p => {
            const pKey = (p.model || p.name || '').trim();
            if (!partMap.has(pKey)) {
              partMap.set(pKey, { ...p, defaultQty: p.qty });
            }
          });
        });
      });
    });

    if (pnlEl) pnlEl.value = backupPnl;
    if (remEl) remEl.value = backupRem;
    if (matEl) matEl.value = backupMat;
    if (p360El) p360El.value = backupP360;

    allPossibleParts = Array.from(partMap.values());
    allPossibleParts.sort((a, b) => {
      const getRank = (p) => {
        const k = (p.kind || p.name || '').toLowerCase();
        if (k.includes('실내기')) return 1;
        if (k.includes('실외기')) return 2;
        if (k.includes('판넬')) {
          if (k.includes('블랙')) return 4.3;
          if (k.includes('승강')) return 4.2;
          if (k.includes('공기청정') || k.includes('공청')) return 4.1;
          return 4.0;
        }
        if (k.includes('리모컨')) {
          if (k.includes('스탠드')) return 5.1;
          if (k.includes('벽걸이')) return 5.2;
          return 5.3;
        }
        if (k.includes('자재')) return 6;
        if (k.includes('벽걸이')) return 3;
        return 7;
      };
      const rankA = getRank(a);
      const rankB = getRank(b);
      if (rankA !== rankB) return rankA - rankB;
      return (a.model || a.name || '').localeCompare(b.model || b.name || '');
    });
  }

  let allParts = allPossibleParts.length > 0 ? allPossibleParts : activeParts.map(p => ({ ...p, defaultQty: p.qty }));
  if (!allParts.length) return;

  tbody.querySelectorAll(`tr[data-part-of="${CSS.escape(s.id)}"]`).forEach(e => e.remove());

  allParts.slice().reverse().forEach(p => {
    const pKey = (p.model || p.name || '').trim();
    const activeMatch = activeParts.find(ap => (ap.model || ap.name || '').trim() === pKey);
    const unit = activeMatch ? activeMatch.price : (partUnitPrice(p) || p.price || 0);
    const defQ = parseInt(p.defaultQty || p.qty || 1, 10);
    const effQ = activeMatch ? (parseInt(setQty, 10) || 0) * (parseInt(activeMatch.qty, 10) || defQ) : 0;

    const tr = document.createElement('tr');
    tr.classList.add('set-part-single');
    tr.setAttribute('data-part-of', s.id);
    tr.setAttribute('data-m', pKey);
    tr.style.display = 'none';
    tr.style.backgroundColor = '#f8fafc';

    // 구조
    const tdD = document.createElement('td');
    tdD.className = 'colD pc-only';
    tdD.colSpan = 2;
    tdD.innerHTML = `<span style="color:#6b7280;">└ [구성]</span> ${escapeEstimateHtml(p.name||p.partName||p.model)}`;
    tr.appendChild(tdD);

    // 모바일
    const tdD_MO = document.createElement('td');
    tdD_MO.className = 'colD mobile-only';
    tdD_MO.colSpan = 2;
    tdD_MO.innerHTML = `└ ${escapeEstimateHtml(p.name||p.partName||p.model)}`;
    tr.appendChild(tdD_MO);

    // 모델
    const tdModel = document.createElement('td');
    tdModel.className = 'model';
    tdModel.textContent = p.model;
    tr.appendChild(tdModel);

    // 출고가
    const tdList = document.createElement('td');
    tdList.className = 'list-price pc-only';
    const baseP = (typeof SINGLE_PARTS !== 'undefined') ? SINGLE_PARTS.find(sp => sp.model === p.model) : null;
    let listP = Number(p.list || p.listPrice || p['출고가'] || p.msrp || baseP?.['출고가'] || baseP?.list || 0);
    
    // 보정
    listP = getBaseListPrice('single', p.model, listP);
    
    tdList.innerHTML = `
      <div style="width:100px; margin:0 auto; position:relative;">
        <input type="text" class="list-price-input" value="${listP > 0 ? fmt(listP) : ''}" 
          onfocus="this.select()"
          style="width:100%; text-align:right; border:1px solid #d1d5db; border-radius:4px; background:#fff; padding:4px 8px; outline:none; font-size:14px; color:#374151;">
      </div><span class="val-for-text" style="position:absolute; width:0; height:0; overflow:hidden;">${listP}</span>`;
    tr.appendChild(tdList);

    // 규격
    const tdSpec = document.createElement('td');
    tdSpec.className = 'spec-col pc-only';
    tdSpec.innerHTML = makeSpecInput(p.spec, 'single-part', p.model + '|' + s.id);
    tr.appendChild(tdSpec);

    // 수량
    const pKeyStr = `${s.id}|${p.model}`;
    const isManual = typeof singleCustomPartQtys !== 'undefined' && singleCustomPartQtys.has(pKeyStr);
    const displayQ = isManual ? singleCustomPartQtys.get(pKeyStr) : effQ;
    const colorStyle = isManual ? 'color:#2563eb; font-weight:bold;' : 'color:#374151; font-weight:normal;';
    
    const tdQty = document.createElement('td');
    tdQty.className = 'qty';
    tdQty.innerHTML = `
      <div class="qty-box">
        <input type="text" class="qty-input part-qty-single" data-set="${escapeEstimateAttr(s.id)}" data-part="${escapeEstimateAttr(p.model)}" data-def="${escapeEstimateAttr(defQ)}" value="${escapeEstimateAttr(displayQ || '')}" onfocus="this.select()" inputmode="numeric" pattern="\\d*" placeholder="0" style="${colorStyle}">
      </div><span class="val-for-text" style="position:absolute; width:0; height:0; overflow:hidden;">${displayQ || 0}</span>`;
    tr.appendChild(tdQty);

    // 단가
    const tdPrice = document.createElement('td');
    tdPrice.className = 'price';
    tdPrice.setAttribute('data-sunit', `${p.model}|${s.id}`);
    tdPrice.innerHTML = `
      <div style="width:100px; margin:0 auto; position:relative;">
        <input type="text" class="price-input part-price-single" data-set="${escapeEstimateAttr(s.id)}" value="${escapeEstimateAttr(unit > 0 ? fmt(unit) : '')}" 
          onfocus="this.select()" placeholder="0"
          style="width:100%; text-align:right; border:1px solid #d1d5db; border-radius:4px; background:#fff; padding:4px 8px; outline:none; font-size:14px; color:#374151;">
      </div><span class="val-for-text" style="position:absolute; width:0; height:0; overflow:hidden;">${unit || 0}</span>`;
    tr.appendChild(tdPrice);

    // 소계
    const tdSub = document.createElement('td');
    tdSub.className = 'sub pc-only';
    tdSub.setAttribute('data-ssub', `${p.model}|${s.id}`);
    tdSub.innerHTML = `${fmt(unit*effQ)}<span class="val-for-text" style="position:absolute; width:0; height:0; overflow:hidden;">${unit*effQ}</span>`;
    tr.appendChild(tdSub);

    // 버튼
    const tdComp = document.createElement('td');
    tdComp.className = 'comp-btn pc-only';
    tr.appendChild(tdComp);

    if (anchor && anchor.nextSibling) tbody.insertBefore(tr, anchor.nextSibling);
    else tbody.appendChild(tr);
  });
}

function renderSingle(){
  const body = document.getElementById('singleBody');
  if(!body) return;
  body.innerHTML='';

  const isExpandChecked = document.getElementById('ss_expand')?.checked || false;

  // 필터
  let rows = SINGLE_SETS.filter(s=>{
    const cls = classifySingleSetFixed(s);
    const size = (s?.sizeText && String(s.sizeText).trim()) || (s?.size||'');
    if(cls.catL==='냉난방 스탠드' && cls.catM==='프레스티지' && String(size).replace(/[^\d]/g,'')==='13') return false;

    const isExpModel = isExpansionModel(s);
    if (isExpModel && !isExpandChecked) return false;

    return true;
  }).map(s=>{
    const cls = classifySingleSetFixed(s);
    return {s, L:unifyCatL_(cls.catL)||'', M:cls.catM||''};
  });

  rows = applySingleFilter(rows);

  // 헤더
  const thead = document.querySelector('#wrapSingle thead tr');
  if(thead) {
    thead.innerHTML = `
      <th class="colL pc-only" colspan="4">품목명</th>
      <th class="colL mobile-only">품목명</th>
      <th class="model">모델명</th>
      <th class="list-price pc-only">출고가</th>
      <th class="spec-col pc-only">규격</th>
      <th style="width:60px;">수량</th>
      <th class="h-price" style="width:100px;">납품가</th>
      <th class="sub pc-only" style="width:100px;">소계</th>
      <th class="comp-btn pc-only" style="width:90px;">구성</th>
    `;
  }

  // 병합
  for(let i=0;i<rows.length;){
    const L=rows[i].L; let j=i,anyM=false;
    while(j<rows.length&&rows[j].L===L){ if(rows[j].M) anyM=true; j++; }
    rows[i].rowSpanL=j-i;
    for(let k=i;k<j;k++){ rows[k].isFirstL=(k===i); rows[k].lOnlyL=!anyM; rows[k].lIndex=k-i; }
    i=j;
  }
  for(let i=0;i<rows.length;){
    const L=rows[i].L,M=rows[i].M; let j=i;
    while(j<rows.length&&rows[j].L===L&&rows[j].M===M) j++;
    rows[i].rowSpanM=j-i;
    for(let k=i;k<j;k++){ rows[k].mIndex=k-i; }
    i=j;
  }

  let prevKey='';
  rows.forEach(row=>{
    const s = row.s;
    const qty = singleQty.get(s.id)||0;
    
    const isSpecial = s.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL;
    const isCut = s.kind === 'CUT';

    const autoUnit = calcSetUnitPrice(s); 
    const currentPrice = (typeof singleCustomPrices !== 'undefined' && singleCustomPrices.has(s.id)) 
                          ? singleCustomPrices.get(s.id) : autoUnit;
    const sub = currentPrice * qty;

    const key=row.L+'|'+(row.M||'__');
    const groupTop=(key!==prevKey); prevKey=key;
    const rawName = s?.name || singleDispNameTrimmed(s,{catL:row.L,catM:row.M});
    const szVal = (s?.sizeText && String(s.sizeText).trim()) || (s?.size||'');
    const szNum = String(szVal).replace(/[^0-9.+]/g,'');
    const dispName = szNum ? `${rawName} ${szNum}평형` : rawName;
    
    const tr=document.createElement('tr');
    tr.classList.add('tint');
    const idx=(row.M?row.mIndex:row.lIndex)||0;
    const a=Math.min(0.28,0.12+0.03*idx);
    tr.style.setProperty('--lRGB',rgbForL(row.L));
    tr.style.setProperty('--mRGB',row.M?rgbForMid(row.M,row.L):rgbForL(row.L));
    tr.style.setProperty('--mA',a.toFixed(2));
    if(groupTop) tr.classList.add('group-top');
    tr.dataset.id = s.id;

    if(row.isFirstL && row.rowSpanL){
      const tdL=document.createElement('td'); tdL.className='colL pc-only'; tdL.textContent=row.L; tdL.rowSpan=row.rowSpanL;
      if(row.lOnlyL) tdL.colSpan=2; tr.appendChild(tdL);
    }
    if(!row.lOnlyL && row.rowSpanM && row.mIndex===0){
      const tdM=document.createElement('td'); tdM.className='colM pc-only'; tdM.textContent=row.M||''; tdM.rowSpan=row.rowSpanM; tr.appendChild(tdM);
    }

    const isSet = !isSpecial && String(s?.unit||'').toUpperCase()==='SET';
    const baseItem = {...s,catL:row.L,catM:row.M,isSet:isSet};

    const tdD_PC=document.createElement('td'); tdD_PC.className='colD spec-click pc-only'; tdD_PC.colSpan=2;
    tdD_PC.textContent=dispName; tdD_PC.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'single'));
    tr.appendChild(tdD_PC);

    const tdD_MO=document.createElement('td'); tdD_MO.className='colD spec-click mobile-only'; tdD_MO.colSpan=1;
    tdD_MO.textContent=dispName; tdD_MO.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'single'));
    tr.appendChild(tdD_MO);

    const tdModel=document.createElement('td'); tdModel.className='model spec-click';
    tdModel.textContent=s?.model||''; tdModel.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'single'));
    tr.appendChild(tdModel);

    // 출고가
    const tdList = document.createElement('td');
    tdList.className = 'list-price pc-only';
    let listP = Number(s.list || s.listPrice || 0);
    listP = getBaseListPrice('single', s.model, listP);
    tdList.innerHTML = isSpecial ? '' : makeListPriceInput(listP, 'single', s.id);
    tr.appendChild(tdList);

    // 규격
    const tdSpec = document.createElement('td');
    tdSpec.className = 'spec-col pc-only';
    if (isSpecial) {
        tdSpec.textContent = '';
    } else {
        tdSpec.textContent = '-';
    }
    tr.appendChild(tdSpec);

    // 수량
    const tdQty = document.createElement('td');
    const state = getStockState_(s?.note);
    if (state.type === 'SOLD') {
       tdQty.className = 'qty'; tdQty.textContent = '품절';
    } else if (state.type === 'FUTURE') {
       tdQty.className = 'qty'; tdQty.innerHTML = `<span style="font-size:8pt; white-space:nowrap;">${escapeEstimateHtml(state.label)}</span>`;
    } else if (isSpecial) {
       tdQty.className = 'qty-static';
       tdQty.textContent = qty;
       const hidden = document.createElement('input');
       hidden.type = 'hidden'; hidden.className = 'qty-input';
       hidden.setAttribute('data-sid', s.id); hidden.value = qty;
       tdQty.appendChild(hidden);
    } else {
      tdQty.className = 'qty';
      const isManual = (qty !== 0);
      const colorStyle = isManual ? 'color:#2563eb; font-weight:bold;' : 'color:#374151; font-weight:normal;';
      tdQty.innerHTML = `<div class="qty-box"><input class="qty-input" data-sid="${escapeEstimateAttr(s.id)}" value="${escapeEstimateAttr((qty !== 0) ? qty : '')}" onfocus="this.select()" inputmode="numeric" pattern="\\d*" placeholder="0" style="${colorStyle}"/></div>`;
    }
    tr.appendChild(tdQty);

    // 단가
    const tdU = document.createElement('td');
    tdU.className = 'price';
    if(isSpecial){
       const wrap = document.createElement('div');
       wrap.style.maxWidth='100px'; wrap.style.margin='0 auto';

       const inp = document.createElement('input');
       inp.type = 'text'; inp.className = 'price-input'; inp.inputMode = 'numeric';
       inp.value = formatSpecialPriceForDisplay(currentPrice, fmt);
       inp.placeholder = '0';
       inp.style.width = '100%'; inp.style.textAlign='right'; 
       inp.style.border='1px solid #d1d5db'; inp.style.borderRadius='4px'; inp.style.padding='4px';
       if(currentPrice) { inp.style.color = '#2563eb'; inp.style.fontWeight = 'bold'; }
       
       inp.addEventListener('focus', function(){ this.select(); });
       inp.addEventListener('change', (e) => handleFreightInput(e, isCut, singleCustomPrices, singleQty, s.id, recomputeSingleExtras));
       wrap.appendChild(inp); tdU.appendChild(wrap);
    } else {
       tdU.setAttribute('data-ssu', s.id);
       tdU.innerHTML = makePriceInput(autoUnit, 'single', s.id);
    }
    tr.appendChild(tdU);

    // 소계
    const tdS2 = document.createElement('td');
    tdS2.className = 'sub pc-only';
    tdS2.setAttribute('data-ss',s.id);
    tdS2.textContent = fmt(sub);
    tr.appendChild(tdS2);

    // 버튼
    const tdComp = document.createElement('td');
    tdComp.className = 'comp-btn pc-only';
    
    // 부자재, 실외기 받침, 발통세트는 구성품 보기 버튼에서 제외
    const isAccessoryOrBase = row.L === '부자재' || row.L === '실외기 받침' || row.L === '실외기 받침대' || /발통세트|SI-AL700a/.test(s.name || s.model);

    if(s.isSet !== false && !isSpecial && !isAccessoryOrBase) {
      tdComp.innerHTML = `<button type="button" class="btn-mini toggle-comp-single" data-id="${escapeEstimateAttr(s.id)}">보기</button>`;
    } else {
      tdComp.textContent = '-';
    }
    tr.appendChild(tdComp);

    body.appendChild(tr);

    if(s.isSet !== false && !isSpecial) {
        renderSingleSetParts(s, qty);
    }
  });

  // 변경
  body.querySelectorAll('.qty-input:not(.part-qty-single)').forEach(inp=>{
    inp.addEventListener('change', e=>{
      const id = e.target.dataset.sid;
      const raw = e.target.value.replace(/[^0-9-]/g, '');
      let v;
      if (raw === '') {
        v = 0;
        e.target.value = '';
        e.target.style.color = '#374151';
        e.target.style.fontWeight = 'normal';
      } else {
        v = parseInt(raw, 10);
        e.target.value = String(v);
        e.target.style.color = '#2563eb';
        e.target.style.fontWeight = 'bold';
      }
      
      const sObj = SINGLE_SETS.find(x => String(x.id) === String(id));
      const realId = (sObj && sObj.id !== undefined) ? sObj.id : id;
      singleQty.set(realId, v);
      
      const tr = e.target.closest('tr');
      const priceInp = tr.querySelector('.price-input');
      const p = parseInt(priceInp ? priceInp.value.replace(/[^0-9]/g,'') : '0', 10);
      const sCell = tr.querySelector('.sub');
      if(sCell) sCell.textContent = fmt(p * v);

      let activeModels = null;
      if (sObj && typeof explodeSetParts === 'function') {
          const activeParts = explodeSetParts(sObj, 1, 0);
          activeModels = new Set(activeParts.map(ap => (ap.model || ap.name || '').trim()));
      }

      const parts = document.querySelectorAll(`#singleBody tr[data-part-of="${CSS.escape(id)}"]`);
      parts.forEach(ptr => {
        const pModel = ptr.getAttribute('data-m');
        const pKeyStr = `${id}|${pModel}`;
        const isManual = typeof singleCustomPartQtys !== 'undefined' && singleCustomPartQtys.has(pKeyStr);

        const defQ = parseInt(ptr.querySelector('.part-qty-single').dataset.def, 10) || 1;
        let effQ = v * defQ;
        
        if (activeModels) {
          if (!activeModels.has(pModel)) {
            effQ = 0;
          }
        }

        if (isManual) {
          effQ = singleCustomPartQtys.get(pKeyStr);
        }

        const qtyInp = ptr.querySelector('.part-qty-single');
        if (qtyInp && !isManual) {
          qtyInp.value = effQ || '';
          qtyInp.setAttribute('value', effQ || '');
          const span = ptr.querySelector('.val-for-text');
          if (span) span.textContent = effQ || 0;
        }

        const pNode = ptr.querySelector('.price-input');
        const pUnit = parseInt(pNode ? pNode.value.replace(/[^0-9]/g, '') : '0', 10);
        const psCell = ptr.querySelector('.sub');
          if (psCell) {
              psCell.childNodes[0].nodeValue = typeof fmt === 'function' ? fmt(pUnit * effQ) : (pUnit * effQ).toLocaleString();
              const subSpan = psCell.querySelector('.val-for-text');
              if (subSpan) subSpan.textContent = pUnit * effQ;
          }
      });

      if(typeof isSingleCalcTriggerId === 'function' && isSingleCalcTriggerId(realId)){
        if(typeof recomputeSingleBaseFoot === 'function') recomputeSingleBaseFoot();
        if(typeof recomputeSingleExtras === 'function') recomputeSingleExtras();
      }
      if(typeof syncSingleTotals === 'function') syncSingleTotals();
      if(typeof updateInlineTotals === 'function') updateInlineTotals();
      if(typeof refreshSelectedBadge === 'function') refreshSelectedBadge();
    });
  });

  el('#singleTotal').textContent=fmt(sumSingles());
  updateInlineTotals();
  refreshBranchOpenButton('single');
}

// 목록
function buildSingleSetCompositionHtml_(s){
  try{
    if(!s) return '';

    const parts = explodeSetParts(s, 1, null) || [];

    if(!parts.length) return '';

    const groups = {
      indoor: new Set(),
      outdoor: new Set(),
      panel: new Set(),
      remote: new Set(),
      material: new Set(),
      wall: new Set()
    };

    // 분류
    parts.forEach(p=>{
      const kind = String(p?.kind || '');
      const name = String(p?.name || '');
      const label = String(p?.model || p?.name || '').trim();
      if(!label) return;

      // 구분
      if(kind.includes('실내기')) groups.indoor.add(label);
      else if(kind.includes('실외기')) groups.outdoor.add(label);
      else if(/리모컨|리모콘/.test(kind)) groups.remote.add(label);
      else if(/판넬|패널/.test(kind)) groups.panel.add(label);
      else if(kind.includes('자재')) groups.material.add(label);
      else if(kind.includes('벽걸이')) groups.wall.add(label);
      // 품명
      else {
        if(/실내기/.test(name)) groups.indoor.add(label);
        else if(/실외기/.test(name)) groups.outdoor.add(label);
        else if(/리모컨|리모콘/.test(name)) groups.remote.add(label);
        else if(/판넬|패널|panel/i.test(name)) groups.panel.add(label);
        else if(/벽걸이/.test(name)) groups.wall.add(label);
        else if(/자재|호스|배관|배선|케이블|동파이프|브라켓|받침대|발통/.test(name)) groups.material.add(label);
      }
    });

    const order = [
      { key:'indoor',   title:'[실내기]' },
      { key:'outdoor',  title:'[실외기]' },
      { key:'wall',     title:'[벽걸이]' },
      { key:'panel',    title:'[판넬]' },
      { key:'remote',   title:'[리모컨]' },
      { key:'material', title:'[자재]' }
    ];

    let any = false;
    let html = '<div style="margin-bottom:12px;text-align:left;font-size:13px;line-height:1.5">';

    order.forEach(g=>{
      const list = Array.from(groups[g.key] || []);
      if(!list.length) return;
      any = true;
      html += `<div><span style="font-weight:700">${g.title}</span> ${list.join(', ')}</div>`;
    });

    html += '</div>';
    return any ? html : '';
  }catch(e){
    return '';
  }
}

function normalizeCommCategory(r){
  const L = String(r.catL || '');
  const M = fixCommMidCategory(r);
  const S = String(r.catS || '');
  return { L, M, S };
}

// 상업멀티 중분류 보정
function fixCommMidCategory(r){
  const name = String(r?.name||'') + ' ' + String(r?.disp||'');
  if (/유선\s*리모[컨콘].*모듈/i.test(name)) return '키트';
  if (/분배\s*헤더/i.test(name)) return '분배헤더';
  return String(r?.catM||'');
}

/* 상업멀티 옵션은 지배 계열의 잠금만 해제한다. 펌프는 직접 지배하는 옵션이 없으므로
   모든 상업 옵션 변경에서 잠금을 보존한다(홈멀티 onHomeOptionChange와 대칭). */
function onCommOptionChange(controlId) {
  const lockSet = {
    comm_panel: COMM_MANUAL_PANEL,
    comm_p360: COMM_MANUAL_PANEL,
    comm_hose_i: COMM_MANUAL_HOSE,
    comm_ex_hose: COMM_MANUAL_HOSE,
    comm_remote: COMM_MANUAL_REMOTE,
    comm_ex_base: COMM_MANUAL_BASE,
  }[controlId];
  if (lockSet) lockSet.clear();
  recomputeCommDerived();
  syncCommTotals();
  if (typeof updateInlineTotals === 'function') updateInlineTotals();
}

/* 상업멀티옵션 */
function renderCommOptions() {
  const box = el('#commOpts'); 
  if(!box) return;

  if(box.querySelector('#comm_rate')) return;

  box.style.display = 'flex';
  box.style.flexWrap = 'wrap';
  box.style.gap = '8px';
  box.style.alignItems = 'center';
  box.innerHTML = '';
  
  box.appendChild(numInp('할인율(%)', 'comm_rate', (window.DISCOUNT_RATE_COMM ? Math.round(window.DISCOUNT_RATE_COMM * 100) : 45), 1));
  box.appendChild(sel('판넬변경',['판넬제외','기본판넬','블랙판넬','승강판넬','공청판넬','동작감지'],'기본판넬','comm_panel'));
  box.appendChild(sel('360판넬',['원형','사각'],'원형','comm_p360'));
  box.appendChild(sel('리모컨',['제외','무선','유선','컬러유선'],'무선','comm_remote'));
  
  box.appendChild(chk('유연호스 I형', false, 'comm_hose_i'));
  box.appendChild(chk('유연호스 제외', false, 'comm_ex_hose'));
  box.appendChild(chk('받침대 제외', false, 'comm_ex_base'));
  box.appendChild(chk('실외기확장', false, 'comm_ext_out'));
  box.appendChild(roundSel('comm'));
  box.appendChild(chk('인상 전 단가', !!PRICE_DEFAULT_VARIANT.commercialMulti, 'chkCommInc'));

  box.querySelectorAll('input,select').forEach(c=>{
    if(c.id.includes('commFilter')) return;
    c.addEventListener('change', (e)=>{
      onCommOptionChange(e.target.id);

      if (c.id === 'comm_ext_out') {
        if (!c.checked) {
          COMMULTI.forEach(r => {
             const txt = `${r?.name||''} ${r?.disp||''}`;
             if (/(가스히트펌프|프레스티지|동시냉난방|공장전원)/i.test(txt) && !/KIT|키트|모듈/i.test(txt)) {
                commQty.set(r.model, 0);
             }
          });
        }
        updateCommFilterOptions();
      }

      if (e.target.id === 'chkCommInc') {
        if(typeof renderComm === 'function') renderComm();
      } else {
        recomputeCommDerived();
        renderComm(true);
      }
      
      syncCommTotals();
      if(typeof updateInlineTotals === 'function') updateInlineTotals();
    });
  });
}

// 상업멀티 필터용 기본 rows
function getCommFilterRows_(){
  if (!Array.isArray(COMMULTI)) return [];

  const KIT_WHITELIST = new Set([
    'ECO 리뉴얼 필터',
    'MCU KIT 6실형(HR, WATER HR용)',
    'MCU KIT 4실형(HR, WATER HR용)',
    'MCU KIT 2실형(HR, WATER HR용)',
    'FCU KIT',
    '인체감시센서 KIT(4way)',
    '인체감시센서 KIT(360)',
    'DMS(PC제어)',
    '멀티Wifi KIT',
    '호환중계기(EHP용)',
    '호환중계기(ERV용)'
  ]);

  return (COMMULTI || [])
    .filter(r => {
      const nm  = String(r?.name || '');
      const txt = nm + ' ' + String(r?.disp || '');

      const isExtTarget = /(GHP|프레스티지|동시냉난방|공장전원)/i.test(txt) && ![...KIT_WHITELIST].some(w => txt.includes(w));
      if (isExtTarget && !el('#comm_ext_out')?.checked) {
        return false;
      }
      return true;
    })
    .map((r, idx) => {
      let { L, M, S } = normalizeCommCategory(r);
      const fullName = `${r?.name || ''} ${r?.disp || ''}`;

      const isExtTarget = /(가스히트펌프|프레스티지|동시냉난방|공장전원)/i.test(fullName) && ![...KIT_WHITELIST].some(w=>fullName.includes(w));
      if (isExtTarget) {
         L = '실외기';
         if (/가스히트펌프/i.test(fullName)) M = '가스히트펌프';
         else if (/프레스티지/i.test(fullName)) M = '프레스티지';
         else if (/동시냉난방/i.test(fullName)) M = '동시냉난방';
         else if (/공장전원/i.test(fullName)) M = '공장전원';
      } else {
         if (/판넬|패널|panel|데코\s*커버|데코커버/i.test(fullName)) {
           L = '판넬';
           if (/1\s*-?\s*Way|1WAY/i.test(fullName)) M = '1-Way';
           else if (/2\s*Way|2WAY/i.test(fullName)) M = '2-Way';
           else if (/4\s*-?\s*Way|4WAY/i.test(fullName)) M = '4-Way';
           else if (/360\s*CST|360CST/i.test(fullName)) M = '360';
         }
         if (/유선\s*리모[컨콘].*모듈/i.test(fullName)) { M = '키트'; }
         if (/분배\s*헤더/i.test(fullName)) { M = '분배헤더'; }
      }

      return { r, L, M, S, idx };
    });
}

/* 상업렌더 */
function renderComm(){
  const body = document.getElementById('commBody');
  if(!body) return;
  body.innerHTML = '';

  const KIT_WHITELIST = new Set([
    'ECO 리뉴얼 필터', 'MCU KIT 6실형(HR, WATER HR용)', 'MCU KIT 4실형(HR, WATER HR용)', 'MCU KIT 2실형(HR, WATER HR용)',
    'FCU KIT', '인체감시센서 KIT(4way)', '인체감시센서 KIT(360)', 'DMS(PC제어)', '멀티Wifi KIT', '호환중계기(EHP용)',
    '호환중계기(ERV용)', '시운전모듈(HASS CONVERTER/모바일용)', '시운전모듈(S-NET CONVERTER/노트북용)',
    '터치중앙제어기(ON/OFF/온도조절)', '16실중앙제어기(ON/OFF)', 'SIM 중계기', '전력 분배기', '외부접점중계기', 'SPI KIT(1WAY용/중.소형)'
  ]);

  let rows = (COMMULTI || []).filter(r=>{
    const nm = r?.name || '';
    const dp = r?.disp || '';
    const txt = `${nm} ${dp}`;
    const isExtTarget = /(가스히트펌프|프레스티지|동시냉난방|공장전원)/i.test(txt) && ![...KIT_WHITELIST].some(w=>txt.includes(w));
    if (isExtTarget && !el('#comm_ext_out')?.checked) return false;
    return true;
  }).map((r, idx) => {
    let { L, M, S } = normalizeCommCategory(r);
    const txt = `${r?.name||''} ${r?.disp||''}`;
    let sortScore = idx;

    const isExtTarget = /(가스히트펌프|프레스티지|동시냉난방|공장전원)/i.test(txt) && ![...KIT_WHITELIST].some(w=>txt.includes(w));
    if (isExtTarget) {
      L = '실외기';
      if (/가스히트펌프/i.test(txt)) M = '가스히트펌프';
      else if (/프레스티지/i.test(txt)) M = '프레스티지';
      else if (/동시냉난방/i.test(txt)) M = '동시냉난방';
      else if (/공장전원/i.test(txt)) M = '공장전원';
    } else {
      if (/판넬|데코커버/i.test(txt)) {
        L = '판넬';
        const t = txt.toUpperCase();
        if (/1\W*WAY/.test(t)) M = '1Way';
        else if (/2\W*WAY/.test(t)) M = '2Way';
        else if (/4\W*WAY|4WAY/.test(t)) M = '4Way';
        else if (/360/.test(t)) M = '360';
      }
      if (/분배\s*헤더/i.test(txt)) { L='부자재'; M='분배헤더'; }
      else if (/분기관/i.test(txt)) { L='부자재'; M='분기관'; }
      else if (/드레인펌프/i.test(txt)) { L='부자재'; M='드레인펌프'; }
      else if (/리모컨/i.test(txt)) { L='부자재'; M='리모컨'; }
      else if (/유연호스/i.test(txt)) { L='부자재'; M='유연호스'; }
      else if (/S2\s*방진가대\s*소|S2\s*방진가대\s*중|S2\s*방진가대\s*대|실외기\s*일자발|원형발통\s*세트|GHP\s*방진가대/i.test(txt)) { L='부자재'; M='받침대'; }
      else if ([...KIT_WHITELIST].some(w=>txt.includes(w))) { L='부자재'; M='키트'; }
    }

    const isEcoOutdoor = (L === '실외기') && /\bECO\b/i.test(M || '');
    if (L !== '실내기' && !isEcoOutdoor && !isExtTarget) S = '';
    return { r, L, M, S, _idx: sortScore };
  });

  rows = applyCommFilter(rows);
  rows.sort((a,b)=>a._idx-b._idx);

  // 헤더
  const thead = document.querySelector('#wrapComm thead tr');
  if(thead) {
    thead.innerHTML = `
      <th class="colL pc-only" colspan="4">품목명</th>
      <th class="colL mobile-only">품목명</th>
      <th class="model">모델명</th>
      <th class="list-price pc-only">출고가</th>
      <th class="spec-col pc-only">규격</th>
      <th style="width:60px;">수량</th>
      <th class="h-price" style="width:100px;">납품가</th>
      <th class="sub pc-only" style="width:100px;">소계</th>
      <th class="pc-only" style="width:60px;">고정DC</th>
      <th class="pc-only" style="width:60px;">변동DC</th>
      <th class="capa pc-only" style="width:60px;">용량</th>
      <th class="comp-btn pc-only" style="width:90px;">구성</th> `;
  }

  for (let i=0;i<rows.length;){ const L = rows[i].L; let j=i, anyM=false; while (j<rows.length && rows[j].L===L){ if (rows[j].M) anyM=true; j++; } for (let k=i;k<j;k++){ rows[k].isFirstL=(k===i); rows[k].rowSpanL=j-i; rows[k].lOnlyL=!anyM; rows[k].lIndex=k-i;} i=j; }
  for (let i=0;i<rows.length;){ const L=rows[i].L, M=rows[i].M; let j=i, hasS=false; while (j<rows.length && rows[j].L===L && rows[j].M===M){ if (rows[j].S) hasS=true; j++; } for (let k=i;k<j;k++){ rows[k].mIndex=k-i; rows[k].rowSpanM=j-i; rows[k].mHasS=hasS; } i=j; }
  for (let i=0;i<rows.length;){ const L=rows[i].L, M=rows[i].M, S=rows[i].S; let j=i; while (j<rows.length && rows[j].L===L && rows[j].M===M && rows[j].S===S) j++; rows[i].rowSpanS=j-i; i=j; }

  let prevKey = '';
  
  rows.forEach(row=>{
    const r = row.r;
    const q = commQty.get(r.model) || 0;
    
    const isSpecial = r.source === SPECIAL_ROW_SOURCE.CATALOG_SPECIAL;
    const isCut = r.kind === 'CUT';

    const unitPrice = commUnitPrice(r.model);
    const currentPrice = (typeof commCustomPrices !== 'undefined' && commCustomPrices.has(r.model)) 
                          ? commCustomPrices.get(r.model) : unitPrice;
    const sub = currentPrice * q;

    const key = row.L+'|'+row.M+'|'+row.S;
    const groupTop = (key !== prevKey); prevKey = key;

    const tr = document.createElement('tr');
    tr.classList.add('tint');
    tr.style.setProperty('--lRGB', rgbForL(row.L));
    tr.style.setProperty('--mRGB', rgbForMid(row.M, row.L));
    tr.style.setProperty('--mA', (Math.min(0.28, 0.12 + 0.03 * (row.mIndex || 0))).toFixed(2));
    if (groupTop) tr.classList.add('group-top');
    tr.setAttribute('data-m', r.model || '');

    if (row.isFirstL && row.rowSpanL){ const tdL = document.createElement('td'); tdL.className = 'colL pc-only'; tdL.textContent = row.L || ''; tdL.rowSpan = row.rowSpanL; if (row.lOnlyL) tdL.colSpan = 3; tr.appendChild(tdL); }
    if (!row.lOnlyL){ if (row.rowSpanM && row.mIndex===0){ const tdM = document.createElement('td'); tdM.className = 'colM pc-only'; tdM.textContent = row.M || ''; tdM.rowSpan = row.rowSpanM; if (!row.mHasS) tdM.colSpan = 2; tr.appendChild(tdM); } if (row.mHasS && row.rowSpanS){ const tdS = document.createElement('td'); tdS.className = 'colS pc-only'; tdS.textContent = row.S || ''; tdS.rowSpan = row.rowSpanS; tr.appendChild(tdS); } }

    const disp = buildDisplayNameComm(r, row);
    const rawName = rawNameOf(r);
    const baseItem = {...r, catL:row.L, catM:row.M, catS:row.S};

    const tdD_PC = document.createElement('td'); tdD_PC.className = 'colD spec-click pc-only'; tdD_PC.textContent = disp; tdD_PC.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'comm')); tr.appendChild(tdD_PC);
    const tdD_MO = document.createElement('td');
    tdD_MO.className = 'colD spec-click mobile-only';
    tdD_MO.textContent = rawName;
    tdD_MO.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'comm'));
    tr.appendChild(tdD_MO);

    // 모델
    const tdModel = document.createElement('td');
    tdModel.className='model spec-click';
    tdModel.textContent=r?.model||'';
    tdModel.addEventListener('dblclick',()=>openSpecModalByItem(baseItem,'comm'));
    tr.appendChild(tdModel);

    // 출고가
    const tdList = document.createElement('td');
    tdList.className = 'list-price pc-only';
    if(isSpecial) {
      tdList.textContent = '';
    } else {
      const listPrice = getBaseListPrice('comm', r.model, Math.round(Number(r.list) || 0));
      tdList.innerHTML = makeListPriceInput(listPrice, 'comm', r.model);
    }
    tr.appendChild(tdList);

    // 규격
    const tdSpec = document.createElement('td');
    tdSpec.className = 'spec-col pc-only';
    const isSet = String(r.unit || '').toUpperCase() === 'SET';
    
    if (isSpecial) {
      tdSpec.textContent = '';
    } else if (isSet) {
      tdSpec.textContent = '-';
    } else {
      let specVal = String(r.spec || '').trim();
      if (!specVal) {
          const p = COMM_PARTS.find(x => x.model === r.model);
          if (p) specVal = String(p.spec || '').trim();
      }
      tdSpec.innerHTML = typeof makeSpecInput === 'function' ? makeSpecInput(specVal, 'comm', r.model) : '';
    }
    tr.appendChild(tdSpec);

    // 수량
    const tdQty = document.createElement('td');
    const state = getStockState_(r?.note);
    if (state.type === 'SOLD') {
      tdQty.className='qty'; tdQty.textContent = '품절'; 
    } else if (state.type === 'FUTURE') { 
      tdQty.className='qty'; tdQty.innerHTML = `<span style="font-size:8pt">${escapeEstimateHtml(state.label)}</span>`; 
    } else if (isSpecial) {
      tdQty.className='qty-static'; tdQty.textContent = q;
    } else {
      tdQty.className='qty';
      let isManual = false;
      if (isCommPanelRow(r)) isManual = typeof COMM_MANUAL_PANEL !== 'undefined' && COMM_MANUAL_PANEL.has(r.model);
      else if (isCommHoseRow(r)) isManual = typeof COMM_MANUAL_HOSE !== 'undefined' && COMM_MANUAL_HOSE.has(r.model);
      else if (isCommRemoteRow(r)) isManual = typeof COMM_MANUAL_REMOTE !== 'undefined' && COMM_MANUAL_REMOTE.has(r.model);
      else if (isCommPumpRow(r)) isManual = typeof COMM_MANUAL_PUMP !== 'undefined' && COMM_MANUAL_PUMP.has(r.model);
      else {
        const sText = ((r.name || '') + ' ' + (r.disp || '') + ' ' + (r.model || '')).toLowerCase();
        if (/방진가대|받침대|발통세트|일자발|si-al/i.test(sText)) isManual = typeof COMM_MANUAL_BASE !== 'undefined' && COMM_MANUAL_BASE.has(r.model);
        else isManual = (q > 0);
      }
      const colorStyle = isManual ? 'color:#2563eb; font-weight:bold;' : 'color:#374151; font-weight:normal;';
      tdQty.innerHTML = `<div class="qty-box"><input class="qty-input" data-model="${escapeEstimateAttr(r?.model||'')}" value="${escapeEstimateAttr((q !== 0 || isManual) ? q : '')}" onfocus="this.select()" inputmode="numeric" pattern="\\d*" placeholder="0" style="${colorStyle}"/></div>`;
    }
    tr.appendChild(tdQty);

    // 단가
    const tdPrice = document.createElement('td'); tdPrice.className = 'price';
    if(isSpecial){
       const wrap = document.createElement('div');
       wrap.style.width='100px'; wrap.style.margin='0 auto'; wrap.style.position='relative';

       const inp = document.createElement('input');
       inp.type = 'text'; inp.className = 'price-input'; inp.inputMode = 'numeric';
       inp.value = formatSpecialPriceForDisplay(currentPrice, fmt);
       inp.placeholder = '0';
       inp.style.width = '100%'; inp.style.textAlign = 'right';
       inp.style.border = '1px solid #d1d5db'; inp.style.borderRadius = '4px'; 
       inp.style.padding = '4px 8px'; inp.style.fontSize = '14px'; inp.style.outline = 'none';
       if(currentPrice) { inp.style.color = '#2563eb'; inp.style.fontWeight = 'bold'; }
       inp.addEventListener('focus', function(){ this.select(); });
       inp.addEventListener('change', (e) => handleFreightInput(e, isCut, commCustomPrices, commQty, r.model, recomputeCommDerived));
       wrap.appendChild(inp); tdPrice.appendChild(wrap);
    } else {
       tdPrice.setAttribute('data-cunit', r.model);
       tdPrice.innerHTML = makePriceInput(unitPrice, 'comm', r.model);
    }
    tr.appendChild(tdPrice);

    // 소계
    const tdSub = document.createElement('td'); tdSub.className = 'sub pc-only';
    tdSub.setAttribute('data-csub', r.model);
    tdSub.textContent = fmt(sub);
    tr.appendChild(tdSub);

    // 고정DC
    const tdFix = document.createElement('td');
    tdFix.className = 'pc-only';
    if(!isSpecial){
      let val = r['고정DC'];
      if(typeof val === 'number' && val <= 1) val = (val*100);
      val = String(val || '').replace(/%/g, '');
      tdFix.innerHTML = `<div class="qty-box"><input class="qty-input fix-dc-inp" data-m="${escapeEstimateAttr(r.model||'')}" value="${escapeEstimateAttr(val)}" onfocus="this.select()" placeholder="%" style="font-size:13px; text-align:center;"/></div>`;
    }
    tr.appendChild(tdFix);

    // 변동DC
    const tdVar = document.createElement('td');
    tdVar.className = 'pc-only';
    if(!isSpecial){
      const checked = r.useK2 ? 'checked' : '';
      tdVar.innerHTML = `<input type="checkbox" class="var-dc-chk" data-m="${escapeEstimateAttr(r.model||'')}" ${checked} style="transform:scale(1.2); cursor:pointer;">`;
    }
    tr.appendChild(tdVar);

    // 용량
    const tdCapa = document.createElement('td');
    tdCapa.className = 'capa pc-only';
    tdCapa.style.textAlign = 'center';
    tdCapa.style.color = '#6b7280';
    tdCapa.style.fontSize = '13px';
    tdCapa.textContent = (r.capacity && Number(r.capacity) > 0) ? r.capacity : '-';
    tr.appendChild(tdCapa);

    // 구성품 버튼 (맨 우측으로 이동)
    const tdComp = document.createElement('td');
    tdComp.className = 'comp-btn pc-only';
    if ((r.unit||'').toUpperCase()==='SET') {
        tdComp.innerHTML = `<button type="button" class="btn-mini toggle-comp-comm" data-m="${escapeEstimateAttr(r.model)}">보기</button>`;
    } else {
        tdComp.textContent = '-';
    }
    tr.appendChild(tdComp);

    if ((r.unit||'').toUpperCase()==='SET'){ tr.dataset.isSet = '1'; tr.dataset.setModel = r.model || ''; }
    body.appendChild(tr);

    if ((r.unit||'').toUpperCase()==='SET'){ renderCommSetParts(r.model, q); }
  });

  updateCommFilterOptions();
  renderCommOptions();
  
  // 갱신
  const updateCommRowPrice = (model, tr) => {
    let u = commUnitPrice(model);
    const q = commQty.get(model)||0;
    const priceInp = tr.querySelector('.price-input');
    if(priceInp && !commCustomPrices.has(model)){
        priceInp.value = u.toLocaleString();
        priceInp.style.color = '#374151';
        priceInp.style.fontWeight = 'normal';
    } else if (commCustomPrices.has(model)) {
        u = commCustomPrices.get(model);
    }
    const subCell = tr.querySelector('.sub');
    if(subCell) subCell.textContent = fmt(u * q);
    syncCommTotals();
  };

  // 리스너
  body.querySelectorAll('.fix-dc-inp').forEach(inp => {
    inp.addEventListener('change', e => updateCommRowPrice(e.target.dataset.m, e.target.closest('tr')));
  });
  body.querySelectorAll('.var-dc-chk').forEach(chk => {
    chk.addEventListener('change', e => updateCommRowPrice(e.target.dataset.m, e.target.closest('tr')));
  });

  // 변경
  body.querySelectorAll('.qty-input:not(.fix-dc-inp):not(.part-qty-comm)').forEach(inp => {
    inp.addEventListener('focus', function() { this.select(); });
    inp.addEventListener('change', e => {
      const m = e.target.dataset.model;
      const raw = e.target.value.replace(/[^0-9-]/g, '');
      let v;
      const rec = COMMULTI.find(x => x.model === m);

      if (raw === '') {
        v = 0;
        e.target.value = '';
        e.target.style.color = '#374151';
        e.target.style.fontWeight = 'normal';
        
        if (rec) {
          if (isCommPanelRow(rec)) COMM_MANUAL_PANEL.delete(m);
          else if (isCommHoseRow(rec)) COMM_MANUAL_HOSE.delete(m);
          else if (isCommRemoteRow(rec)) COMM_MANUAL_REMOTE.delete(m);
          else if (isCommPumpRow(rec)) COMM_MANUAL_PUMP.delete(m);
          const s = ((rec.name||'')+' '+(rec.disp||'')+' '+(rec.model||'')).toLowerCase();
          if (/방진가대|받침대|발통세트|일자발|SI-AL/i.test(s)) COMM_MANUAL_BASE.delete(m);
        }
        
        // 해제
        if (commQty.unlock) commQty.unlock(m);
        commQty.set(m, v);
      } else {
        v = parseInt(raw, 10);
        e.target.value = String(v);
        e.target.style.color = '#2563eb';
        e.target.style.fontWeight = 'bold';
        
        if (rec) {
          if (isCommPanelRow(rec)) COMM_MANUAL_PANEL.add(m);
          else if (isCommHoseRow(rec)) COMM_MANUAL_HOSE.add(m);
          else if (isCommRemoteRow(rec)) COMM_MANUAL_REMOTE.add(m);
          else if (isCommPumpRow(rec)) COMM_MANUAL_PUMP.add(m);
          const s = ((rec.name||'')+' '+(rec.disp||'')+' '+(rec.model||'')).toLowerCase();
          if (/방진가대|받침대|발통세트|일자발|SI-AL/i.test(s)) COMM_MANUAL_BASE.add(m);
        }
        
        // 잠금
        if (commQty.set) commQty.set(m, v, true);
      }

      try {
        const tr = e.target.closest('tr');
        const priceInp = tr.querySelector('.price-input');
        if (priceInp) {
          const p = parseInt(priceInp.value.replace(/[^0-9]/g,'')||0, 10);
          const sCel = tr.querySelector(`[data-csub="${CSS.escape(m)}"]`);
          if(sCel) sCel.textContent = fmt(p * v);
        }
      } catch (err) {}

      // 동기화
      const parts = document.querySelectorAll(`#commBody tr[data-part-of="${CSS.escape(m)}"]`);
      parts.forEach(ptr => {
        const pModel = ptr.getAttribute('data-m');
        const pKeyStr = `${m}|${pModel}`;
        const isManual = typeof commCustomPartQtys !== 'undefined' && commCustomPartQtys.has(pKeyStr);

        const defQ = parseInt(ptr.querySelector('.part-qty-comm').dataset.def, 10) || 1;
        const effQ = isManual ? commCustomPartQtys.get(pKeyStr) : (v * defQ);
        
        const inpPart = ptr.querySelector('.part-qty-comm');
        if (inpPart && !isManual) {
          inpPart.value = effQ ? String(effQ) : '';
        }

        const pUnit = parseInt(ptr.querySelector('.price').textContent.replace(/[^0-9]/g, ''), 10) || 0;
        const psCell = ptr.querySelector('.sub');
        if (psCell) psCell.textContent = fmt(pUnit * effQ);
      });

      if (rec && (isCommIndoorRow(rec) || isCommOutdoorRow(rec) || /전열교환기/i.test(rawNameOf(rec)))) {
        if (isCommOutdoorRow(rec)) {
           try { recalcCommAccessories(); } catch(e){}
        }
        recomputeCommDerived();
        if (window.GLOBAL_BRANCH_STATE) {
          window.GLOBAL_BRANCH_STATE.outOrder = [];
        }
      } else {
        syncCommTotals();
      }
      
      updateCommRatio();
      updateInlineTotals();
      refreshSelectedBadge();
      refreshBranchOpenButton('comm');
    });
  });

  bindCommQtyArrowNav();
  
  if(typeof recomputeCommDerived === 'function') recomputeCommDerived();
  if(typeof syncCommTotals === 'function') syncCommTotals();
  setTimeout(fitAllTables, 0);

  const tfoot = document.querySelector('#wrapComm tfoot td[colspan]');
      if(tfoot) tfoot.colSpan = 15;
}

// 상업멀티 실외기 표시명
function buildDisplayNameComm(r, row){
  const L = String(row?.L || row?.catL || '').trim();
  const M = String(row?.M || row?.catM || '').trim();
  const S = String(row?.S || row?.catS || '').trim();

  // 방식유지
  if (L === '부자재') {
    const src = String(r?.name || '');
    const disp = src
      .replace(/\s{2,}/g, ' ')
      .trim();
    // 공백정리
    return disp;
  }

  // 불필요 키워드 제거
  const raw = `${r?.disp||''} ${r?.name||''}`.trim();
  const scrub = raw
    .replace(/\bDVM[_\s-]*S2?\b/ig, '')
    .replace(/\bEHP\b/ig, '')
    .replace(/\bGHP\b/ig, '')
    .replace(/\b프라임\b/ig, '')
    .replace(/\b프레스티지\b/ig, '')
    .replace(/\b고효율\b/ig, '')
    .replace(/\b한랭지\b/ig, '')
    .replace(/\s+/g,' ')
    .trim();

  const hpMatches = [...scrub.matchAll(/(\d+(?:\.\d+)?\s*HP(?:\s*\([^)]*\))?)/ig)];
  if (hpMatches.length){
    const tail = hpMatches[hpMatches.length-1][1];
    return tail.trim();
  }

  // HP 패턴이 없으면 기본 표시 규칙 사용
  return stripCommKeywords(cleanDisplayName(r?.disp||'', r?.name||''), row);
}

function displayNameForRow(row){
  const catL = String(row?.catL || '').trim();
  const nm = String(row?.name || '');
  if (catL === '부자재') {
    const out = nm.replace(/\s{2,}/g, ' ').trim();
    return out;
  }
  return rawNameOf(row);
}

// 세트 키 정규화
function normKey(s){
  return String(s||'').toUpperCase().replace(/\s+/g,'').replace(/[^\w-]/g,'');
}

// 세트 인덱스
let COMM_SET_INDEX = null;
function buildCommSetIndex(){
  if (COMM_SET_INDEX) return COMM_SET_INDEX;
  // 소스 선택
  const src = (window.COMM_PARTS) || (window.COMM_MULTI_CONFIG) || (window.COMMSET) || (window.COMMCONFIG) || (window.COMMMULTI_CONFIG) || [];
  // 인덱스 생성
  COMM_SET_INDEX = new Map();
  src.forEach(x=>{
    // 세트 키 확보
    const setKey = normKey(String(x['세트'] || x.set || x.Set || x.setModel || x.setKey || '').trim());
    // 모델명 확보
    const model  = String(x['모델명'] || x['모델'] || x.model || x['구성모델'] || x['Model'] || '').trim();
    // 수량 단위 이름 가격
    const qty    = (parseInt(String(x['수량'] || x.qty || x.QTY || x.amount || x['구성수량']).replace(/[^\d-]/g,''),10) || 1);
    const unit   = String(x['단위'] || x.unit || 'EA').trim();
    const name   = String(x['품목명'] || x['모델명'] || x.name || '').trim();
    const price  = (parseInt(String(x['출고가'] || x.unitPrice || x.price).replace(/[^\d-]/g,''),10) || 0);
    if (!setKey || !model) return;
    const arr = COMM_SET_INDEX.get(setKey) || [];
    arr.push({ model, name, qty, unit, price });
    COMM_SET_INDEX.set(setKey, arr);
  });
  return COMM_SET_INDEX;
}

// 세트 미리보기 분해
function explodeCommPreviewParts(setModel, setQty){
  const parts = partsForCommSet_(setModel);
  if (!parts.length){
    return [];
  }
  const qtySet = parseInt(setQty, 10) || 0;
  return parts.map(p => {
    const unitPrice = (typeof commUnitPrice === 'function' ? (commUnitPrice(p.model) || 0) : 0) || p.price || 0;
    const q = qtySet * (parseInt(p.qty, 10) || 1);
    return { name: p.name || p.model, model: p.model, unit: p.unit || 'EA', qty: q, price: unitPrice, sub: unitPrice * q };
  });
}

function isCommSetRow(r){
  return String(r?.catL || '') === '실외기' && String(r?.unit || '').toUpperCase() === 'SET';
}

// 전송용 세트 분해
function explodeCommSets_(setRow, setQty){
  const parts = COMM_PARTS.filter(p => p.refModel === setRow.model);
  const qtySet = parseInt(setQty, 10) || 0;

  if (!parts.length) {
    return [{
      section: 'COMM',
      name: setRow.name,
      model: setRow.model,
      qty: qtySet,
      price: getRealCommPrice(setRow.model) || 0,
      spec: setRow.spec || '',
      specs: [],
      isSetFallback: true
    }];
  }

  // 세트 규격
  const setHeader = COMM_PARTS.find(p => p.model === setRow.model);
  const mainSpec = (setHeader && setHeader.spec) ? setHeader.spec : '';

  return parts.map(p => {
    // 수량 계산
    let finalQty = 0;
    if (String(p.qty).toUpperCase() === 'Q') {
      finalQty = qtySet;
    } else {
      finalQty = qtySet * (parseInt(p.qty, 10) || 1);
    }
    
    // 규격 결정
    const mySpec = p.spec || mainSpec || '';
    
    return { 
      section: 'COMM',
      name: p.name || p.partName || p.model,
      model: p.model, 
      qty: finalQty, 
      price: getRealCommPrice(p.model) || 0,
      kind: p.kind || '',
      spec: mySpec,
      specs: Array.isArray(p.specs) ? p.specs : []
    };
  });
}

// 부품 (상업)
function renderCommSetParts(setModel, setQty){
  const idx = typeof buildCommSetIndex === 'function' ? buildCommSetIndex() : new Map();
  const key = typeof normKey === 'function' ? normKey(String(setModel).trim()) : String(setModel).trim();
  
  let allParts = [];
  if (typeof COMM_PARTS !== 'undefined') {
      allParts = COMM_PARTS.filter(p => p.refModel === setModel || p.setModel === setModel);
  }
  let activeParts = idx.get(key) || [];
  
  if (!allParts.length) {
      allParts = activeParts.map(p => ({...p}));
  }
  if (!allParts.length) return;

  const tbody = typeof el === 'function' ? el('#commBody') : document.getElementById('commBody');
  const anchor = tbody.querySelector(`tr[data-set-model="${CSS.escape(setModel)}"]`);

  tbody.querySelectorAll(`tr[data-part-of="${CSS.escape(setModel)}"]`).forEach(e => e.remove());

  allParts.slice().reverse().forEach(p => {
    const unit = typeof commUnitPrice === 'function' ? commUnitPrice(p.model) : 0;
    const activeMatch = activeParts.find(ap => ap.model === p.model);
    let defQ = 1;
    if(String(p.qty).toUpperCase() === 'Q') defQ = 1; else defQ = parseFloat(p.qty) || 1;
    const effQ = (parseInt(setQty, 10) || 0) * defQ;

    const tr = document.createElement('tr');
    tr.classList.add('set-part');
    tr.setAttribute('data-part-of', setModel);
    tr.setAttribute('data-m', p.model);
    tr.style.display = 'none';
    tr.style.backgroundColor = '#f8fafc';

    // 품목
    const tdD = document.createElement('td'); 
    tdD.className = 'colD pc-only'; 
    tdD.innerHTML = `<span style="color:#6b7280;">└ [구성]</span> ${escapeEstimateHtml(p.name||p.partName||p.model)}`;
    tr.appendChild(tdD);

    const tdD_MO = document.createElement('td'); 
    tdD_MO.className = 'colD mobile-only'; 
