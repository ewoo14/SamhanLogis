  oOpt: { id:'#oldOpts', pc:'#cardOld', mo:'#mobileLeftContent' }
};

// UI재배치
function relocateUI(isMobile){
  Object.values(uiMap).forEach(def=>{
    const el=document.querySelector(def.id);
    const dest=document.querySelector(isMobile?def.mo:def.pc);
    if(!el||!dest) return;
    if(isMobile){
      dest.prepend(el);
    }else{
      const ref=def.ref?document.querySelector(def.ref):null;
      if(ref&&ref.parentNode===dest) dest.insertBefore(el,ref);
      else dest.prepend(el);
    }
  });

  const secs=['home','single','comm','old'];
  secs.forEach(s=>{
    const barId = s==='old' ? '' : `#${s}FilterBar`;
    const bar = s==='old' ? null : document.querySelector(barId);
    
    const pcCardId = s==='home'?'#cardHome':(s==='single'?'#cardSingle':(s==='comm'?'#cardComm':'#cardOld'));
    const pcDest = document.querySelector(pcCardId);
    const resetBtnId = s==='home'?'#btnResetHome':(s==='single'?'#btnResetSingle':(s==='comm'?'#btnResetComm':'#btnResetOld'));
    const resetBtn = document.querySelector(resetBtnId);

    if(isMobile){
      // 우측
      if(bar){
        const sels=bar.querySelectorAll('select');
        if(sels.length){
          let grpR=document.querySelector(`#grpR_${s}`);
          if(!grpR){
            grpR=document.createElement('div');
            grpR.id=`grpR_${s}`; grpR.className='filter-bar';
            document.querySelector('#mobileRightContent').appendChild(grpR);
          }
          sels.forEach(sel=>grpR.appendChild(sel));
        }
      }

      // 하단
      let grpB=document.querySelector(`#grpB_${s}`);
      if(!grpB){
        grpB=document.createElement('div');
        grpB.id=`grpB_${s}`;
        document.querySelector('#mobileBottomContent').appendChild(grpB);
      }
      
      // 내부 행 생성
      let rowCtrl = grpB.querySelector('.bot-ctrl-row');
      if(!rowCtrl){ rowCtrl=document.createElement('div'); rowCtrl.className='bot-ctrl-row'; grpB.appendChild(rowCtrl); }
      
      let rowSearch = grpB.querySelector('.bot-search-row');
      if(!rowSearch){ rowSearch=document.createElement('div'); rowSearch.className='bot-search-row'; grpB.appendChild(rowSearch); }

      // 비율 이동
      const ratioId = s==='home'?'#homeRatio':(s==='comm'?'#commRatio':'');
      let hasRatio = false;
      if(ratioId){
        const rEl = document.querySelector(ratioId);
        if(rEl){
          rowCtrl.prepend(rEl);
          hasRatio = true;
        }
      }

      const recId = s==='home'?'#homeRecommendHp':(s==='comm'?'#commRecommendHp':'');
      if(recId){
        const recEl = document.querySelector(recId);
        if(recEl){
          rowCtrl.prepend(recEl);
        }
      }

      // 레이아웃 클래스 적용
      if(hasRatio){
        rowCtrl.classList.add('has-ratio');
        rowCtrl.classList.remove('no-ratio');
      }else{
        rowCtrl.classList.add('no-ratio');
        rowCtrl.classList.remove('has-ratio');
      }

      // 초기화 버튼 이동 (컨트롤 행)
      if(resetBtn) rowCtrl.appendChild(resetBtn);

      // 검색창 이동 (검색 행)
      if(bar){
        const searchBox = bar.querySelector('.filter-search');
        if(searchBox) rowSearch.appendChild(searchBox);
      }

    }else{
      // PC복구
      const grpR=document.querySelector(`#grpR_${s}`);
      const grpB=document.querySelector(`#grpB_${s}`);

      if(bar && grpR){
        const sels=grpR.querySelectorAll('select');
        Array.from(sels).reverse().forEach(sel=>bar.prepend(sel));
      }

      if(grpB){
        const rowCtrl = grpB.querySelector('.bot-ctrl-row');
        const rowSearch = grpB.querySelector('.bot-search-row');

        // 비율 복구
        const ratioId = s==='home'?'#homeRatio':(s==='comm'?'#commRatio':'');
        if(ratioId && pcDest && rowCtrl){
          const rEl = rowCtrl.querySelector(ratioId);
          const act = pcDest.querySelector('.card-actions');
          if(rEl && act) act.prepend(rEl);
        }

        const recId = s==='home'?'#homeRecommendHp':(s==='comm'?'#commRecommendHp':'');
          if(recId && pcDest && rowCtrl){
            const recEl = rowCtrl.querySelector(recId);
            const act = pcDest.querySelector('.card-actions');
            if(recEl && act) act.prepend(recEl);
          }

        // 초기화 복구
        if(resetBtn && pcDest){
          const act = pcDest.querySelector('.card-actions') || pcDest.querySelector('.card-head');
          if(act) act.appendChild(resetBtn);
        }

        // 검색창 복구
        if(bar && rowSearch){
          const searchBox = rowSearch.querySelector('.filter-search');
          if(searchBox) bar.appendChild(searchBox);
        }
      }

      // 여백
      document.body.style.paddingTop = '';
      document.body.style.paddingBottom = '';
    }
  });
}

// 상단제어 (분기함수 호출 제거됨)
function updateTopControls(){
  const sw=el('#btnSwitch');
  const pv=el('#btnPreview');
  const title=el('.title');
  const isMob=isMobileNow();

  if(isMob){
    if(pv) pv.style.display='flex';
    if(title) title.firstChild.nodeValue=
      (mobileActive==='home'?'홈멀티':
       mobileActive==='single'?'싱글중대형':
       mobileActive==='comm'?'상업멀티':
       mobileActive==='old'?'구형':'종합견적서')+' ';
  }else{
    if(title) title.firstChild.nodeValue='종합견적서';
  }
  
  if(sw) sw.style.display='none';
}

// 서랍토글
function toggleDrawer(mode) {
  // 제어할 서랍 ID 매핑
  const ids = { top: 'drawerTop', bottom: 'drawerBottom', left: 'drawerLeft', right: 'drawerRight' };
  const targetId = ids[mode];
  const target = document.getElementById(targetId);
  if (!target) return;

  // 열기/닫기 토글
  const isOpen = target.classList.toggle('active');

  // 여백 조정
  if (mode === 'top' && document.body.classList.contains('mobile-mode')) {
    let page = document.querySelector('.wrap'); // 기본 메인화면
    if (document.body.classList.contains('preview-active')) {
      page = document.getElementById('cardPreview'); // 견적서 화면
    } else if (document.body.classList.contains('final-active')) {
      page = document.getElementById('cardFinal');   // 전표목록 화면
    }

    if (page) {
      if (isOpen) {
        const drawerHeight = target.clientHeight;
        page.style.paddingTop = (drawerHeight + 10) + 'px'; 
      } else {
        page.style.paddingTop = ''; 
      }
    }
  }

  // 다른 서랍들은 닫기
  Object.values(ids).forEach(id => {
    if (id !== targetId) {
      const other = document.getElementById(id);
      if (other && other.classList.contains('active')) {
        other.classList.remove('active');
      }
    }
  });
}

// 리사이즈
function handleResize(){
  const isMobile=window.matchMedia('(max-width: 1280px)').matches;
  document.body.classList.toggle('mobile-mode',isMobile);
  fixFootersForMobile(isMobile);
  fitAllTables();
  relocateUI(isMobile);
}

// 현재값스냅샷
function getCurrentSlipSnapshot() {
  const getVal = id => {
    const el = document.getElementById(id);
    if (!el) return '';
    if (el.type === 'checkbox') return el.checked ? '1' : '0';
    return String(el.value || '').trim();
  };
  const cust = document.getElementById('custSearch');
  const custCode = cust ? (cust.dataset.code || '') : '';
  const manager = document.getElementById('managerSearch');
  const managerCode = manager ? (manager.dataset.code || '') : '';
  let itemsKey = '';
  if (typeof buildSendRows === 'function') {
    const rows = buildSendRows();
    if (Array.isArray(rows)) {
      itemsKey = rows.map(r => [r.model, r.qty, r.price, r.spec || '', r.remarks || ''].join('|')).join('||');
    }
  }
  return [
    custCode,
    getVal('custSearch'),
    managerCode,
    getVal('managerSearch'),
    getVal('due'),
    getVal('whCode'),
    getVal('addrBase'),
    getVal('addrDetail'),
    getVal('addrAuditBase'),
    getVal('addrAuditDetail'),
    getVal('sameAddr'),
    getVal('auditLater'),
    getVal('tel'),
    getVal('memo'),
    getVal('payDue'),
    getVal('chkCardPay'),
    getVal('payDueStar'),
    getVal('payDuePre'),
    getVal('chkYard'),
    getVal('chkLocal'),
    itemsKey
  ].join('::');
}

// 버튼상태변경
function toggleSlipButton() {
  const btn = document.getElementById('btnGenSlip');
  const btnStock = document.getElementById('btnCheckStock');
  if (!btn) return;

  let failReason = '';

  // 거래처확인
  const cust = document.getElementById('custSearch');
  const hasCust = cust && cust.dataset.code && cust.value.trim();
  if (!hasCust && !failReason) failReason = '거래처';

  // 출고일확인
  const due = document.getElementById('due');
  if ((!due || !due.value.trim()) && !failReason) failReason = '출고일';

  // 출고창고확인
  const whCode = document.getElementById('whCode');
  if ((!whCode || !whCode.value.trim()) && !failReason) failReason = '출고창고';

  // 배송주소확인
  const addrBase = document.getElementById('addrBase');
  if ((!addrBase || !addrBase.value.trim()) && !failReason) failReason = '배송주소';

  // 감리주소확인
  const addrAuditBase = document.getElementById('addrAuditBase');
  const sameAddr = document.getElementById('sameAddr');
  const auditLater = document.getElementById('auditLater');
  const isAuditOk = (sameAddr && sameAddr.checked) || (auditLater && auditLater.checked) || (addrAuditBase && addrAuditBase.value.trim());
  if (!isAuditOk && !failReason) failReason = '감리주소';

  // 인수자번호확인
  const tel = document.getElementById('tel');
  const tv = tel ? tel.value.trim() : '';
  const isTel = /^010-\d{4}-\d{4}$/.test(tv);
  if (!isTel && !failReason) failReason = '인수자번호';

  // 요청사항확인
  const memo = document.getElementById('memo');
  if ((!memo || !memo.value.trim()) && !failReason) failReason = '요청사항';

  // 입금예정일확인
  const payDue = document.getElementById('payDue');
  const payDueStar = document.getElementById('payDueStar');
  const payDuePre = document.getElementById('payDuePre');
  const chkCardPay = document.getElementById('chkCardPay');
  const isPayOk = (chkCardPay && chkCardPay.checked) || (payDueStar && payDueStar.checked) || (payDuePre && payDuePre.checked) || (payDue && payDue.value.trim());
  if (!isPayOk && !failReason) failReason = '입금예정일';

  // 품목확인
  let hasItem = false;
  if (typeof buildSendRows === 'function') {
    const r = buildSendRows();
    if (Array.isArray(r) && r.length > 0) hasItem = true;
  }
  if (!hasItem && !failReason) failReason = '품목';

  // 재고버튼제어
  if (btnStock) {
    if (hasItem) {
      btnStock.disabled = false;
      btnStock.classList.remove('cursor-not-allowed');
      btnStock.classList.add('cursor-pointer');
    } else {
      btnStock.disabled = true;
      btnStock.classList.add('cursor-not-allowed');
      btnStock.classList.remove('cursor-pointer');
    }
  }

  // 전송버튼제어
  if (!failReason) {
    // 중복방지검사
    if (window.LAST_SLIP_SNAPSHOT && typeof getCurrentSlipSnapshot === 'function'
        && getCurrentSlipSnapshot() === window.LAST_SLIP_SNAPSHOT) {
      btn.disabled = true;
      btn.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'cursor-pointer');
      btn.classList.add('bg-gray-400', 'cursor-not-allowed');
      btn.innerText = '전표생성불가(중복방지)';
      return;
    }
    btn.disabled = false;
    btn.classList.remove('bg-gray-400', 'cursor-not-allowed');
    btn.classList.add('bg-blue-600', 'hover:bg-blue-700', 'cursor-pointer');
    btn.innerText = '전표전송가능';
  } else {
    btn.disabled = true;
    btn.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'cursor-pointer');
    btn.classList.add('bg-gray-400', 'cursor-not-allowed');
    btn.innerText = '전표전송불가(' + failReason + ' 없음)';
  }
}

// 유효성검사
function initValidationEvents() {
  const ids = [
    'due',           // 출고일
    'payDue',        // 입금예정일
    'whCode',        // 출고창고
    'memo',          // 요청사항
    'addrBase',      // 배송주소
    'addrAuditBase'  // 감리주소
  ];
  
  // 입력변경감지
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', toggleSlipButton);
      el.addEventListener('change', toggleSlipButton);
    }
  });

  // 수량변경감지
  document.addEventListener('change', function(e) {
    const el = e.target;
    if (el.tagName === 'INPUT' && el.type === 'number') {
      toggleSlipButton();
    }
  });
}

function initOrderCard() {
  // 기본값 설정
  const now = new Date(new Date().getTime() + (9 * 60 * 60 * 1000));
  const today = now.toISOString().split('T')[0];
  const due = document.getElementById('due');
  if(due && !due.value) due.value = today;

  // 전화번호 포맷 강제
  const telEl = document.getElementById('tel');
  if(telEl) {
    telEl.addEventListener('input', function(e) {
      let val = e.target.value.replace(/[^0-9]/g, '');
      let res = '';
      if(val.length < 4) res = val;
      else if(val.length < 8) res = val.substr(0, 3) + '-' + val.substr(3);
      else res = val.substr(0, 3) + '-' + val.substr(3, 4) + '-' + val.substr(7);
      
      if(res.length > 13) res = res.substring(0, 13);
      e.target.value = res;
      checkCardValid();
    });
  }

  // 일반 입력 감지
  const ids = ['due','addrBase','addrDetail','addrAuditBase','addrAuditDetail','payDue','memo','sameAddr','auditLater'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if(el) {
      el.addEventListener('input', checkCardValid);
      el.addEventListener('change', checkCardValid);
    }
  });

  // 버튼 이벤트 연결
  document.getElementById('btnAddrShipNaver').addEventListener('click', () => openAddrSearch('ship', 'naver'));
  document.getElementById('btnAddrShipKakao').addEventListener('click', () => openAddrSearch('ship', 'kakao'));
  document.getElementById('btnAddrAuditNaver').addEventListener('click', () => openAddrSearch('audit', 'naver'));
  document.getElementById('btnAddrAuditKakao').addEventListener('click', () => openAddrSearch('audit', 'kakao'));
  
  // 주소 검색창 닫기
  document.getElementById('btnCloseAddrDock').addEventListener('click', () => {
    document.getElementById('addrDock').style.display = 'none';
  });

  // 네이버 검색 버튼
  const naverBtn = document.getElementById('naverSearchBtn');
  if (naverBtn) naverBtn.addEventListener('click', () => runNaverLocalSearch(true));

  // 네이버 입력란 엔터키 자동완성
  const naverInput = document.getElementById('naverQuery');
  if (naverInput) {
    naverInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') { e.preventDefault(); runNaverLocalSearch(true); }
    });
    naverInput.addEventListener('input', scheduleNaverAutoSearch);
  }
  
  document.getElementById('btnGenSlip').addEventListener('click', submitOrderCard);
  if (typeof initInventoryModal === 'function') {
    initInventoryModal(); 
  }
  
  document.getElementById('chkYard').addEventListener('change', function() {
    if (this.checked) document.getElementById('chkLocal').checked = false;
    updateOrderTags();
    if (typeof toggleSlipButton === 'function') toggleSlipButton();
  });
  document.getElementById('chkLocal').addEventListener('change', function() {
    if (this.checked) document.getElementById('chkYard').checked = false;
    updateOrderTags();
    if (typeof toggleSlipButton === 'function') toggleSlipButton();
  });
  
  const dueEl = document.getElementById('due');
  if(dueEl) {
      dueEl.addEventListener('change', updateOrderTags);
      dueEl.addEventListener('input', updateOrderTags);
  }
  
  const addrBaseEl = document.getElementById('addrBase');
  const addrDetailEl = document.getElementById('addrDetail');
  const syncAudit = () => { if(document.getElementById('sameAddr')?.checked) syncAuditFromShip_(); };
  
  if(addrBaseEl) {
    addrBaseEl.addEventListener('input', enforceTagsOnInput);
    addrBaseEl.addEventListener('input', syncAudit);
  }
  
  if(addrDetailEl) {
    addrDetailEl.addEventListener('input', syncAudit);
  }
  
  const memoEl = document.getElementById('memo');
  if(memoEl) memoEl.addEventListener('input', enforceTagsOnInput);

  updateOrderTags();

  document.getElementById('sameAddr').addEventListener('change', toggleSameAddr);
  document.getElementById('auditLater').addEventListener('change', toggleAuditLater);

  checkCardValid();
}

// 주소검색
function openAddrSearch(targetType, source) {
  logAction('조회', '주소검색');
  if(targetType === 'audit') {
    if(document.getElementById('sameAddr').checked || document.getElementById('auditLater').checked) return;
  }
  const src = source === 'naver' ? 'naver' : 'kakao';
  const isMobile = window.innerWidth <= 1280 || document.body.classList.contains('mobile-mode');
  window.__addrTarget = targetType;

  if (src === 'kakao' && !isMobile) {
    new kakao.Postcode({ oncomplete: onKakaoAddrComplete }).open();
    return;
  }
  openAddrDock_(src, isMobile);
}

// 주소 도크 열기
function openAddrDock_(src, isMobile) {
  const dock = document.getElementById('addrDock');
  const sheet = document.getElementById('addrSheet');
  const embed = document.getElementById('addrEmbed');
  const naver = document.getElementById('naverPanel');
  const title = document.getElementById('addrDockTitle');
  if (!dock || !sheet || !embed || !naver) return;

  if (isMobile) {
    sheet.style.cssText = 'position:absolute; top:60px; left:0; right:0; bottom:0; background:#fff; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 -4px 20px rgba(0,0,0,0.2); border-top-left-radius:16px; border-top-right-radius:16px;';
  } else {
    sheet.style.cssText = 'position:absolute; top:50%; left:50%; transform:translate(-50%, -50%); width:480px; max-width:92vw; height:560px; max-height:88vh; background:#fff; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 10px 30px rgba(0,0,0,0.3); border-radius:12px;';
  }
  dock.style.display = 'block';

  if (src === 'naver') {
    title.textContent = '네이버 주소 검색';
    embed.style.display = 'none';
    naver.style.display = 'flex';
    const q = document.getElementById('naverQuery');
    const r = document.getElementById('naverResults');
    if (q) q.value = '';
    if (r) r.innerHTML = '<div style="padding:30px; text-align:center; color:#6b7280; font-size:13px;">주소 지번 건물명 등을 입력해 검색하세요</div>';
    setTimeout(function () { if (q) q.focus(); }, 80);
  } else {
    title.textContent = '카카오 주소 검색';
    naver.style.display = 'none';
    embed.style.display = 'block';
    embed.innerHTML = '';
    new kakao.Postcode({
      oncomplete: onKakaoAddrComplete,
      width: '100%',
      height: '100%'
    }).embed(embed);
  }
}

// 카카오 결과 처리
function onKakaoAddrComplete(data) {
  let addr = '';
  if (data.userSelectedType === 'R') addr = data.roadAddress;
  else addr = data.jibunAddress;
  if (data.buildingName) addr += ' ' + data.buildingName;
  applyAddrToTarget(addr);
}

// 선택 주소 입력란에 반영
function applyAddrToTarget(addr) {
  const target = window.__addrTarget;
  if (target === 'ship') {
    document.getElementById('addrBase').value = addr;
    if (typeof updateOrderTags === 'function') updateOrderTags();
    if (document.getElementById('sameAddr')?.checked) syncAuditFromShip_();
    document.getElementById('addrDetail').focus();
  } else {
    document.getElementById('addrAuditBase').value = addr;
    document.getElementById('addrAuditDetail').focus();
  }
  const dock = document.getElementById('addrDock');
  if (dock) dock.style.display = 'none';
  if(typeof checkCardValid === 'function') checkCardValid();
}

// 네이버 통합 검색 호출 상호와 도로명 동시
function runNaverLocalSearch(showLoading) {
  const input = document.getElementById('naverQuery');
  const results = document.getElementById('naverResults');
  if (!input || !results) return;
  const q = (input.value || '').trim();
  if (!q) {
    results.innerHTML = '<div style="padding:30px; text-align:center; color:#6b7280; font-size:13px;">검색어를 입력해 주세요</div>';
    return;
  }
  if (showLoading) {
    results.innerHTML = '<div style="padding:30px; text-align:center; color:#6b7280; font-size:13px;">검색 중...</div>';
    results.style.opacity = '1';
  } else {
    results.style.opacity = '0.55';
  }
  window.__naverReqSeq = (window.__naverReqSeq || 0) + 1;
  const seq = window.__naverReqSeq;
  google.script.run
    .withSuccessHandler(function(res){
      if (seq !== window.__naverReqSeq) return;
      results.style.opacity = '1';
      onNaverSearchSuccess(res, q);
    })
    .withFailureHandler(function(err){
      if (seq !== window.__naverReqSeq) return;
      results.style.opacity = '1';
      onNaverSearchFail(err);
    })
    .searchNaverAddress(q);
}

// 자동완성 디바운스 호출 입력 즉시 반응
function scheduleNaverAutoSearch() {
  const input = document.getElementById('naverQuery');
  if (!input) return;
  if (window.__naverDebounceTm) clearTimeout(window.__naverDebounceTm);
  const v = (input.value || '').trim();
  const results = document.getElementById('naverResults');
  if (!v) {
    if (results) results.innerHTML = '<div style="padding:30px; text-align:center; color:#6b7280; font-size:13px;">상호 건물명 도로명 등을 입력하면 자동으로 검색됩니다</div>';
    return;
  }
  window.__naverDebounceTm = setTimeout(runNaverLocalSearch, 180);
}

// HTML 이스케이프
function escapeHtmlAddr(s) {
  return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
    return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
  });
}

// 네이버 검색 성공
function onNaverSearchSuccess(res, queryText) {
  const results = document.getElementById('naverResults');
  if (!results) return;
  if (!res || !res.ok) {
    results.innerHTML = '<div style="padding:30px; text-align:center; color:#b91c1c; font-size:13px;">검색 실패: '
      + escapeHtmlAddr((res && res.error) || '알 수 없는 오류') + '</div>';
    return;
  }
  if (!res.items || !res.items.length) {
    results.innerHTML = '<div style="padding:30px; text-align:center; color:#6b7280; font-size:13px;">검색 결과가 없습니다</div>';
    return;
  }
  results.innerHTML = '';
  res.items.forEach(function(it){
    const name = it.title || '';
    const card = document.createElement('div');
    card.style.cssText = 'padding:10px 12px; border:1px solid #e5e7eb; border-radius:8px; margin-bottom:8px; background:#fff;';
    if (name) {
      const head = document.createElement('div');
      head.style.cssText = 'font-weight:bold; color:#111827; margin-bottom:4px;';
      head.textContent = name;
      card.appendChild(head);
    }
    if (it.category) {
      const cat = document.createElement('div');
      cat.style.cssText = 'font-size:12px; color:#6b7280; margin-bottom:4px;';
      cat.textContent = it.category;
      card.appendChild(cat);
    }
    if (it.roadAddress) {
      card.appendChild(makeAddrRow_('도로명', it.roadAddress, composeAddrWithBuilding_(it.roadAddress, name)));
    }
    if (it.address) {
      card.appendChild(makeAddrRow_('지번', it.address, composeAddrWithBuilding_(it.address, name)));
    }
    results.appendChild(card);
  });
}

// 주소 행 만들기 클릭 시 해당 주소 선택
function makeAddrRow_(label, text, fullAddr) {
  const row = document.createElement('div');
  row.style.cssText = 'display:flex; align-items:center; gap:8px; padding:6px 8px; margin-top:4px; border-radius:6px; cursor:pointer; background:#f9fafb; border:1px solid #e5e7eb;';
  row.onmouseenter = function(){ row.style.background = '#eff6ff'; row.style.borderColor = '#93c5fd'; };
  row.onmouseleave = function(){ row.style.background = '#f9fafb'; row.style.borderColor = '#e5e7eb'; };
  const tag = document.createElement('span');
  tag.style.cssText = 'flex:0 0 auto; font-size:11px; font-weight:bold; color:#fff; background:' + (label === '도로명' ? '#2563eb' : '#6b7280') + '; padding:2px 6px; border-radius:4px;';
  tag.textContent = label;
  const body = document.createElement('span');
  body.style.cssText = 'flex:1; font-size:13px; color:#374151;';
  body.textContent = text;
  row.appendChild(tag);
  row.appendChild(body);
  row.addEventListener('click', function(){ applyAddrToTarget(fullAddr); });
  return row;
}

// 주소 끝에 건물명 추가 단어 중복 제거
function composeAddrWithBuilding_(addr, name) {
  const a = String(addr || '').trim();
  const n = String(name || '').trim();
  if (!a) return n;
  if (!n) return a;
  if (a.indexOf(n) >= 0) return a;
  return dedupeAddrWords_(a + ' ' + n);
}

// 공백 기준 단어 중복 제거
function dedupeAddrWords_(text) {
  const words = String(text || '').split(/\s+/).filter(Boolean);
  const seen = {};
  const out = [];
  words.forEach(function (w) {
    if (seen[w]) return;
    seen[w] = 1;
    out.push(w);
  });
  return out.join(' ');
}

