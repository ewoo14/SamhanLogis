function priceFrom(obj, { priceKeys = ['price','unitPrice','priceRight'], listKeys = ['list','출고가','listPrice','msrp','wholesale','출고가Left','listLeft'] } = {}) {
  // 첫 유효 키 값을 고름
  const first = (o, ks) => {
    for (const k of ks) {
      const v = o && o[k];
      if (v != null && v !== '' && !Number.isNaN(v)) return v;
    }
    return 0;
  };

  const p = Number(first(obj, priceKeys)) || 0;
  if (p) return Math.round(p);

  const l = Number(first(obj, listKeys)) || 0;
  return Math.round(l);
}

