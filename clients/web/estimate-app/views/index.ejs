// 이미지 데이터와 모달 상태 관리 변수
let loadedGateImages = [];
let gateImagesReady = false;

// 이미지호출
function prepareGateImages(images) {
  if (!images || images.length === 0) {
    gateImagesReady = false;
    return;
  }
  loadedGateImages = images;
  gateImagesReady = true;

  const isLoginGateHidden = document.getElementById('pageBizGate').classList.contains('hidden');
  const isWelcomeGateHidden = document.getElementById('mobileGate').classList.contains('hidden');
  
  // 지연로딩처리
  if (isLoginGateHidden && isWelcomeGateHidden) {
    showGateImageModal();
  }
}

// 모달 및 슬라이더 제어
let imgCurrentIndex = 0;

function showGateImageModal() {
  const modal = document.getElementById('gateImageModal');
  const track = document.getElementById('gateImgTrack');
  const btnPrev = document.getElementById('btnImgPrev');
  const btnNext = document.getElementById('btnImgNext');
  
  if (!modal || loadedGateImages.length === 0) return;

  // 이미지 트랙 구성
  let html = '';
  loadedGateImages.forEach(src => {
    const safeSrc = safeEstimateImageSrcAttr(src);
    if (safeSrc) html += `<div class="img-slide"><img src="${safeSrc}"></div>`;
  });
  track.innerHTML = html;

  // 화살표 표시 여부
  if (loadedGateImages.length > 1) {
    if(btnPrev) btnPrev.classList.remove('hidden');
    if(btnNext) btnNext.classList.remove('hidden');
  } else {
    if(btnPrev) btnPrev.classList.add('hidden');
    if(btnNext) btnNext.classList.add('hidden');
  }

  // 모달 보이기 & 첫 슬라이드 초기화
  modal.classList.remove('hidden');
  imgCurrentIndex = 0;
  updateImgSlide();

  // 닫기 버튼
  const closeBtn = document.getElementById('btnImgClose');
  if(closeBtn) {
    closeBtn.onclick = function() {
      modal.classList.add('hidden');
    };
  }

  // 화살표
  if(btnPrev) {
    btnPrev.onclick = function() {
      if (imgCurrentIndex > 0) {
        imgCurrentIndex--;
      } else {
        imgCurrentIndex = loadedGateImages.length - 1; // 루프
      }
      updateImgSlide();
    };
  }
  if(btnNext) {
    btnNext.onclick = function() {
      if (imgCurrentIndex < loadedGateImages.length - 1) {
        imgCurrentIndex++;
      } else {
        imgCurrentIndex = 0; // 루프
      }
      updateImgSlide();
    };
  }
}

function updateImgSlide() {
  const track = document.getElementById('gateImgTrack');
  if(track) {
    track.style.transform = `translateX(-${imgCurrentIndex * 100}%)`;
  }
}

/* 할인율 분리적용 */
(function() {
  
  /* 원본함수 보존 */
  const originBuildSendRows = window.buildSendRows;
  const originOpenPreview   = window.openPreview;

  /* 실내기 단독여부 판단 */
  function isIndoorOnly() {
    let qTotal = 0;
    let qOut = 0;
    
    if(typeof homeQty !== 'undefined' && typeof HOMEMULTI !== 'undefined') {
      HOMEMULTI.forEach(r => {
        const q = homeQty.get(r.model) || 0;
        if(q > 0) {
          qTotal += q;
          if(/실외기|outdoor/i.test((r.name||'')+' '+(r.catL||''))) qOut += q;
        }
      });
    }
    
    if(typeof commQty !== 'undefined' && typeof COMMULTI !== 'undefined') {
      COMMULTI.forEach(r => {
        const q = commQty.get(r.model) || 0;
        if(q > 0) {
          qTotal += q;
          if(/실외기|outdoor/i.test((r.name||'')+' '+(r.catL||''))) qOut += q;
        }
      });
    }
    
    return (qTotal > 0 && qOut === 0);
  }

  /* 보너스율 계산 */
  function getTierBonusRate(sum) {
    if (sum >= 100000000) return 0.04;
    if (sum >= 50000000)  return 0.03;
    if (sum >= 30000000)  return 0.02;
    if (sum >= 10000000)  return 0.01;
    return 0;
  }

  /* 45% 여부확인 */
  function isStandard45(rate) {
    return Math.abs(rate - 0.45) < 0.001;
  }

  /* 메인 래퍼 */
  function runWithAdjustedRates(callback) {
    /* 현재설정값 백업 */
    const oldH = Number(window.DISCOUNT_RATE_HOME || 0);
    const oldC = Number(window.DISCOUNT_RATE_COMM || 0);
    
    let calcH = oldH;
    let calcC = oldC;
    
    /* 실내기 단독체크 (45% -> 40%) */
    if(isIndoorOnly()) {
      if(isStandard45(calcH)) calcH = 0.40;
      if(isStandard45(calcC)) calcC = 0.40;
    }

    /* 홈멀티 보너스 (45%일때만 & 홈총액기준) */
    if(isStandard45(calcH)) {
      const hSum = (typeof sumHome === 'function') ? sumHome() : 0;
      const hBonus = getTierBonusRate(hSum);
      if(hBonus > 0) calcH += hBonus;
    }

    /* 상업멀티 보너스 (45%일때만 & 상업총액기준) */
    if(isStandard45(calcC)) {
      const cSum = (typeof sumComm === 'function') ? sumComm() : 0;
      const cBonus = getTierBonusRate(cSum);
      if(cBonus > 0) calcC += cBonus;
    }

    /* 전송용 변수저장 및 적용 */
    window.LATEST_CALC_RATES = { home: calcH, comm: calcC };
    window.DISCOUNT_RATE_HOME = calcH;
    window.DISCOUNT_RATE_COMM = calcC;

    let result;
    try {
      /* 실행 */
      result = callback();
    } finally {
      /* 복구 */
      window.DISCOUNT_RATE_HOME = oldH;
      window.DISCOUNT_RATE_COMM = oldC;
    }
    
    /* 적요 텍스트 치환 */
    if(Array.isArray(result)) {
       const txtOldH = Math.round(oldH * 100) + '%';
       const txtNewH = Math.round(calcH * 100) + '%';
       
       const txtOldC = Math.round(oldC * 100) + '%';
       const txtNewC = Math.round(calcC * 100) + '%';

       result.forEach(r => {
         if(!r) return;
         
         let targetOld, targetNew;
         /* 섹션별 치환기준 설정 */
         if(r.section === 'HOME') { targetOld=txtOldH; targetNew=txtNewH; }
         else if(r.section === 'COMM') { targetOld=txtOldC; targetNew=txtNewC; }
         else return;

         r.rateInfo = targetNew;

         /* 텍스트 치환 실행 */
         if(targetOld !== targetNew && r.REMARKS && typeof r.REMARKS === 'string') {
           if(r.REMARKS.indexOf(targetOld) !== -1) {
             r.REMARKS = r.REMARKS.split(targetOld).join(targetNew);
           }
         }
       });
    }
    
    return result;
  }

  /* 래핑 적용 */
  window.openPreview = function() {
    runWithAdjustedRates(() => {
      originOpenPreview.apply(this, arguments);
    });
  };

  window.buildSendRows = function() {
    return runWithAdjustedRates(() => {
      return originBuildSendRows.apply(this, arguments);
    });
  };

})();

