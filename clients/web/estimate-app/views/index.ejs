/* 비율 */
function updateBranchRatios(){
  const outs = pickSelectedOutdoors();
  outs.forEach((o, idx)=>{
    const slot = `out${idx+1}`;
    let indoorSum = 0;
    let indoorCount = 0;
    
    /* 캡슐 */
    document.querySelectorAll(`.out-slot[data-out="${slot}"] .capsule.in-grid`).forEach(c=>{
      indoorSum += (parseInt(c.dataset.cap||0,10) * 0.1);
      indoorCount++;
    });
    
    /* 입력 */
    document.querySelectorAll(`.out-slot[data-out="${slot}"] .cap-input`).forEach(inp=>{
      const v = parseInt(inp.value, 10);
      if(v && !isNaN(v)) {
        indoorSum += (v * 0.1);
        indoorCount++;
      }
    });

    const row = o.row || {};
    const capRaw = row['용량'] ?? row['능력'] ?? row.capacity ?? o.cap ?? 0;
    const outdoorCap = parseFloat(String(capRaw).replace(/[^\d.]/g,'')) || 0;
    const ratio = outdoorCap ? (indoorSum / outdoorCap * 100) : 0;
    const name = String(row['품 명'] ?? row.name ?? '').trim();
    const tight = /프라임|한랭지|표준형|냉난방|가스히트펌프|GHP|프레스티지|동시냉난방|공장전원/i.test(name);
    const limit = tight ? 103.0 : 120.0;
    
    /* 초과여부 */
    const maxAllowed = parseInt(row.maxIndoor || 0, 10);
    const isExceed = maxAllowed > 0 && indoorCount > maxAllowed;

    const badge = document.querySelector(`[data-ratio="${slot}"]`);
    if (badge) {
      if (isExceed) {
        badge.textContent = '수량 초과';
        badge.style.color = '#dc2626';
        badge.style.fontWeight = 'bold';
        badge.title = `최대 허용: ${maxAllowed}대 / 입력: ${indoorCount}대`;
      } else {
        badge.textContent = `${ratio.toFixed(1)}%`;
        badge.style.color = '';
        badge.style.fontWeight = '';
        badge.title = '';
        badge.classList.toggle('ratio-bad', ratio > limit);
      }
    }
  });
}

/* 스냅샷 */
function snapshotBranchState(){
  const rows = Array.from(document.querySelectorAll('.indoor-cell')).map(c=>{
    const chip = c.querySelector('.capsule:not(.in-grid)');
    return chip ? {model:chip.dataset.model, cap:parseInt(chip.dataset.cap||'0',10)} : null;
  });
  const grid = {};
  const outs = document.querySelectorAll('.out-head').length;
  for(let i=1; i<=outs; i++){
    grid[`out${i}`] = Array.from(document.querySelectorAll(`.out-slot[data-out="out${i}"]`)).map(z=>{
      const chip = z.querySelector('.capsule.in-grid');
      if(chip) { return { type: 'chip', model: chip.dataset.model, cap: parseInt(chip.dataset.cap||'0', 10) }; }
      const inp = z.querySelector('.cap-input');
      if(inp && inp.value !== null && String(inp.value).trim() !== '') { return { type: 'input', val: String(inp.value).trim() }; }
      return null;
    });
  }
  const extras = {};
  document.querySelectorAll('.extra-branch').forEach(inp => {
    const k = inp.parentElement.dataset.k;
    if(k) extras[k] = inp.value;
  });
  const outNames = {};
  document.querySelectorAll('.out-name-input').forEach(inp => {
    outNames[inp.dataset.out] = inp.value;
  });
  const outOrder = [];
  document.querySelectorAll('.branch-table thead th.out-head').forEach(th => {
    if(th.dataset.out) outOrder.push(th.dataset.out);
  });
  return { rows, grid, extras, outNames, outOrder };
}

/* 분기관매칭 */
function pushBranchPartsToCommFromBadges(){
  const MAP = {
    '1509':'AXJ-YA1509N','2512':'AXJ-YA2512N','2812':'AXJ-YA2812M',
    '2815':'AXJ-YA2815M','3419':'AXJ-YA3419M','4119':'AXJ-YA4119M'
  };

  const totals = { '1509':0,'2512':0,'2812':0,'2815':0,'3419':0,'4119':0 };
  document.querySelectorAll('.code-cell').forEach(c=>{
    const k=(c.dataset.code||'').trim();
    if(k in totals) totals[k]+=1;
  });

  Object.entries(totals).forEach(([k,v])=>{
    const m = MAP[k];
    if(m) {
      const extraInp = document.querySelector(`#branchSummaryBar [data-k="${k}"] .extra-branch`);
      const extraVal = extraInp ? parseInt(extraInp.value || '0', 10) : 0;
      const finalVal = v + extraVal;

      commQty.set(m, finalVal);
      const inp = document.querySelector(`#commBody .qty-input[data-model="${CSS.escape(m)}"]`);
      if(inp) inp.value = finalVal ? String(finalVal) : '';
    }
  });

  if(typeof updateCommRatio==='function') updateCommRatio();
  if(typeof syncCommTotals==='function') syncCommTotals();
}

