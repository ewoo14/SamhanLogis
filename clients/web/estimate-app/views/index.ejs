// CSV 필드 이스케이프
function escapeBOCsvField(val) {
  if (val == null) return '';
  const s = String(val);
  if (/[",\r\n]/.test(s)) {
    return '"' + s.replace(/"/g, '""') + '"';
  }
  return s;
}

// BO 업로드용 CSV 내보내기
async function processBOCSVExport() {
  closeSaveOptions();

  const sections = getStructuredQuoteData();
  if (sections.length === 0) {
    alert('데이터 없음');
    return;
  }

  // 거래처명
  let custName = '거래처미상';
  const custInput = document.getElementById('custSearch');
  if (custInput && custInput.value.trim() !== '') {
    custName = custInput.value.trim();
  }

  // 날짜
  const today = new Date();
  const yymmdd = today.getFullYear().toString().slice(2) +
                 String(today.getMonth() + 1).padStart(2, '0') +
                 String(today.getDate()).padStart(2, '0');

  const fileName = `${custName}_BO_${yymmdd}.csv`;

  // 헤더
  const headers = ['항번','대표모델항번','Product Code','Oppty. 수량','수주(예상)수량','견 적 금 액','견적금액(VAT포함)','서비스보증기간'];
  const lines = [headers.map(escapeBOCsvField).join(',')];

  // 제외 키워드
  const excludeKeywords = ['유연호스', '발통', '일자발', '방진가대'];

  // 데이터 적재
  let seq = 10;
  sections.forEach(sec => {
    sec.rows.forEach(r => {
      if (r.type !== 'item') return;
      const model = (r.model || '').toString().trim();
      if (!model) return;
      const qty = Number(r.qty) || 0;
      if (qty === 0) return;

      const nameStr = ((r.originalName || '') + ' ' + (r.name || '')).replace(/\s+/g, '');
      if (excludeKeywords.some(k => nameStr.includes(k))) return;

      const row = [
        seq,
        seq,
        escapeBOCsvField(model),
        qty,
        qty,
        '',
        '',
        ''
      ];
      lines.push(row.join(','));
      seq += 10;
    });
  });

  // 데이터 없음 처리
  if (lines.length <= 1) {
    alert('내보낼 품목이 없습니다');
    return;
  }

  // 파일 생성
  const csvContent = '﻿' + lines.join('\r\n');
  const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = fileName;
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  setTimeout(() => URL.revokeObjectURL(link.href), 1000);

  if (typeof logAction === 'function') {
    logAction('기능', '견적서 CSV BO용 저장');
  }
}

