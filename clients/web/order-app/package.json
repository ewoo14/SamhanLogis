{
  "name": "@samhan/order-app",
  "version": "0.4.0",
  "private": true,
  "description": "삼한공조시스템 거래처 주문서 web app v4 — legacy partner-order/index.html (9427 라인) 그대로 임베드 + shim + PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local-dev": "node ../../../scripts/run-client-local-dev.cjs web-order-app",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
