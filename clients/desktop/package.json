{
  "name": "@samhan/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Samhan Public 사내 직원용 데스크톱 앱 (Electron)",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:legacy && electron-vite dev",
    "local-dev": "node ../../scripts/run-client-local-dev.cjs desktop",
    "build": "npm run build:legacy && electron-vite build",
    "build:legacy": "node scripts/build-legacy-estimate.cjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:print-renderer": "vite build --config vite.print-renderer.config.ts",
    "build:capacitor": "vite build --config vite.capacitor.config.ts",
    "cap:sync": "npm run build:capacitor && cap sync android",
    "preview": "electron-vite preview",
    "build:win": "npm run build:legacy && electron-vite build && electron-builder --win",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "capture:v4": "node scripts/capture-v4-sales.cjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/preferences": "^8.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@samhan/design-system": "file:../web/design-system",
    "@tanstack/react-query": "^5.59.20",
    "axios": "^1.7.7",
    "electron-store": "^10.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/react": "^16.3.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
