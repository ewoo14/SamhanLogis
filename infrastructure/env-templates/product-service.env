# product-service 전용 환경변수 템플릿 (Phase 2 / Phase 6).

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준.
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- Google Sheets sync (Phase 6 M1a) ----------------------------------
# 시크릿: SAMHAN_GOOGLE_SERVICE_ACCOUNT_KEY 환경변수 (사용자 직접 GCP 콘솔 발급).
GOOGLE_SHEETS_SHEET_ID=1RJqO3jT-yJTi3NDBhL60o_cZWlVETGTU7UlvIKXuVNQ
GOOGLE_SERVICE_ACCOUNT_KEY=/etc/samhan/sa-key.json
GOOGLE_SHEETS_CACHE_TTL_MIN=5
PRODUCT_SYNC_SCHEDULING_ENABLED=true
PRODUCT_SYNC_CRON=0 0 * * * *

# --- 시드 dry-run -------------------------------------------------------
SEED_DRY_RUN_MODE=true
SEED_REPORT_DIR=docs/dev-reports
SEED_SHEET_DIR=../../migration/source/sheet
