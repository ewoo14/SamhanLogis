# arologis-service 전용 환경변수 템플릿 (Phase 10 W10-1 — arologis 배차 마이크로서비스).
# Phase 10/11 renumber 적용 (D-P10-05) — 신규 Phase 10 = arologis / 기존 Phase 10 (AWS) → Phase 11.
# 모든 시크릿 값은 CHANGE_ME_LOCAL_ONLY placeholder — 실제 배포 시점에 secrets manager / .env 로 override.

# --- Server -------------------------------------------------------------
SAMHAN_AROLOGIS_PORT=8097

# --- DataSource (PostgreSQL) ---------------------------------------------
# Phase 10 W10-1 chained-default 패턴 — SAMHAN_AROLOGIS_DB_* 표준, LEGACY_DB_* legacy fallback (Phase 11 cutover 단일화).
SAMHAN_AROLOGIS_DB_HOST=localhost
SAMHAN_AROLOGIS_DB_PORT=5432
SAMHAN_AROLOGIS_DB_NAME=arologis_db
SAMHAN_AROLOGIS_DB_USER=CHANGE_ME_LOCAL_ONLY
SAMHAN_AROLOGIS_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 표준 (chained-default).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- 외부 의존 service URL (4 client) ----------------------------------
# 4 client 의 기본 URL — Phase 11 cutover 시점에 service-discovery 기반 lookup 으로 전환.
SAMHAN_PARTNER_SERVICE_URL=http://partner-service:8095
SAMHAN_USER_SERVICE_URL=http://user-service:8083
SAMHAN_SLIP_SERVICE_URL=http://slip-service:8084
SAMHAN_NOTIFICATION_SERVICE_URL=http://notification-service:8093

# --- 외부 호출용 본 service URL (호출자가 사용) ----------------------------
# 형제 service 가 arologis-service /internal/** 호출 시 사용.
SAMHAN_AROLOGIS_SERVICE_URL=http://arologis-service:8097

# --- Phase 8 2차 ServiceDiscoveryClient provider toggle ---------------------
# eureka (default) | aws-cloud-map (Phase 11 cutover 시점 활성)
SAMHAN_DISCOVERY_PROVIDER=eureka

# --- Phase 10 W10-4 (PR #99) — 4 client skeleton-mode 토글 활성 ----------------
# true (W10-1 default) — 4 client (partner / user / slip / notification) 외부 호출 회피.
# false (W10-4 시점 활성, Phase F D-DF-01 재확정) — slip-service /internal/slips/{slipId}/signatures 양쪽 저장.
# W10-2 인성데이타 통합 시점 동시 활성 (PartnerClient / UserClient 도 함께 false 전환).
SAMHAN_AROLOGIS_CLIENT_SKELETON_MODE=false

# --- Phase F (D-DF-10) — 사본 PNG 디스크 저장 경로 ------------------------------
# CopyImageDiskStorage 가 본 디렉토리 + <signatureId>.png 로 합성된 출고전표 사본 저장.
# Phase 11 cutover 시점 S3 키 (s3://samhan-air-signature-copies/<id>.png) 로 전환.
# Docker 컨테이너 = /var/lib/arologis/signature-copies (VOLUME 마운트). 로컬 dev = /tmp/arologis-copies 권장.
AROLOGIS_SIGNATURE_COPY_DIR=/var/lib/arologis/signature-copies

# --- Phase F (D-DF-06) — print-renderer 정적 file:// 경로 ----------------------
# Docker 이미지 안에 동봉된 multi-entry Vite 산출물 (Stage 1: clients/desktop print-renderer 빌드).
# PlaywrightCopyRenderer 가 본 URL + ?slip=<base64>&driverSig=<b64>&recipientSig=<b64> 로 goto 후
# A4 portrait 영역 screenshot → PNG.
AROLOGIS_PRINT_RENDERER_URL=file:///app/print-renderer/index.html

# --- Phase F (D-DF-06) — Playwright Chromium 단일 페이지 렌더 timeout ------------
# 8000ms = goto + load 완료 + screenshot 합산 한도. timeout 시 RENDERER_TIMEOUT 로 200 응답
# (D-DF-06 — 사본 합성/발송은 best effort, 서명 본체 저장은 이미 Tx1 에서 완료).
AROLOGIS_PLAYWRIGHT_TIMEOUT_MS=8000

# --- Phase 10 W10-1 — DriverMatcher provider 토글 (D-P10-03) -----------------
# mock (default, W10-1) | insung-quick (W10-2 인성데이타 vendor 통합 시점 활성)
SAMHAN_AROLOGIS_MATCHER_PROVIDER=mock

# --- 인성데이타 퀵프로그램 vendor 시크릿 (W10-2 통합 시점 활성) -------------------
# 5만 프리랜서 풀 — 사용자 결정 2026-05-07.
# SP-09 외부 vendor 키 보안 정책: 빈 값 유지 + placeholder 사용 금지 + 운영 PC `.env` 주입.
# Phase 10 W10-2 인성데이타 vendor sandbox 키 발급 후 .env 에 설정.
# blank/placeholder 시 InsungQuickClient 가 runtime guard 로 차단 (NTS/Aligo 패턴 일관).
# SP-10-2 신규: sandboxMode/webhookSecret/알림채널/GPS 설정 추가.
SAMHAN_INSUNG_QUICK_API_URL=
SAMHAN_INSUNG_QUICK_API_KEY=
SAMHAN_INSUNG_QUICK_PARTNER_ID=
SAMHAN_INSUNG_QUICK_SANDBOX_MODE=true
SAMHAN_INSUNG_QUICK_WEBHOOK_SECRET=
SAMHAN_AROLOGIS_NOTIFY_DISPATCH_CHANNEL=insung-talk
SAMHAN_AROLOGIS_NOTIFY_INVITE_CHANNEL=aligo
SAMHAN_AROLOGIS_GPS_PRIORITY=insung-lbs,app-gps,manual
SAMHAN_AROLOGIS_GPS_STALE_THRESHOLD_MS=60000

# --- Phase 10 W10-1 — DriverLocation GPS 30일 cleanup 정책 -------------------
# Daily 03:00 KST scheduled. 1일 이상 자연수.
SAMHAN_AROLOGIS_LOCATION_RETENTION_DAYS=30

# --- Phase 10 W10-1 — GPS 하이브리드 priority (사용자 결정 4, 2026-05-07) ----------
# SP-10-2 W10-2: SAMHAN_AROLOGIS_GPS_PRIORITY / SAMHAN_AROLOGIS_GPS_STALE_THRESHOLD_MS 는
# 위 인성데이타 vendor 섹션에서 선언 (SAMHAN_INSUNG_QUICK_* 그룹 인접). 아래는 참조 주석만 유지.
# 값 = comma-separated source 우선순위 (insung-lbs / app-gps / manual).
# → SAMHAN_AROLOGIS_GPS_PRIORITY=insung-lbs,app-gps,manual  (위 SP-10-2 섹션 참조)

# --- 아로로지스 → Samhan Public slip-service 배차 회신 (Phase A — samhan-dispatch-board) ----
# spec: docs/superpowers/specs/2026-05-14-samhan-dispatch-board-design.md §3 / §6
#
# Mock matcher 매칭 완료/실패 시점, arologis-service 가 slip-service 의
# /internal/dispatch-tasks/{id}/confirm 또는 /unavailable 로 결과 회신.
#
# 호출 보안 = X-Internal-Token: ${SAMHAN_INTERNAL_TOKEN} 헤더 (위 표준 토큰 재사용).
# 슬립 배차 회신 URL (Mock matcher 결과 통보)
SAMHAN_SLIP_DISPATCH_TASK_URL=http://slip-service:8086

# --- Mock matcher 실패 확률 (Phase A only) -----------------------------------
# 0.0 (default) = 항상 성공 (DISPATCHED).
# 1.0          = 항상 실패 (FAILED → slip UNDISPATCHED 복귀).
# QA 시나리오 6 (Mock matcher 불가 시뮬레이션) 검증 시 한시 1.0 으로 설정 후 원복.
# W10-2 인성데이타 vendor 통합 (SAMHAN_AROLOGIS_MATCHER_PROVIDER=insung-quick) 시점 무시.
# Mock matcher 실패 확률 (Phase A, 0.0=항상 성공)
SAMHAN_AROLOGIS_MOCK_FAIL_RATE=0.0
