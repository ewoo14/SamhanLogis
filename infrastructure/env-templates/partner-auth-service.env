# partner-auth-service 전용 환경변수 템플릿 (Phase 6 M2).

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partner_auth_db
DB_USER=samhan
DB_PASSWORD=dev-pw-change-me

# 주문서웹 QA 전용 거래처 시더 (infrastructure/.env.local 에만 실제 값을 설정)
# QA_PARTNER_ORDER_PASSWORD=

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- JWT 서명 비밀키 (partner JWT) -------------------------------------
# Phase 8 2차 — SAMHAN_JWT_SECRET 표준 (JWT_SECRET legacy fallback 보존).
SAMHAN_JWT_SECRET=dev-only-partner-jwt-secret-replace-in-prod-32bytes-min!!
JWT_SECRET=dev-only-partner-jwt-secret-replace-in-prod-32bytes-min!!

# --- dc-config-service 호출 URL ---------------------------------------
# Phase 8 2차 — full URL 표준 (SAMHAN_DC_CONFIG_SERVICE_URL 우선, DC_CONFIG_URL legacy fallback).
SAMHAN_DC_CONFIG_SERVICE_URL=http://dc-config-service:8089
DC_CONFIG_URL=http://dc-config-service:8089
