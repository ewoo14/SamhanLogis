# slip-service 전용 환경변수 템플릿 (Slice B / notification-slice-B 후속).
#
# 이 파일은 slip-service 컨테이너 또는 systemd 유닛이 참조할 수 있는
# per-service env 템플릿입니다. infrastructure/.env.example 가 docker-compose
# 인프라 스택용이라면, 본 파일은 application 런타임 (bootRun / Docker / systemd)
# 전용으로 분리되어 있습니다.
#
# 사용법 (파일 복사만으로 Spring/Compose 가 자동 로드하지 않음):
#   - bootRun/systemd: 본 파일의 값을 shell export 또는 systemd EnvironmentFile 로 로드
#   - local compose: docker compose --env-file infrastructure/env-templates/slip-service.env \
#       -f infrastructure/docker-compose.yml -f infrastructure/docker-compose.local-all.yml up -d slip-service
#   - prod compose: user_data.sh 가 생성한 /opt/samhanlogis/.env.production 을 사용
#
# 모든 값은 DEV-ONLY 기본값입니다. staging/prod 배포 시 안전한 값으로 교체.

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=slip_db
DB_USER=samhan
DB_PASSWORD=samhan_dev_pw
# 창고 매핑 — 이 파일은 DEV_SUBSTITUTE를 명시한 개발 예시다.
WAREHOUSE_MAPPING_MODE=DEV_SUBSTITUTE
WAREHOUSE_UUID_ECOUNT_00003=11111111-1111-1111-1111-000000000001
WAREHOUSE_UUID_ECOUNT_2=11111111-1111-1111-1111-000000000002
WAREHOUSE_UUID_ECOUNT_14=11111111-1111-1111-1111-000000000003
WAREHOUSE_UUID_ECOUNT_1=11111111-1111-1111-1111-000000000004
# #809 R6-M2 + D-R8-2 — slip-service 메인 DataSource 의 Hikari 커넥션 획득 대기 상한(ms).
# application.yml spring.datasource.hikari.connection-timeout 이 소비.
# 기본 30000 = fleet 표준(Hikari 기본값). 종전 4000 전역화는 사용자 요청 경로까지 4초로
# 묶어 pool 포화 시 HTTP 500 을 유발했고, fleet 26모듈 중 slip-service 만의 예외였다.
# 가격기억 fail-soft 의 4초 정책은 아래 전용 pool 노브로 격리됐다.
# (docs/runbooks/slip-price-memory-upsert-failure.md "관련 운영 노브").
DB_CONNECTION_TIMEOUT_MS=30000

# #809 D-R8-2 — 가격기억 전용 DataSource pool (app.slip.price-memory.datasource.hikari).
# 메인 pool 과 격리되어 있어 여기 값은 사용자 요청 경로에 영향을 주지 않는다.
# url/user/password 는 spring.datasource.* 를 공유한다 (같은 DB, 다른 pool).
# POOL_MAX 4 = SAMHAN_PRICE_MEMORY_ASYNC_MAX_POOL_SIZE 4 와 1:1 (worker 당 커넥션 1).
SAMHAN_PRICE_MEMORY_DB_CONNECTION_TIMEOUT_MS=4000
SAMHAN_PRICE_MEMORY_DB_POOL_MAX=4
SAMHAN_PRICE_MEMORY_DB_POOL_MIN_IDLE=0

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# auth-service 와 user-service 의 /auth/internal/** 호출에 사용.
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존, Phase 10 cutover 시점 단일화).
SAMHAN_INTERNAL_TOKEN=dev-internal-token-change-me
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me

# --- Dynamic RBAC (auth-service) ----------------------------------------
# @RequirePermission 이 auth-service 의 /auth/internal/permissions/check 를 직접 조회한다.
SAMHAN_AUTH_SERVICE_URL=http://localhost:8081
# #809 — 권한 조회는 사용자 요청 critical path 이므로 게이트웨이 600초 timeout 을
# 상속하지 않고, repo 동기 RestClient 표준(연결 2s / 응답 3s)으로 auth 장애를
# 빠르게 fail-closed 한다 (application.yml samhan.auth-service.*-timeout-ms).
SAMHAN_AUTH_CONNECT_TIMEOUT_MS=2000
SAMHAN_AUTH_READ_TIMEOUT_MS=3000

# --- Realtime SSE Heartbeat (Phase 12 Step 1, PR-H1) --------------------
# slip-service 의 SSE 스트림에서 keep-alive 용 heartbeat 발송 주기 (초).
# - Reactor Netty / Reverse Proxy / LB 의 idle timeout 보다 짧게 유지 필요.
# - default 30s (api-gateway response-timeout 600s 와 정합).
# - BE 의 ScheduledExecutor 가 본 값을 ms 로 환산하여 사용
#   (`@Scheduled(fixedRateString = "${samhan.realtime.heartbeat-seconds:30}000")`).
# - 변경 시 nginx/ALB proxy_read_timeout 도 함께 검토 (docs/devops/realtime-sse-production.md).
SAMHAN_REALTIME_HEARTBEAT_SECONDS=30

# --- Realtime Broker (Phase 12 Step 2, PR-H2) ---------------------------
# slip-service 의 SSE fan-out broker 구현체 toggle.
# - in-memory (default) : 단일 노드 ConcurrentHashMap 기반. 추가 의존 0.
#                         Phase 11 AWS 단일 EC2 운영 모델 + cafe24 단일 호스팅 모두 적합.
# - redis              : Redis pub/sub 기반 다중 노드 fan-out. 다중 instance 운영 시점에만 활성.
# 전환 가이드 / ElastiCache 비용 / cutover 절차: docs/devops/redis-realtime-broker.md
SAMHAN_REALTIME_BROKER=in-memory

# --- Redis 연결 (samhan.realtime.broker=redis 일 때만 의미 있음) ----------
# - in-memory broker 에서는 미사용 (lazy 의존). default 미설정 시 localhost:6379 fallback.
# - 로컬 개발: infrastructure/docker-compose.yml 의 samhan-redis 컨테이너 (port 6379).
# - 운영 (Phase 11 AWS): AWS ElastiCache Redis cache.t3.micro 권장 (~₩30K/월).
#                       endpoint 예: my-redis.abc123.ng.0001.apne2.cache.amazonaws.com
# - 보안: 동일 VPC + Security Group 내부에서만 접근. 외부 노출 금지.
REDIS_HOST=
REDIS_PORT=6379

# --- Aligo SMS Gateway (Slice B, Solapi → Aligo 마이그) -----------------
# 출고 배송 기사 배치 단위 SMS 발송.
# - H2 local 프로파일: MockSmsGateway 활성 → 아래 값 미사용 (logging only).
# - PgSQL (default) 프로파일: AligoSmsGateway 활성 → 실 Aligo API 호출.
# - 발급: https://smartsms.aligo.in 가입 후 [API 연동] 메뉴에서 키 발급 + user_id 확인.
# - ALIGO_SENDER_PHONE 은 사전 발신번호 등록(전기통신사업법) 완료된 010 번호만.
# - 비용 (Aligo 표준): SMS 8.4원/건. 기사 5~10명/일 × 배치 1~3건 = 월 1.5~4.5천원.
# - 비용 모니터링: Phase 5 Notification Service 분리 시 Grafana 대시보드 추가.
ALIGO_API_KEY=dev-aligo-api-key-change-me
ALIGO_USER_ID=dev-aligo-user-id
ALIGO_SENDER_PHONE=01000000000
ALIGO_BASE_URL=https://apis.aligo.in

# --- Samhan Public → 아로로지스 배차 통신 (Phase A — samhan-dispatch-board) ----
# spec: docs/superpowers/specs/2026-05-14-samhan-dispatch-board-design.md §3 / §6
#
# 배차담당자가 [배차 완료] 클릭 → slip-service 가 본 URL 의
# /internal/arologis/dispatches 로 DispatchTask 페이로드 POST 전송 →
# arologis-service 의 Mock matcher 매칭 결과 회신.
#
# 호출 보안 = X-Internal-Token: ${SAMHAN_INTERNAL_TOKEN} 헤더.
# 양 service 가 같은 Eureka 에 등록되어 있어도, 운영은 본 URL 환경변수 우선 (Phase 11 cutover 전).
# 아로로지스 발송 URL (배차 완료 시점)
SAMHAN_AROLOGIS_DISPATCH_URL=http://arologis-service:8097

# --- P1 범용 사진 첨부 (samhan-attachments bucket) -----------------------
# slip-service 가 AttachmentService 를 통해 samhan-attachments bucket 에 사진을 저장.
# application.yml chained-default:
#   samhan.s3.endpoint: ${SAMHAN_S3_ENDPOINT:http://localhost:9000}
#   samhan.s3.bucket: ${SAMHAN_S3_BUCKET:samhan-attachments}
# 버킷 생성: infrastructure/scripts/setup-minio-buckets.ps1 (start-local-full.ps1 자동 호출)
# Phase 11 AWS S3 cutover: SAMHAN_S3_ENDPOINT 빈 값 → AWS SDK default endpoint 자동 전환.
SAMHAN_S3_ENDPOINT=http://localhost:9000
SAMHAN_S3_ACCESS_KEY=samhan
SAMHAN_S3_SECRET_KEY=samhan_dev_pw
SAMHAN_S3_BUCKET=samhan-attachments
SAMHAN_S3_PRESIGNED_EXPIRY=300

# --- 시리얼 보상 실패 운영 (D-SER-25 retention / D-SER-28 purge / D-SER-26 운영 알림 / D-SER-27 retry) -----------
#
# 모두 기본 비활성. Phase 11 cutover 시 함께 활성화 검토.
#
# [retention] resolved=true(수동 정합 완료) 보상 감사 행의 보존기간 만료분 자동 soft-delete.
#   - RETENTION_ENABLED=true 활성 시 cron(기본 매일 03:30 KST) 으로 정리.
#   - 미해소(resolved=false)·보존기간내 행은 절대 정리하지 않음.
# [purge] retention 으로 soft-delete 된 행 중 grace 기간(기본 30일) 경과분만 물리 삭제.
#   - PURGE_ENABLED=true 활성 시 cron(기본 매일 04:00 KST) 으로 단일 batch(기본 500건) 삭제.
#   - is_deleted=true AND deleted_at<cutoff 조건으로 활성 행은 삭제하지 않음.
# [alert] 보상 실패 발생 시 운영자에게 best-effort push 알림.
#   - ALERT_ENABLED=true 로만 켜고 RECIPIENT_USER_ID 를 비우면 발송 없이 WARN 만 출력하므로,
#     활성 시 반드시 실 운영자 user UUID 를 함께 지정해야 한다.
# [retry] 미해소 보상 실패 중 백오프가 지난 행을 자동 재시도.
#   - RETRY_ENABLED=true 활성 시 cron(기본 10분 간격) 으로 단일 후보 배치를 처리.
#   - max-retries 도달 시 자동 재시도 중단, 수동 정합 대상으로 유지.
#
# Phase 11 운영 체크리스트:
#   [ ] SAMHAN_COMPENSATION_RETENTION_ENABLED=true (보존기간 정리 활성)
#   [ ] SAMHAN_COMPENSATION_PURGE_ENABLED=true (retention soft-delete grace 경과분 물리 삭제 활성)
#   [ ] SAMHAN_COMPENSATION_ALERT_ENABLED=true + SAMHAN_COMPENSATION_ALERT_RECIPIENT_USER_ID=<운영자 user UUID>
#   [ ] SAMHAN_COMPENSATION_RETRY_ENABLED=true (보상 실패 자동 재시도 활성)
SAMHAN_COMPENSATION_RETENTION_ENABLED=false
SAMHAN_COMPENSATION_RETENTION_CRON=0 30 3 * * *
SAMHAN_COMPENSATION_RETENTION_ZONE=Asia/Seoul
SAMHAN_COMPENSATION_RETENTION_DAYS=90
SAMHAN_COMPENSATION_PURGE_ENABLED=false
SAMHAN_COMPENSATION_PURGE_CRON=0 0 4 * * *
SAMHAN_COMPENSATION_PURGE_ZONE=Asia/Seoul
SAMHAN_COMPENSATION_PURGE_GRACE_DAYS=30
SAMHAN_COMPENSATION_PURGE_BATCH_SIZE=500
SAMHAN_COMPENSATION_ALERT_ENABLED=false
SAMHAN_COMPENSATION_ALERT_RECIPIENT_USER_ID=
SAMHAN_COMPENSATION_RETRY_ENABLED=false
SAMHAN_COMPENSATION_RETRY_CRON=0 */10 * * * *
SAMHAN_COMPENSATION_RETRY_MAX=5
SAMHAN_COMPENSATION_RETRY_BACKOFF_MIN=10

# --- #809 거래처+품목 최근단가 기억 (price memory) 운영 노브 --------------
#
# 전표/견적 저장 성공 시 (partnerId, productId) 최근단가를 비동기 fail-soft 로
# 기억하는 보조 기능. upsert 가 실패해도 원 전표/견적 저장은 성공하며,
# /actuator/health 도 UP 을 유지한다 (조용한 기능 저하).
# application.yml 매핑: app.slip.price-memory.* — 보조 기능이 원 저장 경로와
# Hikari pool 을 장기 점유하지 않도록 전용 상한을 둔다.
#
# 튜닝 전 필독: docs/runbooks/slip-price-memory-upsert-failure.md
#   - `queue rejected` 포화 시 QUEUE_CAPACITY 만 무작정 늘리면 메모리와 stale
#     작업만 늘어난다 — slip-service 저장 burst 원인과 DB 지연을 먼저 확인.
#   - 경보: SlipPriceMemoryUpsertFailure (dev = Prometheus rule 기준.
#     prod(Phase 11 CloudWatch) 등가 알람은 CUTOVER.md 수동 체크리스트 참조).
#
# [lock/statement/tx] 인기 (partner_id, product_id) row 경합과 set-based
#   upsert(최대 100행)의 DB 점유 상한. 초과 시 해당 batch 만 실패-기록.
# [async pool/queue] 전용 executor core..max worker + bounded queue.
#   포화 시 queue rejected → slip_price_memory_upsert_failed_total 증가 + WARN.
SAMHAN_PRICE_MEMORY_LOCK_TIMEOUT_MS=1000
SAMHAN_PRICE_MEMORY_STATEMENT_TIMEOUT_MS=3000
SAMHAN_PRICE_MEMORY_TRANSACTION_TIMEOUT_SECONDS=4
SAMHAN_PRICE_MEMORY_ASYNC_CORE_POOL_SIZE=2
SAMHAN_PRICE_MEMORY_ASYNC_MAX_POOL_SIZE=4
SAMHAN_PRICE_MEMORY_ASYNC_QUEUE_CAPACITY=100
SAMHAN_PRICE_MEMORY_ASYNC_SHUTDOWN_AWAIT_SECONDS=5
