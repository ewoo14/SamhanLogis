# =============================================================================
# SamhanLogis 풀 수준 로컬 테스트 — 모든 service 의 시드 toggle 모음
# =============================================================================
#
# 본 파일은 DEV 환경 전용 — 서비스별 시드 환경변수 모음이다.
# 표준 기동에서는 product/inventory 시드를 끄며, 정합성 검증이 서비스 기동을 막지 않게 한다.
# 시드를 실행할 때만 SAMHAN_SEED_TEST_DATA=true를 명시적으로 지정한다.
#
# 사용법 (PowerShell):
#   Get-Content infrastructure/env-templates/.env.dev-seed |
#       ForEach-Object {
#           if ($_ -and -not $_.StartsWith('#')) {
#               $name, $value = $_ -split '=', 2
#               if ($name) { Set-Item "env:$name" $value }
#           }
#       }
#
# 또는 PowerShell 일괄 시작 스크립트 사용 (권장):
#   .\infrastructure\scripts\start-local-full.ps1
#
# 주의:
#   - 모든 SEED 변수는 production 진입 시 default false 또는 미설정 필수
#     (Phase 11 AWS cutover 시점 .env.prod 에서 본 변수 일체 미사용)
#   - seeder 는 idempotent — 재실행 시 row 중복 추가 안 됨 (existsBy* 검증)
#   - @Profile("dev") + @ConditionalOnProperty 이중 가드로 production 침입 방지
#
# W10-5 회고 — env 변수 prefix 통일 (SAMHAN_<X>_SEED_TEST_DATA).
#   application.yml 패턴: ${SAMHAN_<X>_SEED_TEST_DATA:${<X>_SEED_TEST_DATA:false}}
#   → SAMHAN_ prefix 우선, 기존 prefix 없는 변수는 legacy fallback 으로 보존.
#   본 파일은 양쪽 모두 export 하여 기존 사용자 환경 호환 + 신규 표준 일관 양립.
# =============================================================================

# --- Spring profile (전 service 공통) --------------------------------------
SPRING_PROFILES_ACTIVE=dev

# slip-service warehouse-code-map — 개발 환경이 대체 정책임을 명시한다.
# 아래 값은 로컬 dev seed의 consumer 대체값이며 staging alias 권위 원본이 아니다.
WAREHOUSE_MAPPING_MODE=DEV_SUBSTITUTE
WAREHOUSE_UUID_ECOUNT_00003=11111111-1111-1111-1111-000000000001
WAREHOUSE_UUID_ECOUNT_2=11111111-1111-1111-1111-000000000002
WAREHOUSE_UUID_ECOUNT_14=11111111-1111-1111-1111-000000000003
WAREHOUSE_UUID_ECOUNT_1=11111111-1111-1111-1111-000000000004

# =============================================================================
# 시드 toggle — 표준 prefix (SAMHAN_<X>_SEED_TEST_DATA / SAMHAN_USER_SEED_ORG)
# =============================================================================

# 1. user-service (Phase 2) — 16명 사원 (CEO 김미선 외 15명) + 5 부서
SAMHAN_USER_SEED_ORG=true

# 2. partner-service (Phase 9 W1) — 50건 거래처 (한국 HVAC 협력사)
SAMHAN_PARTNER_SEED_TEST_DATA=true
# 2-b. partner-service 첨부 placeholder seed (사업자등록증/명함) — 30 partner × ~2.5 = 75건
SAMHAN_PARTNER_SEED_TEST_ATTACHMENTS=true

# 3-4. product/inventory-service (Phase 2) — 공통 100 product + 200 inventory seed
#     표준 기동은 false. 시드 실행 시에만 true로 override하면 product 선행 후
#     inventory validator가 정합성을 확인하고, 실패 시 시드 실행을 중단한다.
SAMHAN_SEED_TEST_DATA=false

# 5. slip-service (Phase 3) — 100건 전표 (11 status 균등 분포)
SAMHAN_SLIP_SEED_TEST_DATA=false

# 6. partner-order-service (Phase 6 M4) — 30건 주문 (confirm 흐름 + outbox)
SAMHAN_PARTNER_ORDER_SEED_TEST_DATA=false
SAMHAN_FULL_SEED_TEST_DATA=false

# 7. arologis-service (Phase 10 W10-1) — 20건 배차 (Mock DriverMatcher)
SAMHAN_AROLOGIS_SEED_TEST_DATA=true

# 8. accounting-service (Phase 4) — 65 row 한국 일반기업회계기준 + 30 전표
SAMHAN_ACCOUNTING_SEED_TEST_DATA=true

# 9. groupware-service (Phase 9 W2) — 결재선 5 / 메신저 10 / 일정 20
SAMHAN_GROUPWARE_SEED_TEST_DATA=true

# 10. notification-service (Phase 9 W3) — 채널 매트릭스 (FCM/SES/Aligo) 시드
SAMHAN_NOTIFICATION_SEED_TEST_DATA=true

# 11. dashboard-service (Phase 9 W4) — KPI 캐시 + 2 materialized view 초기 refresh
SAMHAN_DASHBOARD_SEED_TEST_DATA=true

# =============================================================================
# Legacy fallback — 기존 prefix 없는 변수 (W10-5 이전 환경 호환).
#   application.yml 의 ${SAMHAN_<X>_SEED_TEST_DATA:${<X>_SEED_TEST_DATA:false}}
#   chained-default 의 두 번째 단계. SAMHAN_ prefix 만 export 해도 동작하지만,
#   양쪽 export 하여 외부 도구 / 사용자 셸 history 호환 보존.
# =============================================================================

USER_SEED_ORG=true
PARTNER_SEED_TEST_DATA=true
PARTNER_SEED_TEST_ATTACHMENTS=true
SLIP_SEED_TEST_DATA=true
PARTNER_ORDER_SEED_TEST_DATA=false
AROLOGIS_SEED_TEST_DATA=true
ACCOUNTING_SEED_TEST_DATA=true
GROUPWARE_SEED_TEST_DATA=true
NOTIFICATION_SEED_TEST_DATA=true
DASHBOARD_SEED_TEST_DATA=true

# =============================================================================
# 검증 방법:
#   1) 시작 스크립트 완료 직후 콘솔 row count 요약 확인
#   2) psql:
#        docker exec -it samhan-postgres psql -U samhan -d user_db -c "SELECT count(*) FROM employees;"
#        docker exec -it samhan-postgres psql -U samhan -d partner_db -c "SELECT count(*) FROM partners;"
#        docker exec -it samhan-postgres psql -U samhan -d product_db -c "SELECT count(*) FROM products;"
#        ... (start-local-full.ps1 의 step 5 가 자동 실행)
#   3) 마스터 로그인 (CEO 김미선):
#        POST http://localhost:8080/api/auth/login
#        body: {"loginId":"kimmiseon","password":"<see services/user-service/.../OrgChartSeeder.java>"}
# =============================================================================
