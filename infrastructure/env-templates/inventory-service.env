# inventory-service 전용 환경변수 템플릿 (Phase 2).

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준.
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- P1 검수 사진 MinIO (samhan-attachments 단일 bucket 통합 전략) -----------
# enabled=false → NoopInspectionAttachmentStorage fallback (CI / 단위 테스트 안전).
# 로컬 개발 시 setup-minio-buckets.ps1 실행 후 true 로 변경.
SAMHAN_INVENTORY_MINIO_ENABLED=false
SAMHAN_INVENTORY_MINIO_ENDPOINT=http://localhost:9000
SAMHAN_INVENTORY_MINIO_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
SAMHAN_INVENTORY_MINIO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
# bucket 이름 — setup-minio-buckets.ps1 의 samhan-attachments 버킷과 반드시 일치.
SAMHAN_INVENTORY_MINIO_BUCKET=samhan-attachments
# presigned URL TTL (초) — 보안 정책 300초 (5분). 운영 변경 시 이 값만 조정.
SAMHAN_S3_PRESIGNED_EXPIRY=300
