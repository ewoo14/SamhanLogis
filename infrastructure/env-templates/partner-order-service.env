# partner-order-service 전용 환경변수 템플릿 (Phase 6 M4).

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=partner_order_db
DB_USER=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_TOKEN legacy fallback 보존).
SAMHAN_INTERNAL_TOKEN=dev-only-token-replace
INTERNAL_TOKEN=dev-only-token-replace

# --- 외부 service 호출 URL --------------------------------------------
# Phase 8 2차 — full URL 표준 (SAMHAN_<SERVICE>_SERVICE_URL 우선, <NAME>_HOST legacy fallback).
SAMHAN_PRODUCT_SERVICE_URL=http://product-service:8084
SAMHAN_INVENTORY_SERVICE_URL=http://inventory-service:8085
SAMHAN_SLIP_SERVICE_URL=http://slip-service:8086
SAMHAN_DC_CONFIG_SERVICE_URL=http://dc-config-service:8089
SAMHAN_PARTNER_AUTH_SERVICE_URL=http://partner-auth-service:8091
PRODUCT_HOST=product-service
INVENTORY_HOST=inventory-service
SLIP_HOST=slip-service
DC_CONFIG_HOST=dc-config-service
PARTNER_AUTH_HOST=partner-auth-service

# --- Bootstrap cache refresh ----------------------------------------------
BOOTSTRAP_CACHE_REFRESH_MINUTES=10
# 주문 확정 확인 메일 수신자(선택). 비어 있으면 메일 요청을 생성하지 않음.
SAMHAN_PARTNER_ORDER_CONFIRMATION_EMAIL=
