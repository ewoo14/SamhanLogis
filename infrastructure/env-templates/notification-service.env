# notification-service 전용 환경변수 템플릿 (Phase 9 W3).
# 모든 시크릿 값은 CHANGE_ME_LOCAL_ONLY placeholder — 실제 배포 시점에 secrets manager / .env 로 override.

# --- Server -------------------------------------------------------------
SAMHAN_NOTIFICATION_PORT=8093

# --- DataSource (PostgreSQL) ---------------------------------------------
# Phase 8 2차 chained-default 패턴 — SAMHAN_NOTIFICATION_DB_* 표준, LEGACY_DB_* legacy fallback (Phase 10 cutover 단일화).
SAMHAN_NOTIFICATION_DB_HOST=localhost
SAMHAN_NOTIFICATION_DB_PORT=5432
SAMHAN_NOTIFICATION_DB_NAME=notification_db
SAMHAN_NOTIFICATION_DB_USER=CHANGE_ME_LOCAL_ONLY
SAMHAN_NOTIFICATION_DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- 외부 의존 service URL (UserClient) ----------------------------------
# user-service 의 /internal/users/{userId} + /internal/users/verify-bulk lookup 호출에 사용.
SAMHAN_USER_SERVICE_URL=http://user-service:8083

# --- 외부 호출용 본 service URL (호출자가 사용) ----------------------------
# 형제 service (groupware-service / partner-order-service / slip-service / dashboard-service) 가
# notification-service /internal/** 호출 시 사용.
SAMHAN_NOTIFICATION_SERVICE_URL=http://notification-service:8093

# --- Phase 8 2차 ServiceDiscoveryClient provider toggle ---------------------
# eureka (default) | aws-cloud-map (Phase 10 cutover 시점 활성)
SAMHAN_DISCOVERY_PROVIDER=eureka

# --- SP-09-2 Aligo SMS 실 발송 (Phase 11 sandbox 키 발급 후 .env 에 설정) ----
# placeholder 사용 금지 — AligoSmsAdapter 는 blank 시 stub 응답.
# 실 발송 전환: Phase 11 sandbox 키를 아래 4개 변수에 실값 설정.
# Spring property binding:
#   samhan.notification.aligo.key     ← SAMHAN_ALIGO_KEY
#   samhan.notification.aligo.userid  ← SAMHAN_ALIGO_USERID
#   samhan.notification.aligo.sender  ← SAMHAN_ALIGO_SENDER
#   samhan.notification.aligo.api-url ← SAMHAN_ALIGO_API_URL
# 주의: SAMHAN_ALIGO_* 만 공식 변수 — alias(ALIGO_API_KEY, ALIGO_USER_ID 등) 사용 금지.
SAMHAN_ALIGO_API_URL=
SAMHAN_ALIGO_KEY=
SAMHAN_ALIGO_USERID=
SAMHAN_ALIGO_SENDER=

# --- Phase 9 W3 — FCM (Firebase Cloud Messaging, Phase 10 활성 대비) --------
SAMHAN_FCM_PROJECT_ID=CHANGE_ME_LOCAL_ONLY
SAMHAN_FCM_CREDENTIALS_PATH=CHANGE_ME_LOCAL_ONLY
SAMHAN_FCM_CREDENTIALS_BASE64=CHANGE_ME_LOCAL_ONLY

# --- P0-2 슬라이스 1 — SMTP (비밀번호 재설정 이메일 발송) -------------------
# 매뉴얼 출처: docs/manual/06-트러블슈팅/01-로그인-실패.md §1-3
# username 비어있으면 SmtpEmailAdapter 가 NoOp 동작 (로그만 출력, 실 발송 X) — local dev 안전.
# 운영 등록: GitHub Secrets (CI) / AWS Secrets Manager (Phase 11 cutover) — README §SMTP 참조.
SMTP_HOST=smtp.cafe24.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@samhan-air.com
SMTP_STARTTLS=true

# --- Phase 9 W3 — UserClient bulk verify Caffeine cache (BE backlog #4) ---
# 짧은 시간 반복 lookup 시 RPC 회피 — TTL 60초 / max 10000 entries (default).
SAMHAN_USER_CACHE_TTL=60
SAMHAN_USER_CACHE_MAX=10000

# --- post-W5 backlog cleanup (Q-W3-1, D-P9-21) — 발송 재시도 최대 횟수 ---
# NotificationService.retry() 시점에 본 임계 초과 시 영구 FAILED 처리 (DEAD_LETTER 의미).
# 기본 5회 — production cutover 시점에 trial-and-error 학습 후 조정.
SAMHAN_NOTIFICATION_RETRY_MAX_ATTEMPTS=5

# --- post-W5 backlog cleanup (Q-W3-3, D-P9-21) — UserClient fail-mode ---
# OPEN (default, fail-soft — 네트워크 / discovery 실패 시 검증 통과) | STRICT (Phase 10 cutover 시점 활성, 검증 실패 시 throw)
# UserVerifierProperties.failMode 와 1:1 매핑 (UserVerifierProperties.failFast 의 의미 alias).
SAMHAN_USER_CLIENT_FAIL_MODE=OPEN
