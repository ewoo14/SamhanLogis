# accounting-service 전용 환경변수 템플릿 (Phase 4 / accounting-slice-A).
#
# 본 파일은 accounting-service 컨테이너 또는 systemd 유닛이 참조할 수 있는
# per-service env 템플릿입니다. infrastructure/.env.example 가 docker-compose
# 인프라 스택용이라면, 본 파일은 application 런타임 (bootRun / Docker / systemd)
# 전용으로 분리되어 있습니다. (slip-service.env 와 동일한 패턴)
#
# 사용법:
#   cp infrastructure/env-templates/accounting-service.env services/accounting-service/.env
#   (services/accounting-service/.env 는 .gitignore 의 .env 패턴으로 자동 무시됨)
#
# 모든 값은 DEV-ONLY 기본값입니다. staging/prod 배포 시 안전한 값으로 교체.

# --- DataSource (PostgreSQL) ---------------------------------------------
# accounting_db 는 infrastructure/postgres/init/01-create-databases.sql 에서
# 컨테이너 최초 부팅 시 생성됨. 신규 환경 변수 추가 없이 slip-service 와 동일.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=accounting_db
DB_USER=samhan
DB_PASSWORD=samhan_dev_pw

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Slice A 시점에 accounting-service 는 외부 호출이 없으나 (Solapi/SES 등 0)
# Slice B 부터 slip-service / partner-service 의 /accounting/internal/**
# 호출에 사용 가능. shared/common 의 InternalTokenGuard 와 동일 secret.
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존, Phase 10 cutover 시점 단일화).
SAMHAN_INTERNAL_TOKEN=dev-internal-token-change-me
INTERNAL_AUTH_TOKEN=dev-internal-token-change-me

# --- SP-09-1 NTS e-tax submit (DRY_RUN 우선, Phase 11 sandbox 전환 시 NTS) ------
# DRY_RUN: 실제 API 호출 없이 즉시 성공 반환 (본 슬라이스 기본 동작)
# NTS: Phase 11 sandbox 연동 후 활성화 — NTS_API_KEY + NTS_BASE_URL 실값으로 교체 필요
ETAX_SUBMIT_METHOD=DRY_RUN
NTS_API_KEY=PLACEHOLDER_DEV_ONLY
NTS_BASE_URL=https://teht.hometax.go.kr

# --- (Slice A 시점) 외부 의존 0 ------------------------------------------
# 회계 표준 계정과목 마스터 + 분개 CRUD 만 — Solapi/MinIO/Elasticsearch 모두 미사용.
# Phase 5+ 에서 다음 항목들이 추가될 예정 (현재 deferred):
#   - 결산 PDF 리포트 발행용 폰트 경로 (REPORT_FONT_PATH)
#   - prometheus pg_exporter 단일 DB 메트릭 (Phase 5 Grafana 대시보드)
