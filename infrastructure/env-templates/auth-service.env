# auth-service 전용 환경변수 템플릿 (Phase 1).
#
# 본 파일은 auth-service 컨테이너 또는 systemd 유닛이 참조할 수 있는
# per-service env 템플릿입니다. infrastructure/.env.example 가 docker-compose
# 인프라 스택용이라면, 본 파일은 application 런타임 (bootRun / Docker / systemd)
# 전용으로 분리되어 있습니다.
#
# 사용법:
#   cp infrastructure/env-templates/auth-service.env services/auth-service/.env
#   (services/auth-service/.env 는 .gitignore 의 .env 패턴으로 자동 무시됨)
#
# 모든 값은 DEV-ONLY 기본값입니다. staging/prod 배포 시 안전한 값으로 교체.

# --- DataSource (PostgreSQL) ---------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=CHANGE_ME_LOCAL_ONLY
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Eureka -------------------------------------------------------------
EUREKA_URL=http://localhost:8761/eureka/

# --- 서비스 간 내부 인증 토큰 ---------------------------------------------
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN legacy fallback 보존, Phase 10 cutover 시점 단일화).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- JWT 서명 비밀키 ----------------------------------------------------
# Phase 8 2차 — SAMHAN_JWT_SECRET 표준 (JWT_SECRET legacy fallback 보존).
SAMHAN_JWT_SECRET=dev-secret-change-me-in-production-32bytes-min!
JWT_SECRET=dev-secret-change-me-in-production-32bytes-min!
COOKIE_SECURE=false # CHANGE_TO_TRUE_IN_PROD (HTTPS 필수)

# --- SMTP (P0-2 비밀번호 셀프 재설정) -----------------------------------
# 현 단계(Phase 11 이전): Mock SMTP — 실제 발송 없이 console.log + auth_audit INSERT.
# Phase 11 이후: AWS SES STARTTLS (host=email-smtp.ap-northeast-2.amazonaws.com, port=587).
SAMHAN_SMTP_HOST=localhost
SAMHAN_SMTP_PORT=25
SAMHAN_SMTP_USERNAME=CHANGE_ME_PROD_ONLY
SAMHAN_SMTP_PASSWORD=CHANGE_ME_PROD_ONLY
SAMHAN_SMTP_AUTH=false
SAMHAN_SMTP_STARTTLS=false
SAMHAN_PASSWORD_RESET_FROM_EMAIL=no-reply@samhanair.com
