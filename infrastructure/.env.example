# SamhanLogis - infrastructure environment template.
# The launcher creates infrastructure/.env automatically when it is absent.
# This file lists the complete local key set. Never commit infrastructure/.env.
# CHANGE_ME_LOCAL_ONLY values are replaced with random local values by the launcher.

# --- PostgreSQL (DEV-ONLY) -----------------------------------------------
POSTGRES_USER=samhan
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_DB=postgres
DB_USER=samhan
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- RabbitMQ (DEV-ONLY) -------------------------------------------------
RABBITMQ_DEFAULT_USER=samhan
RABBITMQ_DEFAULT_PASS=CHANGE_ME_LOCAL_ONLY
RABBIT_USER=samhan
RABBIT_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- MinIO (DEV-ONLY) ----------------------------------------------------
MINIO_ROOT_USER=samhan
MINIO_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY

# --- Elasticsearch (DEV-ONLY) --------------------------------------------
# Security disabled for local dev (xpack.security.enabled=false).
ES_JAVA_OPTS=-Xms512m -Xmx512m

# --- Grafana (DEV-ONLY) --------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ONLY
GF_USERS_ALLOW_SIGN_UP=false

# --- 서비스 간 내부 인증 토큰 (DEV-ONLY) ------------------------------------
# auth-service 와 user-service 의 /auth/internal/** 호출에 사용되는 shared secret.
# prod 프로파일에서 아래 dev 기본값을 그대로 두면 InternalTokenGuard 가 부팅을 거부함.
# 운영 배포 전 강력한 랜덤 문자열로 반드시 교체할 것.
# Phase 8 2차 — SAMHAN_INTERNAL_TOKEN 표준 (INTERNAL_AUTH_TOKEN / INTERNAL_TOKEN legacy fallback 보존, Phase 10 cutover 시점 단일화).
SAMHAN_INTERNAL_TOKEN=CHANGE_ME_LOCAL_ONLY
INTERNAL_AUTH_TOKEN=CHANGE_ME_LOCAL_ONLY

# --- JWT 서명 비밀키 (DEV-ONLY) -------------------------------------------
# auth-service 의 JWT 발급 + api-gateway 의 검증에 사용. 32 byte 이상 권장.
# 운영 배포 전 안전한 비밀키로 반드시 교체.
# Phase 8 2차 — SAMHAN_JWT_SECRET 표준 (JWT_SECRET legacy fallback 보존).
SAMHAN_JWT_SECRET=CHANGE_ME_LOCAL_ONLY
JWT_SECRET=CHANGE_ME_LOCAL_ONLY
SAMHAN_AROLOGIS_JWT_SECRET=CHANGE_ME_LOCAL_ONLY

# --- Gateway ingress attestation (DEV-ONLY) -------------------------------
# 모든 서비스가 gateway 경유 요청의 신원을 검증한다. 로컬 bootstrap이 랜덤값을 생성한다.
SAMHAN_GATEWAY_ATTESTATION=CHANGE_ME_LOCAL_ONLY

# --- Solapi SMS Gateway (slip-service, Slice B) --------------------------
# 출고 배송 기사에게 배치 단위 SMS 1건 자동 발송 시 사용 (Plan §6).
# H2 local 프로파일은 MockSmsGateway 자동 활성 → 아래 값 미설정 가능.
# PgSQL (dev/staging/prod) 프로파일에서만 실제 Aligo API 호출.
# 발급: https://smartsms.aligo.in → 계정 가입 + API Key 발급
# sender-phone 은 사전 발신번호 등록(전기통신사업법) 완료된 010 번호여야 함.
ALIGO_API_KEY=dev-aligo-api-key-change-me
ALIGO_USER_ID=dev-aligo-user-id
ALIGO_SENDER_PHONE=01000000000
ALIGO_BASE_URL=https://apis.aligo.in

# --- SMTP (notification-service, P0-2 슬라이스 1 비밀번호 재설정) ---------
# 매뉴얼 출처: docs/manual/06-트러블슈팅/01-로그인-실패.md §1-3
# 인증되지 않은 환경 (local dev) 에서 SMTP_USERNAME 비어있으면 SmtpEmailAdapter NoOp 동작.
# 운영 등록 절차 (DevOps):
#   1) GitHub Secrets — repository → Settings → Secrets → Actions → SMTP_HOST/PORT/USERNAME/PASSWORD/FROM
#   2) AWS Secrets Manager (Phase 11 cutover) — secret name: samhan/notification/smtp
#   3) cafe24 메일 호스팅 사용 시: smtp.cafe24.com:587 STARTTLS, username = noreply@samhan-air.com
SMTP_HOST=smtp.cafe24.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@samhan-air.com
SMTP_STARTTLS=true

# --- MinIO 슬립 첨부 (slip-service, P1-8 슬라이스 6 모바일 사진 첨부) -----
# 매뉴얼 출처: docs/manual/04-모바일/04-사진-첨부.md §4
# 버킷 자동 생성: infrastructure/scripts/setup-minio-buckets.ps1 (start-local-full.ps1 가 자동 호출)
# enabled=false 시 NoopAttachmentStorage fallback (P0-3 partner-attachments 패턴 동일)
SAMHAN_SLIP_MINIO_ENABLED=false
SAMHAN_SLIP_MINIO_ENDPOINT=http://localhost:9000
SAMHAN_SLIP_MINIO_ACCESS_KEY=samhan
SAMHAN_SLIP_MINIO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
SAMHAN_SLIP_MINIO_BUCKET=slip-attachments
SAMHAN_SLIP_MINIO_PRESIGNED_EXPIRY=300

# --- P1 범용 사진 첨부 (AttachmentService, samhan-attachments bucket) -----
# 대상: 입고 검수 / 배송 완료 / 영업 방문 현장 사진 (단일 파일 ≤5MB, presigned URL 방식).
# 버킷 자동 생성: infrastructure/scripts/setup-minio-buckets.ps1 (start-local-full.ps1 가 자동 호출)
# application.yml chained-default 패턴:
#   samhan.s3.endpoint: ${SAMHAN_S3_ENDPOINT:http://localhost:9000}
#   samhan.s3.access-key: ${SAMHAN_S3_ACCESS_KEY:samhan}
#   samhan.s3.secret-key: ${SAMHAN_S3_SECRET_KEY}
#   samhan.s3.bucket: ${SAMHAN_S3_BUCKET:samhan-attachments}
#   samhan.s3.presigned-expiry-seconds: ${SAMHAN_S3_PRESIGNED_EXPIRY:300}
# Phase 11 AWS S3 cutover:
#   SAMHAN_S3_ENDPOINT=       (빈 값 → AWS SDK default endpoint 자동 전환)
#   SAMHAN_S3_BUCKET=samhan-attachments  (동일 이름 유지)
#   SAMHAN_AWS_REGION=ap-northeast-2
# 정책: private (anonymous read 금지). 다운로드 = presigned URL TTL 300s.
SAMHAN_S3_ENDPOINT=http://localhost:9000

# slip-service 창고 매핑 — 개발 예시의 대체 정책을 명시한다.
WAREHOUSE_MAPPING_MODE=DEV_SUBSTITUTE
WAREHOUSE_UUID_ECOUNT_00003=11111111-1111-1111-1111-000000000001
WAREHOUSE_UUID_ECOUNT_2=11111111-1111-1111-1111-000000000002
WAREHOUSE_UUID_ECOUNT_14=11111111-1111-1111-1111-000000000003
WAREHOUSE_UUID_ECOUNT_1=11111111-1111-1111-1111-000000000004
SAMHAN_S3_ACCESS_KEY=samhan
SAMHAN_S3_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
SAMHAN_S3_BUCKET=samhan-attachments
SAMHAN_S3_PRESIGNED_EXPIRY=300

# --- Samhan Public ↔ 아로로지스 배차 통신 (Phase A — samhan-dispatch-board) ----
# spec: docs/superpowers/specs/2026-05-14-samhan-dispatch-board-design.md §3 / §8
#
# slip-service 측 — arologis-service 의 /internal/arologis/dispatches 호출.
#   배차담당자가 [배차 완료] 클릭 → slip-service 가 본 URL 로 POST 전송 → Mock matcher.
# 아로로지스 발송 URL (배차 완료 시점)
SAMHAN_AROLOGIS_DISPATCH_URL=http://arologis-service:8097
#
# arologis-service 측 — slip-service 의 /internal/dispatch-tasks/* 회신 호출.
#   Mock matcher 매칭 완료/실패 시점 slip-service 로 결과 회신.
#   호출 URL = SAMHAN_SLIP_SERVICE_URL 재사용 (SlipDispatchTaskClient 도 SlipClient/
#   SlipServiceClient 와 동일하게 samhan.slip-service.url 을 그대로 소비, 별도 변수 없음).
# (제거됨, config-audit #745 재수렴) SAMHAN_SLIP_DISPATCH_TASK_URL — arologis-service 코드
#   어디에도 바인딩되지 않는 죽은 변수였다(grep 0건). 별도 URL 처럼 오인되지 않도록 정리했다.
#
# arologis-service 측 — Mock matcher 의 실패 확률 (Phase A only).
#   0.0 (default) = 항상 성공 (DISPATCHED). 1.0 = 항상 실패 (FAILED, slip UNDISPATCHED 복귀).
#   QA 시나리오 6 (Mock matcher 불가) 검증 시 1.0 으로 한시 설정.
# Mock matcher 실패 확률 (Phase A, 0.0=항상 성공)
SAMHAN_AROLOGIS_MOCK_FAIL_RATE=0.0
#
# 서비스 간 호출 토큰 = 위 SAMHAN_INTERNAL_TOKEN 재사용 (별도 변수 없음).
